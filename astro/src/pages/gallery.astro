---
// src/pages/gallery.astro
import Base from '../layouts/Base.astro';
import { getGalleryAlbums, getTeams, fileUrl } from '../lib/directus.js';

const INSTAGRAM_CONNECTED = false;

const albums = await getGalleryAlbums({ limit: 24 }) || [];
const allTeams = await getTeams() || [];
const hashtagTeams = allTeams.filter(t => t.hashtag);
---
<Base title="Gallery" description="Photo galleries from South Wagga Warriors FC — match photography, events and club life.">

  <div class="page-hero">
    <div class="page-hero-inner">
      <div class="label">Club Photography</div>
      <h1>Gallery</h1>
      <p>Match action, training sessions and club events. Photography by the Warriors community.</p>
    </div>
  </div>

  <div class="page-inner">

    <!-- ── TEAM GALLERIES ── -->
    <div class="section-heading">
      <h2>Team Galleries</h2>
      <p class="section-subtext">Follow your team's journey — tag your match day photos with your team's hashtag to contribute to the gallery.</p>
    </div>

    {hashtagTeams.length > 0 ? (
      <div class="hashtag-grid">
        {hashtagTeams.map(team => (
          <div class="hashtag-card card">
            <div class="hc-team-name">{team.short_name || team.name}</div>
            <div class="hc-hashtag">{team.hashtag}</div>
            {INSTAGRAM_CONNECTED ? (
              <a href={`/gallery/team/${team.hashtag.replace(/^#/, '')}`} class="hc-btn hc-btn-active">
                View Photos →
              </a>
            ) : (
              <a href={`/gallery/team/${team.hashtag.replace(/^#/, '')}`} class="hc-btn hc-btn-soon">
                Coming Soon
              </a>
            )}
          </div>
        ))}
      </div>
    ) : (
      <p class="empty-state-sm">Team hashtag galleries will appear here once teams are set up.</p>
    )}

    <div class="divider"></div>

    <!-- ── PHOTO ALBUMS ── -->
    <div class="section-heading">
      <h2>Photo Albums</h2>
    </div>

    {albums.length > 0 ? (
      <div class="albums-grid">
        {albums.map(album => (
          <a href={`/gallery/${album.id}`} class="album-card card">
            <div class="album-cover">
              {album.cover_photo ? (
                <img
                  src={fileUrl(album.cover_photo, { width:600, height:400 })}
                  alt={album.title}
                  loading="lazy"
                />
              ) : (
                <div class="album-cover-placeholder">📷</div>
              )}
              <div class="album-overlay"></div>
              <div class="album-info-overlay">
                <h3>{album.title}</h3>
                {album.date && (
                  <span>{new Date(album.date).toLocaleDateString('en-AU',{day:'numeric',month:'long',year:'numeric'})}</span>
                )}
              </div>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <p>Photo albums will appear here once uploaded by the club.</p>
      </div>
    )}

  </div>

</Base>

<style>
.page-hero { background:linear-gradient(135deg,var(--green-dark),var(--off-black)); border-bottom:1px solid var(--border); padding:60px 48px 48px; }
.page-hero-inner { max-width:1280px; margin:0 auto; }
.page-hero h1 { font-size:clamp(48px,6vw,80px); margin:10px 0 8px; }
.page-hero p  { color:var(--muted); }

.page-inner { max-width:1280px; margin:0 auto; padding:48px; }

.section-heading { margin-bottom:24px; }
.section-heading h2 { font-family:var(--font-cond); font-size:clamp(24px,3vw,36px); font-weight:800; margin-bottom:8px; }
.section-subtext { font-size:14px; color:var(--muted); max-width:600px; }

.divider { border:none; border-top:1px solid var(--border); margin:48px 0; }

/* Hashtag team cards */
.hashtag-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:16px; margin-bottom:0; }
.hashtag-card { padding:24px; display:flex; flex-direction:column; align-items:flex-start; gap:12px; }
.hc-team-name { font-family:var(--font-cond); font-size:12px; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:var(--muted); }
.hc-hashtag { font-family:var(--font-cond); font-size:22px; font-weight:800; color:var(--green-bright); line-height:1.2; }
.hc-btn { display:inline-block; font-family:var(--font-cond); font-size:13px; font-weight:700; letter-spacing:1px; text-transform:uppercase; border-radius:20px; padding:7px 16px; text-decoration:none; transition:all 0.2s; margin-top:auto; }
.hc-btn-active { background:var(--green); color:white; }
.hc-btn-active:hover { background:var(--green-bright); color:var(--black); }
.hc-btn-soon { background:transparent; color:var(--muted); border:1px solid var(--border); cursor:default; pointer-events:none; }
.empty-state-sm { color:var(--muted); font-style:italic; padding:20px 0 40px; }

/* Photo albums */
.albums-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); gap:16px; }

.album-card { text-decoration:none; border-radius:var(--radius-lg); overflow:hidden; transition:transform 0.2s; }
.album-card:hover { transform:translateY(-4px); }
.album-card:hover img { transform:scale(1.06); }

.album-cover { position:relative; aspect-ratio:3/2; overflow:hidden; background:var(--card); }
.album-cover img { width:100%; height:100%; object-fit:cover; transition:transform 0.4s; }
.album-cover-placeholder { width:100%; height:100%; display:flex; align-items:center; justify-content:center; font-size:48px; }

.album-overlay { position:absolute; inset:0; background:linear-gradient(to top,rgba(9,12,9,0.9) 0%,transparent 50%); }

.album-info-overlay { position:absolute; bottom:0; left:0; right:0; padding:20px; }
.album-info-overlay h3 { font-family:var(--font-cond); font-size:18px; font-weight:800; margin-bottom:4px; }
.album-info-overlay span { font-size:12px; color:rgba(238,245,239,0.6); }

.empty-state { text-align:center; padding:80px 0; color:var(--muted); }

@media (max-width:768px) {
  .page-hero { padding:40px 20px 32px; }
  .page-inner { padding:24px 20px; }
  .hashtag-grid { grid-template-columns:repeat(auto-fill,minmax(160px,1fr)); }
}
</style>
