  state.playersPage = 0;
  renderPlayersTable();
});

document.getElementById('players-agegroup').addEventListener('change', e => {
  state.playersAgeGroup = e.target.value;
  state.playersPage = 0;
  renderPlayersTable();
});

document.getElementById('players-gender').addEventListener('change', e => {
  state.playersGender = e.target.value;
  state.playersPage = 0;
  renderPlayersTable();
});

document.getElementById('players-load-more-btn').addEventListener('click', () => {
