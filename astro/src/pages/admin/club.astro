// ── Import tab ───────────────────────────────────────────────────────────────

const dropZone  = document.getElementById('drop-zone');
const csvInput  = document.getElementById('csv-file-input');

dropZone.addEventListener('dragover', e => { e.preventDefault(); dropZone.classList.add('drag-over'); });
dropZone.addEventListener('dragleave', ()=> { dropZone.classList.remove('drag-over'); });
dropZone.addEventListener('drop', e => {
  e.preventDefault(); dropZone.classList.remove('drag-over');
  const file = e.dataTransfer.files[0];
  if (file) handleFileSelected(file);
});
csvInput.addEventListener('change', () => {
  if (csvInput.files[0]) handleFileSelected(csvInput.files[0]);
});

function handleFileSelected(file) {
  state.csvData = file;
  state.csvParsed = null;
  document.getElementById('import-preview').hidden = true;
  document.getElementById('import-success-box').hidden = true;
  document.getElementById('import-progress').hidden = true;

  document.getElementById('file-info').hidden = false;
  document.getElementById('file-info').innerHTML = `
    <div class="file-info">
      <span style="font-size:22px">📄</span>
      <div class="file-info-name">${esc(file.name)}</div>
      <div class="file-info-size">${fmtBytes(file.size)}</div>
    </div>`;

  document.getElementById('import-parse-section').hidden = false;
}

document.getElementById('parse-btn').addEventListener('click', () => {
  if (!state.csvData) return;
  const btn = document.getElementById('parse-btn');
  btn.disabled = true; btn.textContent = 'Parsing…';

  Papa.parse(state.csvData, {
    header: true,
    skipEmptyLines: true,
    complete: (results) => {
      btn.disabled = false; btn.textContent = 'Parse & Preview';
      state.csvParsed = results.data;
      showImportPreview(results.data);
    },
    error: (err) => {
      btn.disabled = false; btn.textContent = 'Parse & Preview';
      alert('Parse error: ' + err.message);
    }
  });
});

function mapCSVRow(row) {
  function intOrNull(v) { const n = parseInt(v, 10); return isNaN(n) ? null : n; }
  function floatOrNull(v) { const n = parseFloat(v); return isNaN(n) ? null : n; }

  const mapped = {
    reg_entry_id:            row['Reg Entry ID'] || null,
    participant_id:          row['Participant ID'] || null,
    ffa_number:              row['FFA Number'] || null,
    reg_status:              row['Reg Status'] || null,
    payment_status:          row['Payment Status'] || null,
    date_registered:         row['Date Registered'] || null,
    first_name:              row['First Name'] || null,
    last_name:               row['Last Name'] || null,
    dob:                     row['DOB'] || null,
    age_years:               intOrNull(row['Age in years']),
    gender:                  row['Gender'] || null,
    address:                 row['Address'] || null,
    state:                   row['State'] || null,
    postcode:                row['Postcode'] || null,
    email:                   row['Email'] || null,
    mobile_phone:            row['Mobile Phone'] || null,
    emergency_contact:       row['Emergency Contact'] || null,
    emergency_contact_phone: row['Emergency Contact Phone'] || null,
    emergency_contact_email: row['Emergency Contact Email'] || null,
    previous_club_name:      row['Previous Club Name'] || null,
    previous_club_year:      row['Previous Club Year'] || null,
    marketing_opted_in:      (row['Club Marketing Opted In']||'').toLowerCase() === 'yes',
    payment_option:          row['Payment Option'] || null,
    total_payable:           floatOrNull(row['Total Invoice Payable']),
    product_name:            row['Product Name'] || null,
    product_age_min:         intOrNull(row['Product Age Min']),
    product_age_max:         intOrNull(row['Product Age Max']),
    product_gender:          row['Product Gender'] || null,
    role_type:               row['Roles'] || null,
    a_league_team:           row['FA Additional Question Answer #1'] || null,
  };

  // Club additional questions
  const q1text = (row['Club Additional Question #1'] || '').toLowerCase();
  const q1ans  = (row['Club Additional Question Answer #1'] || '').toLowerCase();
  if (q1text.includes('new player') || q1text.includes('new to club')) {
    mapped.is_new_to_club = q1ans === 'yes';
  } else if (q1text.includes('permission for your image') || q1text.includes('photo')) {
    mapped.photo_consent = q1ans === 'yes';
  }

  return mapped;
}

function showImportPreview(rows) {
  const mapped = rows.map(mapCSVRow);
  const players  = mapped.filter(r => (r.role_type||'').toLowerCase().includes('player'));
  const coaches  = mapped.filter(r => (r.role_type||'').toLowerCase().includes('coach'));
  const other    = mapped.filter(r => !(r.role_type||'').toLowerCase().includes('player') && !(r.role_type||'').toLowerCase().includes('coach'));

  // Existing FFA numbers
  const existingFFA = new Set(state.registrations.map(r => r.ffa_number).filter(Boolean));
  let newCount = 0, updateCount = 0, unchangedCount = 0;
  mapped.forEach(r => {
    if (!r.ffa_number) { newCount++; return; }
    if (existingFFA.has(r.ffa_number)) updateCount++;
    else newCount++;
  });

  document.getElementById('preview-stats').innerHTML = `
    <div class="preview-stat"><div class="preview-stat-num">${mapped.length}</div><div class="preview-stat-label">Total Records</div></div>
    <div class="preview-stat"><div class="preview-stat-num">${players.length}</div><div class="preview-stat-label">Players</div></div>
    <div class="preview-stat"><div class="preview-stat-num">${coaches.length}</div><div class="preview-stat-label">Coaches</div></div>
    <div class="preview-stat"><div class="preview-stat-num">${other.length}</div><div class="preview-stat-label">Other Roles</div></div>`;

  document.getElementById('preview-breakdown-tbody').innerHTML = `
    <tr><td>New records</td><td><strong>${newCount}</strong></td></tr>
    <tr><td>Updates (matched by FFA Number)</td><td><strong>${updateCount}</strong></td></tr>`;

  document.getElementById('import-btn').textContent = `Import ${mapped.length} Records`;
  document.getElementById('import-preview').hidden = false;
}

function populateImportSeasonSelect() {
  const sel = document.getElementById('import-season-select');
  sel.innerHTML = state.seasons.map(s =>
    `<option value="${s.id}"${s.status === 'active' ? ' selected' : ''}>${esc(s.name||String(s.year))}</option>`
  ).join('');
}

document.getElementById('import-btn').addEventListener('click', async () => {
  if (!state.csvParsed) return;
  const seasonId = parseInt(document.getElementById('import-season-select').value, 10);
  if (!seasonId) { alert('Please select a season.'); return; }

  const btn = document.getElementById('import-btn');
  btn.disabled = true;

  const allMapped = state.csvParsed.map(mapCSVRow);

  // Build existing FFA→id map
  const ffaToId = {};
  state.registrations.forEach(r => { if (r.ffa_number) ffaToId[r.ffa_number] = r.id; });

  const toCreate = [];
  const toUpdate = [];
  allMapped.forEach(r => {
    if (r.ffa_number && ffaToId[r.ffa_number]) {
      const existingId = ffaToId[r.ffa_number];
      // Preserve team assignment
      const existingReg = state.registrations.find(reg => reg.id === existingId);
      const payload = { ...r, season: seasonId };
      if (existingReg && existingReg.team) delete payload.team; // don't overwrite team
      toUpdate.push({ id: existingId, payload });
    } else {
      toCreate.push({ ...r, season: seasonId });
    }
  });

  const total = toCreate.length + toUpdate.length;
  let done = 0;

  document.getElementById('import-progress').hidden = false;
  const progressBar   = document.getElementById('import-progress-bar');
  const progressLabel = document.getElementById('import-progress-label');

  function updateProgress() {
    const pct = total > 0 ? Math.round((done / total) * 100) : 100;
    progressBar.style.width = pct + '%';
    progressLabel.textContent = `Importing… ${done} / ${total}`;
  }
  updateProgress();

  const BATCH = 50;

  // Creates
  for (let i = 0; i < toCreate.length; i += BATCH) {
    const batch = toCreate.slice(i, i + BATCH);
    try {
      await api('/items/club_registrations', {
        method: 'POST',
        body: JSON.stringify(batch),
      });
      done += batch.length;
    } catch (e) {
      done += batch.length; // still advance
    }
    updateProgress();
  }

  // Updates (Directus bulk PATCH)
  for (let i = 0; i < toUpdate.length; i += BATCH) {
    const batch = toUpdate.slice(i, i + BATCH);
    try {
      await api('/items/club_registrations', {
        method: 'PATCH',
        body: JSON.stringify({ keys: batch.map(b => b.id), data: batch[0].payload }),
      });
      done += batch.length;
    } catch {
      // Fall back to individual PATCHes
      for (const item of batch) {
        try {
          await api(`/items/club_registrations/${item.id}`, {
            method: 'PATCH',
            body: JSON.stringify(item.payload),
          });
        } catch {}
        done++;
        updateProgress();
      }
      continue;
    }
    updateProgress();
  }

  progressLabel.textContent = 'Import complete!';
  progressBar.style.width = '100%';

  document.getElementById('import-success-box').hidden = false;
  document.getElementById('import-success-box').innerHTML = `
    <div class="import-success-title">Import Complete</div>
    <div>Created: <strong>${toCreate.length}</strong> new records &nbsp;·&nbsp; Updated: <strong>${toUpdate.length}</strong> existing records</div>`;

  btn.disabled = false;
  btn.textContent = 'Import Again';

  // Reload registrations
  await loadRegistrations();
  renderPlayersTab();
  renderPlayersTable();
  if (state.selectedTeamId) { renderTeamsSidebar(); renderTeamDetail(); }
});

// ── Season tab ───────────────────────────────────────────────────────────────

function renderSeasonTab() {
  renderCurrentSeasonCard();
  renderArchivedSeasons();
}

function renderCurrentSeasonCard() {
  const card = document.getElementById('season-current-card');
  const s = state.activeSeason;
  if (!s) {
    card.innerHTML = '<div style="color:var(--muted);font-style:italic;">No active season. Create one below.</div>';
    return;
  }
  const playerCount = state.registrations.filter(r => (r.role_type||'').toLowerCase().includes('player')).length;
  const teamCount   = state.teams.length;

  card.innerHTML = `
    <div class="season-card-header">
      <div>
        <div style="font-family:var(--font-cond);font-size:11px;text-transform:uppercase;letter-spacing:0.1em;color:var(--muted);margin-bottom:4px;">Current Season</div>
        <div class="season-card-name">${esc(s.name || String(s.year))}</div>
      </div>
      <span class="status-badge status-active">Active</span>
    </div>
    <div class="season-counts">
      <div class="season-count">
        <div class="season-count-num">${playerCount}</div>
        <div class="season-count-label">Players</div>
      </div>
      <div class="season-count">
        <div class="season-count-num">${teamCount}</div>
        <div class="season-count-label">Teams</div>
      </div>
      <div class="season-count">
        <div class="season-count-num">${s.year || '—'}</div>
        <div class="season-count-label">Year</div>
      </div>
    </div>
    <button id="archive-season-btn" class="btn-danger">Archive Season</button>`;

  document.getElementById('archive-season-btn').addEventListener('click', () => {
    document.getElementById('archive-modal').hidden = false;
  });
}

document.getElementById('archive-cancel').addEventListener('click', () => {
  document.getElementById('archive-modal').hidden = true;
});

document.getElementById('archive-confirm').addEventListener('click', async () => {
  document.getElementById('archive-modal').hidden = true;
  if (!state.activeSeason) return;
  try {
    const res = await api(`/items/club_seasons/${state.activeSeason.id}`, {
      method: 'PATCH',
      body: JSON.stringify({ status: 'archived' }),
    });
    if (!res.ok) throw new Error('Failed to archive season');
    state.activeSeason.status = 'archived';
    const idx = state.seasons.findIndex(s => s.id === state.activeSeason.id);
    if (idx !== -1) state.seasons[idx].status = 'archived';
    state.activeSeason = null;
    document.getElementById('season-chip').hidden = true;
    renderSeasonTab();
  } catch (err) {
    alert('Error: ' + err.message);
  }
});

document.getElementById('create-season-btn').addEventListener('click', async () => {
  const name = document.getElementById('new-season-name').value.trim();
  const year = parseInt(document.getElementById('new-season-year').value.trim(), 10);
  const msg  = document.getElementById('new-season-msg');
  msg.textContent = ''; msg.style.color = '';
  if (!name) { msg.textContent = 'Please enter a season name.'; msg.style.color = 'var(--red)'; return; }
  if (!year || isNaN(year)) { msg.textContent = 'Please enter a valid year.'; msg.style.color = 'var(--red)'; return; }

  const btn = document.getElementById('create-season-btn');
  btn.disabled = true; btn.textContent = 'Creating…';

  try {
    const res = await api('/items/club_seasons', {
      method: 'POST',
      body: JSON.stringify({ name, year, status: 'active' }),
    });
    if (!res.ok) throw new Error('Failed to create season');
    const data = await res.json();
    const newSeason = data.data;
    state.seasons.unshift(newSeason);
    state.activeSeason = newSeason;

    const chip = document.getElementById('season-chip');
    chip.textContent = newSeason.name || String(newSeason.year);
    chip.hidden = false;

    document.getElementById('new-season-name').value = '';
    document.getElementById('new-season-year').value = '';
    msg.textContent = 'Season created!'; msg.style.color = 'var(--green)';
    setTimeout(() => { msg.textContent = ''; }, 3000);

    // Reload teams/regs for new season
    await loadTeams();
    await loadRegistrations();
    renderSeasonTab();
    renderTeamsSidebar();
    renderPlayersTab();
    renderPlayersTable();
    populateImportSeasonSelect();
  } catch (err) {
    msg.textContent = err.message; msg.style.color = 'var(--red)';
  } finally {
    btn.disabled = false; btn.textContent = 'Create Season';
  }
});

function renderArchivedSeasons() {
  const archived = state.seasons.filter(s => s.status === 'archived');
  const container = document.getElementById('archived-seasons-list');
  if (!archived.length) {
    container.innerHTML = '<div style="color:var(--muted);font-style:italic;font-size:13px;">No archived seasons.</div>';
    return;
  }
  container.innerHTML = archived.map(s => `
    <div class="archived-row">
      <div>
        <div class="archived-row-name">${esc(s.name || String(s.year))}</div>
        <div class="archived-row-meta">Year: ${s.year || '—'}</div>
      </div>
      <span class="status-badge status-archived">Archived</span>
    </div>`).join('');
}

