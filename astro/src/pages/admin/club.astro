---
// src/pages/admin/club.astro
// Club Administrator portal — team, player, import, and season management
import PortalBase from '../../layouts/PortalBase.astro';
import { CLUB } from '../../club.config.js';
const directusUrl = import.meta.env.PUBLIC_DIRECTUS_URL || 'https://directus-production-ebbb.up.railway.app';
---
<PortalBase
  title={`${CLUB.shortName} — Club Admin`}
  description={`${CLUB.shortName} club administration panel.`}
>

<style is:global>
@import url('https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Barlow+Condensed:wght@400;600;700;800;900&display=swap');

[hidden] { display: none !important; }

:root {
  --bg: #f4f6f8;
  --surface: #ffffff;
  --card: #f8f9fa;
  --border: #e1e4e8;
  --text: #1c2128;
  --muted: #656d76;
  --green: #1d7a3a;
  --green-light: #e6f4ea;
  --green-accent: #2da44e;
  --amber: #9a6700;
  --amber-light: #fff8c5;
  --red: #cf222e;
  --red-light: #ffebe9;
  --blue: #0969da;
  --blue-light: #ddf4ff;
  --font-body: 'Barlow', sans-serif;
  --font-cond: 'Barlow Condensed', sans-serif;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body { background: var(--bg); color: var(--text); font-family: var(--font-body); font-size: 14px; }

/* ── Login ───────────────────────────────────────────────────────────────── */
.login-hero { background: linear-gradient(135deg, #1c2128 0%, #0d1117 100%); padding: 60px 24px; text-align: center; }
.login-label { font-family: var(--font-cond); font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: #8b949e; display: block; }
.login-title { font-family: var(--font-cond); font-size: 36px; font-weight: 800; color: #fff; margin-top: 8px; }
.login-sub { color: #6e7681; font-size: 14px; margin-top: 8px; }
.login-outer { display: flex; justify-content: center; padding: 32px 24px 48px; }
.login-card { width: 100%; max-width: 400px; background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 24px; display: flex; flex-direction: column; gap: 14px; box-shadow: 0 4px 16px rgba(0,0,0,0.08); }
.field-group { display: flex; flex-direction: column; gap: 5px; }
.field-group label { font-size: 13px; font-weight: 600; }
.field-group input { padding: 9px 12px; border: 1px solid var(--border); border-radius: 6px; font-size: 14px; background: var(--card); }
.field-group input:focus { outline: none; border-color: var(--green-accent); }
.error-text { font-size: 13px; color: var(--red); }

/* ── Topbar ──────────────────────────────────────────────────────────────── */
.topbar { background: var(--surface); border-bottom: 1px solid var(--border); position: sticky; top: 0; z-index: 100; box-shadow: 0 1px 4px rgba(0,0,0,0.06); }
.topbar-row1 { max-width: 1400px; margin: 0 auto; padding: 12px 24px; display: flex; justify-content: space-between; align-items: center; }
.topbar-label { font-family: var(--font-cond); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); display: block; }
.topbar-title { font-family: var(--font-cond); font-size: 20px; font-weight: 800; color: var(--text); }
.topbar-right { display: flex; align-items: center; gap: 12px; }
.topbar-row2 { max-width: 1400px; margin: 0 auto; padding: 0 24px; display: flex; gap: 2px; border-top: 1px solid var(--border); }
.tab-nav { padding: 10px 16px; font-family: var(--font-cond); font-size: 13px; font-weight: 700; letter-spacing: 0.05em; background: none; border: none; color: var(--muted); cursor: pointer; border-bottom: 2px solid transparent; margin-bottom: -1px; display: flex; align-items: center; gap: 6px; transition: color 0.2s; }
.tab-nav:hover { color: var(--text); }
.tab-nav--active { color: var(--green-accent); border-bottom-color: var(--green-accent); }
.season-chip { background: var(--green-light); color: var(--green); border-radius: 12px; padding: 3px 12px; font-family: var(--font-cond); font-size: 12px; font-weight: 700; }
.user-badge { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 4px 12px; font-size: 13px; font-weight: 500; }
.btn-ghost { background: none; border: none; color: var(--muted); cursor: pointer; font-family: var(--font-cond); font-size: 13px; font-weight: 700; padding: 6px 10px; }
.btn-ghost:hover { color: var(--text); }

/* ── Shared Buttons ──────────────────────────────────────────────────────── */
.btn-primary { width: 100%; padding: 11px; background: var(--green-accent); color: #fff; border: none; border-radius: 7px; font-family: var(--font-cond); font-size: 15px; font-weight: 800; letter-spacing: 0.04em; cursor: pointer; }
.btn-primary:hover { background: var(--green); }
.btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }
.btn-green { background: var(--green-accent); color: #fff; border: none; border-radius: 7px; padding: 9px 18px; font-family: var(--font-cond); font-size: 13px; font-weight: 800; cursor: pointer; white-space: nowrap; }
.btn-green:hover { background: var(--green); }
.btn-green:disabled { opacity: 0.5; cursor: not-allowed; }
.btn-outline { background: none; border: 1px solid var(--border); border-radius: 7px; padding: 8px 16px; font-family: var(--font-cond); font-size: 13px; font-weight: 700; cursor: pointer; color: var(--text); }
.btn-outline:hover { border-color: var(--text); }
.btn-danger { background: none; border: 1px solid var(--red); color: var(--red); border-radius: 7px; padding: 8px 16px; font-family: var(--font-cond); font-size: 13px; font-weight: 700; cursor: pointer; }
.btn-danger:hover { background: var(--red-light); }
.btn-sm { padding: 5px 12px; font-size: 12px; border-radius: 5px; }

/* ── Misc/Loading ────────────────────────────────────────────────────────── */
.full-loading { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 60vh; gap: 16px; color: var(--muted); }
.spinner { width: 28px; height: 28px; border: 3px solid var(--border); border-top-color: var(--green-accent); border-radius: 50%; animation: spin 0.8s linear infinite; }
.spinner-sm { width: 16px; height: 16px; border: 2px solid rgba(255,255,255,0.4); border-top-color: #fff; border-radius: 50%; animation: spin 0.8s linear infinite; display: inline-block; vertical-align: middle; }
@keyframes spin { to { transform: rotate(360deg); } }
.section-heading { font-family: var(--font-cond); font-size: 12px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); margin-bottom: 10px; }
.view { display: block; }
.tab-panel { display: none; }
.tab-panel.active { display: block; }

/* ── Payment chips ───────────────────────────────────────────────────────── */
.pay-chip { display: inline-block; font-family: var(--font-cond); font-size: 10px; font-weight: 700; padding: 2px 8px; border-radius: 10px; letter-spacing: 0.04em; white-space: nowrap; }
.pay-paid    { background: var(--green-light); color: var(--green); }
.pay-partial { background: var(--amber-light); color: var(--amber); }
.pay-unpaid  { background: var(--red-light); color: var(--red); }
.pay-unknown { background: var(--card); color: var(--muted); }

/* ── STATUS badges ───────────────────────────────────────────────────────── */
.status-badge { display: inline-block; font-family: var(--font-cond); font-size: 11px; font-weight: 700; padding: 3px 10px; border-radius: 10px; letter-spacing: 0.04em; }
.status-active   { background: var(--green-light); color: var(--green); }
.status-archived { background: var(--card); color: var(--muted); }

/* ── TAB: TEAMS ─────────────────────────────────────────────────────────── */
.teams-layout { display: grid; grid-template-columns: 280px 1fr; height: calc(100vh - 113px); }
.teams-sidebar { border-right: 1px solid var(--border); background: var(--surface); display: flex; flex-direction: column; overflow: hidden; }
.teams-sidebar-header { padding: 12px; border-bottom: 1px solid var(--border); }
.teams-detail { overflow-y: auto; background: var(--bg); }
.team-group-label { padding: 6px 12px 4px; font-family: var(--font-cond); font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); background: var(--card); border-bottom: 1px solid var(--border); }
.team-row { padding: 10px 14px; border-bottom: 1px solid var(--border); cursor: pointer; transition: background 0.1s; display: flex; justify-content: space-between; align-items: center; }
.team-row:hover { background: var(--card); }
.team-row.selected { background: var(--green-light); }
.team-row-left { display: flex; flex-direction: column; gap: 2px; }
.team-row-name { font-weight: 600; font-size: 14px; }
.team-row-hashtag { font-size: 11px; color: var(--muted); font-family: var(--font-cond); }
.team-row-right { display: flex; align-items: center; gap: 6px; }
.player-count-chip { background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 1px 7px; font-family: var(--font-cond); font-size: 11px; font-weight: 700; color: var(--muted); }
.teams-list-scroll { flex: 1; overflow-y: auto; }
.detail-empty { padding: 48px 32px; color: var(--muted); font-style: italic; text-align: center; font-size: 15px; }
.team-detail-inner { padding: 24px; max-width: 800px; }
.team-detail-form { display: flex; flex-direction: column; gap: 14px; background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 20px; margin-bottom: 24px; }
.form-row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.form-field { display: flex; flex-direction: column; gap: 5px; }
.form-field label { font-size: 12px; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; font-family: var(--font-cond); }
.form-field input, .form-field select, .form-field textarea { padding: 8px 10px; border: 1px solid var(--border); border-radius: 6px; font-size: 14px; background: var(--surface); font-family: var(--font-body); }
.form-field input:focus, .form-field select:focus, .form-field textarea:focus { outline: none; border-color: var(--green-accent); }
.hashtag-wrap { display: flex; align-items: center; border: 1px solid var(--border); border-radius: 6px; overflow: hidden; background: var(--surface); }
.hashtag-prefix { padding: 8px 10px; background: var(--card); border-right: 1px solid var(--border); color: var(--muted); font-weight: 700; font-size: 14px; }
.hashtag-wrap input { border: none; border-radius: 0; flex: 1; }
.hashtag-wrap input:focus { outline: none; }
.color-swatches { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 4px; }
.color-swatch { width: 28px; height: 28px; border-radius: 50%; cursor: pointer; border: 3px solid transparent; transition: transform 0.1s, border-color 0.1s; }
.color-swatch:hover { transform: scale(1.15); }
.color-swatch.selected { border-color: var(--text); }
.squad-heading { font-family: var(--font-cond); font-size: 18px; font-weight: 800; margin-bottom: 14px; }
.squad-table { width: 100%; border-collapse: collapse; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; overflow: hidden; margin-bottom: 24px; }
.squad-table th { background: var(--card); font-family: var(--font-cond); font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); padding: 9px 14px; text-align: left; border-bottom: 1px solid var(--border); }
.squad-table td { padding: 9px 14px; border-bottom: 1px solid var(--border); font-size: 13px; vertical-align: middle; }
.squad-table tr:last-child td { border-bottom: none; }
.squad-table tr:hover td { background: var(--card); }
.add-players-section { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 16px; }
.add-players-search { width: 100%; padding: 8px 12px; border: 1px solid var(--border); border-radius: 6px; font-size: 14px; margin-bottom: 10px; }
.add-players-search:focus { outline: none; border-color: var(--green-accent); }
.add-player-results { display: flex; flex-direction: column; gap: 4px; max-height: 220px; overflow-y: auto; }
.add-player-result { padding: 8px 12px; background: var(--card); border: 1px solid var(--border); border-radius: 6px; display: flex; justify-content: space-between; align-items: center; cursor: pointer; transition: background 0.1s; }
.add-player-result:hover { background: var(--green-light); border-color: var(--green-accent); }
.add-player-name { font-weight: 600; font-size: 13px; }
.add-player-meta { font-size: 12px; color: var(--muted); }
.save-row { display: flex; align-items: center; gap: 12px; }
.save-msg { font-family: var(--font-cond); font-size: 13px; color: var(--green); font-weight: 700; }
.save-err { font-family: var(--font-cond); font-size: 13px; color: var(--red); font-weight: 700; }

/* ── TAB: PLAYERS ───────────────────────────────────────────────────────── */
.players-layout { padding: 20px 24px; max-width: 1400px; margin: 0 auto; }
.players-top { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin-bottom: 14px; }
.players-search { flex: 1; min-width: 200px; padding: 8px 12px; border: 1px solid var(--border); border-radius: 6px; font-size: 14px; }
.players-search:focus { outline: none; border-color: var(--green-accent); }
.filter-chips { display: flex; gap: 6px; flex-wrap: wrap; }
.filter-chip { padding: 5px 12px; border: 1px solid var(--border); border-radius: 16px; font-family: var(--font-cond); font-size: 12px; font-weight: 700; cursor: pointer; background: none; color: var(--muted); transition: all 0.15s; }
.filter-chip:hover { border-color: var(--green-accent); color: var(--green-accent); }
.filter-chip.active { background: var(--green-light); border-color: var(--green-accent); color: var(--green-accent); }
.players-select { padding: 7px 10px; border: 1px solid var(--border); border-radius: 6px; font-size: 13px; background: var(--surface); }
.players-select:focus { outline: none; border-color: var(--green-accent); }
.stats-bar-players { display: flex; gap: 6px; align-items: center; margin-bottom: 14px; font-family: var(--font-cond); font-size: 13px; color: var(--muted); }
.stats-bar-players strong { color: var(--text); }
.players-table-wrap { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; overflow: hidden; }
.players-table { width: 100%; border-collapse: collapse; }
.players-table th { background: var(--card); font-family: var(--font-cond); font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); padding: 10px 14px; text-align: left; border-bottom: 1px solid var(--border); }
.players-table td { padding: 9px 14px; border-bottom: 1px solid var(--border); font-size: 13px; vertical-align: middle; }
.players-table tr:last-child td { border-bottom: none; }
.players-table tr.unlinked { border-left: 3px solid var(--amber); }
.players-table tr.unlinked td:first-child { padding-left: 11px; }
.unlinked-label { color: var(--amber); font-style: italic; font-size: 12px; }
.assign-select { padding: 5px 8px; border: 1px solid var(--border); border-radius: 5px; font-size: 12px; background: var(--surface); cursor: pointer; }
.assign-select:focus { outline: none; border-color: var(--green-accent); }
.load-more-row { padding: 16px; text-align: center; border-top: 1px solid var(--border); }

/* ── TAB: IMPORT ────────────────────────────────────────────────────────── */
.import-layout { padding: 32px 24px; display: flex; justify-content: center; }
.import-card { width: 100%; max-width: 620px; background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 32px; box-shadow: 0 2px 12px rgba(0,0,0,0.06); }
.import-card h2 { font-family: var(--font-cond); font-size: 24px; font-weight: 800; margin-bottom: 8px; }
.import-card p { color: var(--muted); font-size: 14px; line-height: 1.6; margin-bottom: 24px; }
.drop-zone { border: 2px dashed var(--border); border-radius: 10px; padding: 48px 24px; text-align: center; cursor: pointer; transition: border-color 0.2s, background 0.2s; position: relative; }
.drop-zone:hover, .drop-zone.drag-over { border-color: var(--green-accent); background: var(--green-light); }
.drop-zone-icon { font-size: 40px; margin-bottom: 12px; }
.drop-zone-text { font-family: var(--font-cond); font-size: 16px; font-weight: 700; color: var(--muted); }
.drop-zone-sub { font-size: 13px; color: var(--muted); margin-top: 6px; }
.drop-zone input[type=file] { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
.file-info { display: flex; align-items: center; gap: 12px; background: var(--card); border: 1px solid var(--border); border-radius: 8px; padding: 12px 16px; margin-top: 16px; }
.file-info-name { font-weight: 600; font-size: 14px; flex: 1; }
.file-info-size { color: var(--muted); font-size: 13px; font-family: var(--font-cond); }
.preview-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin: 20px 0; }
.preview-stat { background: var(--card); border: 1px solid var(--border); border-radius: 8px; padding: 12px; text-align: center; }
.preview-stat-num { font-family: var(--font-cond); font-size: 24px; font-weight: 800; color: var(--text); }
.preview-stat-label { font-size: 11px; color: var(--muted); font-family: var(--font-cond); letter-spacing: 0.06em; text-transform: uppercase; }
.preview-breakdown { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
.preview-breakdown th { text-align: left; font-family: var(--font-cond); font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--muted); padding: 8px 10px; border-bottom: 1px solid var(--border); }
.preview-breakdown td { padding: 8px 10px; border-bottom: 1px solid var(--border); font-size: 13px; }
.import-progress { background: var(--card); border-radius: 8px; padding: 16px; margin-top: 16px; }
.progress-bar-outer { background: var(--border); border-radius: 4px; height: 8px; overflow: hidden; margin: 8px 0; }
.progress-bar-inner { height: 100%; background: var(--green-accent); border-radius: 4px; transition: width 0.3s; }
.progress-label { font-family: var(--font-cond); font-size: 13px; color: var(--muted); }
.import-success { background: var(--green-light); border: 1px solid #a7f3d0; border-radius: 8px; padding: 16px; margin-top: 16px; }
.import-success-title { font-family: var(--font-cond); font-size: 16px; font-weight: 800; color: var(--green); margin-bottom: 6px; }
.season-select-row { display: flex; gap: 10px; align-items: center; margin: 16px 0; }
.season-select-row label { font-size: 13px; font-weight: 600; white-space: nowrap; }
.season-select-row select { flex: 1; padding: 8px 10px; border: 1px solid var(--border); border-radius: 6px; font-size: 14px; }

/* ── TAB: SEASON ────────────────────────────────────────────────────────── */
.season-layout { padding: 24px; max-width: 700px; margin: 0 auto; display: flex; flex-direction: column; gap: 20px; }
.season-current-card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 24px; }
.season-card-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px; }
.season-card-name { font-family: var(--font-cond); font-size: 26px; font-weight: 800; }
.season-counts { display: flex; gap: 20px; margin-bottom: 20px; }
.season-count { display: flex; flex-direction: column; gap: 2px; }
.season-count-num { font-family: var(--font-cond); font-size: 28px; font-weight: 800; color: var(--green-accent); }
.season-count-label { font-size: 12px; color: var(--muted); font-family: var(--font-cond); text-transform: uppercase; letter-spacing: 0.06em; }
.new-season-card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 24px; }
.new-season-card h3 { font-family: var(--font-cond); font-size: 18px; font-weight: 800; margin-bottom: 16px; }
.new-season-form { display: flex; flex-direction: column; gap: 12px; }
.new-season-form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.archived-seasons-card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 24px; }
.archived-seasons-card h3 { font-family: var(--font-cond); font-size: 18px; font-weight: 800; margin-bottom: 16px; }
.archived-row { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid var(--border); }
.archived-row:last-child { border-bottom: none; }
.archived-row-name { font-weight: 600; font-size: 14px; }
.archived-row-meta { font-size: 12px; color: var(--muted); margin-top: 2px; }

/* ── Modal ──────────────────────────────────────────────────────────────── */
.modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 200; display: flex; align-items: center; justify-content: center; padding: 24px; }
.modal-box { background: var(--surface); border-radius: 12px; padding: 28px; max-width: 440px; width: 100%; box-shadow: 0 8px 32px rgba(0,0,0,0.18); }
.modal-title { font-family: var(--font-cond); font-size: 20px; font-weight: 800; margin-bottom: 10px; }
.modal-body { font-size: 14px; color: var(--muted); line-height: 1.6; margin-bottom: 20px; }
.modal-actions { display: flex; gap: 10px; justify-content: flex-end; }

@media (max-width: 900px) {
  .teams-layout { grid-template-columns: 1fr; height: auto; }
  .teams-sidebar { max-height: 240px; border-right: none; border-bottom: 1px solid var(--border); }
  .form-row-2 { grid-template-columns: 1fr; }
  .preview-stats { grid-template-columns: 1fr 1fr; }
}
</style>

<!-- PapaParse for CSV import -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.4.1/papaparse.min.js"></script>

<!-- ── View: Login ──────────────────────────────────────────────────────── -->
<div id="view-login" class="view">
  <div class="login-hero">
    <span class="login-label">{CLUB.shortName}</span>
    <h1 class="login-title">Club Admin Portal</h1>
    <p class="login-sub">Team and player management</p>
  </div>
  <div class="login-outer">
    <div class="login-card">
      <div class="field-group">
        <label for="login-email">Email</label>
        <input id="login-email" type="email" autocomplete="email" placeholder={`admin@${CLUB.email.split('@')[1]}`}>
      </div>
      <div class="field-group">
        <label for="login-password">Password</label>
        <input id="login-password" type="password" autocomplete="current-password">
      </div>
      <button id="login-btn" class="btn-primary">Sign In &rarr;</button>
      <p id="login-error" class="error-text" hidden></p>
    </div>
  </div>
</div>

<!-- ── View: Dashboard ──────────────────────────────────────────────────── -->
<div id="view-dashboard" class="view" hidden>

  <!-- Topbar -->
  <div class="topbar">
    <div class="topbar-row1">
      <div>
        <span class="topbar-label">{CLUB.shortName}</span>
        <h1 class="topbar-title">Club Admin</h1>
      </div>
      <div class="topbar-right">
        <span id="season-chip" class="season-chip" hidden></span>
