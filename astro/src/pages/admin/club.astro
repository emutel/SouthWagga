</div><!-- /view-dashboard -->

<!-- Archive modal -->
<div id="archive-modal" class="modal-overlay" hidden>
  <div class="modal-box">
    <div class="modal-title">Archive This Season?</div>
    <div class="modal-body">This will lock the season. All data is preserved and can be viewed, but no further changes can be made. Are you sure?</div>
    <div class="modal-actions">
      <button id="archive-cancel" class="btn-outline">Cancel</button>
      <button id="archive-confirm" class="btn-danger">Archive Season</button>
    </div>
