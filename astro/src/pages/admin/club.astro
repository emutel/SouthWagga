<script define:vars={{ directusUrl }}>
const DURL = directusUrl.replace(/\/$/, '');

// ── Helpers ─────────────────────────────────────────────────────────────────

function asArray(v) { return Array.isArray(v) ? v : []; }

function esc(s) {
  if (s == null) return '';
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function fmtBytes(n) {
  if (n < 1024) return n + ' B';
  if (n < 1048576) return (n/1024).toFixed(1) + ' KB';
  return (n/1048576).toFixed(1) + ' MB';
}

// ── Session storage ──────────────────────────────────────────────────────────

const ALS = {
  get token()   { return sessionStorage.getItem('warriors_club_token'); },
  get refresh() { return sessionStorage.getItem('warriors_club_refresh'); },
  get user()    { try { return JSON.parse(sessionStorage.getItem('warriors_club_user')||'null'); } catch { return null; } },
  set token(v)  { sessionStorage.setItem('warriors_club_token', v); },
  set refresh(v){ sessionStorage.setItem('warriors_club_refresh', v); },
  set user(v)   { sessionStorage.setItem('warriors_club_user', JSON.stringify(v)); },
  clear()       { ['warriors_club_token','warriors_club_refresh','warriors_club_user'].forEach(k => sessionStorage.removeItem(k)); },
};

// ── API helper ───────────────────────────────────────────────────────────────

async function api(path, opts = {}) {
  const go = async (token) => {
    const headers = { 'Content-Type': 'application/json', ...(opts.headers || {}) };
    if (token) headers['Authorization'] = 'Bearer ' + token;
    return fetch(DURL + path, { ...opts, headers });
  };

  let res = await go(ALS.token);

  if (res.status === 401 && ALS.refresh) {
    // Try refresh
    const rr = await fetch(DURL + '/auth/refresh', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ refresh_token: ALS.refresh }),
    });
    if (rr.ok) {
      const rd = await rr.json();
      ALS.token   = rd.data.access_token;
      ALS.refresh = rd.data.refresh_token;
      res = await go(ALS.token);
    } else {
      ALS.clear();
      showLogin();
      throw new Error('Session expired');
    }
  }

  return res;
}

// ── Payment chip ─────────────────────────────────────────────────────────────

function payChip(status) {
  const s = (status || '').toLowerCase();
  if (s === 'paid' || s === 'payment complete')       return `<span class="pay-chip pay-paid">Paid</span>`;
  if (s === 'partial' || s.includes('partial'))       return `<span class="pay-chip pay-partial">Partial</span>`;
  if (s === 'unpaid' || s === 'pending' || s === '')  return `<span class="pay-chip pay-unpaid">Unpaid</span>`;
  return `<span class="pay-chip pay-unknown">${esc(status)}</span>`;
}

function payClass(status) {
  const s = (status || '').toLowerCase();
  if (s === 'paid' || s === 'payment complete') return 'pay-paid';
  if (s.includes('partial')) return 'pay-partial';
  return 'pay-unpaid';
}

// ── Views ────────────────────────────────────────────────────────────────────

function showLogin() {
  document.getElementById('view-login').hidden   = false;
  document.getElementById('view-dashboard').hidden = true;
}

function showDashboard() {
  document.getElementById('view-login').hidden   = true;
  document.getElementById('view-dashboard').hidden = false;
}

// ── App state ────────────────────────────────────────────────────────────────

let state = {
  seasons: [],
  activeSeason: null,
  teams: [],
  registrations: [],
  selectedTeamId: null,
  // players tab
  playersPage: 0,
  playersPageSize: 50,
  playersFilter: 'all',
  playersSearch: '',
  playersAgeGroup: '',
  playersGender: '',
  // import
  csvData: null,
  csvParsed: null,
};

// ── Login ────────────────────────────────────────────────────────────────────

const ALLOWED_ROLES = ['club administrator', 'club admin', 'administrator', 'admin', 'technical director', 'director'];

function roleAllowed(roleName) {
  if (!roleName) return false;
  const lower = roleName.toLowerCase();
  return ALLOWED_ROLES.some(r => lower.includes(r));
}

document.getElementById('login-btn')?.addEventListener('click', doLogin);
document.getElementById('login-password')?.addEventListener('keydown', e => { if (e.key === 'Enter') doLogin(); });

async function doLogin() {
  const email    = document.getElementById('login-email').value.trim();
  const password = document.getElementById('login-password').value;
  const errEl    = document.getElementById('login-error');
  const btn      = document.getElementById('login-btn');
  errEl.hidden = true;
  btn.disabled = true;
  btn.textContent = 'Signing in…';
  try {
    const res = await fetch(DURL + '/auth/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email, password }),
    });
    if (!res.ok) { throw new Error('Invalid credentials'); }
    const data = await res.json();
    ALS.token   = data.data.access_token;
    ALS.refresh = data.data.refresh_token;
    // Fetch user info
    const ur = await fetch(DURL + '/users/me?fields=id,email,first_name,last_name,role.name', {
      headers: { Authorization: 'Bearer ' + ALS.token },
    });
    if (!ur.ok) throw new Error('Could not fetch user info');
    const ud = await ur.json();
    const user = ud.data;
    const roleName = user.role?.name || '';
    if (!roleAllowed(roleName)) {
      ALS.clear();
      throw new Error('Access denied. Insufficient permissions.');
    }
    ALS.user = user;
    showDashboard();
    initDashboard();
  } catch (err) {
    errEl.textContent = err.message;
    errEl.hidden = false;
  } finally {
    btn.disabled = false;
    btn.textContent = 'Sign In →';
  }
}

document.getElementById('logout-btn')?.addEventListener('click', () => {
  ALS.clear();
  showLogin();
});

// ── Tab navigation ───────────────────────────────────────────────────────────

document.querySelectorAll('.tab-nav').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.tab-nav').forEach(b => b.classList.remove('tab-nav--active'));
    btn.classList.add('tab-nav--active');
    const tab = btn.dataset.tab;
    document.querySelectorAll('.tab-panel').forEach(p => {
      p.classList.remove('active');
      p.hidden = true;
    });
    const panel = document.getElementById('tab-' + tab);
    if (panel) { panel.hidden = false; panel.classList.add('active'); }
  });
});

// ── Init dashboard ───────────────────────────────────────────────────────────

async function initDashboard() {
  document.getElementById('admin-loading').hidden = false;
  document.querySelectorAll('.tab-panel').forEach(p => { p.hidden = true; p.classList.remove('active'); });

  const user = ALS.user;
  if (user) {
    document.getElementById('user-badge').textContent = (user.first_name || user.email || 'User');
  }

  try {
    await loadSeasons();
    await loadTeams();
    await loadRegistrations();

    document.getElementById('admin-loading').hidden = true;
    // Show first tab
    const firstPanel = document.getElementById('tab-teams');
    firstPanel.hidden = false; firstPanel.classList.add('active');
    renderTeamsSidebar();
    renderPlayersTab();
    renderSeasonTab();
    populateImportSeasonSelect();
  } catch (err) {
    document.getElementById('admin-loading').innerHTML = `<p style="color:var(--red)">Failed to load data: ${esc(err.message)}</p>`;
  }
}

// ── Seasons ──────────────────────────────────────────────────────────────────

async function loadSeasons() {
  const res = await api('/items/club_seasons?sort=-year&limit=100');
  if (!res.ok) throw new Error('Could not load seasons');
  const data = await res.json();
  state.seasons = asArray(data.data);
  state.activeSeason = state.seasons.find(s => s.status === 'active') || state.seasons[0] || null;
  const chip = document.getElementById('season-chip');
  if (state.activeSeason) {
    chip.textContent = state.activeSeason.name || String(state.activeSeason.year);
    chip.hidden = false;
  }
}

// ── Teams ────────────────────────────────────────────────────────────────────

async function loadTeams() {
  if (!state.activeSeason) { state.teams = []; return; }
  const res = await api(`/items/teams?filter[season][_eq]=${state.activeSeason.year}&sort=sort_order,name&limit=200`);
  if (!res.ok) throw new Error('Could not load teams');
  const data = await res.json();
  state.teams = asArray(data.data);
}

// ── Registrations ────────────────────────────────────────────────────────────

async function loadRegistrations() {
  if (!state.activeSeason) { state.registrations = []; return; }
  const res = await api(`/items/club_registrations?filter[season][_eq]=${state.activeSeason.id}&limit=2000&fields=id,first_name,last_name,team,ffa_number,product_name,product_age_min,product_age_max,gender,payment_status,role_type`);
  if (!res.ok) throw new Error('Could not load registrations');
  const data = await res.json();
  state.registrations = asArray(data.data);
}

// ── Teams sidebar ────────────────────────────────────────────────────────────

const TEAM_COLORS = ['#2da44e','#0969da','#cf222e','#9a3fcf','#e36209','#1a1f2e'];

function playerCountForTeam(teamId) {
  return state.registrations.filter(r => r.team === teamId && (r.role_type||'').toLowerCase().includes('player')).length;
}

function renderTeamsSidebar() {
  const container = document.getElementById('teams-list');
  if (!state.teams.length) {
    container.innerHTML = '<div style="padding:20px;color:var(--muted);font-style:italic;font-size:13px;">No teams yet. Create one above.</div>';
    return;
  }

  // Group by gender/type
  const groups = { Boys: [], Girls: [], Mixed: [], Senior: [], Other: [] };
  state.teams.forEach(t => {
    const d = (t.division || t.name || '').toLowerCase();
    const n = (t.name || '').toLowerCase();
    if (n.includes('girl') || n.includes('women') || d.includes('girl') || d.includes('women')) groups.Girls.push(t);
    else if (n.includes('senior') || n.includes('men') || d.includes('senior') || d.includes('open')) groups.Senior.push(t);
    else if (n.includes('mixed') || d.includes('mixed')) groups.Mixed.push(t);
    else if (n.includes('boy') || n.includes('u1') || n.includes('u2') || d.includes('boy')) groups.Boys.push(t);
    else groups.Other.push(t);
  });

  let html = '';
  Object.entries(groups).forEach(([label, teams]) => {
    if (!teams.length) return;
    html += `<div class="team-group-label">${esc(label)}</div>`;
    teams.forEach(t => {
      const count = playerCountForTeam(t.id);
      const hashtag = t.hashtag ? '#' + t.hashtag : '';
      const isSelected = state.selectedTeamId === t.id;
      html += `<div class="team-row${isSelected ? ' selected' : ''}" data-team-id="${t.id}">
        <div class="team-row-left">
          <div class="team-row-name">${esc(t.name)}</div>
          ${hashtag ? `<div class="team-row-hashtag">${esc(hashtag)}</div>` : '<div class="team-row-hashtag" style="opacity:0.4">no hashtag</div>'}
        </div>
        <div class="team-row-right">
          <span class="player-count-chip">${count}</span>
        </div>
      </div>`;
    });
  });
  container.innerHTML = html;

  container.querySelectorAll('.team-row').forEach(row => {
    row.addEventListener('click', () => {
      state.selectedTeamId = parseInt(row.dataset.teamId, 10);
      renderTeamsSidebar();
      renderTeamDetail();
    });
  });
}

function renderTeamDetail() {
  const detail = document.getElementById('teams-detail');
  if (!state.selectedTeamId) {
    detail.innerHTML = '<div class="detail-empty">&#8592; Select a team or create one</div>';
    return;
  }
  const team = state.teams.find(t => t.id === state.selectedTeamId);
  if (!team) {
    detail.innerHTML = '<div class="detail-empty">Team not found.</div>';
    return;
  }

  const players = state.registrations.filter(r => r.team === team.id && (r.role_type||'').toLowerCase().includes('player'));
  const swatches = TEAM_COLORS.map(c =>
    `<div class="color-swatch${(team.color_accent||'').toLowerCase() === c.toLowerCase() ? ' selected' : ''}" style="background:${c}" data-color="${c}"></div>`
  ).join('');

  const playerRows = players.map(p =>
    `<tr>
      <td>${esc(p.first_name)} ${esc(p.last_name)}</td>
      <td><span style="font-family:var(--font-cond);font-size:12px;">${esc(p.product_name||'—')}</span></td>
      <td>${payChip(p.payment_status)}</td>
      <td><button class="btn-outline btn-sm remove-player-btn" data-reg-id="${p.id}">Remove</button></td>
    </tr>`
  ).join('');

  // Unlinked players for add section
  const unlinked = state.registrations.filter(r => !r.team && (r.role_type||'').toLowerCase().includes('player'));

  detail.innerHTML = `<div class="team-detail-inner">
    <div class="team-detail-form" id="team-detail-form">
      <div class="form-row-2">
        <div class="form-field">
          <label>Team Name</label>
          <input id="td-name" type="text" value="${esc(team.name||'')}">
        </div>
        <div class="form-field">
          <label>Hashtag</label>
          <div class="hashtag-wrap">
            <span class="hashtag-prefix">#</span>
            <input id="td-hashtag" type="text" value="${esc(team.hashtag||'')}" placeholder="SWWarriorsU12Boys">
          </div>
        </div>
      </div>
      <div class="form-row-2">
        <div class="form-field">
          <label>Coach</label>
          <input id="td-coach" type="text" value="${esc(team.coach||'')}">
        </div>
        <div class="form-field">
          <label>Manager</label>
          <input id="td-manager" type="text" value="${esc(team.manager||'')}">
        </div>
      </div>
      <div class="form-field">
        <label>Accent Colour</label>
        <div class="color-swatches" id="td-swatches">${swatches}</div>
      </div>
      <div class="save-row">
        <button id="td-save-btn" class="btn-green">Save Changes</button>
        <span id="td-save-msg" class="save-msg" hidden></span>
        <span id="td-save-err" class="save-err" hidden></span>
      </div>
    </div>

    <div class="squad-heading">Squad (${players.length} players)</div>
    <table class="squad-table">
      <thead><tr><th>Name</th><th>Age Group</th><th>Payment</th><th></th></tr></thead>
      <tbody id="squad-tbody">${playerRows || '<tr><td colspan="4" style="color:var(--muted);font-style:italic;">No players assigned</td></tr>'}</tbody>
    </table>

    <div class="add-players-section">
      <div class="section-heading">Add Players</div>
      <input id="add-player-search" type="search" class="add-players-search" placeholder="Search unlinked players by name or FFA number…">
      <div id="add-player-results" class="add-player-results">
        <div style="color:var(--muted);font-size:13px;font-style:italic;">Type to search ${unlinked.length} unlinked players…</div>
      </div>
    </div>
  </div>`;

  // Colour swatches
  detail.querySelectorAll('.color-swatch').forEach(sw => {
    sw.addEventListener('click', () => {
      detail.querySelectorAll('.color-swatch').forEach(s => s.classList.remove('selected'));
      sw.classList.add('selected');
    });
  });

  // Save button
  document.getElementById('td-save-btn').addEventListener('click', saveTeamDetail);

  // Remove player buttons
  detail.querySelectorAll('.remove-player-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const regId = parseInt(btn.dataset.regId, 10);
      btn.disabled = true; btn.textContent = '…';
      try {
        const res = await api(`/items/club_registrations/${regId}`, {
          method: 'PATCH',
          body: JSON.stringify({ team: null }),
        });
        if (!res.ok) throw new Error('Failed');
        const reg = state.registrations.find(r => r.id === regId);
        if (reg) reg.team = null;
        renderTeamsSidebar();
        renderTeamDetail();
      } catch {
        btn.disabled = false; btn.textContent = 'Remove';
      }
    });
  });

  // Add player search
  const addSearch = document.getElementById('add-player-search');
  const addResults = document.getElementById('add-player-results');
  addSearch.addEventListener('input', () => {
    const q = addSearch.value.trim().toLowerCase();
    if (!q) {
      addResults.innerHTML = `<div style="color:var(--muted);font-size:13px;font-style:italic;">Type to search ${unlinked.length} unlinked players…</div>`;
      return;
    }
    const matches = state.registrations.filter(r =>
      !r.team &&
      (r.role_type||'').toLowerCase().includes('player') &&
      (`${r.first_name} ${r.last_name}`.toLowerCase().includes(q) || (r.ffa_number||'').toLowerCase().includes(q))
    ).slice(0, 20);
    if (!matches.length) {
      addResults.innerHTML = '<div style="color:var(--muted);font-size:13px;font-style:italic;">No matching unlinked players</div>';
      return;
    }
    addResults.innerHTML = matches.map(r =>
      `<div class="add-player-result" data-reg-id="${r.id}">
        <div>
          <div class="add-player-name">${esc(r.first_name)} ${esc(r.last_name)}</div>
          <div class="add-player-meta">${esc(r.product_name||'—')} · ${esc(r.gender||'—')} · FFA: ${esc(r.ffa_number||'—')}</div>
        </div>
        ${payChip(r.payment_status)}
      </div>`
    ).join('');
    addResults.querySelectorAll('.add-player-result').forEach(el => {
      el.addEventListener('click', async () => {
        const regId = parseInt(el.dataset.regId, 10);
        el.style.opacity = '0.5'; el.style.pointerEvents = 'none';
        try {
          const res = await api(`/items/club_registrations/${regId}`, {
            method: 'PATCH',
            body: JSON.stringify({ team: state.selectedTeamId }),
          });
          if (!res.ok) throw new Error('Failed');
          const reg = state.registrations.find(r => r.id === regId);
          if (reg) reg.team = state.selectedTeamId;
          addSearch.value = '';
          renderTeamsSidebar();
          renderTeamDetail();
        } catch {
          el.style.opacity = '1'; el.style.pointerEvents = '';
        }
      });
    });
  });
}

async function saveTeamDetail() {
  const btn  = document.getElementById('td-save-btn');
  const msg  = document.getElementById('td-save-msg');
  const errEl = document.getElementById('td-save-err');
  msg.hidden = true; errEl.hidden = true;
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-sm"></span> Saving…';

  const selectedSwatch = document.querySelector('#td-swatches .color-swatch.selected');
  const payload = {
    name:         document.getElementById('td-name').value.trim(),
    hashtag:      document.getElementById('td-hashtag').value.trim(),
    coach:        document.getElementById('td-coach').value.trim(),
    manager:      document.getElementById('td-manager').value.trim(),
    color_accent: selectedSwatch ? selectedSwatch.dataset.color : '',
  };

  try {
    const res = await api(`/items/teams/${state.selectedTeamId}`, {
      method: 'PATCH',
      body: JSON.stringify(payload),
    });
    if (!res.ok) throw new Error('Save failed');
    const data = await res.json();
    const idx = state.teams.findIndex(t => t.id === state.selectedTeamId);
    if (idx !== -1) state.teams[idx] = { ...state.teams[idx], ...data.data };
    msg.textContent = 'Saved!'; msg.hidden = false;
    setTimeout(() => { msg.hidden = true; }, 2500);
    renderTeamsSidebar();
  } catch (err) {
    errEl.textContent = err.message; errEl.hidden = false;
  } finally {
    btn.disabled = false; btn.textContent = 'Save Changes';
  }
}

// New team
document.getElementById('new-team-btn').addEventListener('click', async () => {
  if (!state.activeSeason) { alert('No active season found.'); return; }
  const name = prompt('New team name:');
  if (!name) return;
  try {
    const res = await api('/items/teams', {
      method: 'POST',
      body: JSON.stringify({ name: name.trim(), season: String(state.activeSeason.year), status: 'active' }),
    });
    if (!res.ok) throw new Error('Failed to create team');
    const data = await res.json();
    state.teams.push(data.data);
    state.selectedTeamId = data.data.id;
    renderTeamsSidebar();
    renderTeamDetail();
  } catch (err) {
    alert('Error: ' + err.message);
  }
});

// ── Players tab ──────────────────────────────────────────────────────────────

function getFilteredPlayers() {
  let list = state.registrations.filter(r => (r.role_type||'').toLowerCase().includes('player'));

  if (state.playersFilter === 'unlinked') list = list.filter(r => !r.team);
  else if (state.playersFilter === 'paid')  list = list.filter(r => (r.payment_status||'').toLowerCase() === 'paid' || (r.payment_status||'').toLowerCase() === 'payment complete');
  else if (state.playersFilter === 'unpaid') list = list.filter(r => { const s = (r.payment_status||'').toLowerCase(); return s !== 'paid' && s !== 'payment complete' && !s.includes('partial'); });

  if (state.playersAgeGroup) list = list.filter(r => r.product_name === state.playersAgeGroup);
  if (state.playersGender)   list = list.filter(r => r.gender === state.playersGender);

  if (state.playersSearch) {
    const q = state.playersSearch.toLowerCase();
    list = list.filter(r =>
      `${r.first_name} ${r.last_name}`.toLowerCase().includes(q) ||
      (r.ffa_number||'').toLowerCase().includes(q)
    );
  }

  // Unlinked first
  list.sort((a, b) => {
    if (!a.team && b.team) return -1;
    if (a.team && !b.team) return  1;
    return `${a.last_name} ${a.first_name}`.localeCompare(`${b.last_name} ${b.first_name}`);
  });

  return list;
}

function renderPlayersTab() {
  const all = state.registrations.filter(r => (r.role_type||'').toLowerCase().includes('player'));
  const unlinked = all.filter(r => !r.team);
  const paid     = all.filter(r => { const s = (r.payment_status||'').toLowerCase(); return s === 'paid' || s === 'payment complete'; });

  // Stats bar
  document.getElementById('players-stats-bar').innerHTML =
    `<strong>${all.length}</strong> total &nbsp;·&nbsp; <strong style="color:var(--amber)">${unlinked.length}</strong> unlinked &nbsp;·&nbsp; <strong style="color:var(--green)">${paid.length}</strong> paid`;

  // Populate age group dropdown
  const ageGroups = [...new Set(all.map(r => r.product_name).filter(Boolean))].sort();
  const agSelect = document.getElementById('players-agegroup');
  const agCurrent = agSelect.value;
  agSelect.innerHTML = '<option value="">All Age Groups</option>' +
    ageGroups.map(ag => `<option value="${esc(ag)}"${ag === agCurrent ? ' selected' : ''}>${esc(ag)}</option>`).join('');

  renderPlayersTable();
}

function renderPlayersTable() {
  const filtered = getFilteredPlayers();
  const page = state.playersPage;
  const size = state.playersPageSize;
  const slice = filtered.slice(0, (page + 1) * size);

  const teamMap = {};
  state.teams.forEach(t => { teamMap[t.id] = t; });

  const teamOptions = state.teams.map(t => `<option value="${t.id}">${esc(t.name)}</option>`).join('');

  const rows = slice.map(r => {
    const isUnlinked = !r.team;
    const teamName = r.team ? (teamMap[r.team]?.name || 'Unknown Team') : null;
    return `<tr class="${isUnlinked ? 'unlinked' : ''}">
      <td><strong>${esc(r.first_name)} ${esc(r.last_name)}</strong></td>
      <td><span style="font-family:var(--font-cond);font-size:12px;">${esc(r.product_name||'—')}</span></td>
      <td>${esc(r.gender||'—')}</td>
      <td>${payChip(r.payment_status)}</td>
      <td>${isUnlinked ? '<span class="unlinked-label">— Unlinked —</span>' : esc(teamName)}</td>
      <td>
        <select class="assign-select" data-reg-id="${r.id}" data-current-team="${r.team||''}">
          <option value="">Assign to team…</option>
          ${teamOptions}
          ${r.team ? '<option value="__unlink__">Unlink from team</option>' : ''}
        </select>
      </td>
    </tr>`;
  }).join('');

  document.getElementById('players-tbody').innerHTML = rows || '<tr><td colspan="6" style="color:var(--muted);font-style:italic;padding:20px;">No players match the current filters.</td></tr>';

  const loadMoreRow = document.getElementById('players-load-more');
  if (filtered.length > slice.length) {
    loadMoreRow.hidden = false;
    document.getElementById('players-load-more-btn').textContent = `Load More (${filtered.length - slice.length} remaining)`;
  } else {
    loadMoreRow.hidden = true;
  }

  // Assign dropdowns
  document.querySelectorAll('.assign-select').forEach(sel => {
    sel.addEventListener('change', async () => {
      const regId = parseInt(sel.dataset.regId, 10);
      const val   = sel.value;
      if (!val) return;
      sel.disabled = true;
      try {
        const newTeam = val === '__unlink__' ? null : parseInt(val, 10);
        const res = await api(`/items/club_registrations/${regId}`, {
          method: 'PATCH',
          body: JSON.stringify({ team: newTeam }),
        });
        if (!res.ok) throw new Error('Failed');
        const reg = state.registrations.find(r => r.id === regId);
        if (reg) reg.team = newTeam;
        renderPlayersTab();
        renderPlayersTable();
        if (state.selectedTeamId) renderTeamsSidebar();
      } catch {
        sel.disabled = false;
      }
    });
  });
}

// Filter chip events
document.querySelectorAll('.filter-chip[data-pf]').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.filter-chip[data-pf]').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
