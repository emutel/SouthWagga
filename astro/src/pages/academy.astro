---
// src/pages/academy.astro
import Base from '../layouts/Base.astro';
import { getAcademyPrograms, fileUrl } from '../lib/directus.js';

const programs = await getAcademyPrograms() || [];
const active   = programs.filter(p => p.status === 'active');
const full     = programs.filter(p => p.status === 'full');
---
<Base
  title="Warriors Academy"
  description="South Wagga Warriors FC Academy — structured player development for ages 8–16. Tuesday & Thursday evenings. Structured technical development for every player."
>

  <!-- ── HERO ─────────────────────────────────────────────── -->
  <div class="academy-hero">
    <div class="academy-hero-inner">
      <div class="label">Player Development</div>
      <h1>Warriors Academy</h1>
      <p class="hero-sub">Technical excellence. Community values. Every player's potential, developed.</p>
      <div class="hero-badge">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        Tuesday &amp; Thursday &nbsp;|&nbsp; 5:00 – 6:30 pm &nbsp;|&nbsp; Rawlings Park
      </div>
      <div class="hero-ctas">
        <a href="/academy/register" class="btn btn-primary">Register Interest →</a>
        <a href="/academy/portal"   class="btn btn-secondary">Parent &amp; Player Login</a>
      </div>
    </div>
    <div class="hero-card-tease">
      <div class="tease-card">
        <div class="tease-top">
          <span class="tease-ov">74</span>
          <span class="tease-pos">MID</span>
        </div>
        <div class="tease-silhouette">
          <svg viewBox="0 0 60 80" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="30" cy="16" r="12" fill="rgba(255,255,255,0.15)"/>
            <path d="M8 72 C8 48 16 38 30 36 C44 38 52 48 52 72" fill="rgba(255,255,255,0.15)"/>
          </svg>
        </div>
        <div class="tease-name">YOUR PLAYER</div>
        <div class="tease-stats">
          <span><b>PAC</b> ??</span><span><b>SHO</b> ??</span><span><b>PAS</b> ??</span>
          <span><b>DRI</b> ??</span><span><b>DEF</b> ??</span><span><b>PHY</b> ??</span>
        </div>
        <div class="tease-cta-label">Earn your Player Card →</div>
      </div>
    </div>
  </div>

  <!-- ── PHILOSOPHY PILLARS ───────────────────────────────── -->
  <section class="section section--dark">
    <div class="section-inner">
      <div class="label">Our Philosophy</div>
      <h2>Development Without Limits</h2>
      <p class="section-sub">We believe every young player — regardless of experience level — deserves the same technical foundation used by elite academies worldwide.</p>
      <div class="pillars-grid">
        <div class="pillar">
          <div class="pillar-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--green-bright)" stroke-width="1.8"><circle cx="12" cy="8" r="4"/><path d="M4 20 Q4 14 12 14 Q20 14 20 20"/></svg>
          </div>
          <h3>Inclusive, Not Selective</h3>
          <p>No tryouts. No cuts. We develop every player who wants to learn. Unlike SAP's identification model, our program is open to every child in our community.</p>
        </div>
        <div class="pillar">
          <div class="pillar-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--green-bright)" stroke-width="1.8"><path d="M12 2L2 7 12 12 22 7 12 2z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
          </div>
          <h3>Proven Methodology</h3>
          <p>Our curriculum is built on the English FA Long Term Player Development framework and internationally recognised ball mastery principles — the same foundations used by professional clubs globally.</p>
        </div>
        <div class="pillar">
          <div class="pillar-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--green-bright)" stroke-width="1.8"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <h3>Community-Rooted</h3>
          <p>Run by the Warriors for the Warriors. Sessions at Rawlings Park, fitting around family schedules with Tuesday and Thursday evening sessions.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── PROGRAM TIERS ────────────────────────────────────── -->
  <section class="section section--card">
    <div class="section-inner">
      <div class="label">Program Tiers</div>
      <h2>Find Your Level</h2>
      <p class="section-sub">Three age-specific pathways, each building on the last. Players move between tiers as they grow and develop.</p>
      <div class="tiers-grid">

        <div class="tier-card">
          <div class="tier-badge tier-foundation">Foundation</div>
          <div class="tier-age">U8 – U10</div>
          <h3>Ball Mastery &amp; Fun</h3>
          <p>The most important years for a footballer. We build a love of the ball through touches, tricks, and small-sided games. Players develop soft first touch, confident dribbling, and basic passing at game speed.</p>
          <ul class="tier-skills">
            <li>Ball lifting &amp; juggling</li>
            <li>Soft first touch</li>
            <li>Running with the ball</li>
            <li>Inside-foot passing</li>
            <li>Basic 1v1 moves</li>
            <li>Scanning &amp; awareness</li>
          </ul>
        </div>

        <div class="tier-card tier-card--featured">
          <div class="tier-badge tier-development">Development</div>
          <div class="tier-age">U11 – U12</div>
          <h3>Skill &amp; Game Intelligence</h3>
          <p>The FA LTPD's "learn to train" phase. Players who build solid technique here become confident, creative players at any level. We introduce 1v1 moves, aerial control, and positional thinking.</p>
          <ul class="tier-skills">
            <li>1v1 moves (step-over, scissor)</li>
            <li>Outside-foot passing &amp; shooting</li>
            <li>Receiving aerial balls</li>
            <li>Positional awareness</li>
            <li>Transition play</li>
            <li>Introduction to heading</li>
          </ul>
        </div>

        <div class="tier-card">
          <div class="tier-badge tier-advanced">Advanced</div>
          <div class="tier-age">U13 – U16</div>
          <h3>Tactical &amp; Physical Development</h3>
          <p>Position-specific training, pressing systems, and advanced technique. We use the FA's "train to train" principles and respect each player's individual physical maturation (PHV awareness).</p>
          <ul class="tier-skills">
            <li>Advanced 1v1 (elastico, double-scissor)</li>
            <li>Long-range passing &amp; shooting</li>
            <li>Pressing &amp; defensive systems</li>
            <li>Set piece delivery</li>
            <li>Position-specific roles</li>
            <li>Physical load management</li>
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- ── CURRICULUM PYRAMID ───────────────────────────────── -->
  <section class="section section--dark">
    <div class="section-inner curriculum-inner">
      <div>
        <div class="label">The Curriculum</div>
        <h2>The Development Pyramid</h2>
        <p class="section-sub">Every session is built around the same progression: master the ball, learn to receive and pass, beat opponents 1v1, develop speed and finishing, then apply everything in group play. It's not a ladder — every level strengthens the others.</p>
        <div class="curriculum-levels">
          <div class="curr-level curr-l6">
            <span class="curr-num">6</span>
            <div>
              <strong>Group Attack Play</strong>
              <span>Fast-break combinations, pressing, spacing</span>
            </div>
          </div>
          <div class="curr-level curr-l5">
            <span class="curr-num">5</span>
            <div>
              <strong>Finishing</strong>
              <span>Instinctive shooting, placement, power</span>
            </div>
          </div>
          <div class="curr-level curr-l4">
            <span class="curr-num">4</span>
            <div>
              <strong>Speed</strong>
              <span>Acceleration with &amp; without the ball</span>
            </div>
          </div>
          <div class="curr-level curr-l3">
            <span class="curr-num">3</span>
            <div>
              <strong>Moves (1v1)</strong>
              <span>Beating opponents with confidence</span>
            </div>
          </div>
          <div class="curr-level curr-l2">
            <span class="curr-num">2</span>
            <div>
              <strong>Passing &amp; Receiving</strong>
              <span>First touch, weight, timing, range</span>
            </div>
          </div>
          <div class="curr-level curr-l1">
            <span class="curr-num">1</span>
            <div>
              <strong>Ball Mastery</strong>
              <span>One ball. One player. The foundation of everything.</span>
            </div>
          </div>
        </div>
      </div>
      <div class="session-format">
        <div class="label">Session Format</div>
        <h3>Every 90-Minute Session</h3>
        <div class="session-steps">
          <div class="step"><span class="step-time">10 min</span><span class="step-name">Arrival &amp; Activation</span><span class="step-desc">Dynamic warm-up, ball familiarisation</span></div>
          <div class="step"><span class="step-time">15 min</span><span class="step-name">Ball Mastery</span><span class="step-desc">Individual ball work — one ball, one player, building touch and confidence</span></div>
          <div class="step"><span class="step-time">20 min</span><span class="step-name">Skill Theme</span><span class="step-desc">Session's technical focus (receiving, 1v1 moves, finishing etc)</span></div>
          <div class="step"><span class="step-time">25 min</span><span class="step-name">Game Application</span><span class="step-desc">Small-sided game with coaching cues tied to the theme</span></div>
          <div class="step"><span class="step-time">10 min</span><span class="step-name">Cool-Down &amp; Debrief</span><span class="step-desc">Stretch, coach feedback, preview of next session</span></div>
          <div class="step step--optional"><span class="step-time">+10 min</span><span class="step-name">Parent Q&amp;A (Optional)</span><span class="step-desc">Parents are welcome to stay and chat with coaches after each session</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── SAP COMPARISON ───────────────────────────────────── -->
  <section class="section section--card">
    <div class="section-inner">
      <div class="label">Why Warriors Academy?</div>
      <h2>A Different Kind of Development</h2>
      <p class="section-sub">Football Australia's SAP program is excellent — but it's not for everyone. Here's how we compare.</p>
      <div class="compare-grid">
        <div class="compare-col compare-col--sap">
          <h3>Football Australia SAP</h3>
          <ul>
            <li class="compare-neutral">Selection-based — identified players only</li>
            <li class="compare-neutral">Ages 9–12 primary focus</li>
            <li class="compare-neutral">Competition and representative pathway focus</li>
            <li class="compare-neutral">Structured around FFA national curriculum</li>
            <li class="compare-neutral">External program (separate to club training)</li>
          </ul>
        </div>
        <div class="compare-vs">VS</div>
        <div class="compare-col compare-col--warriors">
          <h3>Warriors Academy</h3>
          <ul>
            <li class="compare-good">Open to all — no selection process</li>
            <li class="compare-good">Ages 8–16, three progressive tiers</li>
            <li class="compare-good">Development-first, builds love of the game</li>
            <li class="compare-good">FA LTPD + proven international development frameworks</li>
            <li class="compare-good">Club program — builds community and belonging</li>
          </ul>
        </div>
      </div>
      <p class="compare-note">Warriors Academy is a complement to club competition, not a replacement. Many of our players also participate in SAP. We welcome all.</p>
    </div>
  </section>

  <!-- ── PROGRESS TRACKING TEASER ─────────────────────────── -->
  <section class="section section--dark tracking-section">
    <div class="section-inner tracking-inner">
      <div class="tracking-text">
        <div class="label">Player Progress</div>
        <h2>Your Child's Player Card</h2>
        <p>Every player enrolled in the Academy earns a personalised FIFA-style Player Card, updated each term by our coaches. Six attributes rated and age-normalised — so a U9 and a U14 are always measured against their own peers, never each other.</p>
        <ul class="tracking-features">
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--green-bright)" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
            Six attributes: PAC, SHO, PAS, DRI, DEF, PHY
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--green-bright)" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
            Age-normalised scores — always a fair comparison
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--green-bright)" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
            Bronze → Silver → Gold → Elite tiers as players improve
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--green-bright)" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
            Downloadable &amp; shareable PNG card
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--green-bright)" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
            Coach notes &amp; session feedback visible to parents
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--green-bright)" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
            Message the Technical Director directly from the portal
          </li>
        </ul>
        <a href="/academy/portal" class="btn btn-primary" style="margin-top:24px">Access Your Portal →</a>
      </div>
      <div class="tracking-card-demo">
        <div class="demo-card demo-gold">
          <div class="demo-card-header">
            <div class="demo-overall">82</div>
            <div class="demo-pos-badge">MID</div>
            <div class="demo-club">
              <svg viewBox="0 0 40 40" width="32" height="32" fill="none">
                <polygon points="20,3 37,12 37,28 20,37 3,28 3,12" fill="rgba(255,255,255,0.15)" stroke="rgba(255,255,255,0.3)" stroke-width="1.5"/>
                <text x="20" y="25" text-anchor="middle" font-size="12" font-weight="bold" fill="rgba(255,255,255,0.8)" font-family="Arial">W</text>
              </svg>
            </div>
          </div>
          <div class="demo-photo-area">
            <svg viewBox="0 0 80 100" fill="none" xmlns="http://www.w3.org/2000/svg" width="80" height="100">
              <circle cx="40" cy="26" r="18" fill="rgba(255,255,255,0.2)"/>
              <path d="M8 95 C8 65 20 54 40 52 C60 54 72 65 72 95" fill="rgba(255,255,255,0.2)"/>
            </svg>
          </div>
          <div class="demo-name">ALEX W.</div>
          <div class="demo-age-grp">U12</div>
          <div class="demo-stats-grid">
            <div class="demo-stat"><span class="demo-sv">71</span><span class="demo-sl">PAC</span></div>
            <div class="demo-stat"><span class="demo-sv">68</span><span class="demo-sl">SHO</span></div>
            <div class="demo-stat"><span class="demo-sv">82</span><span class="demo-sl">PAS</span></div>
            <div class="demo-stat"><span class="demo-sv">85</span><span class="demo-sl">DRI</span></div>
            <div class="demo-stat"><span class="demo-sv">55</span><span class="demo-sl">DEF</span></div>
            <div class="demo-stat"><span class="demo-sv">66</span><span class="demo-sl">PHY</span></div>
          </div>
        </div>
        <div class="demo-history">
          <div class="demo-h-label">Progress last 3 terms</div>
          <div class="demo-h-row"><span>Overall</span><div class="demo-bar"><div class="demo-fill" style="width:83%"></div></div><span class="demo-hv">82</span></div>
          <div class="demo-h-row"><span>DRI</span><div class="demo-bar"><div class="demo-fill demo-fill--dri" style="width:86%"></div></div><span class="demo-hv">85</span></div>
          <div class="demo-h-row"><span>PAS</span><div class="demo-bar"><div class="demo-fill demo-fill--pas" style="width:83%"></div></div><span class="demo-hv">82</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── FAQ ──────────────────────────────────────────────── -->
  <section class="section section--card faq-section">
    <div class="section-inner">
      <div class="label">FAQ</div>
      <h2>Common Questions</h2>
      <div class="faq-list">
        <details class="faq-item">
          <summary>How much does the Academy cost?</summary>
          <p>Pricing is set per term and varies by program tier. Full pricing is shown on each program listing below. Payment is processed securely through Square.</p>
        </details>
        <details class="faq-item">
          <summary>What equipment does my child need?</summary>
          <p>Boots (grass or multi-ground), shin pads, and a ball. We recommend size 3 for U8–U10, size 4 for U11–U14, and size 5 for U15+. Water bottle and club training top if you have one — not required.</p>
        </details>
        <details class="faq-item">
          <summary>Is the Academy a replacement for my child's team training?</summary>
          <p>No — it complements it. Academy sessions focus on individual technical development that will improve your child's performance in their team environment. Many Academy players also play in club competitions.</p>
        </details>
        <details class="faq-item">
          <summary>What's the difference between this and the SAP program?</summary>
          <p>Football Australia's SAP program is for identified players aged 9–12 and has a competitive, representative pathway focus. Our Academy is open to all players aged 8–16, regardless of experience level, and focuses on individual technical development rather than selection and competition.</p>
        </details>
        <details class="faq-item">
          <summary>How does the Player Card and portal work?</summary>
          <p>Once your child is enrolled and accepted, you'll receive login details for the parent portal. Our coaches assess each player each term across six technical attributes. The scores are age-normalised — so you're always seeing your child's progress relative to their own age group. You can also message the Technical Director directly through the portal.</p>
        </details>
        <details class="faq-item">
          <summary>What is your cancellation policy?</summary>
          <p>We offer a full refund if you cancel before the first session of each term. After the first session, we can offer a 50% credit toward the following term. Please contact the academy coordinator for any special circumstances.</p>
        </details>
        <details class="faq-item">
          <summary>What if my child has a medical condition or injury?</summary>
          <p>Please include any relevant medical information in the registration form. Our coaches hold current Working With Children checks and first aid certifications. Please also communicate directly with the Technical Director so we can accommodate your child's needs.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- ── REGISTRATION CTA ──────────────────────────────────── -->
  <section class="reg-cta">
    <div class="reg-cta-inner">
      <div>
        <h2>Ready to Start?</h2>
        <p>Register your child's interest and we'll be in touch within 3 business days.</p>
      </div>
      <a href="/academy/register" class="btn btn-primary btn-lg">Register Interest →</a>
    </div>
  </section>

  <!-- ── PROGRAM LISTINGS ──────────────────────────────────── -->
  <div class="programs-outer">
    <div class="section-inner">

      {active.length > 0 && (
        <section class="programs-section">
          <div class="label" style="margin-bottom:32px">Open for Enrolment</div>
          <div class="programs-grid">
            {active.map((p, i) => (
              <div class={`program-card card ${i === 0 ? 'program-card--featured' : ''}`}>
                {p.image && (
                  <img
                    src={fileUrl(p.image, { width: i === 0 ? 800 : 600, height: 300 })}
                    alt={p.name}
                    class="program-img"
                    loading="lazy"
                  />
                )}
                <div class="program-body">
                  <div class="program-tags">
                    {p.age_group && <span class="age-tag">{p.age_group}</span>}
                    {p.spots_left && p.spots_left <= 5 && (
                      <span class="spots-tag">Only {p.spots_left} spots left!</span>
                    )}
                  </div>
                  <h2>{p.name}</h2>
                  {p.description && (
                    <div class="program-desc" set:html={p.description} />
                  )}
                  <div class="program-details">
                    {p.schedule && (
                      <div class="program-detail">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        <span>{p.schedule}</span>
                      </div>
                    )}
                  </div>
                </div>
                <div class="program-footer">
                  <div class="program-price">
                    <span class="price-amount">${parseFloat(p.price || 0).toFixed(0)}</span>
                    {p.price_note && <span class="price-note">{p.price_note}</span>}
                  </div>
                  {p.square_url ? (
                    <a href={p.square_url} target="_blank" rel="noopener" class="btn btn-primary">
                      Enrol Now →
                    </a>
                  ) : (
                    <a href="/academy/register" class="btn btn-secondary">Register Interest →</a>
                  )}
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      {full.length > 0 && (
        <section class="programs-section">
          <div class="label" style="margin-bottom:24px">Currently Full</div>
          <div class="programs-grid programs-grid--small">
            {full.map(p => (
              <div class="program-card program-card--full card">
                <div class="program-body">
                  {p.age_group && <span class="age-tag">{p.age_group}</span>}
                  <h3>{p.name}</h3>
                  {p.schedule && <p class="program-sched">{p.schedule}</p>}
                  <p class="full-note">This program is currently full. Contact us to join the waitlist.</p>
                </div>
                <div class="program-footer">
                  <a href="/about#contact" class="btn btn-secondary">Join Waitlist</a>
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      {programs.length === 0 && (
        <div class="empty-state">
          <p>Academy programs for the upcoming term will be announced shortly.</p>
          <a href="/academy/register" class="btn btn-primary" style="margin-top:20px">Register Interest Now</a>
        </div>
      )}

    </div>
  </div>

</Base>

<style>
/* ── HERO ────────────────────────────────────────────── */
.academy-hero {
  background: linear-gradient(135deg, var(--green-dark) 0%, var(--off-black) 60%);
  border-bottom: 1px solid var(--border);
  padding: 60px 48px 48px;
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 40px;
  align-items: center;
  max-width: 100%;
  overflow: hidden;
}
.academy-hero-inner { max-width: 640px; }
.academy-hero h1 { font-size: clamp(52px, 7vw, 88px); margin: 12px 0 8px; line-height: 0.95; }
.hero-sub { color: var(--muted); font-size: 18px; max-width: 500px; margin-bottom: 20px; }
.hero-badge {
  display: inline-flex; align-items: center; gap: 10px;
  background: rgba(37,160,76,0.12); border: 1px solid rgba(37,160,76,0.3);
  color: var(--green-bright); font-family: var(--font-cond); font-size: 13px;
  font-weight: 700; letter-spacing: 1px; padding: 8px 16px; border-radius: 20px;
  margin-bottom: 28px;
}
.hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; }

/* Tease card in hero */
.hero-card-tease { padding-right: 24px; }
.tease-card {
  width: 180px;
  background: linear-gradient(160deg, #c9a030 0%, #8b6914 100%);
  border-radius: 12px;
  padding: 16px 14px 14px;
  box-shadow: 0 16px 40px rgba(0,0,0,0.5);
  position: relative;
  overflow: hidden;
