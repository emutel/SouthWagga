---
<Base title="MiniRoos 2026" description={`2026 MiniRoos teams and draw schedule for ${CLUB.name}.`}>

  <div class="page-hero">
    <div class="page-hero-inner">
      <div class="label">2026 Season</div>
      <h1>MiniRoos</h1>
      <p>Saturday morning football for Under 5s through Under 11/12s. No ladders · No formal results · Just fun.</p>
    </div>
  </div>

  <div class="page-inner">

    <!-- Tab bar -->
    <div class="tab-bar" role="tablist">
      <button class="tab active" data-tab="teams" role="tab">Teams &amp; Squads</button>
      <button class="tab" data-tab="draws" role="tab">Draw Schedule</button>
    </div>

    <!-- ── TEAMS PANEL ── -->
    <div class="tab-panel active" id="panel-teams">

      <!-- Age group filter pills -->
      <div class="age-pills">
        <button class="age-pill active" data-age="all">All Groups</button>
        {ageGroups.map(g => (
          <button class="age-pill" data-age={g.id}>
            {g.label}
            {g.gender === 'girls' && <span class="girls-dot"></span>}
          </button>
        ))}
      </div>

      <!-- Age group sections -->
      {ageGroups.map(g => (
        <div class="age-section" data-age={g.id} id={g.id}>
          <div class="age-header">
            <h2 class="age-title">{g.label}</h2>
            {g.gender === 'girls' && <span class="gender-badge girls">Girls</span>}
            <span class="time-badge">{g.drawTime}</span>
          </div>

          <div class={`teams-row teams-${g.teams.length}`}>
            {g.teams.map(t => (
              <div class="team-card">
                <div class="team-card-header">
                  <span class="team-name">{t.name}</span>
                  {t.coachNeeded
                    ? <span class="coach-needed">Coach needed</span>
                    : <span class="coach-name">{t.coach}</span>
                  }
                  {t.note && <span class="team-note">{t.note}</span>}
                </div>
                <ul class="squad-list">
                  {t.players.map(p => (
                    <li>{p}</li>
                  ))}
                </ul>
                <div class="player-count">{t.players.length} players</div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- ── DRAWS PANEL ── -->
    <div class="tab-panel" id="panel-draws">

      <div class="draws-intro">
        <p>MiniRoos games are played every Saturday morning at <strong>Rawlings Park</strong>. Games run approximately 40 minutes. No ladders or scores are recorded — just fun, development football for all kids.</p>
      </div>

      <!-- Ground maps -->
      <h3 class="section-heading">Ground Maps</h3>
      <p class="section-sub">Know which field your team is on before you arrive.</p>
      <div class="maps-grid">
        {groundMaps.map(m => (
          <div class="map-card">
            <div class="map-card-header">
              <span class="map-title">{m.name}</span>
              <a href={m.link} target="_blank" rel="noopener" class="map-open-link">Open full size ↗</a>
            </div>
            <div class="map-embed-wrap">
              <img
                src={`https://drive.google.com/uc?export=view&id=${m.driveId}`}
                alt={`${m.name} field layout`}
                class="map-img"
                loading="lazy"
                onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
              />
              <div class="map-fallback" style="display:none">
                <p>Map preview unavailable.</p>
                <a href={m.link} target="_blank" rel="noopener" class="btn btn-primary" style="font-size:13px;padding:8px 18px">Open in Google Drive ↗</a>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Draw documents by age group -->
      <h3 class="section-heading" style="margin-top:56px">Round-by-Round Draws</h3>
      <p class="section-sub">Select your age group to see the full fixture draw. Each draw shows all rounds for the season.</p>

      <div class="draw-age-pills">
        {drawGroups.map(g => (
          <button class="draw-age-pill" data-draw={g.id}>
            {g.label}
            {g.gender === 'girls' && <span class="girls-dot"></span>}
          </button>
        ))}
      </div>

      <div class="draw-sections">
        {drawGroups.map(g => (
          <div class="draw-section" data-draw-section={g.id} style="display:none">
            <div class="draw-section-header">
              <div class="draw-section-title">
                <h3>{g.label}</h3>
                {g.gender === 'girls' && <span class="gender-badge girls">Girls</span>}
              </div>
              <span class="draw-time">{g.time}</span>
            </div>

            {g.dribl ? (
              <div class="dribl-note">
                <p>U11/12 fixtures are managed through Dribl. View your team's schedule on the <a href="/results">Results &amp; Fixtures</a> page.</p>
              </div>
            ) : (
              <div class={`draw-docs draw-docs-${g.draws?.length}`}>
                {g.draws?.map(d => (
                  <div class="draw-doc-card">
                    <div class="draw-doc-header">
                      <span class="draw-doc-name">{d.name}</span>
                      <a
                        href={`https://drive.google.com/file/d/${d.driveId}/view`}
                        target="_blank"
                        rel="noopener"
                        class="draw-doc-link"
                      >Open full size ↗</a>
                    </div>
                    <div class="draw-iframe-wrap">
                      <iframe
                        src={`https://drive.google.com/file/d/${d.driveId}/preview`}
                        title={d.name}
                        loading="lazy"
                        class="draw-iframe"
                        allowfullscreen
                      ></iframe>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>
        ))}

        <div class="draw-placeholder" id="draw-placeholder">
          <p>Select an age group above to view the draw.</p>
        </div>
      </div>

    </div>

  </div>

</Base>

<script>
  // Tab switching
  document.querySelectorAll('.tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
      tab.classList.add('active');
      document.getElementById(`panel-${(tab as HTMLElement).dataset.tab}`)?.classList.add('active');
    });
  });

  // Age group filter (teams tab)
  document.querySelectorAll('.age-pill').forEach(pill => {
    pill.addEventListener('click', () => {
      document.querySelectorAll('.age-pill').forEach(p => p.classList.remove('active'));
      pill.classList.add('active');
      const age = (pill as HTMLElement).dataset.age;
      document.querySelectorAll('.age-section').forEach(sec => {
        (sec as HTMLElement).style.display = (age === 'all' || (sec as HTMLElement).dataset.age === age) ? '' : 'none';
      });
    });
  });

  // Draw age group selector (draws tab)
  document.querySelectorAll('.draw-age-pill').forEach(pill => {
    pill.addEventListener('click', () => {
      const id = (pill as HTMLElement).dataset.draw;
      const alreadyActive = pill.classList.contains('active');

      document.querySelectorAll('.draw-age-pill').forEach(p => p.classList.remove('active'));
      document.querySelectorAll('.draw-section').forEach(s => (s as HTMLElement).style.display = 'none');
      const placeholder = document.getElementById('draw-placeholder');

      if (alreadyActive) {
        if (placeholder) placeholder.style.display = '';
      } else {
        pill.classList.add('active');
        if (placeholder) placeholder.style.display = 'none';
        const target = document.querySelector(`[data-draw-section="${id}"]`) as HTMLElement;
        if (target) target.style.display = '';
      }
    });
  });
</script>

<style>
.page-hero {
  background: linear-gradient(135deg, var(--green-dark) 0%, var(--off-black) 100%);
  border-bottom: 1px solid var(--border);
  padding: 60px 48px 48px;
}
.page-hero-inner { max-width: 1280px; margin: 0 auto; }
.page-hero .label {
  font-family: var(--font-cond);
  font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase;
  color: var(--green-bright); margin-bottom: 8px;
}
.page-hero h1 { font-size: clamp(48px, 6vw, 80px); margin: 0 0 10px; }
.page-hero p  { color: var(--muted); font-size: 15px; }

.page-inner { max-width: 1280px; margin: 0 auto; padding: 40px 48px; }

/* Tabs */
.tab-bar {
  display: flex; gap: 4px; border-bottom: 1px solid var(--border); margin-bottom: 32px;
}
.tab {
  padding: 10px 22px; background: none; border: none;
  border-bottom: 2px solid transparent; margin-bottom: -1px;
  font-family: var(--font-cond); font-size: 14px; font-weight: 700;
  letter-spacing: 1.5px; text-transform: uppercase; color: var(--muted); cursor: pointer;
  transition: all 0.15s;
}
.tab:hover, .tab.active { color: var(--white); border-bottom-color: var(--green-bright); }

.tab-panel { display: none; }
.tab-panel.active { display: block; }

/* Age pills */
.age-pills {
