/* Mini card */
.mini-card {
  min-width: 120px; border-radius: 10px; padding: 12px 10px 10px;
  box-shadow: 0 8px 24px rgba(0,0,0,0.4); border: 1px solid rgba(255,255,255,0.1);
}
.card-bronze { background: linear-gradient(160deg, #cd7f32 0%, #8b4513 100%); }
.card-silver { background: linear-gradient(160deg, #d0d0d0 0%, #7a8a90 100%); }
.card-gold   { background: linear-gradient(160deg, #d4a017 0%, #8b6400 100%); }
.card-elite  { background: linear-gradient(160deg, #00c853 0%, #1d7a3a 100%); }
.mc-top { display: flex; justify-content: space-between; margin-bottom: 6px; }
.mc-ov  { font-family: var(--font-display); font-size: 32px; color: rgba(255,255,255,0.9); line-height: 1; }
