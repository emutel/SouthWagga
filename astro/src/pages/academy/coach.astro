---
// src/pages/academy/coach.astro
// Coach Dashboard — redesigned with tabbed detail panel
import Base from '../../layouts/Base.astro';
---
<Base
  title="Academy Coach Dashboard"
  description="Warriors FC Academy coach dashboard — manage player assessments and messages."
>

  <!-- ── LOGIN ── -->
  <div id="view-login" class="coach-view">
    <div class="login-hero">
      <div class="login-hero-inner">
        <div class="label">Warriors Academy</div>
        <h1>Coach Dashboard</h1>
        <p>Sign in with your coach account to manage players, assessments and messages.</p>
      </div>
    </div>
    <div class="login-wrap">
      <div class="login-box card">
        <h2>Coach Sign In</h2>
        <form id="coach-login-form" novalidate>
          <div class="field">
            <label for="c-email">Email</label>
            <input type="email" id="c-email" autocomplete="email" required>
          </div>
          <div class="field">
            <label for="c-password">Password</label>
            <input type="password" id="c-password" autocomplete="current-password" required>
          </div>
          <div id="c-login-error" class="form-error" hidden></div>
          <button type="submit" class="btn btn-primary btn-full" id="c-login-btn">Sign In →</button>
        </form>
        <p class="login-help">Need access? Contact the club administrator.</p>
      </div>
    </div>
  </div>

  <!-- ── DASHBOARD ── -->
  <div id="view-dashboard" class="coach-view" hidden>

    <!-- Topbar -->
    <div class="topbar">
      <div class="topbar-inner">
        <div class="topbar-brand">
          <div class="label">Warriors Academy</div>
          <h1 class="topbar-title">Coach Dashboard</h1>
        </div>
        <div class="topbar-actions">
          <a href="/coaching/sessions" target="_blank" class="btn btn-outline-green btn-sm">Session Plans ↗</a>
          <span id="coach-name-display" class="coach-badge"></span>
          <button class="btn btn-secondary btn-sm" id="c-logout-btn">Sign Out</button>
        </div>
      </div>
    </div>

    <!-- Loading -->
    <div id="c-loading" class="state-msg">
      <div class="spinner"></div>
      <p>Loading players…</p>
    </div>

    <!-- Access denied -->
    <div id="c-access-denied" class="state-msg" hidden>
      <p style="color:var(--muted)">Access denied. Your account does not have coach permissions.</p>
      <button id="c-back-login" class="btn btn-secondary" style="margin-top:16px">Back to Login</button>
    </div>

    <!-- Main content -->
    <div id="c-content" class="coach-body" hidden>

      <!-- LEFT: Player list -->
      <aside class="player-col">
        <div class="player-col-header">
          <input id="player-search" type="text" placeholder="Search players…" class="search-input">
          <div id="player-count" class="player-count"></div>
        </div>
        <div id="player-list" class="player-list"></div>
      </aside>

      <!-- RIGHT: Detail panel -->
      <main class="detail-col">

        <!-- Empty state -->
        <div id="no-player-selected" class="no-selection">
          <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="1.1"><circle cx="12" cy="8" r="4"/><path d="M4 20 Q4 14 12 14 Q20 14 20 20"/></svg>
          <p>Select a player to view their card, assess their stats, and message their family.</p>
        </div>

        <!-- Player detail (shown on selection) -->
        <div id="player-detail" hidden>

          <!-- Player header -->
          <div class="detail-header" id="detail-player-info">
            <!-- rendered by JS -->
          </div>

          <!-- Tab nav -->
          <div class="detail-tabs">
            <button class="dtab dtab--active" data-tab="assess">Assessment</button>
            <button class="dtab" data-tab="history">History</button>
            <button class="dtab" data-tab="messages">Messages</button>
          </div>

          <!-- ── TAB: ASSESSMENT ── -->
          <div id="dtab-assess" class="dtab-panel">
            <div class="assess-layout">

              <!-- Card preview column -->
              <div class="card-preview-col">
                <div class="preview-label">Live Preview</div>
                <div id="detail-card-preview"></div>
              </div>

              <!-- Sliders column -->
              <div class="sliders-col">
                <form id="assessment-form">
                  <input type="hidden" id="assess-player-id">
                  <input type="hidden" id="assess-age-group">
                  <input type="hidden" id="assess-position">

                  <div class="sliders-grid">

                    <div class="slider-field" data-attr="pace">
                      <div class="slider-header">
                        <label>PAC — Pace</label>
                        <div class="slider-vals">
                          <span class="sv" id="sv-pace">5</span>
                          <span class="slider-norm" id="sn-pace"></span>
                        </div>
                      </div>
                      <input type="range" min="1" max="10" value="5" id="slider-pace" class="attr-slider" data-attr="pace">
                    </div>

                    <div class="slider-field" data-attr="shooting">
                      <div class="slider-header">
                        <label>SHO — Shooting</label>
                        <div class="slider-vals">
                          <span class="sv" id="sv-shooting">5</span>
                          <span class="slider-norm" id="sn-shooting"></span>
                        </div>
                      </div>
                      <input type="range" min="1" max="10" value="5" id="slider-shooting" class="attr-slider" data-attr="shooting">
                    </div>

                    <div class="slider-field" data-attr="passing">
                      <div class="slider-header">
                        <label>PAS — Passing</label>
                        <div class="slider-vals">
                          <span class="sv" id="sv-passing">5</span>
                          <span class="slider-norm" id="sn-passing"></span>
                        </div>
                      </div>
                      <input type="range" min="1" max="10" value="5" id="slider-passing" class="attr-slider" data-attr="passing">
                    </div>

                    <div class="slider-field" data-attr="dribbling">
                      <div class="slider-header">
                        <label>DRI — Dribbling</label>
                        <div class="slider-vals">
                          <span class="sv" id="sv-dribbling">5</span>
                          <span class="slider-norm" id="sn-dribbling"></span>
                        </div>
                      </div>
                      <input type="range" min="1" max="10" value="5" id="slider-dribbling" class="attr-slider" data-attr="dribbling">
                    </div>

                    <div class="slider-field" data-attr="defending">
                      <div class="slider-header">
                        <label>DEF — Defending</label>
                        <div class="slider-vals">
                          <span class="sv" id="sv-defending">5</span>
                          <span class="slider-norm" id="sn-defending"></span>
                        </div>
                      </div>
                      <input type="range" min="1" max="10" value="5" id="slider-defending" class="attr-slider" data-attr="defending">
                    </div>

                    <div class="slider-field" data-attr="physical">
                      <div class="slider-header">
                        <label>PHY — Physical</label>
                        <div class="slider-vals">
                          <span class="sv" id="sv-physical">5</span>
                          <span class="slider-norm" id="sn-physical"></span>
                        </div>
                      </div>
                      <input type="range" min="1" max="10" value="5" id="slider-physical" class="attr-slider" data-attr="physical">
                    </div>

                  </div><!-- /sliders-grid -->

                  <div class="field notes-field">
                    <label for="assess-notes">Coach Notes <span class="field-hint">(visible to parent)</span></label>
                    <textarea id="assess-notes" rows="3" placeholder="What went well? What to work on?"></textarea>
                  </div>

                  <div class="form-actions">
                    <button type="submit" class="btn btn-primary" id="save-assess-btn">Save Assessment →</button>
                    <span id="assess-saved-msg" class="save-ok" hidden>✓ Assessment saved</span>
                    <span id="assess-error-msg" class="save-err" hidden>Failed to save. Try again.</span>
                  </div>

                </form>
              </div><!-- /sliders-col -->

            </div><!-- /assess-layout -->
          </div><!-- /dtab-assess -->

          <!-- ── TAB: HISTORY ── -->
          <div id="dtab-history" class="dtab-panel" hidden>
            <div id="assess-history" class="history-list"></div>
          </div>

          <!-- ── TAB: MESSAGES ── -->
          <div id="dtab-messages" class="dtab-panel" hidden>
            <div id="coach-message-thread" class="message-thread"></div>
            <form id="coach-msg-form" class="compose-form">
              <textarea id="coach-msg-input" rows="3" placeholder="Write a message to the player's family…"></textarea>
              <button type="submit" class="btn btn-primary btn-sm" id="coach-send-btn">Send →</button>
            </form>
          </div>

        </div><!-- /player-detail -->
      </main>
    </div><!-- /coach-body -->
  </div><!-- /view-dashboard -->

</Base>

<script>
const DURL = import.meta.env.PUBLIC_DIRECTUS_URL || '';

// ── AUTH ──────────────────────────────────────────────────────
const CLS = {
  get token()   { return sessionStorage.getItem('warriors_coach_token'); },
  get refresh() { return sessionStorage.getItem('warriors_coach_refresh'); },
  get user()    { try { return JSON.parse(sessionStorage.getItem('warriors_coach_user') || 'null'); } catch { return null; } },
  set token(v)  { sessionStorage.setItem('warriors_coach_token', v); },
  set refresh(v){ sessionStorage.setItem('warriors_coach_refresh', v); },
  set user(v)   { sessionStorage.setItem('warriors_coach_user', JSON.stringify(v)); },
  clear()       { ['warriors_coach_token','warriors_coach_refresh','warriors_coach_user'].forEach(k => sessionStorage.removeItem(k)); },
};

async function capi(path, opts = {}, token = CLS.token) {
  const headers = { 'Content-Type': 'application/json' };
  if (token) headers['Authorization'] = `Bearer ${token}`;
  const res = await fetch(`${DURL}${path}`, { ...opts, headers: { ...headers, ...(opts.headers||{}) } });
  if (res.status === 401) {
    const refreshed = await tryRefresh();
    if (refreshed) return capi(path, opts, CLS.token);
    showCoachLogin(); return null;
  }
  if (!res.ok) return null;
  const json = await res.json();
  return json.data ?? json;
}

async function tryRefresh() {
  if (!CLS.refresh) return false;
  try {
    const res = await fetch(`${DURL}/auth/refresh`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ refresh_token: CLS.refresh, mode: 'json' }),
    });
    if (!res.ok) return false;
    const { data } = await res.json();
    CLS.token = data.access_token; CLS.refresh = data.refresh_token;
    return true;
  } catch { return false; }
}

// ── FIFA CARD UTILS ───────────────────────────────────────────
const AGE_SCALE = {
  'u8-u9':  { min:30, max:72 }, 'u10-u11': { min:35, max:78 },
  'u12-u13':{ min:40, max:83 }, 'u14-u16': { min:45, max:90 },
};
function normalize(raw, ag) {
  const s = AGE_SCALE[ag] || AGE_SCALE['u12-u13'];
  return Math.round(s.min + (raw - 1) * (s.max - s.min) / 9);
}
function calcOverall(attrs, position) {
  const { pac, sho, pas, dri, def, phy } = attrs;
  const isAtk = ['forward','midfielder'].includes(position);
  return isAtk ? Math.round((dri*2+sho*2+pac+pas+phy)/7)
               : Math.round((def*2+phy*2+pac+pas+dri)/7);
}
function tierInfo(ov) {
  if (ov >= 90) return { name:'Elite',  cls:'card-elite'  };
  if (ov >= 75) return { name:'Gold',   cls:'card-gold'   };
  if (ov >= 60) return { name:'Silver', cls:'card-silver' };
  return              { name:'Bronze', cls:'card-bronze' };
}
const posLabel = p => ({ goalkeeper:'GK', defender:'CB', midfielder:'MID', forward:'FWD' }[p] || 'MID');

function buildFIFACard(enrollment, profile, rawAttrs) {
  const ag  = enrollment?.age_group || 'u12-u13';
  const pos = profile?.position || 'midfielder';
  const attrs = {
    pac: normalize(rawAttrs.pace,      ag), sho: normalize(rawAttrs.shooting,  ag),
    pas: normalize(rawAttrs.passing,   ag), dri: normalize(rawAttrs.dribbling, ag),
    def: normalize(rawAttrs.defending, ag), phy: normalize(rawAttrs.physical,  ag),
  };
  const ov    = calcOverall(attrs, pos);
  const tier  = tierInfo(ov);
  const agLbl = {'u8-u9':'U9','u10-u11':'U11','u12-u13':'U13','u14-u16':'U16'}[ag] || ag.toUpperCase();
  const fn    = enrollment?.player_first_name || '';
  const ln    = enrollment?.player_last_name  || '';
  const name  = `${fn} ${(ln[0]||'')}.`.trim();
  return `
<div class="fifa-card ${tier.cls}">
  <div class="fc-header">
    <div class="fc-left">
      <div class="fc-overall">${ov}</div>
      <div class="fc-pos">${posLabel(pos)}</div>
      <div class="fc-tier">${tier.name}</div>
    </div>
    <div class="fc-badge"><svg viewBox="0 0 40 40" width="34" height="34" fill="none"><polygon points="20,3 37,12 37,28 20,37 3,28 3,12" fill="rgba(255,255,255,0.12)" stroke="rgba(255,255,255,0.25)" stroke-width="1.5"/><text x="20" y="26" text-anchor="middle" font-size="13" font-weight="bold" fill="rgba(255,255,255,0.7)" font-family="Arial">W</text></svg></div>
  </div>
  <div class="fc-photo"><svg viewBox="0 0 80 100" fill="none" width="80" height="100"><circle cx="40" cy="26" r="18" fill="rgba(255,255,255,0.2)"/><path d="M8 95 C8 65 20 54 40 52 C60 54 72 65 72 95" fill="rgba(255,255,255,0.2)"/></svg></div>
  <div class="fc-name">${name.toUpperCase()}</div>
  <div class="fc-club">${agLbl} · Warriors FC</div>
  <div class="fc-stats">
    ${[['PAC',attrs.pac],['SHO',attrs.sho],['PAS',attrs.pas],['DRI',attrs.dri],['DEF',attrs.def],['PHY',attrs.phy]].map(([l,v])=>`<div class="fc-stat"><span class="fc-sv">${v}</span><span class="fc-sl">${l}</span></div>`).join('')}
  </div>
</div>`;
}

// ── STATE ─────────────────────────────────────────────────────
let allPlayers = [];
let selectedIdx = -1;
let _lastAssessMap = {};

// ── VIEWS ─────────────────────────────────────────────────────
function showCoachLogin() {
  CLS.clear();
  document.getElementById('view-login').hidden = false;
  document.getElementById('view-dashboard').hidden = true;
}
function showCoachDashboard(user) {
  document.getElementById('view-login').hidden = true;
  document.getElementById('view-dashboard').hidden = false;
  const name = user?.first_name ? `${user.first_name}${user.last_name ? ' ' + user.last_name[0] + '.' : ''}` : 'Coach';
  document.getElementById('coach-name-display').textContent = name;
}

// ── DETAIL TABS ───────────────────────────────────────────────
function switchDetailTab(name) {
  document.querySelectorAll('.dtab').forEach(b => b.classList.toggle('dtab--active', b.dataset.tab === name));
  document.querySelectorAll('.dtab-panel').forEach(p => { p.hidden = true; });
  const panel = document.getElementById(`dtab-${name}`);
  if (panel) panel.hidden = false;
}
document.querySelectorAll('.dtab').forEach(btn => {
  btn.addEventListener('click', () => switchDetailTab(btn.dataset.tab));
});

// ── LOAD PLAYERS ──────────────────────────────────────────────
async function loadAllPlayers() {
  document.getElementById('c-loading').hidden = false;
  document.getElementById('c-content').hidden = true;

  const profiles = await capi(
    '/items/academy_player_profiles?fields=id,position,photo,jersey_number,enrollment.id,enrollment.age_group,enrollment.player_first_name,enrollment.player_last_name,enrollment.parent_email&limit=200'
  );
  if (!profiles) { document.getElementById('c-loading').hidden = true; return; }

  allPlayers = (Array.isArray(profiles) ? profiles : []).map(p => ({ profile: p, enrollment: p.enrollment }));

  const latestData = await capi('/items/academy_assessments?filter[is_latest][_eq]=true&limit=200&fields=player,pace_raw,shooting_raw,passing_raw,dribbling_raw,defending_raw,physical_raw,assessment_date');
  const assessMap = {};
  (Array.isArray(latestData) ? latestData : []).forEach(a => { assessMap[String(a.player)] = a; });

  renderPlayerList(allPlayers, assessMap);
  document.getElementById('c-loading').hidden = true;
  document.getElementById('c-content').hidden = false;
}

function renderPlayerList(players, assessMap) {
  if (assessMap) _lastAssessMap = assessMap;
  const aMap = _lastAssessMap;
  const list = document.getElementById('player-list');
  const countEl = document.getElementById('player-count');
  if (countEl) countEl.textContent = `${players.length} player${players.length !== 1 ? 's' : ''}`;

  if (!players.length) {
    list.innerHTML = '<p class="empty-list">No players found.</p>';
    return;
  }
  list.innerHTML = players.map(p => {
    const enr       = p.enrollment || {};
    const name      = `${enr.player_first_name||''} ${enr.player_last_name||''}`.trim();
    const ag        = enr.age_group ? enr.age_group.toUpperCase().replace('-','/') : '—';
    const posShort  = posLabel(p.profile?.position || p.position || 'midfielder');
    const origIdx   = allPlayers.indexOf(p);
    const profileId = String(p.profile?.id || p.id);
    const assess    = aMap[profileId];
    const isActive  = selectedIdx === origIdx;

    let tierCls = 'tier-none', tierHtml = '', assessedHtml = '<span class="pi-date">Never assessed</span>';
    if (assess) {
      const ageKey = enr.age_group || 'u12-u13';
      const posKey = p.profile?.position || p.position || 'midfielder';
      const attrs  = {
        pac: normalize(assess.pace_raw,      ageKey), sho: normalize(assess.shooting_raw,  ageKey),
        pas: normalize(assess.passing_raw,   ageKey), dri: normalize(assess.dribbling_raw, ageKey),
        def: normalize(assess.defending_raw, ageKey), phy: normalize(assess.physical_raw,  ageKey),
      };
      const ov   = calcOverall(attrs, posKey);
      const tier = tierInfo(ov);
      tierCls  = tier.cls;
      tierHtml = `<span class="tier-chip ${tier.cls}">${tier.name.toUpperCase()} <strong>${ov}</strong></span>`;
      const d  = new Date(assess.assessment_date).toLocaleDateString('en-AU', {day:'numeric',month:'short',year:'numeric'});
      assessedHtml = `<span class="pi-date">Last assessed: ${d}</span>`;
    }

    return `
<button class="player-card ${isActive ? 'player-card--active' : ''} border-${tierCls}" data-idx="${origIdx}">
  <div class="pc-main">
    <div class="pc-name">${name}</div>
    <div class="pc-meta">
      <span class="pc-ag">${ag}</span>
      <span class="pc-pos">${posShort}</span>
      ${tierHtml}
    </div>
    ${assessedHtml}
  </div>
</button>`;
  }).join('');

  list.querySelectorAll('.player-card').forEach(btn => {
    btn.addEventListener('click', () => selectPlayer(parseInt(btn.dataset.idx)));
  });
}

// ── SEARCH ────────────────────────────────────────────────────
document.getElementById('player-search').addEventListener('input', e => {
  const q = e.target.value.toLowerCase();
  const filtered = allPlayers.filter(p => {
    const enr = p.enrollment || {};
    return `${enr.player_first_name||''} ${enr.player_last_name||''}`.toLowerCase().includes(q);
  });
  renderPlayerList(filtered);
});

// ── SELECT PLAYER ─────────────────────────────────────────────
async function selectPlayer(idx) {
  selectedIdx = idx;
  const { profile, enrollment } = allPlayers[idx];
  renderPlayerList(allPlayers);

  document.getElementById('no-player-selected').hidden = true;
  document.getElementById('player-detail').hidden = false;
  switchDetailTab('assess');

  const name   = `${enrollment?.player_first_name||''} ${enrollment?.player_last_name||''}`.trim();
  const ag     = enrollment?.age_group || 'u12-u13';
  const agDisp = ag.toUpperCase().replace('-','/');
  const pos    = posLabel(profile.position || 'midfielder');
  const ageLabels = { 'u8-u11':'MiniRoos 8–11','u8-u9':'MiniRoos 5–9','u12-u13':'Youth U12–U13','u14-u16':'Youth U14–U16','u5-u7':'MiniRoos 5–7' };

  document.getElementById('detail-player-info').innerHTML = `
<div class="dh-name">${name}</div>
<div class="dh-chips">
  <span class="chip-ag">${agDisp}</span>
  <span class="chip-pos">${pos}</span>
  ${profile.jersey_number ? `<span class="chip-jersey">#${profile.jersey_number}</span>` : ''}
</div>
<a href="/coaching/sessions?age=${ag}" target="_blank" class="plans-link">View ${ageLabels[ag] || ag} Session Plans ↗</a>`;

  document.getElementById('assess-player-id').value = profile.id;
  document.getElementById('assess-age-group').value  = ag;
  document.getElementById('assess-position').value   = profile.position || 'midfielder';

  document.querySelectorAll('.attr-slider').forEach(s => { s.value = 5; });
  document.getElementById('assess-notes').value = '';
  updateAllPreviews(ag);
  updateCardPreview();

  const latestData = await capi(
    `/items/academy_assessments?filter[player][_eq]=${profile.id}&filter[is_latest][_eq]=true&limit=1&fields=*`
  );
  const latest = Array.isArray(latestData) ? latestData[0] : null;
  if (latest) {
    ['pace','shooting','passing','dribbling','defending','physical'].forEach(attr => {
      const sl = document.getElementById(`slider-${attr}`);
      if (sl && latest[`${attr}_raw`]) sl.value = latest[`${attr}_raw`];
    });
    document.getElementById('assess-notes').value = latest.notes || '';
    updateAllPreviews(ag);
    updateCardPreview();
  }

  const histData = await capi(
    `/items/academy_assessments?filter[player][_eq]=${profile.id}&sort[]=-assessment_date&limit=10&fields=*`
  );
  renderAssessHistory(Array.isArray(histData) ? histData : [], ag, profile.position);

  const msgData = await capi(
    `/items/academy_messages?filter[player][_eq]=${profile.id}&sort[]=date_created&fields=*`
  );
  renderMessages(Array.isArray(msgData) ? msgData : []);
}

// ── SLIDER PREVIEWS ───────────────────────────────────────────
function normChipClass(v) { return v >= 65 ? 'norm-green' : v >= 50 ? 'norm-amber' : 'norm-red'; }

function updateAllPreviews(ag) {
  ['pace','shooting','passing','dribbling','defending','physical'].forEach(attr => {
    const slider = document.getElementById(`slider-${attr}`);
    const valEl  = document.getElementById(`sv-${attr}`);
    const normEl = document.getElementById(`sn-${attr}`);
    if (!slider) return;
    const raw  = parseInt(slider.value);
    const norm = normalize(raw, ag);
    if (valEl)  valEl.textContent = raw;
    if (normEl) { normEl.textContent = norm; normEl.className = `slider-norm ${normChipClass(norm)}`; }
  });
}

function updateCardPreview() {
  const ag  = document.getElementById('assess-age-group').value || 'u12-u13';
  const idx = selectedIdx;
  if (idx < 0) return;
  const { enrollment, profile } = allPlayers[idx];
  const rawAttrs = {
    pace:      parseInt(document.getElementById('slider-pace').value      || 5),
    shooting:  parseInt(document.getElementById('slider-shooting').value  || 5),
    passing:   parseInt(document.getElementById('slider-passing').value   || 5),
    dribbling: parseInt(document.getElementById('slider-dribbling').value || 5),
    defending: parseInt(document.getElementById('slider-defending').value || 5),
    physical:  parseInt(document.getElementById('slider-physical').value  || 5),
  };
  document.getElementById('detail-card-preview').innerHTML = buildFIFACard(enrollment, profile, rawAttrs);
}

document.querySelectorAll('.attr-slider').forEach(slider => {
  slider.addEventListener('input', () => {
    const ag = document.getElementById('assess-age-group').value || 'u12-u13';
    updateAllPreviews(ag);
    updateCardPreview();
  });
});

// ── RENDER HISTORY ────────────────────────────────────────────
function renderAssessHistory(assessments, ag, position) {
  const el = document.getElementById('assess-history');
  if (!assessments.length) {
    el.innerHTML = '<p class="empty-msg">No assessments recorded yet.</p>';
    return;
  }
  el.innerHTML = assessments.map(a => {
    const attrs = {
      pac: normalize(a.pace_raw,ag),      sho: normalize(a.shooting_raw,ag),
      pas: normalize(a.passing_raw,ag),   dri: normalize(a.dribbling_raw,ag),
      def: normalize(a.defending_raw,ag), phy: normalize(a.physical_raw,ag),
    };
    const ov   = calcOverall(attrs, position || 'midfielder');
    const tier = tierInfo(ov);
    const d    = new Date(a.assessment_date).toLocaleDateString('en-AU',{day:'numeric',month:'short',year:'numeric'});
    return `
<div class="hist-entry ${a.is_latest ? 'hist-entry--current' : ''}">
  <div class="he-row">
    <span class="he-date">${d}</span>
    <span class="he-ov ${tier.cls}">${ov}</span>
    <span class="he-tier">${tier.name}</span>
    ${a.is_latest ? '<span class="he-latest">Current</span>' : ''}
    <span class="he-coach">by ${a.assessed_by||'Coach'}</span>
  </div>
  <div class="he-bars">
    ${[['PAC',attrs.pac],['SHO',attrs.sho],['PAS',attrs.pas],['DRI',attrs.dri],['DEF',attrs.def],['PHY',attrs.phy]].map(([l,v])=>`
    <div class="he-bar-row">
      <span class="he-lbl">${l}</span>
      <div class="he-bar-bg"><div class="he-bar-fill" style="width:${Math.min(v,99)}%"></div></div>
      <span class="he-bv">${v}</span>
    </div>`).join('')}
  </div>
  ${a.notes ? `<p class="he-notes">${a.notes}</p>` : ''}
</div>`;
  }).join('');
}

// ── RENDER MESSAGES ───────────────────────────────────────────
function renderMessages(messages) {
  const el = document.getElementById('coach-message-thread');
  if (!messages.length) {
    el.innerHTML = '<p class="empty-msg">No messages yet.</p>';
    return;
  }
  el.innerHTML = messages.map(m => `
<div class="msg msg--${m.sender_role}">
  <div class="msg-meta">
    <span class="msg-author">${m.sender_name||(m.sender_role==='coach'?'You':'Parent')}</span>
    <span class="msg-date">${new Date(m.date_created).toLocaleDateString('en-AU',{day:'numeric',month:'short',year:'numeric'})}</span>
  </div>
  <div class="msg-body">${m.body.replace(/\n/g,'<br>')}</div>
</div>`).join('');
  el.scrollTop = el.scrollHeight;
}

// ── SAVE ASSESSMENT ───────────────────────────────────────────
document.getElementById('assessment-form').addEventListener('submit', async e => {
  e.preventDefault();
  const saveBtn  = document.getElementById('save-assess-btn');
  const savedMsg = document.getElementById('assess-saved-msg');
  const errMsg   = document.getElementById('assess-error-msg');
  savedMsg.hidden = true; errMsg.hidden = true;
  saveBtn.disabled = true; saveBtn.textContent = 'Saving…';

  const playerId = document.getElementById('assess-player-id').value;
  const ag       = document.getElementById('assess-age-group').value;
  const coach    = CLS.user;

  const existing = await capi(`/items/academy_assessments?filter[player][_eq]=${playerId}&filter[is_latest][_eq]=true&fields=id`);
  if (Array.isArray(existing) && existing.length > 0) {
    await Promise.all(existing.map(a =>
      capi(`/items/academy_assessments/${a.id}`, { method:'PATCH', body:JSON.stringify({ is_latest:false }) })
    ));
  }

  const payload = {
    player:            playerId,
    assessed_by:       `${coach?.first_name||''} ${coach?.last_name||''}`.trim() || 'Coach',
    assessment_date:   new Date().toISOString().split('T')[0],
    age_group_at_time: ag,
    pace_raw:          parseInt(document.getElementById('slider-pace').value),
    shooting_raw:      parseInt(document.getElementById('slider-shooting').value),
    passing_raw:       parseInt(document.getElementById('slider-passing').value),
    dribbling_raw:     parseInt(document.getElementById('slider-dribbling').value),
    defending_raw:     parseInt(document.getElementById('slider-defending').value),
    physical_raw:      parseInt(document.getElementById('slider-physical').value),
    notes:             document.getElementById('assess-notes').value.trim() || null,
    is_latest:         true,
  };

  const result = await capi('/items/academy_assessments', { method:'POST', body:JSON.stringify(payload) });
  if (result) {
    savedMsg.hidden = false;
    setTimeout(() => { savedMsg.hidden = true; }, 3000);
    const histData = await capi(`/items/academy_assessments?filter[player][_eq]=${playerId}&sort[]=-assessment_date&limit=10&fields=*`);
    const pos = document.getElementById('assess-position').value;
    renderAssessHistory(Array.isArray(histData) ? histData : [], ag, pos);
    // Refresh player list badges
    const allAssess = await capi('/items/academy_assessments?filter[is_latest][_eq]=true&limit=200&fields=player,pace_raw,shooting_raw,passing_raw,dribbling_raw,defending_raw,physical_raw,assessment_date');
    if (Array.isArray(allAssess)) {
      _lastAssessMap = {};
      allAssess.forEach(a => { _lastAssessMap[String(a.player)] = a; });
      renderPlayerList(allPlayers);
    }
  } else {
    errMsg.hidden = false;
  }
  saveBtn.disabled = false; saveBtn.textContent = 'Save Assessment →';
});

// ── SEND MESSAGE ──────────────────────────────────────────────
document.getElementById('coach-msg-form').addEventListener('submit', async e => {
  e.preventDefault();
  const input   = document.getElementById('coach-msg-input');
  const sendBtn = document.getElementById('coach-send-btn');
  const body    = input.value.trim();
  if (!body || selectedIdx < 0) return;

  const { profile } = allPlayers[selectedIdx];
  const coach = CLS.user;
  sendBtn.disabled = true; sendBtn.textContent = 'Sending…';

  const result = await capi('/items/academy_messages', { method:'POST', body:JSON.stringify({
    player:      profile.id,
    sender_role: 'coach',
    sender_name: `${coach?.first_name||''} ${coach?.last_name||''}`.trim() || 'Coach',
    body,
  })});
  if (result) {
    input.value = '';
    const msgData = await capi(`/items/academy_messages?filter[player][_eq]=${profile.id}&sort[]=date_created&fields=*`);
    renderMessages(Array.isArray(msgData) ? msgData : []);
  }
  sendBtn.disabled = false; sendBtn.textContent = 'Send →';
});

// ── LOGIN ─────────────────────────────────────────────────────
document.getElementById('coach-login-form').addEventListener('submit', async e => {
  e.preventDefault();
  const errEl = document.getElementById('c-login-error');
  const btn   = document.getElementById('c-login-btn');
  errEl.hidden = true; btn.disabled = true; btn.textContent = 'Signing in…';
  try {
    const res  = await fetch(`${DURL}/auth/login`, {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ email: document.getElementById('c-email').value.trim(), password: document.getElementById('c-password').value }),
    });
    const json = await res.json();
    if (!res.ok) throw new Error(json?.errors?.[0]?.message || 'Login failed');
    CLS.token   = json.data.access_token;
    CLS.refresh = json.data.refresh_token;
    const user = await capi('/users/me?fields=id,email,first_name,last_name,role.name');
    if (!user) throw new Error('Could not load profile');
    CLS.user = user;
    const role = (user?.role?.name||'').toLowerCase();
    if (!['coach','administrator','admin','technical_director','technical director','director'].some(r => role.includes(r))) {
      CLS.clear();
      document.getElementById('c-access-denied').hidden = false;
      document.getElementById('c-loading').hidden = true;
      document.getElementById('view-login').hidden = true;
      document.getElementById('view-dashboard').hidden = false;
      btn.disabled = false; btn.textContent = 'Sign In →';
      return;
    }
    showCoachDashboard(user);
    loadAllPlayers();
  } catch (err) {
    errEl.textContent = err.message.includes('Invalid') ? 'Invalid email or password.' : err.message;
    errEl.hidden = false; btn.disabled = false; btn.textContent = 'Sign In →';
  }
});

document.getElementById('c-logout-btn').addEventListener('click', () => {
  if (CLS.token) fetch(`${DURL}/auth/logout`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({refresh_token:CLS.refresh})}).catch(()=>{});
  showCoachLogin();
});
document.getElementById('c-back-login')?.addEventListener('click', showCoachLogin);

// ── INIT ──────────────────────────────────────────────────────
(async function init() {
  if (!CLS.token) { showCoachLogin(); return; }
  const user = await capi('/users/me?fields=id,email,first_name,last_name,role.name');
  if (!user) { showCoachLogin(); return; }
  CLS.user = user;
  const role = (user?.role?.name||'').toLowerCase();
  if (!['coach','administrator','admin','technical_director','technical director','director'].some(r => role.includes(r))) {
    CLS.clear(); showCoachLogin(); return;
  }
  showCoachDashboard(user);
  loadAllPlayers();
})();
</script>

