.portal-hero h1 { font-size: clamp(48px,6vw,72px); margin: 10px 0 8px; }
.portal-hero p  { color: var(--muted); }

.login-outer { display: flex; justify-content: center; padding: 56px 20px; }
.login-card  { width: 100%; max-width: 440px; padding: 40px; }
.login-card h2 { font-size: 36px; margin-bottom: 20px; }
.field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 16px; }
.field label { font-family: var(--font-cond); font-size: 14px; font-weight: 700; }
input[type="email"], input[type="password"] {
  background: var(--black); border: 1px solid var(--border); border-radius: var(--radius);
  color: var(--white); font-family: var(--font-body); font-size: 15px; padding: 11px 14px; width: 100%;
}
input:focus { outline: none; border-color: var(--green); }
.btn-full { width: 100%; justify-content: center; margin-top: 8px; }
.login-footer { margin-top: 16px; }
.login-footer p { font-size: 13px; color: var(--muted); }
.form-msg--error {
  background: rgba(217,48,37,0.1); border: 1px solid rgba(217,48,37,0.3);
  border-radius: var(--radius); padding: 12px 14px; font-size: 14px; color: #ff6b6b; margin-bottom: 12px;
}

.dash-header { background: var(--off-black); border-bottom: 1px solid var(--border); padding: 20px 48px; }
.dash-header-inner { max-width: 100%; display: flex; justify-content: space-between; align-items: center; }
.dash-header h1 { font-size: clamp(28px,4vw,44px); }
.dash-header-actions { display: flex; align-items: center; gap: 16px; }
.coach-name { font-family: var(--font-cond); font-size: 14px; color: var(--muted); font-weight: 700; }
.btn-sm { padding: 8px 16px; font-size: 13px; }

.dash-body { height: calc(100vh - 80px); overflow: hidden; }
.dash-loading { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 200px; color: var(--muted); gap: 12px; }
.spinner { width: 32px; height: 32px; border: 3px solid var(--border); border-top-color: var(--green); border-radius: 50%; animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.dash-error { text-align: center; padding: 40px; color: var(--muted); }

/* Layout */
.coach-layout { display: grid; grid-template-columns: 280px 1fr; height: calc(100vh - 80px); }
.player-list-col { border-right: 1px solid var(--border); display: flex; flex-direction: column; overflow: hidden; }
.list-header { padding: 14px; border-bottom: 1px solid var(--border); }
.search-input {
  width: 100%; background: var(--black); border: 1px solid var(--border);
  border-radius: var(--radius); color: var(--white); font-family: var(--font-body);
  font-size: 14px; padding: 9px 12px;
}
.search-input:focus { outline: none; border-color: var(--green); }
.player-list { flex: 1; overflow-y: auto; }
.player-item {
  width: 100%; background: none; border: none; border-bottom: 1px solid var(--border);
  padding: 14px 16px; text-align: left; cursor: pointer; transition: background 0.1s;
}
.player-item:hover { background: rgba(37,160,76,0.06); }
.player-item--active { background: rgba(37,160,76,0.1); border-left: 3px solid var(--green-bright); }
.pi-name     { font-family: var(--font-cond); font-size: 15px; font-weight: 700; color: var(--white); margin-bottom: 4px; }
.pi-meta     { display: flex; gap: 8px; }
.pi-sub      { font-size: 11px; font-family: var(--font-cond); color: var(--muted); font-weight: 700; display: flex; align-items: center; gap: 6px; flex-wrap: wrap; margin-bottom: 3px; }
.pi-assessed { font-size: 11px; color: var(--muted); font-style: italic; }
.pi-ag       { font-size: 11px; font-family: var(--font-cond); color: var(--green-bright); font-weight: 700; letter-spacing: 1px; background: rgba(37,160,76,0.12); padding: 2px 7px; border-radius: 3px; }
.empty-list-msg { padding: 20px 16px; font-size: 13px; color: var(--muted); }

/* Tier badges in player list */
.tier-badge  { font-family: var(--font-cond); font-size: 10px; font-weight: 800; letter-spacing: 1px; padding: 2px 6px; border-radius: 4px; white-space: nowrap; }
.tier-elite  { background: #e5f4ff; color: #0088cc; }
.tier-gold   { background: #fffde0; color: #cc8800; }
.tier-silver { background: #f0f0f0; color: #666; }
.tier-bronze { background: #fff4e0; color: #8b5000; }

/* Normalised value chips on sliders */
.slider-norm { padding: 2px 8px; border-radius: 10px; font-size: 12px; font-weight: 700; }
.norm-green  { background: rgba(37,160,76,0.15); color: var(--green-bright); }
.norm-amber  { background: rgba(255,180,0,0.15); color: #ffb400; }
.norm-red    { background: rgba(220,50,50,0.15); color: #e05050; }

/* Session plan link in player detail */
.session-plan-link { display: inline-block; margin-top: 8px; font-family: var(--font-cond); font-size: 12px; font-weight: 700; color: var(--green-bright); text-decoration: none; letter-spacing: 0.5px; }
.session-plan-link:hover { text-decoration: underline; }

/* Player detail */
.player-detail-col { overflow-y: auto; padding: 32px 40px 80px; }
.no-selection { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 300px; gap: 16px; text-align: center; color: var(--muted); }
