---
// src/pages/academy/coach.astro
// Coach Dashboard — full rewrite, clipboard-style UI
import PortalBase from '../../layouts/PortalBase.astro';
import { CLUB } from '../../club.config.js';
const demoToken = import.meta.env.PUBLIC_DEMO_TOKEN || '';
---
<PortalBase
  title="Academy Coach Dashboard"
  description={`${CLUB.shortName} Academy coach dashboard — manage player assessments and messages.`}
>

<!-- Demo mode marker (hidden, read by JS) -->
{CLUB.demoMode && <div id="demo-mode" data-token={demoToken} hidden></div>}

<!-- View: Login -->
<div id="view-login" class="view">
  <div class="login-hero">
    <span class="login-label">{CLUB.shortName} Academy</span>
    <h1 class="login-title">Coach Dashboard</h1>
    <p class="login-sub">Sign in to manage your players</p>
  </div>
  <div class="login-outer">
    <div class="login-card">
      {CLUB.demoMode && (
        <div class="demo-info-banner">
          <span style="font-size:20px;flex-shrink:0">ℹ️</span>
          <div>
            <strong>Demo login</strong>
            <span class="demo-cred"><span class="demo-cred-label">Email</span> coach@riverside-demo.com</span>
            <span class="demo-cred"><span class="demo-cred-label">Password</span> Demo1234!</span>
          </div>
        </div>
      )}
      <div class="field-group">
        <label>Email</label>
        <input id="login-email" type="email" autocomplete="email" value={CLUB.demoMode ? 'coach@riverside-demo.com' : ''}>
      </div>
      <div class="field-group">
        <label>Password</label>
        <input id="login-password" type="password" autocomplete="current-password" value={CLUB.demoMode ? 'Demo1234!' : ''}>
      </div>
      <button id="login-btn" class="btn-green">Sign In →</button>
      <p id="login-error" class="error-msg" hidden></p>
      <p class="login-note">Need access? Contact the club administrator.</p>
    </div>
  </div>
</div>

<!-- View: Dashboard -->
<div id="view-dashboard" class="view" hidden>

  <!-- Topbar -->
  <div class="topbar">
    <div class="topbar-inner">
      <div class="topbar-brand">
        <span class="brand-label">{CLUB.shortName} Academy</span>
        <span class="brand-title">Coach Dashboard</span>
      </div>
      <div class="topbar-actions">
        <button id="view-players-btn" class="topbar-view-btn topbar-view-btn--active">Players</button>
        <button id="view-sessions-btn" class="topbar-view-btn">Sessions</button>
        <span id="coach-badge" class="coach-badge"></span>
        <button id="logout-btn" class="btn-ghost">Sign Out</button>
      </div>
    </div>
  </div>

  <!-- Loading state -->
  <div id="coach-loading" class="full-loading">
    <div class="spinner"></div>
    <p>Loading players…</p>
  </div>

  <!-- Main two-pane layout -->
  <div id="coach-body" class="coach-body" hidden>

    <!-- LEFT: Player roster -->
    <div class="roster-col">
      <div class="roster-header">
        <input id="player-search" type="search" placeholder="Search players…" class="search-input">
        <span id="player-count" class="player-count"></span>
      </div>
      <div id="player-list" class="player-list"></div>
    </div>

    <!-- RIGHT: Detail panel -->
    <div class="detail-col">

      <!-- Empty state -->
      <div id="detail-empty" class="detail-empty">
        <div class="empty-icon">👥</div>
        <p>Select a player from the roster to view their card, assess their stats, and send messages.</p>
      </div>

      <!-- Player detail -->
      <div id="detail-panel" hidden>

        <!-- Detail header -->
        <div class="detail-header">
          <div class="detail-header-left">
            <h2 id="detail-name" class="detail-name"></h2>
            <div class="detail-chips">
              <span id="detail-age-chip" class="chip chip--blue"></span>
              <span id="detail-pos-chip" class="chip chip--green"></span>
              <span id="detail-jersey" class="chip chip--gray"></span>
            </div>
          </div>
          <a id="detail-plans-link" href="/coaching/sessions" target="_blank" class="plans-link">
            View Session Plans ↗
          </a>
        </div>

        <!-- Tab bar -->
        <div class="detail-tabs">
          <button class="dtab dtab--active" data-tab="assessment">Assessment</button>
          <button class="dtab" data-tab="history">History</button>
          <button class="dtab" data-tab="messages">Messages <span id="msg-badge" class="msg-badge" hidden>0</span></button>
        </div>

        <!-- Tab: Assessment -->
        <div id="dtab-assessment" class="dtab-panel">
          <div class="assess-layout">
            <!-- Left: Live card preview -->
            <div class="card-preview-col">
              <p class="preview-label">Live Preview</p>
              <div id="card-preview"></div>
            </div>
            <!-- Right: Sliders -->
            <div class="sliders-col">
              <div id="save-banner" class="save-banner"></div>
              <!-- Assessment guide toggle -->
              <div class="assess-guide-bar">
                <span class="assess-guide-note">Conduct this test on a player's first session and at the end of every term.</span>
                <button id="guide-toggle-btn" class="guide-toggle-btn">📋 Assessment Guide</button>
              </div>
              <div id="assess-guide" class="assess-guide" hidden>
                <div id="assess-guide-body"><!-- Injected by JS --></div>
              </div>
              <div class="sliders-grid" id="sliders-grid">
                <!-- Injected by JS -->
              </div>
              <div class="notes-field">
                <label class="notes-label">Coach Notes</label>
                <textarea id="assess-notes" class="notes-textarea" rows="3" placeholder="Optional notes about this assessment…"></textarea>
              </div>
              <button id="save-btn" class="btn-green btn-save">Save Assessment →</button>
              <p id="assess-error" class="error-msg" hidden></p>
            </div>
          </div>
        </div>

        <!-- Tab: History -->
        <div id="dtab-history" class="dtab-panel" hidden>
          <div id="history-content"></div>
        </div>

        <!-- Tab: Messages -->
        <div id="dtab-messages" class="dtab-panel" hidden>
          <div id="message-thread" class="message-thread"></div>
          <form id="msg-form" class="msg-form">
            <textarea id="msg-body" class="msg-textarea" rows="3" placeholder="Write a message to the player's family…"></textarea>
            <div class="msg-form-footer">
              <span id="msg-send-error" class="error-msg" hidden></span>
              <button type="submit" id="msg-send-btn" class="btn-green btn-sm">Send Message →</button>
            </div>
          </form>
        </div>

      </div><!-- /detail-panel -->
    </div><!-- /detail-col -->
  </div><!-- /coach-body -->

  <!-- Sessions panel -->
  <div id="sessions-panel" class="sessions-panel" hidden>
    <div class="sess-filters">
      <div class="sess-filter-row">
        <div id="sess-age-filters" class="sess-age-btns">
          <button class="sess-age-btn sess-age-btn--active" data-age="">All Groups</button>
          <button class="sess-age-btn" data-age="u5-u7">MiniRoos 5–7</button>
          <button class="sess-age-btn" data-age="u8-u11">MiniRoos 8–11</button>
          <button class="sess-age-btn" data-age="u12-u13">Youth U12–U13</button>
          <button class="sess-age-btn" data-age="u14-u16">Youth U14–U16</button>
          <button class="sess-age-btn" data-age="senior">Senior</button>
        </div>
        <input id="sess-search" type="search" placeholder="Search sessions…" class="sess-search">
      </div>
      <div class="sess-filter-row sess-filter-row--meta">
        <select id="sess-theme-filter" class="sess-theme-select"><option value="">All Themes</option></select>
        <span id="sess-count" class="sess-count"></span>
      </div>
    </div>
    <div id="sess-loading" class="sess-state">Loading sessions…</div>
    <div id="sess-empty" class="sess-state" hidden>No sessions match your filters.</div>
    <div id="sess-grid" class="sess-grid" hidden></div>
  </div>

</div><!-- /view-dashboard -->

<style is:global>
[hidden] { display: none !important; }

:root {
  --bg: #f8f9fa;
  --surface: #ffffff;
  --card: #f1f3f5;
  --border: #dee2e6;
  --text: #1a1d23;
  --muted: #6c757d;
  --green: #1d7a3a;
  --green-light: #e8f5ee;
  --green-accent: #25a04c;
  --amber: #b45309;
  --amber-light: #fef3c7;
  --red: #dc2626;
  --red-light: #fee2e2;
  --font-body: 'Barlow', sans-serif;
  --font-cond: 'Barlow Condensed', sans-serif;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body { background: var(--bg); color: var(--text); font-family: var(--font-body); font-size: 15px; }

/* Login */
.login-hero { background: linear-gradient(135deg, #1d3a28 0%, #0f2018 100%); padding: 60px 24px; text-align: center; }
.login-label { font-family: var(--font-cond); font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase; color: #6db38a; }
.login-title { font-family: var(--font-cond); font-size: 40px; font-weight: 800; color: #fff; margin-top: 8px; }
.login-sub { color: rgba(255,255,255,0.5); font-size: 14px; margin-top: 8px; }
.login-outer { display: flex; justify-content: center; padding: 32px 24px 48px; }
.login-card { width: 100%; max-width: 420px; background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 28px; display: flex; flex-direction: column; gap: 16px; }
.demo-info-banner { display:flex; gap:12px; align-items:flex-start; background:rgba(59,130,246,0.1); border:1px solid rgba(59,130,246,0.3); border-radius:8px; padding:12px 14px; font-size:13px; line-height:1.8; color:#93c5fd; }
.demo-info-banner strong { display:block; color:#bfdbfe; margin-bottom:4px; }
.demo-cred { display:block; font-family:monospace; font-size:12px; color:#bfdbfe; }
.demo-cred-label { display:inline-block; width:60px; font-family:sans-serif; text-transform:uppercase; font-size:10px; letter-spacing:1px; color:#7ca8d4; }
.field-group { display: flex; flex-direction: column; gap: 6px; }
.field-group label { font-size: 13px; font-weight: 600; color: var(--text); }
.field-group input { padding: 10px 12px; border: 1px solid var(--border); border-radius: 6px; font-size: 14px; background: var(--bg); color: var(--text); }
.field-group input:focus { outline: none; border-color: var(--green-accent); }
.login-note { font-size: 12px; color: var(--muted); text-align: center; }

/* Topbar */
.topbar { background: var(--surface); border-bottom: 3px solid var(--green); position: sticky; top: 0; z-index: 100; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
.topbar-inner { max-width: 1400px; margin: 0 auto; padding: 12px 24px; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
.brand-label { font-family: var(--font-cond); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); display: block; }
.brand-title { font-family: var(--font-cond); font-size: 18px; font-weight: 800; color: var(--text); }
.topbar-actions { display: flex; align-items: center; gap: 10px; }
.coach-badge { background: var(--green-light); color: var(--green); border-radius: 20px; padding: 5px 14px; font-family: var(--font-cond); font-size: 13px; font-weight: 700; letter-spacing: 0.04em; }

/* Two-pane layout */
.coach-body { display: grid; grid-template-columns: 300px 1fr; height: calc(100vh - 67px); }
.roster-col { border-right: 1px solid var(--border); display: flex; flex-direction: column; overflow: hidden; background: var(--surface); }
.detail-col { overflow-y: auto; background: var(--bg); }

/* Roster */
.roster-header { padding: 12px; border-bottom: 1px solid var(--border); display: flex; flex-direction: column; gap: 8px; }
.search-input { width: 100%; padding: 8px 12px; border: 1px solid var(--border); border-radius: 6px; font-size: 14px; background: var(--bg); }
.search-input:focus { outline: none; border-color: var(--green-accent); }
.player-count { font-size: 12px; color: var(--muted); font-family: var(--font-cond); }
.player-list { flex: 1; overflow-y: auto; }

/* Group headers */
.group-header { padding: 8px 12px 4px; font-family: var(--font-cond); font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); background: var(--card); border-bottom: 1px solid var(--border); position: sticky; top: 0; z-index: 1; }

/* Player cards in roster */
.player-row {
  display: flex; align-items: center; gap: 10px; padding: 10px 12px;
  border-bottom: 1px solid var(--border); cursor: pointer; background: var(--surface);
  border-left: 3px solid transparent; transition: background 0.15s;
}
.player-row:hover { background: var(--card); }
.player-row.selected { background: var(--green-light); border-left-color: var(--green-accent); }
.pr-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
.pr-dot--unread { background: var(--amber); }
.pr-dot--empty { background: transparent; }
.pr-info { flex: 1; min-width: 0; }
.pr-name { font-weight: 600; font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.pr-meta { font-size: 12px; color: var(--muted); margin-top: 1px; }
.tier-chip { font-family: var(--font-cond); font-size: 10px; font-weight: 700; padding: 2px 7px; border-radius: 10px; letter-spacing: 0.05em; white-space: nowrap; }
.tier-bronze { background: rgba(180,80,20,0.12); color: #b44a14; }
.tier-silver { background: rgba(80,100,150,0.12); color: #5070a0; }
.tier-gold   { background: rgba(160,120,20,0.15); color: #9a7010; }
.tier-elite  { background: rgba(0,60,140,0.12); color: #0040a0; }
.tier-unrated { background: var(--card); color: var(--muted); }

/* Detail header */
.detail-header { display: flex; justify-content: space-between; align-items: flex-start; padding: 20px 24px 0; }
.detail-name { font-family: var(--font-cond); font-size: 26px; font-weight: 800; color: var(--text); }
.detail-chips { display: flex; gap: 6px; margin-top: 6px; flex-wrap: wrap; }
.chip { font-family: var(--font-cond); font-size: 12px; font-weight: 700; padding: 3px 10px; border-radius: 20px; letter-spacing: 0.04em; }
.chip--blue  { background: #dbeafe; color: #1d4ed8; }
.chip--green { background: var(--green-light); color: var(--green); }
.chip--gray  { background: var(--card); color: var(--muted); }
.plans-link { font-family: var(--font-cond); font-size: 13px; font-weight: 700; color: var(--green-accent); text-decoration: none; border: 1px solid var(--green-accent); padding: 6px 14px; border-radius: 6px; white-space: nowrap; margin-top: 2px; }
.plans-link:hover { background: var(--green-light); }

/* Detail tabs */
.detail-tabs { display: flex; border-bottom: 2px solid var(--border); margin: 16px 24px 0; gap: 2px; }
.dtab { padding: 10px 16px; font-family: var(--font-cond); font-size: 13px; font-weight: 700; letter-spacing: 0.05em; background: none; border: none; color: var(--muted); cursor: pointer; border-bottom: 2px solid transparent; margin-bottom: -2px; display: flex; align-items: center; gap: 6px; transition: color 0.2s; }
.dtab:hover { color: var(--text); }
.dtab--active { color: var(--green); border-bottom-color: var(--green); }
.msg-badge { background: var(--green-accent); color: #fff; border-radius: 10px; padding: 1px 6px; font-size: 11px; font-family: var(--font-cond); font-weight: 700; }
.dtab-panel { padding: 20px 24px; }

/* Assessment layout */
.assess-layout { display: grid; grid-template-columns: 180px 1fr; gap: 24px; align-items: start; }
.card-preview-col { display: flex; flex-direction: column; align-items: center; gap: 8px; }
.preview-label { font-size: 11px; font-family: var(--font-cond); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }

/* Assessment guide */
.assess-guide-bar { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 10px; }
.assess-guide-note { font-size: 11px; color: var(--muted); font-style: italic; line-height: 1.3; }
.guide-toggle-btn { background: none; border: 1px solid var(--green); color: var(--green); border-radius: 6px; font-family: var(--font-cond); font-size: 12px; font-weight: 700; padding: 4px 10px; cursor: pointer; white-space: nowrap; flex-shrink: 0; transition: background 0.15s; }
.guide-toggle-btn:hover { background: #e6f9f3; }
.assess-guide { background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 10px; padding: 14px; margin-bottom: 14px; }
.assess-guide[hidden] { display: none !important; }
.ag-item { padding: 10px 0; border-bottom: 1px solid #d1fae5; }
.ag-item:last-child { border-bottom: none; padding-bottom: 0; }
.ag-item-hdr { display: flex; align-items: center; gap: 6px; margin-bottom: 4px; }
.ag-icon { font-size: 16px; }
.ag-label { font-family: var(--font-cond); font-size: 14px; font-weight: 700; color: #065f46; }
.ag-test { font-size: 12px; color: #374151; margin: 2px 0; line-height: 1.4; }
.ag-equip { font-size: 11px; color: #6b7280; margin: 0 0 6px; }
.ag-bmarks { display: flex; flex-wrap: wrap; gap: 4px 8px; }
.ag-bmark-row { display: flex; gap: 4px; align-items: center; font-size: 11px; background: #fff; border: 1px solid #bbf7d0; border-radius: 4px; padding: 2px 7px; }
.ag-score { font-family: var(--font-cond); font-weight: 700; color: #059669; }
.ag-target { color: #374151; }

/* Sliders */
.sliders-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 16px; margin-bottom: 16px; }
.slider-field { display: flex; flex-direction: column; gap: 4px; }
.slider-label { display: flex; justify-content: space-between; align-items: center; }
.slider-label-text { font-family: var(--font-cond); font-size: 13px; font-weight: 700; letter-spacing: 0.06em; color: var(--text); }
.slider-val-chip { font-family: var(--font-cond); font-size: 12px; font-weight: 700; padding: 2px 8px; border-radius: 10px; }
.chip-green  { background: #dcfce7; color: #166534; }
.chip-amber  { background: #fef3c7; color: #92400e; }
.chip-red    { background: #fee2e2; color: #991b1b; }
input[type=range] { width: 100%; height: 6px; accent-color: var(--green-accent); cursor: pointer; }
input[type=range]::-webkit-slider-thumb { width: 22px; height: 22px; }

/* Save banner */
.save-banner { display: none; background: var(--green); color: #fff; border-radius: 6px; padding: 10px 14px; font-family: var(--font-cond); font-size: 13px; font-weight: 700; margin-bottom: 12px; }
.save-banner.visible { display: flex; align-items: center; gap: 8px; }

/* Notes */
.notes-field { margin-bottom: 12px; }
.notes-label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px; }
.notes-textarea { width: 100%; padding: 10px; border: 1px solid var(--border); border-radius: 6px; font-size: 14px; font-family: var(--font-body); resize: vertical; }
.notes-textarea:focus { outline: none; border-color: var(--green-accent); }

/* History */
.hist-entry { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 14px 16px; margin-bottom: 12px; }
.hist-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
.hist-date { font-size: 13px; color: var(--muted); font-family: var(--font-cond); }
.hist-bars { display: grid; grid-template-columns: repeat(6,1fr); gap: 6px; }
.hb-item { display: flex; flex-direction: column; align-items: center; gap: 3px; }
.hb-track { width: 100%; height: 4px; background: var(--card); border-radius: 2px; overflow: hidden; }
.hb-fill  { height: 100%; background: var(--green-accent); border-radius: 2px; }
.hb-label { font-size: 9px; font-family: var(--font-cond); color: var(--muted); }
.hb-val   { font-size: 11px; font-family: var(--font-cond); font-weight: 700; }
.hist-notes { margin-top: 10px; font-size: 13px; color: var(--muted); font-style: italic; border-top: 1px solid var(--border); padding-top: 8px; }
.hist-empty { color: var(--muted); font-style: italic; padding: 16px 0; }

/* Messages */
.message-thread { max-height: 350px; overflow-y: auto; display: flex; flex-direction: column; gap: 10px; padding: 12px; background: var(--card); border-radius: 10px; margin-bottom: 12px; }
.msg-bubble { max-width: 80%; }
.msg--parent { align-self: flex-end; }
.msg--coach  { align-self: flex-start; }
.msg-body { padding: 9px 13px; border-radius: 10px; font-size: 14px; line-height: 1.5; white-space: pre-wrap; }
.msg--parent .msg-body { background: #dcfce7; border: 1px solid #a7f3d0; }
.msg--coach  .msg-body { background: var(--surface); border: 1px solid var(--border); }
.msg-meta { font-size: 11px; color: var(--muted); font-family: var(--font-cond); margin-top: 3px; }
.msg--parent .msg-meta { text-align: right; }
.msg-empty { color: var(--muted); font-style: italic; text-align: center; padding: 20px 0; }
.msg-form { display: flex; flex-direction: column; gap: 8px; }
.msg-textarea { width: 100%; padding: 10px; border: 1px solid var(--border); border-radius: 6px; font-size: 14px; font-family: var(--font-body); resize: vertical; }
.msg-textarea:focus { outline: none; border-color: var(--green-accent); }
.msg-form-footer { display: flex; justify-content: space-between; align-items: center; }

/* Buttons */
.btn-green { background: var(--green); color: #fff; border: none; border-radius: 8px; padding: 12px 20px; font-family: var(--font-cond); font-size: 14px; font-weight: 800; letter-spacing: 0.04em; cursor: pointer; }
.btn-green:hover { background: var(--green-accent); }
.btn-green:disabled { opacity: 0.5; cursor: not-allowed; }
.btn-sm { padding: 8px 16px; font-size: 13px; }
.btn-save { width: 100%; }
.btn-outline-green { background: none; border: 1px solid var(--green-accent); color: var(--green-accent); border-radius: 6px; padding: 7px 14px; font-family: var(--font-cond); font-size: 13px; font-weight: 700; text-decoration: none; cursor: pointer; }
.btn-outline-green:hover { background: var(--green-light); }
.topbar-view-btn { background: none; border: 1px solid var(--border); color: var(--muted); border-radius: 6px; padding: 6px 14px; font-family: var(--font-cond); font-size: 13px; font-weight: 700; cursor: pointer; transition: background 0.15s, color 0.15s, border-color 0.15s; }
.topbar-view-btn--active { background: var(--green-accent); border-color: var(--green-accent); color: #fff; }
.topbar-view-btn:not(.topbar-view-btn--active):hover { border-color: var(--green-accent); color: var(--green-accent); }

/* Sessions panel */
.sessions-panel { padding: 0 24px 48px; max-width: 1200px; margin: 0 auto; }
.sess-filters { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 16px; margin-bottom: 20px; display: flex; flex-direction: column; gap: 10px; }
.sess-filter-row { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
.sess-filter-row--meta { justify-content: space-between; }
.sess-age-btns { display: flex; gap: 6px; flex-wrap: wrap; }
.sess-age-btn { padding: 5px 12px; border: 1px solid var(--border); background: var(--surface); color: var(--muted); border-radius: 20px; font-family: var(--font-cond); font-size: 12px; font-weight: 700; cursor: pointer; transition: all 0.15s; }
.sess-age-btn--active { background: var(--green-accent); border-color: var(--green-accent); color: #fff; }
.sess-age-btn:not(.sess-age-btn--active):hover { border-color: var(--green-accent); color: var(--green-accent); }
.sess-search { flex: 1; min-width: 160px; border: 1px solid var(--border); border-radius: 6px; padding: 7px 12px; font-size: 13px; color: var(--text); background: var(--bg); }
.sess-theme-select { border: 1px solid var(--border); border-radius: 6px; padding: 7px 12px; font-size: 13px; color: var(--text); background: var(--bg); }
.sess-count { font-size: 12px; color: var(--muted); font-family: var(--font-cond); font-weight: 700; }
.sess-state { padding: 60px; text-align: center; color: var(--muted); font-size: 14px; }
.sess-group { margin-bottom: 28px; }
.sess-group-heading { font-family: var(--font-cond); font-size: 14px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); margin: 0 0 12px; }
.sess-group-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; }
.sess-card { display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--border); border-radius: 10px; overflow: hidden; text-decoration: none; color: inherit; transition: box-shadow 0.15s, transform 0.15s; }
.sess-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.1); transform: translateY(-1px); }
.sess-card-theme { padding: 6px 12px; font-family: var(--font-cond); font-size: 11px; font-weight: 700; letter-spacing: 0.06em; color: #fff; text-transform: uppercase; }
.sess-card-body { padding: 12px; flex: 1; }
.sess-card-title { font-family: var(--font-cond); font-size: 15px; font-weight: 700; color: var(--text); margin: 0 0 6px; line-height: 1.3; }
.sess-card-meta { display: flex; gap: 10px; font-size: 12px; color: var(--muted); margin-bottom: 6px; }
.sess-card-obj { font-size: 12px; color: var(--muted); margin: 0; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.sess-card-foot { padding: 8px 12px; font-family: var(--font-cond); font-size: 12px; font-weight: 700; color: var(--green-accent); border-top: 1px solid var(--border); }
.btn-ghost { background: none; border: none; color: var(--muted); font-family: var(--font-cond); font-size: 13px; font-weight: 700; cursor: pointer; padding: 6px 10px; }
.btn-ghost:hover { color: var(--text); }

/* Misc */
.error-msg { color: var(--red); font-size: 13px; }
.full-loading { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 60vh; gap: 16px; color: var(--muted); }
.detail-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 60vh; gap: 16px; color: var(--muted); text-align: center; padding: 40px; }
.empty-icon { font-size: 48px; }
.spinner { width: 32px; height: 32px; border: 3px solid var(--border); border-top-color: var(--green-accent); border-radius: 50%; animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

/* FIFA card styles */
.fifa-card { width: 160px; border-radius: 12px; padding: 14px 12px 12px; position: relative; filter: drop-shadow(0 8px 24px rgba(0,0,0,0.3)); }
.card-bronze { background: linear-gradient(145deg, #3d2008 0%, #7c4010 40%, #b86020 100%); }
.card-silver { background: linear-gradient(145deg, #1a1f2e 0%, #3a4060 40%, #6070a0 100%); }
.card-gold   { background: linear-gradient(145deg, #2a1f00 0%, #7a5800 40%, #c09020 100%); }
.card-elite  { background: linear-gradient(145deg, #001a2e 0%, #003060 40%, #0060b0 100%); }
.fc-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 6px; }
.fc-overall { font-size: 32px; font-weight: 900; color: #fff; line-height: 1; font-family: var(--font-cond); }
.fc-pos   { font-size: 10px; color: rgba(255,255,255,0.7); font-family: var(--font-cond); font-weight: 700; }
.fc-tier  { font-size: 9px; color: rgba(255,255,255,0.5); font-family: var(--font-cond); text-transform: uppercase; }
.fc-photo { display: flex; justify-content: center; margin: 6px 0; }
.fc-photo-img { width: 60px; height: 60px; border-radius: 50%; object-fit: cover; border: 2px solid rgba(255,255,255,0.3); }
.fc-name  { text-align: center; font-size: 11px; font-weight: 800; color: #fff; font-family: var(--font-cond); letter-spacing: 0.06em; margin: 4px 0 2px; }
.fc-age   { text-align: center; font-size: 8px; color: rgba(255,255,255,0.5); font-family: var(--font-cond); margin-bottom: 8px; }
.fc-stats { display: grid; grid-template-columns: repeat(3,1fr); gap: 3px 6px; }
.fc-stat  { display: flex; flex-direction: column; align-items: center; }
.fc-sv    { font-size: 12px; font-weight: 800; color: #fff; font-family: var(--font-cond); line-height: 1; }
.fc-sl    { font-size: 7px; color: rgba(255,255,255,0.6); font-family: var(--font-cond); }

/* Responsive */
@media (max-width: 1024px) {
  .assess-layout { grid-template-columns: 1fr; }
  .card-preview-col { flex-direction: row; align-items: center; gap: 16px; }
}
@media (max-width: 900px) {
  .coach-body { grid-template-columns: 1fr; height: auto; }
  .roster-col { max-height: 300px; border-right: none; border-bottom: 1px solid var(--border); }
}
@media (max-width: 600px) {
  .sliders-grid { grid-template-columns: 1fr; }
}
</style>

<script define:vars={{ clubShortName: CLUB.shortName, clubAbbr: CLUB.abbreviation }}></script>
<script is:inline>
const DURL = import.meta.env.PUBLIC_DIRECTUS_URL || 'https://directus-production-ebbb.up.railway.app';

// ── asArray helper — prevents all API bugs ──
function asArray(v) { return Array.isArray(v) ? v : []; }

// ── Auth — sessionStorage ──
const CLS = {
  get token()   { return sessionStorage.getItem('warriors_coach_token'); },
  get refresh() { return sessionStorage.getItem('warriors_coach_refresh'); },
  get user()    { try { return JSON.parse(sessionStorage.getItem('warriors_coach_user')||'null'); } catch { return null; } },
  set token(v)  { sessionStorage.setItem('warriors_coach_token', v); },
  set refresh(v){ sessionStorage.setItem('warriors_coach_refresh', v); },
  set user(v)   { sessionStorage.setItem('warriors_coach_user', JSON.stringify(v)); },
  clear()       { ['warriors_coach_token','warriors_coach_refresh','warriors_coach_user'].forEach(k => sessionStorage.removeItem(k)); },
};

// ── State ──
let allPlayers = [];
let assessMap  = {};
let unreadSet  = new Set();
let selectedIdx = -1;
let selectedPlayer = null;
let selectedPlayerMessages = [];

// ── AGE_SCALE / stat math ──
const AGE_SCALE = {
  'u8-u9':   { min: 30, max: 72 },
  'u10-u11': { min: 35, max: 78 },
  'u12-u13': { min: 40, max: 83 },
  'u14-u16': { min: 45, max: 90 },
};
function normalize(raw, ag) {
  const s = AGE_SCALE[ag] || AGE_SCALE['u12-u13'];
  return Math.round(s.min + (raw - 1) * (s.max - s.min) / 9);
}
function calcOverall(attrs, position) {
  const { pac, sho, pas, dri, def, phy } = attrs;
  const isAtk = ['forward','midfielder'].includes(position);
  return isAtk ? Math.round((dri*2+sho*2+pac+pas+phy)/7)
               : Math.round((def*2+phy*2+pac+pas+dri)/7);
}
function tierInfo(ov) {
  if (ov >= 90) return { name: 'Elite',  cls: 'card-elite'  };
  if (ov >= 75) return { name: 'Gold',   cls: 'card-gold'   };
  if (ov >= 60) return { name: 'Silver', cls: 'card-silver' };
  return              { name: 'Bronze', cls: 'card-bronze' };
}
function posLabel(p) {
  return { goalkeeper: 'GK', defender: 'CB', midfielder: 'MID', forward: 'FWD' }[p] || 'MID';
}

// ── FIFA card builder ──
function buildFIFACard(enrollment, profile, rawAttrs) {
  const ag  = enrollment?.age_group || 'u12-u13';
  const pos = profile?.position || 'midfielder';
  const fn  = enrollment?.player_first_name || '';
  const ln  = enrollment?.player_last_name  || '';
  const name = `${fn} ${(ln[0]||'')}.`.trim();
  const agLbl = {'u8-u9':'U9','u10-u11':'U11','u12-u13':'U13','u14-u16':'U16'}[ag] || ag.toUpperCase();
  const photoSrc = profile?.photo ? `${DURL}/assets/${profile.photo}?width=160&height=160&format=webp&fit=cover` : null;
  const photoHtml = photoSrc
    ? `<img src="${photoSrc}" class="fc-photo-img" alt="${fn}">`
    : `<svg viewBox="0 0 80 100" width="60" height="75" fill="none"><circle cx="40" cy="26" r="18" fill="rgba(255,255,255,0.2)"/><path d="M8 95 C8 65 20 54 40 52 C60 54 72 65 72 95" fill="rgba(255,255,255,0.2)"/></svg>`;

  if (!rawAttrs || rawAttrs.pace == null) {
    return `<div class="fifa-card card-bronze">
      <div class="fc-header"><div><div class="fc-overall">—</div><div class="fc-pos">${posLabel(pos)}</div><div class="fc-tier">Unrated</div></div></div>
      <div class="fc-photo">${photoHtml}</div>
      <div class="fc-name">${name.toUpperCase()}</div>
      <div class="fc-age">${agLbl} · ${clubShortName}</div>
    </div>`;
  }

  const attrs = {
    pac: normalize(rawAttrs.pace,      ag),
    sho: normalize(rawAttrs.shooting,  ag),
    pas: normalize(rawAttrs.passing,   ag),
    dri: normalize(rawAttrs.dribbling, ag),
    def: normalize(rawAttrs.defending, ag),
    phy: normalize(rawAttrs.physical,  ag),
  };
  const ov   = calcOverall(attrs, pos);
  const tier = tierInfo(ov);

  return `<div class="fifa-card ${tier.cls}">
    <div class="fc-header">
      <div><div class="fc-overall">${ov}</div><div class="fc-pos">${posLabel(pos)}</div><div class="fc-tier">${tier.name}</div></div>
      <svg viewBox="0 0 40 40" width="24" height="24" fill="none"><polygon points="20,3 37,12 37,28 20,37 3,28 3,12" fill="rgba(255,255,255,0.12)" stroke="rgba(255,255,255,0.25)" stroke-width="1.5"/><text x="20" y="26" text-anchor="middle" font-size="13" font-weight="bold" fill="rgba(255,255,255,0.7)" font-family="Arial">W</text></svg>
    </div>
    <div class="fc-photo">${photoHtml}</div>
    <div class="fc-name">${name.toUpperCase()}</div>
    <div class="fc-age">${agLbl} · ${clubShortName}</div>
    <div class="fc-stats">
      ${[['PAC',attrs.pac],['SHO',attrs.sho],['PAS',attrs.pas],['DRI',attrs.dri],['DEF',attrs.def],['PHY',attrs.phy]].map(([l,v])=>`<div class="fc-stat"><span class="fc-sv">${v}</span><span class="fc-sl">${l}</span></div>`).join('')}
    </div>
  </div>`;
}

// ── API helper ──
async function capi(path, opts = {}, token = CLS.token) {
  try {
    const headers = { 'Content-Type': 'application/json' };
    if (token) headers['Authorization'] = `Bearer ${token}`;
    const res = await fetch(`${DURL}${path}`, { ...opts, headers: { ...headers, ...(opts.headers||{}) } });
    if (res.status === 401) {
      const ok = await tryRefresh();
      if (ok) return capi(path, opts, CLS.token);
      showLogin(); return null;
    }
    if (res.status === 204) return { ok: true };
    if (!res.ok) return null;
    const json = await res.json();
    return json.data ?? json;
  } catch(e) { console.error('capi error', path, e); return null; }
}

// ── Token refresh ──
async function tryRefresh() {
  if (!CLS.refresh) return false;
  try {
    const res = await fetch(`${DURL}/auth/refresh`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ refresh_token: CLS.refresh, mode: 'json' }),
    });
    if (!res.ok) return false;
    const { data } = await res.json();
    CLS.token = data.access_token; CLS.refresh = data.refresh_token;
    return true;
  } catch { return false; }
}

// ── View helpers ──
function showLogin()     { CLS.clear(); document.getElementById('view-login').hidden = false; document.getElementById('view-dashboard').hidden = true; }
function showDashboard() { document.getElementById('view-login').hidden = true; document.getElementById('view-dashboard').hidden = false; }

// ── Load all players ──
async function loadAllPlayers() {
  const [profilesRaw, assessRaw, unreadRaw] = await Promise.all([
    capi('/items/academy_player_profiles?fields=id,position,photo,jersey_number,enrollment.id,enrollment.age_group,enrollment.player_first_name,enrollment.player_last_name,enrollment.parent_email,enrollment.status&limit=200'),
    capi('/items/academy_assessments?filter[is_latest][_eq]=true&limit=200&fields=player,pace_raw,shooting_raw,passing_raw,dribbling_raw,defending_raw,physical_raw,assessment_date'),
    capi('/items/academy_messages?filter[sender_role][_eq]=parent&filter[read_at][_null]=true&limit=200&fields=player'),
  ]);

  allPlayers = asArray(profilesRaw);

  assessMap = {};
  asArray(assessRaw).forEach(a => { assessMap[String(a.player)] = a; });

  unreadSet = new Set(asArray(unreadRaw).map(m => String(m.player)));

  document.getElementById('coach-loading').hidden = true;
  document.getElementById('coach-body').hidden = false;

  renderPlayerList(allPlayers);
}

// ── Render player list ──
const GROUP_ORDER  = ['u8-u9', 'u10-u11', 'u12-u13', 'u14-u16'];
const GROUP_LABELS = { 'u8-u9': 'U8/U9', 'u10-u11': 'U10/U11', 'u12-u13': 'U12/U13', 'u14-u16': 'U14/U16' };
const AG_DISPLAY   = { 'u8-u9': 'U8/U9', 'u10-u11': 'U10/U11', 'u12-u13': 'U12/U13', 'u14-u16': 'U14/U16' };

function renderPlayerList(players, searchQuery = '') {
  const list    = document.getElementById('player-list');
  const countEl = document.getElementById('player-count');

  if (!players.length) {
    list.innerHTML = '<p style="padding:16px;color:var(--muted);font-size:13px;">No players found.</p>';
    countEl.textContent = '';
    return;
  }

  countEl.textContent = `${players.length} player${players.length !== 1 ? 's' : ''}`;

  let html = '';

  if (searchQuery) {
    players.forEach((p, i) => { html += renderPlayerRow(p, i); });
  } else {
    const groups = {};
    players.forEach((p, i) => {
      const ag = p.enrollment?.age_group || 'unknown';
      if (!groups[ag]) groups[ag] = [];
      groups[ag].push({ p, i });
    });
    GROUP_ORDER.forEach(ag => {
      if (!groups[ag]?.length) return;
      html += `<div class="group-header">${GROUP_LABELS[ag] || ag.toUpperCase()}</div>`;
      groups[ag].forEach(({ p, i }) => { html += renderPlayerRow(p, i); });
    });
    if (groups['unknown']?.length) {
      html += `<div class="group-header">Other</div>`;
      groups['unknown'].forEach(({ p, i }) => { html += renderPlayerRow(p, i); });
    }
  }

  list.innerHTML = html;

  list.querySelectorAll('.player-row').forEach(el => {
    el.addEventListener('click', () => selectPlayer(parseInt(el.dataset.idx)));
  });

  if (selectedIdx >= 0) {
    list.querySelector(`.player-row[data-idx="${selectedIdx}"]`)?.classList.add('selected');
  }
}

function renderPlayerRow(p, i) {
  const enr  = p.enrollment || {};
  const name = `${enr.player_first_name || ''} ${enr.player_last_name || ''}`.trim() || 'Unknown Player';
  const ag   = enr.age_group || '';
  const pos  = { goalkeeper: 'GK', defender: 'CB', midfielder: 'MID', forward: 'FWD' }[p.position] || p.position || '';

  const assess = assessMap[String(p.id)];
  let tierHtml = `<span class="tier-chip tier-unrated">Unrated</span>`;
  if (assess) {
    const attrs = {
      pac: normalize(assess.pace_raw,      ag), sho: normalize(assess.shooting_raw,  ag),
      pas: normalize(assess.passing_raw,   ag), dri: normalize(assess.dribbling_raw, ag),
      def: normalize(assess.defending_raw, ag), phy: normalize(assess.physical_raw,  ag),
    };
    const ov  = calcOverall(attrs, p.position || 'midfielder');
    const t   = tierInfo(ov);
    const cls = t.cls.replace('card-', 'tier-');
    tierHtml = `<span class="tier-chip ${cls}">${t.name.toUpperCase()} ${ov}</span>`;
  }

  const hasUnread = unreadSet.has(String(p.id));
  const lastDate  = assess
    ? new Date(assess.assessment_date).toLocaleDateString('en-AU', { day: 'numeric', month: 'short' })
    : 'Never assessed';

  return `<div class="player-row${selectedIdx === i ? ' selected' : ''}" data-idx="${i}">
    <span class="pr-dot ${hasUnread ? 'pr-dot--unread' : 'pr-dot--empty'}"></span>
    <div class="pr-info">
      <div class="pr-name">${name}</div>
      <div class="pr-meta">${pos ? pos + ' · ' : ''}${lastDate}</div>
    </div>
    ${tierHtml}
  </div>`;
}

// ── Select player ──
async function selectPlayer(idx) {
  selectedIdx    = idx;
  selectedPlayer = allPlayers[idx];
  if (!selectedPlayer) return;

  document.querySelectorAll('.player-row').forEach(el => {
    el.classList.toggle('selected', parseInt(el.dataset.idx) === idx);
  });

  const p   = selectedPlayer;
  const enr = p.enrollment || {};
  const ag  = enr.age_group || 'u12-u13';
  const pos = p.position || 'midfielder';
  const fn  = enr.player_first_name || '';
  const ln  = enr.player_last_name  || '';

  document.getElementById('detail-empty').hidden = true;
  document.getElementById('detail-panel').hidden = false;

  document.getElementById('detail-name').textContent = `${fn} ${ln}`.trim();
  document.getElementById('detail-age-chip').textContent = AG_DISPLAY[ag] || ag.toUpperCase();
  document.getElementById('detail-pos-chip').textContent = posLabel(pos);
  const jerseyEl = document.getElementById('detail-jersey');
  jerseyEl.textContent = p.jersey_number ? `#${p.jersey_number}` : '';
  jerseyEl.hidden = !p.jersey_number;

  const plansLink = document.getElementById('detail-plans-link');
  plansLink.href = `/coaching/sessions?age=${ag}`;
  plansLink.textContent = `View ${AG_DISPLAY[ag]||ag} Session Plans ↗`;

  switchDetailTab('assessment');

  const latestFromMap = assessMap[String(p.id)];
  renderSliders(ag, latestFromMap);

  const [latestAssess, historyRaw, messagesRaw] = await Promise.all([
    capi(`/items/academy_assessments?filter[player][_eq]=${p.id}&filter[is_latest][_eq]=true&limit=1&fields=*`),
    capi(`/items/academy_assessments?filter[player][_eq]=${p.id}&sort[]=-assessment_date&limit=10&fields=*`),
    capi(`/items/academy_messages?filter[player][_eq]=${p.id}&sort[]=date_created&fields=*`),
  ]);

  const latest   = asArray(latestAssess)[0] || null;
  const history  = asArray(historyRaw);
  const messages = asArray(messagesRaw);
  selectedPlayerMessages = messages;

  if (latest) renderSliders(ag, latest);

  document.getElementById('history-content').innerHTML = renderHistory(history, ag, pos);

  renderMessages(messages);

  const unreadCount = messages.filter(m => m.sender_role === 'parent' && !m.read_at).length;
  const badge = document.getElementById('msg-badge');
  badge.textContent = unreadCount;
  badge.hidden = unreadCount === 0;
}

// ── Assessment guide data ──
const ASSESS_GUIDE = [
  {
    attr: 'pace', label: 'PAC — Pace', icon: '⚡',
    test: '20-metre sprint, standing start, 2 attempts — record best time.',
    equipment: 'Cones, stopwatch',
    benchmarks: {
      'u8-u9':   [[10,'< 4.0 s'],[8,'4.0 – 4.8 s'],[6,'4.8 – 5.6 s'],[4,'5.6 – 6.4 s'],[2,'> 6.4 s']],
      'u10-u11': [[10,'< 3.7 s'],[8,'3.7 – 4.5 s'],[6,'4.5 – 5.3 s'],[4,'5.3 – 6.1 s'],[2,'> 6.1 s']],
      'u12-u13': [[10,'< 3.4 s'],[8,'3.4 – 4.2 s'],[6,'4.2 – 5.0 s'],[4,'5.0 – 5.8 s'],[2,'> 5.8 s']],
      'u14-u16': [[10,'< 3.2 s'],[8,'3.2 – 3.9 s'],[6,'3.9 – 4.7 s'],[4,'4.7 – 5.5 s'],[2,'> 5.5 s']],
    },
  },
  {
    attr: 'shooting', label: 'SHO — Shooting', icon: '🎯',
    test: '10 shots from the penalty spot. On target = 1 pt, goal = 2 pts. Max 20 pts. Divide by 2 to get raw score (round up).',
    equipment: 'Balls, goal',
    benchmarks: { all: [[10,'18–20 pts'],[8,'14–17 pts'],[6,'10–13 pts'],[4,'5–9 pts'],[2,'0–4 pts']] },
  },
  {
    attr: 'dribbling', label: 'DRI — Dribbling', icon: '🔄',
    test: 'Slalom through 5 cones (1 m apart) and back. 2 attempts — best time. Void attempt if cone is missed.',
    equipment: '5 cones, stopwatch',
    benchmarks: {
      'u8-u9':   [[10,'< 9 s'],[8,'9–11 s'],[6,'11–14 s'],[4,'14–17 s'],[2,'> 17 s']],
      'u10-u11': [[10,'< 8 s'],[8,'8–10 s'],[6,'10–13 s'],[4,'13–16 s'],[2,'> 16 s']],
      'u12-u13': [[10,'< 7 s'],[8,'7–9 s'],[6,'9–12 s'],[4,'12–15 s'],[2,'> 15 s']],
      'u14-u16': [[10,'< 6 s'],[8,'6–8 s'],[6,'8–11 s'],[4,'11–14 s'],[2,'> 14 s']],
    },
  },
  {
    attr: 'passing', label: 'PAS — Passing', icon: '↗',
    test: '10 passes through a 1 m cone gate from distance below. Count gates hit cleanly.',
    equipment: '2 cones (gate), balls',
    benchmarks: {
      'u8-u9':   [[10,'9–10 (8 m)'],[8,'7–8'],[6,'5–6'],[4,'3–4'],[2,'0–2']],
      'u10-u11': [[10,'9–10 (12 m)'],[8,'7–8'],[6,'5–6'],[4,'3–4'],[2,'0–2']],
      'u12-u13': [[10,'9–10 (15 m)'],[8,'7–8'],[6,'5–6'],[4,'3–4'],[2,'0–2']],
      'u14-u16': [[10,'9–10 (18 m)'],[8,'7–8'],[6,'5–6'],[4,'3–4'],[2,'0–2']],
    },
  },
  {
    attr: 'defending', label: 'DEF — Defending', icon: '🛡',
    test: '5 × 1v1 scenarios. Attacker starts 5 m away, aims to reach a cone goal 10 m behind you. Score: clean stop 2 pts, delay 1 pt, beaten 0 pts. Max 10 pts = raw score 10.',
    equipment: '3 cones, partner',
    benchmarks: { all: [[10,'9–10 pts'],[8,'7–8 pts'],[6,'5–6 pts'],[4,'3–4 pts'],[2,'0–2 pts']] },
  },
  {
    attr: 'physical', label: 'PHY — Physical', icon: '💪',
    test: 'Multi-stage fitness test (beep test). Record the level reached when the player can no longer keep pace.',
    equipment: '2 cones (20 m), beep test audio',
    benchmarks: {
      'u8-u9':   [[10,'Level 6+'],[8,'Level 5'],[6,'Level 4'],[4,'Level 3'],[2,'< Level 3']],
      'u10-u11': [[10,'Level 7+'],[8,'Level 6'],[6,'Level 5'],[4,'Level 4'],[2,'< Level 4']],
      'u12-u13': [[10,'Level 8+'],[8,'Level 7'],[6,'Level 6'],[4,'Level 5'],[2,'< Level 5']],
      'u14-u16': [[10,'Level 9+'],[8,'Level 8'],[6,'Level 7'],[4,'Level 6'],[2,'< Level 6']],
    },
  },
];

function agKeyCoach(ag) {
  const s = (ag || '').toLowerCase().replace(/[\s/]/g,'-');
  if (s.includes('8') || s.includes('9')) return 'u8-u9';
  if (s.includes('10') || s.includes('11')) return 'u10-u11';
  if (s.includes('12') || s.includes('13')) return 'u12-u13';
  return 'u14-u16';
}

function renderAssessmentGuide(ag) {
  const ak = agKeyCoach(ag);
  const body = document.getElementById('assess-guide-body');
  if (!body) return;
  body.innerHTML = ASSESS_GUIDE.map(g => {
    const bmarks = g.benchmarks[ak] || g.benchmarks.all || [];
    const rows = bmarks.map(([score, target]) =>
      `<div class="ag-bmark-row"><span class="ag-score">Score ${score}</span><span class="ag-target">${target}</span></div>`
    ).join('');
    return `
<div class="ag-item">
  <div class="ag-item-hdr"><span class="ag-icon">${g.icon}</span><strong class="ag-label">${g.label}</strong></div>
  <p class="ag-test"><em>Test:</em> ${g.test}</p>
  <p class="ag-equip">Equipment: ${g.equipment}</p>
  <div class="ag-bmarks">${rows}</div>
</div>`;
  }).join('');
}

// Toggle guide visibility
document.getElementById('guide-toggle-btn').addEventListener('click', () => {
  const guide = document.getElementById('assess-guide');
  guide.hidden = !guide.hidden;
  document.getElementById('guide-toggle-btn').textContent = guide.hidden ? '📋 Assessment Guide' : '📋 Hide Guide';
});

// ── Slider rendering ──
const ATTR_LABELS = { pace: 'PAC', shooting: 'SHO', passing: 'PAS', dribbling: 'DRI', defending: 'DEF', physical: 'PHY' };
const ATTRS = ['pace','shooting','passing','dribbling','defending','physical'];

function normChipClass(v) { return v >= 65 ? 'chip-green' : v >= 50 ? 'chip-amber' : 'chip-red'; }

function renderSliders(ag, assessment) {
  const grid = document.getElementById('sliders-grid');
  grid.innerHTML = ATTRS.map(attr => {
    const rawVal  = assessment?.[`${attr}_raw`] ?? 5;
    const normVal = normalize(rawVal, ag);
    return `<div class="slider-field" data-attr="${attr}">
      <div class="slider-label">
        <span class="slider-label-text">${ATTR_LABELS[attr]}</span>
        <span class="slider-val-chip ${normChipClass(normVal)}" id="chip-${attr}">${normVal}</span>
      </div>
      <input type="range" min="1" max="10" value="${rawVal}" id="slider-${attr}"
        oninput="updateSlider('${attr}', '${ag}', this.value)">
    </div>`;
  }).join('');

  const notesEl = document.getElementById('assess-notes');
  if (notesEl) notesEl.value = assessment?.notes || '';

  // Populate assessment guide for this player's age group
  renderAssessmentGuide(ag);
  // Keep guide hidden when switching players unless coach had it open
  const guide = document.getElementById('assess-guide');
  if (guide && !guide.hidden) {
    document.getElementById('guide-toggle-btn').textContent = '📋 Hide Guide';
  }
}

function updateSlider(attr, ag, rawVal) {
  const norm = normalize(parseInt(rawVal), ag);
  const chip = document.getElementById(`chip-${attr}`);
  if (chip) { chip.textContent = norm; chip.className = `slider-val-chip ${normChipClass(norm)}`; }
  updateCardPreview();
}

function updateCardPreview() {
  const p = selectedPlayer;
  if (!p) return;
  const ag  = p.enrollment?.age_group || 'u12-u13';
  const raw = {};
  ATTRS.forEach(attr => {
    const el = document.getElementById(`slider-${attr}`);
    raw[attr] = el ? parseInt(el.value) : 5;
  });
  document.getElementById('card-preview').innerHTML = buildFIFACard(p.enrollment, p, raw);
}

// ── History rendering ──
function renderHistory(history, ag, position) {
  if (!history.length) return `<p class="hist-empty">No previous assessments. Fill in the sliders above and save to create the first one.</p>`;
  return history.map(a => {
    const attrs = {
      pac: normalize(a.pace_raw,ag),      sho: normalize(a.shooting_raw,ag),
      pas: normalize(a.passing_raw,ag),   dri: normalize(a.dribbling_raw,ag),
      def: normalize(a.defending_raw,ag), phy: normalize(a.physical_raw,ag),
    };
    const ov      = calcOverall(attrs, position);
    const t       = tierInfo(ov);
    const tierCls = t.cls.replace('card-','tier-');
    const date    = new Date(a.assessment_date).toLocaleDateString('en-AU', { day:'numeric', month:'short', year:'numeric' });
    const barEntries = [['PAC',attrs.pac],['SHO',attrs.sho],['PAS',attrs.pas],['DRI',attrs.dri],['DEF',attrs.def],['PHY',attrs.phy]];
    return `<div class="hist-entry">
      <div class="hist-header">
        <span class="hist-date">${date}${a.assessed_by ? ` · ${a.assessed_by}` : ''}</span>
        <span class="tier-chip ${tierCls}">${t.name.toUpperCase()} ${ov}</span>
      </div>
      <div class="hist-bars">
        ${barEntries.map(([l,v])=>`<div class="hb-item">
          <div class="hb-val">${v}</div>
          <div class="hb-track"><div class="hb-fill" style="width:${v}%"></div></div>
          <div class="hb-label">${l}</div>
        </div>`).join('')}
      </div>
      ${a.notes ? `<div class="hist-notes">"${a.notes}"</div>` : ''}
    </div>`;
  }).join('');
}

// ── Messages rendering ──
function renderMessages(messages) {
  const thread = document.getElementById('message-thread');
  if (!messages.length) {
    thread.innerHTML = `<p class="msg-empty">No messages yet. Send a message to the player's family below.</p>`;
  } else {
    thread.innerHTML = messages.map(m => {
      const isCoach = m.sender_role === 'coach';
      const date    = new Date(m.date_created).toLocaleDateString('en-AU', { day:'numeric', month:'short' });
      return `<div class="msg-bubble msg--${isCoach ? 'coach' : 'parent'}">
        <div class="msg-body">${m.body}</div>
        <div class="msg-meta">${m.sender_name || (isCoach ? 'Coach' : 'Parent')} · ${date}</div>
      </div>`;
    }).join('');
    setTimeout(() => { thread.scrollTop = thread.scrollHeight; }, 50);
  }

  const form    = document.getElementById('msg-form');
  const newForm = form.cloneNode(true);
  form.parentNode.replaceChild(newForm, form);

  newForm.addEventListener('submit', async e => {
    e.preventDefault();
    const ta    = newForm.querySelector('#msg-body');
    const btn   = newForm.querySelector('#msg-send-btn');
    const errEl = newForm.querySelector('#msg-send-error');
    const body  = ta.value.trim();
    if (!body) return;

    btn.disabled = true; btn.textContent = 'Sending…';

    const coach      = CLS.user;
    const senderName = `${coach?.first_name||''} ${coach?.last_name||''}`.trim() || 'Coach';

    const result = await capi('/items/academy_messages', {
      method: 'POST',
      body: JSON.stringify({ player: selectedPlayer.id, sender_role: 'coach', sender_name: senderName, body }),
    });

    if (result) {
      ta.value = '';
      const freshMsgs = await capi(`/items/academy_messages?filter[player][_eq]=${selectedPlayer.id}&sort[]=date_created&fields=*`);
      selectedPlayerMessages = asArray(freshMsgs);
      renderMessages(selectedPlayerMessages);
      const badge = document.getElementById('msg-badge');
      if (badge) badge.hidden = true;
    } else {
      errEl.hidden = false;
      errEl.textContent = 'Failed to send. Please try again.';
      setTimeout(() => { errEl.hidden = true; }, 4000);
    }

    btn.disabled = false; btn.textContent = 'Send Message →';
  });
}

// ── Tab switching ──
function switchDetailTab(name) {
  document.querySelectorAll('.dtab').forEach(b => b.classList.toggle('dtab--active', b.dataset.tab === name));
  document.querySelectorAll('.dtab-panel').forEach(p => { p.hidden = p.id !== `dtab-${name}`; });
  if (name === 'assessment') updateCardPreview();
}

document.addEventListener('click', e => {
  if (e.target.classList.contains('dtab')) switchDetailTab(e.target.dataset.tab);
});

// ── Save assessment ──
document.getElementById('save-btn').addEventListener('click', async () => {
  const p = selectedPlayer;
  if (!p) return;

  const btn   = document.getElementById('save-btn');
  const errEl = document.getElementById('assess-error');
  btn.disabled = true; btn.textContent = 'Saving…';
  errEl.hidden = true;

  const ag    = p.enrollment?.age_group || 'u12-u13';
  const coach = CLS.user;

  const payload = {
    player:            p.id,
    assessed_by:       `${coach?.first_name||''} ${coach?.last_name||''}`.trim() || 'Coach',
    assessment_date:   new Date().toISOString().split('T')[0],
    age_group_at_time: ag,
    pace_raw:      parseInt(document.getElementById('slider-pace').value),
    shooting_raw:  parseInt(document.getElementById('slider-shooting').value),
    passing_raw:   parseInt(document.getElementById('slider-passing').value),
    dribbling_raw: parseInt(document.getElementById('slider-dribbling').value),
    defending_raw: parseInt(document.getElementById('slider-defending').value),
    physical_raw:  parseInt(document.getElementById('slider-physical').value),
    notes:         document.getElementById('assess-notes').value.trim() || null,
    is_latest:     true,
  };

  // Mark existing latest as not-latest
  const existing = await capi(`/items/academy_assessments?filter[player][_eq]=${p.id}&filter[is_latest][_eq]=true&fields=id`);
  await Promise.all(asArray(existing).map(a =>
    capi(`/items/academy_assessments/${a.id}`, { method: 'PATCH', body: JSON.stringify({ is_latest: false }) })
  ));

  const result = await capi('/items/academy_assessments', { method: 'POST', body: JSON.stringify(payload) });

  if (result) {
    const banner = document.getElementById('save-banner');
    banner.textContent = '✓ Assessment saved — card updated';
    banner.classList.add('visible');
    setTimeout(() => banner.classList.remove('visible'), 3000);

    assessMap[String(p.id)] = {
      player:           p.id,
      pace_raw:         payload.pace_raw,
      shooting_raw:     payload.shooting_raw,
      passing_raw:      payload.passing_raw,
      dribbling_raw:    payload.dribbling_raw,
      defending_raw:    payload.defending_raw,
      physical_raw:     payload.physical_raw,
      assessment_date:  payload.assessment_date,
    };
    renderPlayerList(allPlayers, document.getElementById('player-search').value);

    const freshHistory = await capi(`/items/academy_assessments?filter[player][_eq]=${p.id}&sort[]=-assessment_date&limit=10&fields=*`);
    document.getElementById('history-content').innerHTML = renderHistory(asArray(freshHistory), ag, p.position || 'midfielder');
  } else {
    errEl.hidden = false;
    errEl.textContent = 'Failed to save. Please try again.';
    setTimeout(() => { errEl.hidden = true; }, 5000);
  }

  btn.disabled = false; btn.textContent = 'Save Assessment →';
});

// ── Search ──
document.getElementById('player-search').addEventListener('input', e => {
  const q        = e.target.value.toLowerCase().trim();
  const filtered = q
    ? allPlayers.filter(p => {
        const name = `${p.enrollment?.player_first_name||''} ${p.enrollment?.player_last_name||''}`.toLowerCase();
        return name.includes(q);
      })
    : allPlayers;
  renderPlayerList(filtered, q);
});

// ── Demo mode ──
const DEMO_EL    = document.getElementById('demo-mode');
const DEMO_MODE  = !!DEMO_EL;
const DEMO_TOKEN = DEMO_EL?.dataset.token || '';

// ── Login ──
document.getElementById('login-btn').addEventListener('click', async () => {
  const email    = document.getElementById('login-email').value.trim();
  const password = document.getElementById('login-password').value;
  const errEl    = document.getElementById('login-error');
  const btn      = document.getElementById('login-btn');
  if (!DEMO_MODE && (!email || !password)) return;
  btn.disabled = true; btn.textContent = 'Signing in…';
  errEl.hidden = true;

  if (DEMO_MODE) {
    CLS.token   = DEMO_TOKEN;
    CLS.refresh = '';
    const demoUser = { id: 'demo', email: 'demo@demo.com', first_name: 'Demo', last_name: 'User', role: { name: 'coach' } };
    CLS.user = demoUser;
    showDashboard();
    const badge = document.getElementById('coach-badge');
    badge.textContent = 'Demo';
    await loadAllPlayers();
    btn.disabled = false; btn.textContent = 'Sign In →';
    return;
  }

  try {
    const res = await fetch(`${DURL}/auth/login`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email, password }),
    });
    if (!res.ok) throw new Error('Invalid credentials');
    const { data } = await res.json();
    CLS.token = data.access_token; CLS.refresh = data.refresh_token;

    const userRes = await fetch(`${DURL}/users/me?fields=id,email,first_name,last_name,role.name`, {
      headers: { Authorization: `Bearer ${CLS.token}` },
    });
    if (!userRes.ok) throw new Error('Could not load user');
    const { data: user } = await userRes.json();

    const role = (user?.role?.name||'').toLowerCase();
    if (!['coach','administrator','admin','technical director','director'].some(r => role.includes(r))) {
      CLS.clear();
      throw new Error('Your account does not have coach access. Please contact the club administrator.');
    }

    CLS.user = user;
    showDashboard();

    const badge = document.getElementById('coach-badge');
    const fn = user.first_name || '';
    const li = user.last_name?.[0] || '';
    badge.textContent = `${fn}${li ? ' ' + li + '.' : ''}`;

    await loadAllPlayers();
  } catch(err) {
    errEl.textContent = err.message || 'Sign in failed. Please try again.';
    errEl.hidden = false;
  }

  btn.disabled = false; btn.textContent = 'Sign In →';
});

// ── Logout ──
document.getElementById('logout-btn').addEventListener('click', async () => {
  if (CLS.refresh) {
    await fetch(`${DURL}/auth/logout`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${CLS.token}` },
      body: JSON.stringify({ refresh_token: CLS.refresh }),
    }).catch(() => {});
  }
  showLogin();
});

// ── Init ──
async function init() {
  if (!CLS.token) { showLogin(); return; }

  const userRes = await fetch(`${DURL}/users/me?fields=id,email,first_name,last_name,role.name`, {
    headers: { Authorization: `Bearer ${CLS.token}` },
  });

  if (!userRes.ok) {
    const ok = await tryRefresh();
    if (!ok) { showLogin(); return; }
    return init();
  }

  const { data: user } = await userRes.json();
  const role = (user?.role?.name||'').toLowerCase();
  if (!['coach','administrator','admin','technical director','director'].some(r => role.includes(r))) {
    showLogin(); return;
  }

  CLS.user = user;
  showDashboard();

  const badge = document.getElementById('coach-badge');
  const fn = user.first_name || '';
  const li = user.last_name?.[0] || '';
  badge.textContent = `${fn}${li ? ' ' + li + '.' : ''}`;

  await loadAllPlayers();
}

document.addEventListener('DOMContentLoaded', init);

// ── Sessions panel ──────────────────────────────────────────
let sessionsLoaded = false;
let allSessions = [];
let sessAgeFilter = '';
let sessThemeFilter = '';
let sessSearchFilter = '';

// Map player academy age group → session age group key
function playerAgToSessionAg(ag) {
  const s = (ag || '').toLowerCase().replace(/[\s/]/g, '-');
  if (s.includes('5') || s.includes('6') || s.includes('7')) return 'u5-u7';
  if (s.includes('8') || s.includes('9') || s.includes('10') || s.includes('11')) return 'u8-u11';
  if (s.includes('12') || s.includes('13')) return 'u12-u13';
  if (s.includes('14') || s.includes('15') || s.includes('16')) return 'u14-u16';
  return '';
}

const AGE_DISPLAY = { 'u5-u7':'MiniRoos 5–7', 'u8-u11':'MiniRoos 8–11', 'u12-u13':'Youth U12–U13', 'u14-u16':'Youth U14–U16', 'senior':'Senior' };
const THEME_COLORS = {
  'Passing': '#3b82f6', 'Dribbling': '#8b5cf6', 'Shooting': '#ef4444',
  'Defending': '#f59e0b', 'Possession': '#10b981', 'Crossing & Finishing': '#f97316',
  'Set Pieces': '#06b6d4', 'Small-Sided Games': '#84cc16', 'Strength & Conditioning': '#e11d48',
  'Goalkeeping': '#64748b',
};

async function loadSessions() {
  if (sessionsLoaded) return;
  try {
    const data = asArray(await capi(
      '/items/session_plans?filter[status][_eq]=published&limit=400&sort[]=age_group&sort[]=week' +
      '&fields=id,title,slug,theme,age_group,duration,week,objectives'
    ));
    allSessions = data;
    sessionsLoaded = true;

    // Populate theme dropdown
    const themes = [...new Set(data.map(s => s.theme).filter(Boolean))].sort();
    const sel = document.getElementById('sess-theme-filter');
    themes.forEach(t => {
      const o = document.createElement('option');
      o.value = t; o.textContent = t;
      sel.appendChild(o);
    });
    renderSessions();
  } catch (err) {
    document.getElementById('sess-loading').textContent = 'Could not load sessions. Please try again.';
  }
}

function renderSessions() {
  const grid = document.getElementById('sess-grid');
  const empty = document.getElementById('sess-empty');
  const loading = document.getElementById('sess-loading');
  const count = document.getElementById('sess-count');

  const search = sessSearchFilter.toLowerCase();
  const filtered = allSessions.filter(s => {
    if (sessAgeFilter && s.age_group !== sessAgeFilter) return false;
    if (sessThemeFilter && s.theme !== sessThemeFilter) return false;
    if (search && !s.title?.toLowerCase().includes(search) && !s.objectives?.toLowerCase().includes(search) && !s.theme?.toLowerCase().includes(search)) return false;
    return true;
  });

  loading.hidden = true;
  count.textContent = `${filtered.length} session${filtered.length !== 1 ? 's' : ''}`;

  if (!filtered.length) {
    grid.hidden = true;
    empty.hidden = false;
    return;
  }
  empty.hidden = true;
  grid.hidden = false;

  // Group by age_group for display
  const groups = {};
  filtered.forEach(s => {
    const k = s.age_group || 'other';
    if (!groups[k]) groups[k] = [];
    groups[k].push(s);
  });

  const groupOrder = ['u5-u7','u8-u11','u12-u13','u14-u16','senior','other'];
  grid.innerHTML = groupOrder.filter(k => groups[k]).map(k => {
    const cards = groups[k].map(s => {
      const tc = THEME_COLORS[s.theme] || '#6b7280';
      return `<a href="/coaching/sessions/${s.slug}" target="_blank" rel="noopener" class="sess-card">
  <div class="sess-card-theme" style="background:${tc}">${s.theme || 'General'}</div>
  <div class="sess-card-body">
    <h4 class="sess-card-title">${s.title}</h4>
    <div class="sess-card-meta">
      ${s.duration ? `<span>⏱ ${s.duration} min</span>` : ''}
      <span>Week ${s.week ?? '—'}</span>
    </div>
    ${s.objectives ? `<p class="sess-card-obj">${s.objectives}</p>` : ''}
  </div>
  <div class="sess-card-foot">View Plan →</div>
</a>`;
    }).join('');
    const showHeading = !sessAgeFilter;
    return showHeading
      ? `<div class="sess-group"><h3 class="sess-group-heading">${AGE_DISPLAY[k] || k}</h3><div class="sess-group-grid">${cards}</div></div>`
      : `<div class="sess-group-grid">${cards}</div>`;
  }).join('');
}

// View toggle
document.getElementById('view-players-btn').addEventListener('click', () => {
  document.getElementById('coach-body').hidden = false;
  document.getElementById('sessions-panel').hidden = true;
  document.getElementById('view-players-btn').classList.add('topbar-view-btn--active');
  document.getElementById('view-sessions-btn').classList.remove('topbar-view-btn--active');
});

document.getElementById('view-sessions-btn').addEventListener('click', () => {
  document.getElementById('coach-body').hidden = true;
  document.getElementById('sessions-panel').hidden = false;
  document.getElementById('view-players-btn').classList.remove('topbar-view-btn--active');
  document.getElementById('view-sessions-btn').classList.add('topbar-view-btn--active');
  // Pre-filter to selected player's age group if one is selected
  if (selectedPlayer) {
    const sAg = playerAgToSessionAg(selectedPlayer.enrollment?.age_group);
    if (sAg) {
      sessAgeFilter = sAg;
      document.querySelectorAll('.sess-age-btn').forEach(b => {
        b.classList.toggle('sess-age-btn--active', b.dataset.age === sAg);
      });
    }
  }
  loadSessions();
});

// Age group filter buttons
document.getElementById('sess-age-filters').addEventListener('click', (e) => {
  const btn = e.target.closest('.sess-age-btn');
  if (!btn) return;
  sessAgeFilter = btn.dataset.age;
  document.querySelectorAll('.sess-age-btn').forEach(b => b.classList.remove('sess-age-btn--active'));
  btn.classList.add('sess-age-btn--active');
  if (sessionsLoaded) renderSessions();
});

document.getElementById('sess-theme-filter').addEventListener('change', (e) => {
  sessThemeFilter = e.target.value;
  if (sessionsLoaded) renderSessions();
});

document.getElementById('sess-search').addEventListener('input', (e) => {
  sessSearchFilter = e.target.value;
  if (sessionsLoaded) renderSessions();
});
</script>

