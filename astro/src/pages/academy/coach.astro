---
// src/pages/academy/coach.astro
// Coach / Technical Director Dashboard — Directus JWT authenticated (coach or administrator role)
import Base from '../../layouts/Base.astro';
---
<Base
  title="Academy Coach Dashboard"
  description="Warriors FC Academy coach dashboard — manage player assessments and messages."
>

  <!-- Login View -->
  <div id="view-login" class="coach-view">
    <div class="portal-hero">
      <div class="portal-hero-inner">
        <div class="label">Academy</div>
        <h1>Coach Dashboard</h1>
        <p>Sign in with your Directus coach account to manage player assessments and messages.</p>
      </div>
    </div>
    <div class="login-outer">
      <div class="login-card card">
        <h2>Coach Sign In</h2>
        <form id="coach-login-form" novalidate>
          <div class="field">
            <label for="c-email">Email</label>
            <input type="email" id="c-email" autocomplete="email" required>
          </div>
          <div class="field">
            <label for="c-password">Password</label>
            <input type="password" id="c-password" autocomplete="current-password" required>
          </div>
          <div id="c-login-error" class="form-msg form-msg--error" hidden></div>
          <button type="submit" class="btn btn-primary btn-full" id="c-login-btn">Sign In →</button>
        </form>
        <div class="login-footer">
          <p>Need access? Contact the club administrator to create a coach account in Directus.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Dashboard View -->
  <div id="view-dashboard" class="coach-view" hidden>

    <div class="dash-header">
      <div class="dash-header-inner">
        <div>
          <div class="label">Academy</div>
          <h1>Coach Dashboard</h1>
        </div>
        <div class="dash-header-actions">
          <span id="coach-name-display" class="coach-name"></span>
          <a href="/coaching/sessions" target="_blank" class="btn btn-outline-green btn-sm">Session Plans ↗</a>
          <button class="btn btn-secondary btn-sm" id="c-logout-btn">Sign Out</button>
        </div>
      </div>
    </div>

    <div class="dash-body">
      <div id="c-loading" class="dash-loading">
        <div class="spinner"></div>
        <p>Loading players…</p>
      </div>
      <div id="c-access-denied" class="dash-error" hidden>
        <p>Access denied. Your account does not have coach or administrator permissions.</p>
        <button id="c-back-login" class="btn btn-secondary" style="margin-top:16px">Back to Login</button>
      </div>
      <div id="c-content" hidden>
        <div class="coach-layout">

          <!-- Player list -->
          <aside class="player-list-col">
            <div class="list-header">
              <input type="text" id="player-search" placeholder="Search players…" class="search-input">
            </div>
            <div id="player-list" class="player-list"></div>
          </aside>

          <!-- Player detail -->
          <main class="player-detail-col">
            <div id="no-player-selected" class="no-selection">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="1.2"><circle cx="12" cy="8" r="4"/><path d="M4 20 Q4 14 12 14 Q20 14 20 20"/></svg>
              <p>Select a player from the list to view their details and leave an assessment.</p>
            </div>

            <div id="player-detail" hidden>

              <div class="detail-header">
                <div id="detail-player-info">
                  <!-- Player name, age group, last assessed -->
                </div>
                <div class="detail-card-preview" id="detail-card-preview">
                  <!-- Mini FIFA card rendered here -->
                </div>
              </div>

              <!-- Assessment Form -->
              <div class="detail-section">
                <div class="section-label">New Assessment</div>
                <form id="assessment-form">
                  <input type="hidden" id="assess-player-id">
                  <input type="hidden" id="assess-age-group">
                  <input type="hidden" id="assess-position">

                  <div class="sliders-grid">
                    <div class="slider-field" data-attr="pace">
                      <div class="slider-header">
                        <label>PAC — Pace</label>
                        <span class="slider-val" id="sv-pace">5</span>
                        <span class="slider-norm" id="sn-pace"></span>
                      </div>
                      <input type="range" min="1" max="10" value="5" id="slider-pace" class="attr-slider" data-attr="pace">
                    </div>
                    <div class="slider-field" data-attr="shooting">
                      <div class="slider-header">
                        <label>SHO — Shooting</label>
                        <span class="slider-val" id="sv-shooting">5</span>
                        <span class="slider-norm" id="sn-shooting"></span>
                      </div>
                      <input type="range" min="1" max="10" value="5" id="slider-shooting" class="attr-slider" data-attr="shooting">
                    </div>
                    <div class="slider-field" data-attr="passing">
                      <div class="slider-header">
                        <label>PAS — Passing</label>
                        <span class="slider-val" id="sv-passing">5</span>
                        <span class="slider-norm" id="sn-passing"></span>
                      </div>
                      <input type="range" min="1" max="10" value="5" id="slider-passing" class="attr-slider" data-attr="passing">
                    </div>
                    <div class="slider-field" data-attr="dribbling">
                      <div class="slider-header">
                        <label>DRI — Dribbling</label>
                        <span class="slider-val" id="sv-dribbling">5</span>
                        <span class="slider-norm" id="sn-dribbling"></span>
                      </div>
                      <input type="range" min="1" max="10" value="5" id="slider-dribbling" class="attr-slider" data-attr="dribbling">
                    </div>
                    <div class="slider-field" data-attr="defending">
                      <div class="slider-header">
                        <label>DEF — Defending</label>
                        <span class="slider-val" id="sv-defending">5</span>
                        <span class="slider-norm" id="sn-defending"></span>
                      </div>
                      <input type="range" min="1" max="10" value="5" id="slider-defending" class="attr-slider" data-attr="defending">
                    </div>
                    <div class="slider-field" data-attr="physical">
                      <div class="slider-header">
                        <label>PHY — Physical</label>
                        <span class="slider-val" id="sv-physical">5</span>
                        <span class="slider-norm" id="sn-physical"></span>
                      </div>
                      <input type="range" min="1" max="10" value="5" id="slider-physical" class="attr-slider" data-attr="physical">
                    </div>
                  </div>

                  <div class="field" style="margin-top:16px">
                    <label for="assess-notes">Coach Notes (visible to parents)</label>
                    <textarea id="assess-notes" rows="4" placeholder="Write feedback for the parent and player. What went well? What to work on at home?"></textarea>
                  </div>

                  <div class="form-actions">
                    <button type="submit" class="btn btn-primary" id="save-assess-btn">Save Assessment →</button>
                    <span id="assess-saved-msg" class="saved-msg" hidden>Assessment saved!</span>
                    <span id="assess-error-msg" class="error-msg" hidden>Failed to save. Please try again.</span>
                  </div>
                </form>
              </div>

              <!-- Assessment History -->
              <div class="detail-section">
                <div class="section-label">Assessment History</div>
                <div id="assess-history"></div>
              </div>

              <!-- Messages -->
              <div class="detail-section">
                <div class="section-label">Messages with Parent</div>
                <div id="coach-message-thread" class="message-thread"></div>
                <form id="coach-msg-form" class="message-compose">
                  <textarea id="coach-msg-input" rows="3" placeholder="Write a reply to the parent…"></textarea>
                  <button type="submit" class="btn btn-primary btn-sm" id="coach-send-btn">Send Message →</button>
                </form>
              </div>

            </div>
          </main>

        </div>
      </div>
    </div>
  </div>

</Base>

<script>
const DURL = import.meta.env.PUBLIC_DIRECTUS_URL || '';

const CLS = {
  get token()   { return sessionStorage.getItem('warriors_coach_token'); },
  get refresh() { return sessionStorage.getItem('warriors_coach_refresh'); },
  get user()    { try { return JSON.parse(sessionStorage.getItem('warriors_coach_user') || 'null'); } catch { return null; } },
  set token(v)  { sessionStorage.setItem('warriors_coach_token', v); },
  set refresh(v){ sessionStorage.setItem('warriors_coach_refresh', v); },
  set user(v)   { sessionStorage.setItem('warriors_coach_user', JSON.stringify(v)); },
  clear()       { ['warriors_coach_token','warriors_coach_refresh','warriors_coach_user'].forEach(k => sessionStorage.removeItem(k)); },
};

async function capi(path, opts = {}, token = CLS.token) {
  const headers = { 'Content-Type': 'application/json' };
  if (token) headers['Authorization'] = `Bearer ${token}`;
  const res = await fetch(`${DURL}${path}`, { ...opts, headers: { ...headers, ...(opts.headers||{}) } });
  if (res.status === 401) {
    const refreshed = await tryRefresh();
    if (refreshed) return capi(path, opts, CLS.token);
    showCoachLogin();
    return null;
  }
  if (!res.ok) return null;
  const json = await res.json();
  return json.data ?? json;
}

async function tryRefresh() {
  if (!CLS.refresh) return false;
  try {
    const res = await fetch(`${DURL}/auth/refresh`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ refresh_token: CLS.refresh, mode: 'json' }),
    });
    if (!res.ok) return false;
    const { data } = await res.json();
    CLS.token = data.access_token; CLS.refresh = data.refresh_token;
    return true;
  } catch { return false; }
}

// ── FIFA card utils (duplicated for standalone page) ──────────
const AGE_SCALE = {
  'u8-u9':   { min: 30, max: 72 },
  'u10-u11': { min: 35, max: 78 },
  'u12-u13': { min: 40, max: 83 },
  'u14-u16': { min: 45, max: 90 },
};
function normalize(raw, ag) {
  const s = AGE_SCALE[ag] || AGE_SCALE['u12-u13'];
  return Math.round(s.min + (raw - 1) * (s.max - s.min) / 9);
}
function calcOverall(attrs, position) {
  const { pac, sho, pas, dri, def, phy } = attrs;
  const isAtk = ['forward','midfielder'].includes(position);
  return isAtk ? Math.round((dri*2 + sho*2 + pac + pas + phy) / 7)
               : Math.round((def*2 + phy*2 + pac + pas + dri) / 7);
}
function cardTierClass(ov) {
  if (ov >= 90) return 'card-elite';
  if (ov >= 75) return 'card-gold';
  if (ov >= 60) return 'card-silver';
  return 'card-bronze';
}
function buildMiniCard(enrollment, profile, rawAttrs) {
  const ag  = enrollment?.age_group || 'u12-u13';
  const pos = profile?.position || 'midfielder';
  const posMap = { goalkeeper:'GK', defender:'CB', midfielder:'MID', forward:'FWD' };
  const attrs = {
    pac: normalize(rawAttrs.pace, ag),     sho: normalize(rawAttrs.shooting, ag),
    pas: normalize(rawAttrs.passing, ag),  dri: normalize(rawAttrs.dribbling, ag),
    def: normalize(rawAttrs.defending, ag),phy: normalize(rawAttrs.physical, ag),
  };
  const ov = calcOverall(attrs, pos);
  const tc = cardTierClass(ov);
  return `
<div class="mini-card ${tc}">
  <div class="mc-top"><span class="mc-ov">${ov}</span><span class="mc-pos">${posMap[pos]||'MID'}</span></div>
  <div class="mc-stats">
    ${Object.entries(attrs).map(([k,v]) => `<span><b>${k.toUpperCase()}</b>${v}</span>`).join('')}
  </div>
</div>`;
}

// ── STATE ─────────────────────────────────────────────────────
let allPlayers = []; // { profile, enrollment }
let selectedIdx = -1;

// ── VIEWS ─────────────────────────────────────────────────────
function showCoachLogin() {
  CLS.clear();
  document.getElementById('view-login').hidden = false;
  document.getElementById('view-dashboard').hidden = true;
}
function showCoachDashboard(user) {
  document.getElementById('view-login').hidden = true;
  document.getElementById('view-dashboard').hidden = false;
  document.getElementById('coach-name-display').textContent = user?.first_name || 'Coach';
}

// ── LOAD ALL PLAYERS ──────────────────────────────────────────
async function loadAllPlayers() {
  document.getElementById('c-loading').hidden = false;
  document.getElementById('c-content').hidden = true;

  // Load all enrolled profiles
  const profiles = await capi(
    `/items/academy_player_profiles?fields=id,position,photo,jersey_number,enrollment.id,enrollment.age_group,enrollment.player_first_name,enrollment.player_last_name,enrollment.parent_email&limit=200`
  );
  if (!profiles) { document.getElementById('c-loading').hidden = true; return; }

  allPlayers = profiles.map(p => ({ profile: p, enrollment: p.enrollment }));

  // Batch-fetch all latest assessments to populate player list badges
  const latestAssessments = await capi('/items/academy_assessments?filter[is_latest][_eq]=true&limit=200&fields=player,pace_raw,shooting_raw,passing_raw,dribbling_raw,defending_raw,physical_raw,assessment_date');
  const assessMap = {};
  (latestAssessments || []).forEach(a => { assessMap[String(a.player)] = a; });

  renderPlayerList(allPlayers, assessMap);
  document.getElementById('c-loading').hidden = true;
  document.getElementById('c-content').hidden = false;
}

// Stored assessMap so renderPlayerList (called on search/re-render) can reuse it
let _lastAssessMap = {};

function renderPlayerList(players, assessMap) {
  if (assessMap) _lastAssessMap = assessMap;
  const aMap = _lastAssessMap;
  const list = document.getElementById('player-list');
  if (players.length === 0) {
    list.innerHTML = '<p class="empty-list-msg">No enrolled players found.</p>';
    return;
  }
  list.innerHTML = players.map((p, i) => {
    const enr = p.enrollment || {};
    const name = `${enr.player_first_name || ''} ${enr.player_last_name || ''}`.trim();
    const ag = enr.age_group ? enr.age_group.toUpperCase().replace('-','/') : '—';
    const pos = (p.profile?.position || p.position || '').toUpperCase();
    const posShort = { GOALKEEPER:'GK', DEFENDER:'CB', MIDFIELDER:'MID', FORWARD:'FWD' }[pos] || pos || 'MID';
    const originalIdx = allPlayers.indexOf(p);
    const profileId = p.profile?.id || p.id;
    const assess = aMap[String(profileId)];
    let tierBadgeHtml = '';
    let assessedHtml = '<div class="pi-assessed">Never assessed</div>';
    if (assess) {
      const ageKey = enr.age_group || 'u12-u13';
      const posKey = p.profile?.position || p.position || 'midfielder';
      const attrs = {
        pac: normalize(assess.pace_raw, ageKey),
        sho: normalize(assess.shooting_raw, ageKey),
        pas: normalize(assess.passing_raw, ageKey),
        dri: normalize(assess.dribbling_raw, ageKey),
        def: normalize(assess.defending_raw, ageKey),
        phy: normalize(assess.physical_raw, ageKey),
      };
      const ov = calcOverall(attrs, posKey);
      const tierLabel = ov >= 90 ? 'ELITE' : ov >= 75 ? 'GOLD' : ov >= 60 ? 'SILVER' : 'BRONZE';
      const tierKey   = tierLabel.toLowerCase();
      tierBadgeHtml = `<span class="tier-badge tier-${tierKey}">${tierLabel} ${ov}</span>`;
      const d = new Date(assess.assessment_date).toLocaleDateString('en-AU', { day:'numeric', month:'short', year:'numeric' });
      assessedHtml = `<div class="pi-assessed">Last assessed: ${d}</div>`;
    }
    return `
<button class="player-item ${selectedIdx === originalIdx ? 'player-item--active' : ''}" data-idx="${originalIdx}">
  <div class="pi-name">${name}</div>
  <div class="pi-sub">${ag}${posShort ? ' · ' + posShort : ''} ${tierBadgeHtml}</div>
  ${assessedHtml}
</button>`;
  }).join('');

  list.querySelectorAll('.player-item').forEach(btn => {
    btn.addEventListener('click', () => selectPlayer(parseInt(btn.dataset.idx)));
  });
}

// ── SEARCH ────────────────────────────────────────────────────
document.getElementById('player-search').addEventListener('input', (e) => {
  const q = e.target.value.toLowerCase();
  const filtered = allPlayers.filter(p => {
    const enr = p.enrollment || {};
    const name = `${enr.player_first_name||''} ${enr.player_last_name||''}`.toLowerCase();
    return name.includes(q);
  });
  renderPlayerList(filtered);
});

// ── SELECT PLAYER ─────────────────────────────────────────────
async function selectPlayer(idx) {
  selectedIdx = idx;
  const { profile, enrollment } = allPlayers[idx];

  document.getElementById('no-player-selected').hidden = true;
  document.getElementById('player-detail').hidden = false;

  // Refresh list highlight
  renderPlayerList(allPlayers);

  const name = `${enrollment?.player_first_name||''} ${enrollment?.player_last_name||''}`.trim();
  const ag = enrollment?.age_group || 'u12-u13';

  const ageLabels = { 'u8-u11':'MiniRoos 8–11', 'u12-u13':'Youth U12–U13', 'u14-u16':'Youth U14–U16', 'u5-u7':'MiniRoos 5–7' };
  const planLink = `<a href="/coaching/sessions${ag ? '?age='+ag : ''}" target="_blank" class="session-plan-link">View ${ageLabels[ag] || ''} Session Plans ↗</a>`;

  document.getElementById('detail-player-info').innerHTML = `
<h2 class="detail-name">${name}</h2>
<div class="detail-meta">
  <span class="detail-ag">${ag.toUpperCase().replace('-','/')}</span>
  <span class="detail-pos">${(profile.position||'midfielder').toUpperCase()}</span>
  ${profile.jersey_number ? `<span class="detail-jersey">#${profile.jersey_number}</span>` : ''}
</div>
${planLink}`;

  // Set hidden fields
  document.getElementById('assess-player-id').value  = profile.id;
  document.getElementById('assess-age-group').value  = ag;
  document.getElementById('assess-position').value   = profile.position || 'midfielder';

  // Reset sliders
  document.querySelectorAll('.attr-slider').forEach(s => { s.value = 5; });
  updateAllPreviews(ag);

  // Load latest assessment to prefill sliders
  const latestData = await capi(
    `/items/academy_assessments?filter[player][_eq]=${profile.id}&filter[is_latest][_eq]=true&limit=1&fields=*`
  );
  const latest = Array.isArray(latestData) ? latestData[0] : null;
  if (latest) {
    ['pace','shooting','passing','dribbling','defending','physical'].forEach(attr => {
      const sliderKey = `${attr}_raw`;
      const slider = document.getElementById(`slider-${attr}`);
      if (slider && latest[sliderKey]) slider.value = latest[sliderKey];
    });
    if (latest.notes) document.getElementById('assess-notes').value = latest.notes;
    else document.getElementById('assess-notes').value = '';
    updateAllPreviews(ag);
    updateMiniCard();
  } else {
    document.getElementById('assess-notes').value = '';
    updateMiniCard();
  }

  // Load assessment history
  const histData = await capi(
    `/items/academy_assessments?filter[player][_eq]=${profile.id}&sort[]=-assessment_date&limit=10&fields=*`
  );
  renderAssessHistory(histData || [], ag, profile.position);

  // Load messages
  const msgData = await capi(
    `/items/academy_messages?filter[player][_eq]=${profile.id}&sort[]=date_created&fields=*`
  );
  renderMessages(msgData || []);
}

// ── SLIDER PREVIEW ────────────────────────────────────────────
function normChipClass(v) {
  if (v >= 65) return 'norm-green';
  if (v >= 50) return 'norm-amber';
  return 'norm-red';
}

function updateAllPreviews(ag) {
  ['pace','shooting','passing','dribbling','defending','physical'].forEach(attr => {
    const slider = document.getElementById(`slider-${attr}`);
    const valEl  = document.getElementById(`sv-${attr}`);
    const normEl = document.getElementById(`sn-${attr}`);
    if (!slider) return;
    const raw = parseInt(slider.value);
    const normVal = normalize(raw, ag);
    if (valEl)  valEl.textContent = raw;
    if (normEl) {
      normEl.textContent = normVal;
      normEl.className = `slider-norm ${normChipClass(normVal)}`;
    }
  });
}

function updateMiniCard() {
  const ag  = document.getElementById('assess-age-group').value;
  const pos = document.getElementById('assess-position').value;
  const enrIdx = selectedIdx;
  if (enrIdx < 0) return;
  const { enrollment, profile } = allPlayers[enrIdx];
  const rawAttrs = {
    pace:      parseInt(document.getElementById('slider-pace').value),
    shooting:  parseInt(document.getElementById('slider-shooting').value),
    passing:   parseInt(document.getElementById('slider-passing').value),
    dribbling: parseInt(document.getElementById('slider-dribbling').value),
    defending: parseInt(document.getElementById('slider-defending').value),
    physical:  parseInt(document.getElementById('slider-physical').value),
  };
  document.getElementById('detail-card-preview').innerHTML = buildMiniCard(enrollment, profile, rawAttrs);
}

document.querySelectorAll('.attr-slider').forEach(slider => {
  slider.addEventListener('input', () => {
    const ag = document.getElementById('assess-age-group').value || 'u12-u13';
    updateAllPreviews(ag);
    updateMiniCard();
  });
});

// ── HISTORY RENDER ────────────────────────────────────────────
function renderAssessHistory(assessments, ag, position) {
  const el = document.getElementById('assess-history');
  if (!assessments.length) {
    el.innerHTML = '<p class="empty-msg">No assessments on record.</p>';
    return;
  }
  el.innerHTML = assessments.map(a => {
    const attrs = {
      pac: normalize(a.pace_raw, ag), sho: normalize(a.shooting_raw, ag),
      pas: normalize(a.passing_raw, ag), dri: normalize(a.dribbling_raw, ag),
      def: normalize(a.defending_raw, ag), phy: normalize(a.physical_raw, ag),
    };
    const ov = calcOverall(attrs, position || 'midfielder');
    const tc = cardTierClass(ov);
    const d = new Date(a.assessment_date).toLocaleDateString('en-AU', { day:'numeric', month:'short', year:'numeric' });
    const isCurrent = a.is_latest;
    return `
<div class="hist-item ${isCurrent ? 'hist-item--current' : ''}">
  <div class="hist-item-top">
    <span class="hist-item-date">${d}</span>
    <span class="hist-item-ov ${tc}">${ov}</span>
    ${isCurrent ? '<span class="current-badge">Current</span>' : ''}
    <span class="hist-item-coach">by ${a.assessed_by || 'Coach'}</span>
  </div>
  ${a.notes ? `<p class="hist-item-notes">${a.notes}</p>` : ''}
</div>`;
  }).join('');
}

// ── MESSAGES RENDER ───────────────────────────────────────────
function renderMessages(messages) {
  const el = document.getElementById('coach-message-thread');
  if (!messages.length) {
    el.innerHTML = '<p class="empty-msg">No messages yet.</p>';
    return;
  }
  el.innerHTML = messages.map(m => `
<div class="msg msg--${m.sender_role}">
  <div class="msg-meta">
    <span class="msg-author">${m.sender_name || (m.sender_role === 'coach' ? 'You' : 'Parent')}</span>
    <span class="msg-date">${new Date(m.date_created).toLocaleDateString('en-AU', { day:'numeric', month:'short', year:'numeric' })}</span>
  </div>
  <div class="msg-body">${m.body.replace(/\n/g, '<br>')}</div>
</div>`).join('');
  el.scrollTop = el.scrollHeight;
}

// ── SAVE ASSESSMENT ───────────────────────────────────────────
document.getElementById('assessment-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  const saveBtn = document.getElementById('save-assess-btn');
  const savedMsg = document.getElementById('assess-saved-msg');
  const errMsg   = document.getElementById('assess-error-msg');
  savedMsg.hidden = true; errMsg.hidden = true;
  saveBtn.disabled = true; saveBtn.textContent = 'Saving…';

  const playerId = document.getElementById('assess-player-id').value;
  const ag       = document.getElementById('assess-age-group').value;
  const coach    = CLS.user;

  // Mark all existing assessments for this player as not-latest
  const existing = await capi(
    `/items/academy_assessments?filter[player][_eq]=${playerId}&filter[is_latest][_eq]=true&fields=id`
  );
  if (existing && existing.length > 0) {
    await Promise.all(existing.map(a =>
      capi(`/items/academy_assessments/${a.id}`, {
        method: 'PATCH', body: JSON.stringify({ is_latest: false }),
      })
    ));
  }

  const payload = {
    player:            playerId,
    assessed_by:       `${coach?.first_name || ''} ${coach?.last_name || ''}`.trim() || 'Coach',
    assessment_date:   new Date().toISOString().split('T')[0],
    age_group_at_time: ag,
    pace_raw:          parseInt(document.getElementById('slider-pace').value),
    shooting_raw:      parseInt(document.getElementById('slider-shooting').value),
    passing_raw:       parseInt(document.getElementById('slider-passing').value),
    dribbling_raw:     parseInt(document.getElementById('slider-dribbling').value),
    defending_raw:     parseInt(document.getElementById('slider-defending').value),
    physical_raw:      parseInt(document.getElementById('slider-physical').value),
    notes:             document.getElementById('assess-notes').value.trim() || null,
    is_latest:         true,
  };

  const result = await capi('/items/academy_assessments', { method: 'POST', body: JSON.stringify(payload) });
  if (result) {
    savedMsg.hidden = false;
    setTimeout(() => { savedMsg.hidden = true; }, 3000);
    // Reload history
    const histData = await capi(
      `/items/academy_assessments?filter[player][_eq]=${playerId}&sort[]=-assessment_date&limit=10&fields=*`
    );
    const pos = document.getElementById('assess-position').value;
    renderAssessHistory(histData || [], ag, pos);
  } else {
    errMsg.hidden = false;
  }

  saveBtn.disabled = false; saveBtn.textContent = 'Save Assessment →';
});

// ── SEND MESSAGE ──────────────────────────────────────────────
document.getElementById('coach-msg-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  const input = document.getElementById('coach-msg-input');
  const sendBtn = document.getElementById('coach-send-btn');
  const body = input.value.trim();
  if (!body || selectedIdx < 0) return;

  const { profile } = allPlayers[selectedIdx];
  const coach = CLS.user;
  sendBtn.disabled = true; sendBtn.textContent = 'Sending…';

  const payload = {
    player:      profile.id,
    sender_role: 'coach',
    sender_name: `${coach?.first_name || ''} ${coach?.last_name || ''}`.trim() || 'Technical Director',
    body,
  };

  const result = await capi('/items/academy_messages', { method: 'POST', body: JSON.stringify(payload) });
  if (result) {
    input.value = '';
    const msgData = await capi(
      `/items/academy_messages?filter[player][_eq]=${profile.id}&sort[]=date_created&fields=*`
    );
    renderMessages(msgData || []);
  }
  sendBtn.disabled = false; sendBtn.textContent = 'Send Message →';
});

// ── LOGIN ─────────────────────────────────────────────────────
document.getElementById('coach-login-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  const errEl = document.getElementById('c-login-error');
  const btn   = document.getElementById('c-login-btn');
  errEl.hidden = true; btn.disabled = true; btn.textContent = 'Signing in…';

  const email    = document.getElementById('c-email').value.trim();
  const password = document.getElementById('c-password').value;

  try {
    const res  = await fetch(`${DURL}/auth/login`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email, password }),
    });
    const json = await res.json();
    if (!res.ok) throw new Error(json?.errors?.[0]?.message || 'Login failed');

    CLS.token   = json.data.access_token;
    CLS.refresh = json.data.refresh_token;

    const user = await capi('/users/me?fields=id,email,first_name,last_name,role.name');
    if (!user) throw new Error('Could not load profile');
    CLS.user = user;

    const role = user?.role?.name?.toLowerCase() || '';
    if (!['coach','administrator','admin','technical_director','technical director','director'].some(r => role.includes(r))) {
      CLS.clear();
      document.getElementById('c-access-denied').hidden = false;
      document.getElementById('c-loading').hidden = true;
      document.getElementById('view-login').hidden = true;
      document.getElementById('view-dashboard').hidden = false;
      btn.disabled = false; btn.textContent = 'Sign In →';
      return;
    }

    showCoachDashboard(user);
    loadAllPlayers();

  } catch (err) {
    errEl.textContent = err.message.includes('Invalid') ? 'Invalid email or password.' : err.message;
    errEl.hidden = false; btn.disabled = false; btn.textContent = 'Sign In →';
  }
});

// ── LOGOUT ────────────────────────────────────────────────────
document.getElementById('c-logout-btn').addEventListener('click', () => {
  if (CLS.token) {
    fetch(`${DURL}/auth/logout`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ refresh_token: CLS.refresh }),
    }).catch(() => {});
  }
  showCoachLogin();
});
document.getElementById('c-back-login')?.addEventListener('click', showCoachLogin);

// ── INIT ──────────────────────────────────────────────────────
(async function init() {
  if (!CLS.token) { showCoachLogin(); return; }
  const user = await capi('/users/me?fields=id,email,first_name,last_name,role.name');
  if (!user) { showCoachLogin(); return; }
  CLS.user = user;
  const role = user?.role?.name?.toLowerCase() || '';
  if (!['coach','administrator','admin','technical_director'].some(r => role.includes(r))) {
    CLS.clear(); showCoachLogin(); return;
  }
  showCoachDashboard(user);
  loadAllPlayers();
})();
</script>

<style>
.coach-view { min-height: 100vh; }
.portal-hero { background: linear-gradient(135deg, var(--green-dark), var(--off-black)); padding: 60px 48px 40px; border-bottom: 1px solid var(--border); }
