.detail-ag, .detail-pos, .detail-jersey {
  font-family: var(--font-cond); font-size: 12px; font-weight: 700; letter-spacing: 1.5px;
  padding: 4px 10px; border-radius: 4px;
}
.detail-ag  { background: rgba(37,160,76,0.12); color: var(--green-bright); }
.detail-pos { background: rgba(100,149,237,0.12); color: #6495ed; }
