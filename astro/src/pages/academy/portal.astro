.fc-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 8px; }
.fc-left   { display: flex; flex-direction: column; gap: 2px; }
.fc-overall { font-family: var(--font-display); font-size: 56px; color: rgba(255,255,255,0.92); line-height: 1; letter-spacing: 1px; }
