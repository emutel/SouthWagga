.portal-hero h1 { font-size: clamp(48px, 6vw, 72px); margin: 10px 0 8px; }
.portal-hero p  { color: var(--muted); }
.login-outer { display: flex; justify-content: center; padding: 56px 20px; }
.login-card { width: 100%; max-width: 440px; padding: 40px; }
.login-card h2 { font-size: 36px; margin-bottom: 6px; }
.login-sub { color: var(--muted); font-size: 14px; margin-bottom: 28px; }
.field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 16px; }
.field label { font-family: var(--font-cond); font-size: 14px; font-weight: 700; }
input[type="email"], input[type="password"] {
  background: var(--black); border: 1px solid var(--border); border-radius: var(--radius);
  color: var(--white); font-family: var(--font-body); font-size: 15px; padding: 11px 14px; width: 100%;
}
input:focus { outline: none; border-color: var(--green); }
.btn-full { width: 100%; justify-content: center; margin-top: 8px; }
.login-footer { margin-top: 20px; display: flex; flex-direction: column; gap: 6px; }
.login-footer p { font-size: 13px; color: var(--muted); }
.login-footer a { color: var(--green-bright); text-decoration: none; }
.form-msg--error {
  background: rgba(217,48,37,0.1); border: 1px solid rgba(217,48,37,0.3); border-radius: var(--radius);
  padding: 12px 14px; font-size: 14px; color: #ff6b6b; margin-bottom: 12px;
}

/* Dashboard */
.dash-header { background: var(--off-black); border-bottom: 1px solid var(--border); padding: 20px 48px; }
.dash-header-inner { max-width: 1280px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; gap: 20px; }
.dash-header h1 { font-size: clamp(28px, 4vw, 44px); }
.btn-sm { padding: 8px 16px; font-size: 13px; }

.player-tabs { background: var(--card); border-bottom: 1px solid var(--border); padding: 0 48px; }
.tabs-inner { max-width: 1280px; margin: 0 auto; display: flex; gap: 4px; }
.player-tab {
  background: none; border: none; border-bottom: 3px solid transparent;
  color: var(--muted); font-family: var(--font-cond); font-size: 15px; font-weight: 700;
