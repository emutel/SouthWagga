  border-radius: 50%; animation: spin 0.8s linear infinite; margin: 0 auto 16px;
}
@keyframes spin { to { transform: rotate(360deg); } }
.dash-error { text-align: center; padding: 40px; color: var(--muted); }
.link-btn { background: none; border: none; color: var(--green-bright); cursor: pointer; text-decoration: underline; font-size: inherit; }

/* Content grid */
.content-grid { display: grid; grid-template-columns: 280px 1fr; gap: 40px; align-items: start; }
.section-label {
  font-family: var(--font-cond); font-size: 11px; font-weight: 700; letter-spacing: 2.5px;
  text-transform: uppercase; color: var(--green-bright); margin-bottom: 14px;
  display: flex; align-items: center; gap: 8px;
}
.section-label::before { content: ''; display: block; width: 14px; height: 2px; background: var(--green-bright); }

/* FIFA card styles */
.fifa-card {
  width: 252px; border-radius: 16px; padding: 18px 16px 16px;
  box-shadow: 0 24px 56px rgba(0,0,0,0.55); border: 1px solid rgba(255,255,255,0.12);
  position: relative;
}
.card-bronze { background: linear-gradient(160deg, #cd7f32 0%, #8b4513 55%, #5c2c0a 100%); }
