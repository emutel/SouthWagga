}
.player-tab:hover { color: var(--white); }
.player-tab--active { color: var(--green-bright); border-bottom-color: var(--green-bright); }

.dash-body { max-width: 1280px; margin: 0 auto; padding: 40px 48px 80px; }
.dash-loading { text-align: center; padding: 80px 0; color: var(--muted); }
.spinner {
