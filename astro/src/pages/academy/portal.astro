// ── STATE ─────────────────────────────────────────────────────
let currentProfiles = [];
let currentProfileIdx = 0;
function currentProfile() { return currentProfiles[currentProfileIdx]; }

// ── TOAST ─────────────────────────────────────────────────────
function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.hidden = false;
  t.classList.add('visible');
  setTimeout(() => {
    t.classList.remove('visible');
    setTimeout(() => { t.hidden = true; }, 300);
  }, 2000);
}

// ── TABS ──────────────────────────────────────────────────────
function switchTab(name) {
  document.querySelectorAll('.portal-tab').forEach(b => b.classList.toggle('portal-tab--active', b.dataset.tab === name));
  document.querySelectorAll('.tab-panel').forEach(p => p.classList.toggle('active', p.id === `tab-${name}`));
}

// ── VIEWS ─────────────────────────────────────────────────────
function showLogin() {
  LS.clear();
  document.getElementById('view-login').hidden = false;
  document.getElementById('view-dashboard').hidden = true;
}

function showDashboard() {
  document.getElementById('view-login').hidden = true;
  document.getElementById('view-dashboard').hidden = false;
}

// ── BUILD FIFA CARD ───────────────────────────────────────────
function buildFIFACard(enrollment, profile, assessment) {
  const ag  = enrollment?.age_group || 'u12-u13';
  const pos = profile?.position || 'midfielder';

  const attrs = assessment ? {
    pac: normalize(assessment.pace_raw,      ag),
    sho: normalize(assessment.shooting_raw,  ag),
    pas: normalize(assessment.passing_raw,   ag),
    dri: normalize(assessment.dribbling_raw, ag),
    def: normalize(assessment.defending_raw, ag),
    phy: normalize(assessment.physical_raw,  ag),
  } : { pac: '?', sho: '?', pas: '?', dri: '?', def: '?', phy: '?' };

  const overall = assessment ? calcOverall(attrs, pos) : '—';
  const tier    = assessment ? cardTier(overall) : { name: 'Unrated', cls: 'card-bronze' };

  const photoSrc = profile?.photo
    ? `${DURL}/assets/${profile.photo}?width=200&height=200&format=webp&fit=cover`
    : null;

  const agLabel = { 'u8-u9': 'U9', 'u10-u11': 'U11', 'u12-u13': 'U13', 'u14-u16': 'U16' }[ag] || ag.toUpperCase();
  const firstName = enrollment?.player_first_name || '';
  const lastName  = enrollment?.player_last_name  || '';
  const nameDisplay = `${firstName} ${lastName ? lastName[0] + '.' : ''}`.trim();

  return `
<div class="fifa-card ${tier.cls}">
  <div class="fc-header">
    <div>
      <div class="fc-overall">${overall}</div>
      <div class="fc-pos">${posLabel(pos)}</div>
      <div class="fc-tier">${tier.name}</div>
    </div>
    <div class="fc-badge">
      <svg viewBox="0 0 40 40" width="36" height="36" fill="none">
        <polygon points="20,3 37,12 37,28 20,37 3,28 3,12" fill="rgba(255,255,255,0.12)" stroke="rgba(255,255,255,0.25)" stroke-width="1.5"/>
        <text x="20" y="26" text-anchor="middle" font-size="13" font-weight="bold" fill="rgba(255,255,255,0.7)" font-family="Arial">W</text>
      </svg>
    </div>
  </div>
  <div class="fc-photo">
    ${photoSrc
      ? `<img src="${photoSrc}" alt="${nameDisplay}" class="fc-photo-img">`
      : `<svg class="fc-photo-svg" viewBox="0 0 80 100" fill="none" width="80" height="100"><circle cx="40" cy="26" r="18" fill="rgba(255,255,255,0.2)"/><path d="M8 95 C8 65 20 54 40 52 C60 54 72 65 72 95" fill="rgba(255,255,255,0.2)"/></svg>`}
  </div>
  <div class="fc-name">${nameDisplay.toUpperCase()}</div>
  <div class="fc-age">${agLabel} · Warriors FC</div>
  <div class="fc-stats">
    <div class="fc-stat"><span class="fc-sv">${attrs.pac}</span><span class="fc-sl">PAC</span></div>
    <div class="fc-stat"><span class="fc-sv">${attrs.sho}</span><span class="fc-sl">SHO</span></div>
    <div class="fc-stat"><span class="fc-sv">${attrs.pas}</span><span class="fc-sl">PAS</span></div>
    <div class="fc-stat"><span class="fc-sv">${attrs.dri}</span><span class="fc-sl">DRI</span></div>
    <div class="fc-stat"><span class="fc-sv">${attrs.def}</span><span class="fc-sl">DEF</span></div>
    <div class="fc-stat"><span class="fc-sv">${attrs.phy}</span><span class="fc-sl">PHY</span></div>
  </div>
</div>`;
}

// ── BUILD STATS PANEL ─────────────────────────────────────────
function buildStatsPanel(profile, assessment) {
  if (!assessment) {
    return `<p style="color:var(--muted);font-style:italic;padding:16px 0;">No assessment yet. Check back after your first session.</p>`;
  }

  const ag  = profile?.enrollment?.age_group || 'u12-u13';
  const pos = profile?.position || 'midfielder';

  const attrList = [
    { key: 'pace',      label: 'PAC', raw: assessment.pace_raw      },
    { key: 'shooting',  label: 'SHO', raw: assessment.shooting_raw  },
    { key: 'passing',   label: 'PAS', raw: assessment.passing_raw   },
    { key: 'dribbling', label: 'DRI', raw: assessment.dribbling_raw },
    { key: 'defending', label: 'DEF', raw: assessment.defending_raw },
    { key: 'physical',  label: 'PHY', raw: assessment.physical_raw  },
  ];

  const normalised = attrList.map(a => ({ ...a, value: normalize(a.raw, ag) }));
  const sorted = [...normalised].sort((a, b) => a.value - b.value);
  const focusKeys = new Set([sorted[0].key, sorted[1].key]);

  const attrs = {
    pac: normalize(assessment.pace_raw, ag),
    sho: normalize(assessment.shooting_raw, ag),
    pas: normalize(assessment.passing_raw, ag),
    dri: normalize(assessment.dribbling_raw, ag),
    def: normalize(assessment.defending_raw, ag),
    phy: normalize(assessment.physical_raw, ag),
  };
  const overall = calcOverall(attrs, pos);
  const tier    = cardTier(overall);

  const dateStr = assessment.assessment_date
    ? new Date(assessment.assessment_date).toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' })
    : null;

  const rows = normalised.map(a => {
    const isFocus = focusKeys.has(a.key);
    const width   = Math.min(a.value, 99);
    return `
<div class="stat-row">
  <span class="stat-label">${a.label}</span>
  <div class="stat-bar-wrap">
    <div class="stat-bar ${isFocus ? 'stat-bar--focus' : 'stat-bar--normal'}" data-width="${width}" style="width:0%"></div>
  </div>
  <span class="stat-value">${a.value}</span>
  ${isFocus ? '<span class="stat-focus-badge">▲ Focus Area</span>' : ''}
</div>`;
  }).join('');

  return `
${rows}
<div class="stats-overall">
  Overall: <strong>${overall}</strong> <span style="color:var(--muted)">· ${tier.name}</span>
  ${dateStr ? `<span style="font-size:12px;color:var(--muted);display:block;margin-top:4px">Last assessed: ${dateStr}</span>` : ''}
</div>`;
}

// ── BUILD FEEDBACK TAB ────────────────────────────────────────
function buildFeedbackTab(latestAssessment, allAssessments, ageGroup, position) {
  const ag  = ageGroup  || 'u12-u13';
  const pos = position  || 'midfielder';

  let feedbackCard = '';
  if (latestAssessment?.notes) {
    const dateStr = latestAssessment.assessment_date
      ? new Date(latestAssessment.assessment_date).toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' })
      : '';
    const coachName = latestAssessment.coach_name || 'Technical Director';
    feedbackCard = `
<div class="feedback-card">
  <p class="feedback-quote">${latestAssessment.notes.replace(/\n/g, '<br>')}</p>
  <div class="feedback-meta">${coachName}${dateStr ? ' · ' + dateStr : ''}</div>
</div>`;
  } else {
    feedbackCard = `<p class="feedback-empty">No coach notes recorded yet. Check back after your next assessment.</p>`;
  }

  // Progress timeline (up to 3)
  const histEntries = allAssessments.slice(0, 3).map(a => {
    const attrs2 = {
      pac: normalize(a.pace_raw, ag),
      sho: normalize(a.shooting_raw, ag),
      pas: normalize(a.passing_raw, ag),
      dri: normalize(a.dribbling_raw, ag),
      def: normalize(a.defending_raw, ag),
      phy: normalize(a.physical_raw, ag),
    };
    const ov   = calcOverall(attrs2, pos);
    const tier = cardTier(ov);
    const d    = a.assessment_date
      ? new Date(a.assessment_date).toLocaleDateString('en-AU', { month: 'short', year: 'numeric' })
      : '—';
    const tierChipCls = `tier-chip tier-chip--${tier.cls.replace('card-', '')}`;
    const bars = [
      ['PAC', attrs2.pac], ['SHO', attrs2.sho], ['PAS', attrs2.pas],
      ['DRI', attrs2.dri], ['DEF', attrs2.def], ['PHY', attrs2.phy],
    ].map(([l, v]) => `
<div class="he-bar">
  <span class="he-bar-val">${v}</span>
  <div class="he-bar-track"><div class="he-bar-fill" style="width:${Math.min(v,99)}%"></div></div>
  <span class="he-bar-label">${l}</span>
</div>`).join('');
    return `
<div class="hist-entry">
  <div class="hist-header">
    <span class="hist-date">${d}</span>
    <span class="${tierChipCls}">${ov} · ${tier.name}</span>
  </div>
  <div class="he-bars">${bars}</div>
</div>`;
  }).join('');

  const histSection = allAssessments.length > 0
    ? `<p class="progress-heading" style="margin-top:28px">Progress Timeline</p>${histEntries}`
    : `<p class="feedback-empty" style="margin-top:28px">No assessments yet. Check back after your first term.</p>`;

  return feedbackCard + histSection;
}

// ── BUILD MESSAGES TAB ────────────────────────────────────────
function buildMessagesTab(messages, playerId) {
  const bubbles = messages.length === 0
    ? `<p class="msg-empty">No messages yet. Use the form below to get in touch.</p>`
    : messages.map(m => {
        const isParent = m.sender_role === 'parent';
        const senderDisplay = m.sender_name || (isParent ? 'You' : 'Technical Director');
        const dateDisplay = m.date_created
          ? new Date(m.date_created).toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' })
          : '';
        return `
<div class="msg-bubble msg--${isParent ? 'parent' : 'coach'}">
  <div class="msg-body">${(m.body || '').replace(/\n/g, '<br>')}</div>
  <div class="msg-meta">${senderDisplay}${dateDisplay ? ' · ' + dateDisplay : ''}</div>
</div>`;
      }).join('');

  return `
<div class="message-thread" id="msg-thread">${bubbles}</div>
<form id="msg-compose-form" class="compose-form">
  <textarea class="compose-textarea" placeholder="Write a message to the Technical Director…" rows="3"></textarea>
  <span class="compose-error"></span>
  <button type="submit" class="btn-send">Send Message →</button>
</form>`;
}

// ── BUILD TRAIN TAB ───────────────────────────────────────────
function buildTrainTab(profile, assessment) {
  const allKeys = ['pace', 'shooting', 'passing', 'dribbling', 'defending', 'physical'];

  function drillSection(attrKey, isFocus) {
    const section = HOME_DRILLS[attrKey];
    if (!section) return '';
    const focusBadge = isFocus ? `<span class="focus-badge">Focus Area</span>` : '';
    const items = section.drills.map(d => `
<div class="drill-item">
  <span class="drill-icon">${d.icon || '⚽'}</span>
  <div>
    <strong style="font-family:var(--font-cond);font-size:15px;color:var(--text);display:block;margin-bottom:4px">${d.name}</strong>
    <span style="color:var(--muted);font-size:13px;line-height:1.6">${d.desc}</span>
  </div>
</div>`).join('');
    return `
<div class="drill-section">
  <div class="drill-section-header">
    <span class="drill-title">${section.label}</span>
    ${focusBadge}
  </div>
  <div class="drill-list">${items}</div>
</div>`;
  }

  if (!assessment) {
    return `<div>${allKeys.map(k => drillSection(k, false)).join('')}</div>`;
  }

  const ag = profile?.enrollment?.age_group || 'u12-u13';
  const attrValues = [
    { key: 'pace',      value: normalize(assessment.pace_raw,      ag) },
    { key: 'shooting',  value: normalize(assessment.shooting_raw,  ag) },
    { key: 'passing',   value: normalize(assessment.passing_raw,   ag) },
    { key: 'dribbling', value: normalize(assessment.dribbling_raw, ag) },
    { key: 'defending', value: normalize(assessment.defending_raw, ag) },
    { key: 'physical',  value: normalize(assessment.physical_raw,  ag) },
  ];

  const sorted    = [...attrValues].sort((a, b) => a.value - b.value);
  const focusKeys = [sorted[0].key, sorted[1].key];
  const focusSections = focusKeys.map(k => drillSection(k, true)).join('');

  const generalSection = `
<div class="drill-section">
  <div class="drill-section-header">
    <span class="drill-title">General Fitness</span>
  </div>
  <p style="color:var(--muted);font-size:14px;line-height:1.7;margin-bottom:16px">
    Alongside your focus areas, staying generally fit makes everything easier on the pitch.
    Browse the full S&amp;C session library for structured training sessions by age group.
  </p>
  <a href="/coaching/sessions" class="btn-download" style="display:inline-flex;text-decoration:none">View Session Plans →</a>
</div>`;

  return `<div>${focusSections}${generalSection}</div>`;
}

// ── REWIRE MESSAGE FORM ───────────────────────────────────────
function rewireMessageForm(profile) {
  const form = document.getElementById('msg-compose-form');
  if (!form) return;
  form.addEventListener('submit', async e => {
    e.preventDefault();
    const ta     = form.querySelector('textarea');
    const btn    = form.querySelector('button[type=submit]');
    const errEl  = form.querySelector('.compose-error');
    const body   = ta.value.trim();
    if (!body) return;
    btn.disabled = true; btn.textContent = 'Sending…';
    const user       = LS.user;
    const senderName = [user?.first_name, user?.last_name].filter(Boolean).join(' ') || 'Parent';
    const result = await api('/items/academy_messages', {
      method: 'POST',
      body: JSON.stringify({ player: profile.id, sender_role: 'parent', sender_name: senderName, body }),
    });
    if (result) {
      ta.value = '';
      const newMsgsData = await api(`/items/academy_messages?filter[player][_eq]=${profile.id}&sort[]=date_created&fields=*`);
      document.getElementById('tab-messages').innerHTML = buildMessagesTab(asArray(newMsgsData), profile.id);
      const thread = document.getElementById('msg-thread');
      if (thread) thread.scrollTop = thread.scrollHeight;
      rewireMessageForm(profile);
      showToast('Message sent!');
    } else {
      errEl.style.display = 'block';
      errEl.textContent = 'Failed to send. Check your connection and try again.';
    }
    btn.disabled = false; btn.textContent = 'Send Message →';
  });
}

// ── RENDER PLAYER CONTENT ─────────────────────────────────────
function renderPlayerContent(profile, latestAssessment, allAssessments, messages) {
  const enr = profile.enrollment;

  document.getElementById('dash-title').textContent = enr?.player_first_name
    ? `${enr.player_first_name}'s Card`
    : 'Player Portal';

  // FIFA card
  document.getElementById('fifa-card-wrap').innerHTML = buildFIFACard(enr, profile, latestAssessment);
  setTimeout(() => document.querySelector('#fifa-card-wrap .fifa-card')?.classList.add('card-animate'), 50);

  // Stats panel
  document.getElementById('stats-panel').innerHTML = buildStatsPanel(profile, latestAssessment);
  setTimeout(() => {
    document.querySelectorAll('.stat-bar').forEach(b => {
      const w = b.dataset.width;
      if (w) b.style.width = w + '%';
    });
  }, 100);

  // Tab content
  const ag  = enr?.age_group || 'u12-u13';
  const pos = profile.position || 'midfielder';
  document.getElementById('tab-feedback').innerHTML = buildFeedbackTab(latestAssessment, allAssessments, ag, pos);
  document.getElementById('tab-messages').innerHTML = buildMessagesTab(messages, profile.id);
  document.getElementById('tab-train').innerHTML    = buildTrainTab(profile, latestAssessment);

  // Scroll thread to bottom
  const thread = document.getElementById('msg-thread');
  if (thread) thread.scrollTop = thread.scrollHeight;

  // Wire up message form
  rewireMessageForm(profile);

  // Wire up tab buttons
  document.querySelectorAll('.portal-tab').forEach(b => {
    b.addEventListener('click', () => switchTab(b.dataset.tab));
  });
  switchTab('feedback');

  // Show content
  document.getElementById('dash-loading').hidden = true;
  document.getElementById('dash-content').hidden = false;
}

// ── LOAD PLAYER DATA ──────────────────────────────────────────
async function loadPlayerData(profile) {
  document.getElementById('dash-loading').hidden = false;
  document.getElementById('dash-content').hidden = true;
  document.getElementById('dash-error').hidden   = true;

  try {
    // Resolve enrollment if string/number
    let enrollment = profile.enrollment;
    if (typeof enrollment === 'string' || typeof enrollment === 'number') {
      enrollment = await api(`/items/academy_enrollments/${enrollment}?fields=id,age_group,player_first_name,player_last_name,parent_email`);
      if (!enrollment) throw new Error('enrollment fetch failed');
      profile.enrollment = enrollment;
    }

    const [historyData, messagesData] = await Promise.all([
      api(`/items/academy_assessments?filter[player][_eq]=${profile.id}&sort[]=-assessment_date&limit=5&fields=*`),
      api(`/items/academy_messages?filter[player][_eq]=${profile.id}&sort[]=date_created&fields=*`),
    ]);

    const allAssessments    = asArray(historyData);
    const messages          = asArray(messagesData);
    const latestAssessment  = allAssessments.find(a => a.is_latest) || allAssessments[0] || null;

    renderPlayerContent(profile, latestAssessment, allAssessments, messages);
  } catch (err) {
    console.error('loadPlayerData error:', err);
    document.getElementById('dash-loading').hidden = true;
    document.getElementById('dash-error').hidden   = false;
  }
}

// ── LOAD PROFILES FROM ENROLLMENTS ───────────────────────────
async function loadProfilesFromEnrollments(enrollments) {
  const profiles = [];

  for (const enr of enrollments) {
    const profileData = await api(
      `/items/academy_player_profiles?filter[enrollment][_eq]=${enr.id}&limit=1&fields=id,position,photo,jersey_number,enrollment`
    );
    if (profileData && profileData.length > 0) {
      const p = profileData[0];
      p.enrollment = enr;
      profiles.push(p);
    } else {
      const name = `${enr.player_first_name} ${enr.player_last_name}`;
      document.getElementById('dash-loading').hidden = true;
      document.getElementById('dash-pending').hidden = false;
      document.getElementById('dash-pending').innerHTML = `
<div class="pending-state">
  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="1.2"><polyline points="20 6 9 17 4 12"/></svg>
  <h3 class="pending-h3">Accepted — Profile Being Set Up</h3>
  <p class="pending-p">Great news — <strong>${name}'s</strong> application has been accepted! The Technical Director is setting up the player profile. Check back shortly and your Player Card will be ready.</p>
  <a href="/contact" class="btn-secondary" style="margin-top:16px;display:inline-block;text-decoration:none">Contact Us</a>
</div>`;
      return;
    }
  }

  currentProfiles    = profiles;
  currentProfileIdx  = 0;

  // Build player tabs if multiple players
  const tabsWrap = document.getElementById('player-tabs');
  if (profiles.length > 1) {
    tabsWrap.hidden = false;
    tabsWrap.innerHTML = profiles.map((p, i) => `
<button class="player-tab-btn ${i === 0 ? 'player-tab-btn--active' : ''}" data-idx="${i}">
  ${p.enrollment.player_first_name} ${p.enrollment.player_last_name}
</button>`).join('');
    tabsWrap.querySelectorAll('.player-tab-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        currentProfileIdx = parseInt(btn.dataset.idx);
        tabsWrap.querySelectorAll('.player-tab-btn').forEach(b => b.classList.remove('player-tab-btn--active'));
        btn.classList.add('player-tab-btn--active');
        loadPlayerData(currentProfiles[currentProfileIdx]);
      });
    });
  } else {
    tabsWrap.hidden = true;
  }

  if (profiles.length > 0) {
    loadPlayerData(profiles[0]);
  } else {
    document.getElementById('dash-loading').hidden = true;
    document.getElementById('dash-content').hidden = false;
    document.getElementById('tab-feedback').innerHTML = '<p style="color:var(--muted);font-style:italic">No player profile found. Please contact the Technical Director.</p>';
    switchTab('feedback');
  }
}

// ── LOAD PROFILES ─────────────────────────────────────────────
async function loadProfiles(user) {
  try {
    const allStatuses = 'pending,accepted,enrolled';

    let enrollments = asArray(await api(
      `/items/academy_enrollments?filter[directus_user_id][_eq]=${user.id}&filter[status][_in]=${allStatuses}&fields=id,status,age_group,player_first_name,player_last_name,parent_email`
    ));

    if (enrollments.length === 0) {
      const email = (user.email || '').toLowerCase();
      enrollments = asArray(await api(
        `/items/academy_enrollments?filter[parent_email][_eq]=${email}&filter[status][_in]=${allStatuses}&fields=id,status,age_group,player_first_name,player_last_name,parent_email`
      ));
    }

    if (enrollments.length === 0) {
      document.getElementById('dash-loading').hidden = true;
      document.getElementById('dash-pending').hidden = false;
      document.getElementById('dash-pending').innerHTML = `
<div class="pending-state">
  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="1.2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
  <h3 class="pending-h3">No enrollment found</h3>
  <p class="pending-p">We couldn't find a registration matching your account. If you've recently submitted an interest form, the Technical Director may not have linked your account yet.</p>
  <a href="/contact" class="btn-secondary" style="margin-top:16px;display:inline-block;text-decoration:none">Contact Us</a>
</div>`;
      return;
    }

    const pending = enrollments.filter(e => e.status === 'pending');
    const active  = enrollments.filter(e => e.status === 'accepted' || e.status === 'enrolled');

    if (active.length === 0 && pending.length > 0) {
      const name = `${pending[0].player_first_name} ${pending[0].player_last_name}`;
      document.getElementById('dash-loading').hidden = true;
      document.getElementById('dash-pending').hidden = false;
      document.getElementById('dash-pending').innerHTML = `
<div class="pending-state">
  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--amber)" stroke-width="1.2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
  <h3 class="pending-h3">Application Under Review</h3>
  <p class="pending-p">Your registration for <strong>${name}</strong> has been received and is being reviewed by the Technical Director. You'll hear back within 3 business days.</p>
  <p class="pending-p" style="margin-top:8px">Once approved, your child's Player Card and portal features will appear here.</p>
  <a href="/contact" class="btn-secondary" style="margin-top:16px;display:inline-block;text-decoration:none">Get in Touch</a>
</div>`;
      return;
    }

    return loadProfilesFromEnrollments(active);
  } catch (err) {
    console.error('loadProfiles error:', err);
    document.getElementById('dash-loading').hidden = true;
    document.getElementById('dash-error').hidden   = false;
  }
}

// ── LOGIN ─────────────────────────────────────────────────────
document.getElementById('login-btn').addEventListener('click', async () => {
  const errEl   = document.getElementById('login-error');
  const loginBtn = document.getElementById('login-btn');
  errEl.hidden  = true;
  loginBtn.disabled = true;
  loginBtn.textContent = 'Signing in…';

  const email    = (document.getElementById('login-email') as HTMLInputElement).value.trim();
  const password = (document.getElementById('login-password') as HTMLInputElement).value;

  try {
    const res = await fetch(`${DURL}/auth/login`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email, password }),
    });
    const json = await res.json();
    if (!res.ok) throw new Error(json?.errors?.[0]?.message || 'Login failed');

    LS.token   = json.data.access_token;
    LS.refresh = json.data.refresh_token;

    const user = await api('/users/me?fields=id,email,first_name,last_name,role');
    if (!user) throw new Error('Could not load user profile');
    LS.user = user;

    showDashboard();
    loadProfiles(user);
  } catch (err) {
    errEl.textContent = (err as Error).message === 'Login failed' ? 'Invalid email or password.' : (err as Error).message;
    errEl.hidden = false;
    loginBtn.disabled = false;
    loginBtn.textContent = 'Sign In →';
  }
});

// Also allow Enter key on password field
document.getElementById('login-password')?.addEventListener('keydown', e => {
  if (e.key === 'Enter') document.getElementById('login-btn')?.click();
});

// ── LOGOUT ────────────────────────────────────────────────────
document.getElementById('logout-btn').addEventListener('click', () => {
  if (LS.token) {
    fetch(`${DURL}/auth/logout`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ refresh_token: LS.refresh }),
    }).catch(() => {});
  }
  showLogin();
});

// ── RETRY ─────────────────────────────────────────────────────
document.getElementById('retry-btn')?.addEventListener('click', () => {
  const user = LS.user;
  if (user) {
    document.getElementById('dash-error').hidden = true;
    document.getElementById('dash-loading').hidden = false;
    loadProfiles(user);
  }
});

// ── DOWNLOAD CARD ─────────────────────────────────────────────
document.getElementById('download-btn').addEventListener('click', async () => {
  if (typeof html2canvas === 'undefined') {
    showToast('Download not available yet. Please try again in a moment.');
    return;
  }
  const wrap = document.getElementById('fifa-card-wrap');
  if (!wrap) return;
  const btn = document.getElementById('download-btn');
  btn.textContent = 'Generating…';
  btn.disabled = true;
  try {
    const canvas = await html2canvas(wrap, { backgroundColor: null, scale: 3, useCORS: true, allowTaint: false });
    const link = document.createElement('a');
    const profile = currentProfile();
    const name = profile?.enrollment
      ? `${profile.enrollment.player_first_name}_${profile.enrollment.player_last_name}`
      : 'player';
    link.download = `warriors-player-card-${name}.png`;
    link.href = canvas.toDataURL('image/png');
    link.click();
    showToast('Card saved!');
  } catch (err) {
    console.error('Card download failed:', err);
    showToast('Download failed. Please try again.');
  }
  btn.textContent = 'Download Card';
  btn.disabled = false;
});

// ── SHARE CARD ────────────────────────────────────────────────
async function generateCardDataUrl() {
  if (typeof html2canvas === 'undefined') return null;
  const wrap = document.getElementById('fifa-card-wrap');
  if (!wrap) return null;
  const canvas = await html2canvas(wrap, { backgroundColor: null, scale: 3, useCORS: true, allowTaint: false });
  return canvas.toDataURL('image/png');
}

document.getElementById('share-btn').addEventListener('click', async () => {
  const shareText = 'Check out my Warriors FC Academy player card! ⚽🏆';
  const shareUrl = window.location.href;

  // Try native Web Share API first (mobile browsers)
  if (navigator.share && navigator.canShare) {
    try {
      const dataUrl = await generateCardDataUrl();
      let shareData = { title: 'My Warriors FC Card', text: shareText, url: shareUrl };
      if (dataUrl) {
        const res = await fetch(dataUrl);
        const blob = await res.blob();
        const file = new File([blob], 'warriors-player-card.png', { type: 'image/png' });
        if (navigator.canShare({ files: [file] })) shareData.files = [file];
      }
      await navigator.share(shareData);
      return;
    } catch (e) {
      if (e.name === 'AbortError') return; // user cancelled
    }
  }

  // Fallback: show share menu with platform links
  const menu = document.getElementById('share-menu');
  if (!menu.hidden) { menu.hidden = true; return; }

  const profile = currentProfile();
  const name = profile?.enrollment
    ? `${profile.enrollment.player_first_name} ${profile.enrollment.player_last_name}`
    : 'Warriors Player';
  const text = encodeURIComponent(`Check out ${name}'s Warriors FC Academy card! ⚽🏆`);
  const url = encodeURIComponent(shareUrl);

  document.getElementById('share-wa').href = `https://wa.me/?text=${text}%20${url}`;
  document.getElementById('share-tw').href = `https://twitter.com/intent/tweet?text=${text}&url=${url}`;
  document.getElementById('share-fb').href = `https://www.facebook.com/sharer/sharer.php?u=${url}&quote=${text}`;

  menu.hidden = false;
});

// Close share menu on outside click
document.addEventListener('click', (e) => {
  const menu = document.getElementById('share-menu');
  const btn = document.getElementById('share-btn');
  if (!menu.hidden && !menu.contains(e.target) && e.target !== btn) {
    menu.hidden = true;
  }
});

// ── STATS INFO MODAL ─────────────────────────────────────────
function agKey(ag) {
  const s = (ag || '').toLowerCase().replace(/\s/g,'-').replace(/\//g,'-');
  if (s.includes('8') || s.includes('9')) return 'u8-u9';
  if (s.includes('10') || s.includes('11')) return 'u10-u11';
  if (s.includes('12') || s.includes('13')) return 'u12-u13';
  return 'u14-u16';
}

function openStatsModal() {
  const profile = currentProfile();
  const ak = agKey(profile?.enrollment?.age_group);
  const body = document.getElementById('stats-modal-body');

  body.innerHTML = STAT_INFO.map(info => {
    const bmarks = info.benchmarks[ak] || info.benchmarks.all || [];
    const bmarkRows = bmarks.map(([score, target]) =>
      `<div class="si-bmark-row"><span class="si-bmark-score">${score}</span><span class="si-bmark-target">${target}</span></div>`
    ).join('');
    const tipItems = info.tips.map(t => `<li>${t}</li>`).join('');
    return `
<div class="si-card">
  <div class="si-card-hdr">
    <span class="si-icon">${info.icon}</span>
    <h3 class="si-label">${info.label}</h3>
  </div>
  <p class="si-desc">${info.desc}</p>
  <div class="si-section">
    <p class="si-section-title">The Test</p>
    <p class="si-test-detail">${info.test}</p>
    <p class="si-equipment">Equipment: ${info.equipment}</p>
  </div>
  <div class="si-section">
    <p class="si-section-title">Score Benchmarks${info.benchmarks.all ? '' : ` · ${ak.toUpperCase()}`}</p>
    <div class="si-bmarks">${bmarkRows}</div>
  </div>
  <div class="si-section si-tips-section">
    <p class="si-section-title">How to Improve</p>
    <ul class="si-tips">${tipItems}</ul>
  </div>
</div>`;
  }).join('');

  document.getElementById('stats-modal').hidden = false;
  document.body.style.overflow = 'hidden';
}

function closeStatsModal() {
  document.getElementById('stats-modal').hidden = true;
  document.body.style.overflow = '';
}

document.getElementById('stats-info-btn').addEventListener('click', openStatsModal);
document.getElementById('stats-modal-close').addEventListener('click', closeStatsModal);
document.getElementById('stats-modal-backdrop').addEventListener('click', closeStatsModal);
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeStatsModal(); });

// ── INIT ──────────────────────────────────────────────────────
async function init() {
  // Inject random quote
  const q = QUOTES[Math.floor(Math.random() * QUOTES.length)];
  document.getElementById('quote-band').innerHTML = `
    <p class="quote-text">"${q.text}"</p>
    <p class="quote-attr">— ${q.author}</p>`;

  // Check session expired flag
  if (sessionStorage.getItem('portal_session_expired')) {
    document.getElementById('session-expired-msg').hidden = false;
    sessionStorage.removeItem('portal_session_expired');
  }

  // Check auth
  if (!LS.token) { showLogin(); return; }

  const user = await api('/users/me?fields=id,email,first_name,last_name,role');
  if (!user) { showLogin(); return; }
  LS.user = user;

  showDashboard();
  await loadProfiles(user);
}

document.addEventListener('DOMContentLoaded', init);
</script>

