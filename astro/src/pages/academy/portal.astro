---
// src/pages/academy/portal.astro
// Parent/Player Portal — fully client-side authenticated via Directus JWT
import PortalBase from '../../layouts/PortalBase.astro';
---
<PortalBase
  title="Academy — Player Portal"
  description="South Wagga Warriors FC Academy parent and player portal. View your child's Player Card, progress, and messages."
>

<!-- Quote band — always visible, above everything -->
<div id="quote-band" class="quote-band"></div>

<!-- Login view -->
<div id="view-login" class="portal-view">
  <div class="login-hero">
    <div class="login-hero-inner">
      <span class="login-label">Warriors Academy</span>
      <h1 class="login-h1">Player Portal</h1>
      <p class="login-sub">Sign in to view your player card and stats</p>
    </div>
  </div>
  <div class="login-outer">
    <div class="login-card">
      <div id="session-expired-msg" hidden style="background:rgba(245,158,11,0.12);border:1px solid rgba(245,158,11,0.3);border-radius:8px;padding:12px 14px;font-size:14px;color:#f59e0b;margin-bottom:16px;">Your session expired. Please sign in again.</div>
      <div class="login-field-group">
        <label for="login-email">Email</label>
        <input id="login-email" type="email" autocomplete="email" placeholder="your@email.com">
      </div>
      <div class="login-field-group">
        <label for="login-password">Password</label>
        <input id="login-password" type="password" autocomplete="current-password" placeholder="••••••••">
      </div>
      <button id="login-btn" class="btn-primary">Sign In →</button>
      <div id="login-error" class="form-msg form-msg--error" hidden></div>
      <div class="login-footer">
        <p>Not enrolled yet? <a href="/academy/register">Register Interest →</a></p>
        <p>Need help? <a href="/contact">Contact us</a></p>
      </div>
    </div>
  </div>
</div>

<!-- Dashboard view -->
<div id="view-dashboard" class="portal-view" hidden>
  <div class="dash-header">
    <div class="dash-header-inner">
      <div>
        <span class="dash-label">Warriors Academy</span>
        <h1 id="dash-title" class="dash-h1">Player Portal</h1>
      </div>
      <button id="logout-btn" class="btn-secondary">Sign Out</button>
    </div>
  </div>

  <!-- Player tabs (only if multiple children) -->
  <div id="player-tabs" class="player-tabs" hidden></div>

  <!-- Loading / error / content states -->
  <div id="dash-loading" class="dash-loading">
    <div class="spinner"></div>
    <p>Loading player data…</p>
  </div>
  <div id="dash-error" class="dash-error" hidden>
    <p>Couldn't load player data. Please try again or <a href="/contact">contact us</a>.</p>
    <button id="retry-btn" class="btn-secondary" style="margin-top:16px">Try Again</button>
  </div>
  <div id="dash-pending" hidden></div>

  <div id="dash-content" hidden>
    <!-- Hero: card + stats -->
    <div class="player-hero">
      <div class="hero-card-col">
        <div id="fifa-card-wrap"></div>
        <div class="card-actions">
          <button id="download-btn" class="btn-download">Download Card</button>
          <button id="share-btn" class="btn-share" title="Share to socials">Share</button>
        </div>
        <div id="share-menu" class="share-menu" hidden>
          <a id="share-wa" class="share-option share-wa" target="_blank" rel="noopener">WhatsApp</a>
          <a id="share-tw" class="share-option share-tw" target="_blank" rel="noopener">Twitter / X</a>
          <a id="share-fb" class="share-option share-fb" target="_blank" rel="noopener">Facebook</a>
        </div>
      </div>
      <div class="hero-stats-col">
        <div class="stats-heading-row">
          <h2 class="stats-heading">Current Stats</h2>
          <button id="stats-info-btn" class="stats-info-btn">ⓘ How am I scored?</button>
        </div>
        <div id="stats-panel"></div>
      </div>
    </div>

    <!-- Tabs -->
    <div class="tab-bar">
      <button class="portal-tab portal-tab--active" data-tab="feedback">Feedback from Coach</button>
      <button class="portal-tab" data-tab="messages">Messages</button>
      <button class="portal-tab" data-tab="train">Train at Home</button>
    </div>
    <div class="tab-content">
      <div id="tab-feedback" class="tab-panel active"></div>
      <div id="tab-messages" class="tab-panel"></div>
      <div id="tab-train" class="tab-panel"></div>
    </div>
  </div>
</div>

<!-- Toast -->
<div id="toast" class="toast" hidden></div>

<!-- Stats Info Modal -->
<div id="stats-modal" class="stats-modal" hidden>
  <div class="stats-modal-backdrop" id="stats-modal-backdrop"></div>
  <div class="stats-modal-inner">
    <div class="stats-modal-hdr">
      <h2 class="stats-modal-title">How Your Stats Are Measured</h2>
      <button id="stats-modal-close" class="modal-close-btn">✕</button>
    </div>
    <p class="stats-modal-subtitle">Your Warriors FC card is updated at the start of each season and at the end of every term. Here's exactly how each stat is tested — and what you can do to reach the next level.</p>
    <div id="stats-modal-body" class="stats-modal-body"><!-- Injected by JS --></div>
  </div>
</div>

</PortalBase>

<!-- html2canvas for card download -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js" integrity="sha512-BNaRQnYJYiPSqHHDb58B0yaPfCu+Wgds8Gp/gU33kqBtgNS4tSPHuGibyoeqMV/TJlSKda6FXzoEyYGjTe+vXA==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>

<script>
// ── CONFIG ────────────────────────────────────────────────────
const DURL = import.meta.env.PUBLIC_DIRECTUS_URL || '';

// ── HELPERS ───────────────────────────────────────────────────
function asArray(v) { return Array.isArray(v) ? v : []; }

// ── TOKEN HELPERS ─────────────────────────────────────────────
const LS = {
  get token()   { return localStorage.getItem('warriors_academy_token'); },
  get refresh() { return localStorage.getItem('warriors_academy_refresh'); },
  get user()    { try { return JSON.parse(localStorage.getItem('warriors_academy_user') || 'null'); } catch { return null; } },
  set token(v)  { localStorage.setItem('warriors_academy_token', v); },
  set refresh(v){ localStorage.setItem('warriors_academy_refresh', v); },
  set user(v)   { localStorage.setItem('warriors_academy_user', JSON.stringify(v)); },
  clear()       { ['warriors_academy_token','warriors_academy_refresh','warriors_academy_user'].forEach(k => localStorage.removeItem(k)); },
};

// ── API HELPERS ───────────────────────────────────────────────
async function api(path, opts = {}, token = LS.token) {
  const headers = { 'Content-Type': 'application/json' };
  if (token) headers['Authorization'] = `Bearer ${token}`;
  const res = await fetch(`${DURL}${path}`, { ...opts, headers: { ...headers, ...(opts.headers||{}) } });
  if (res.status === 401) {
    const refreshed = await tryRefresh();
    if (refreshed) return api(path, opts, LS.token);
    showLogin();
    return null;
  }
  if (!res.ok) return null;
  const json = await res.json();
  return json.data ?? json;
}

async function tryRefresh() {
  if (!LS.refresh) return false;
  try {
    const res = await fetch(`${DURL}/auth/refresh`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ refresh_token: LS.refresh, mode: 'json' }),
    });
    if (!res.ok) return false;
    const { data } = await res.json();
    LS.token   = data.access_token;
    LS.refresh = data.refresh_token;
    return true;
  } catch { return false; }
}

// ── FIFA CARD UTILS ───────────────────────────────────────────
const AGE_SCALE = {
  'u8-u9':   { min: 30, max: 72 },
  'u10-u11': { min: 35, max: 78 },
  'u12-u13': { min: 40, max: 83 },
  'u14-u16': { min: 45, max: 90 },
};

function normalize(raw, ageGroup) {
  const scale = AGE_SCALE[ageGroup] || AGE_SCALE['u12-u13'];
  return Math.round(scale.min + (raw - 1) * (scale.max - scale.min) / 9);
}

function calcOverall(attrs, position) {
  const { pac, sho, pas, dri, def, phy } = attrs;
  const isAttacker = ['forward', 'midfielder'].includes(position);
  if (isAttacker) return Math.round((dri*2 + sho*2 + pac + pas + phy) / 7);
  return Math.round((def*2 + phy*2 + pac + pas + dri) / 7);
}

function cardTier(overall) {
  if (overall >= 90) return { name: 'Elite',  cls: 'card-elite'  };
  if (overall >= 75) return { name: 'Gold',   cls: 'card-gold'   };
  if (overall >= 60) return { name: 'Silver', cls: 'card-silver' };
  return                    { name: 'Bronze', cls: 'card-bronze' };
}

function posLabel(position) {
  return { goalkeeper: 'GK', defender: 'CB', midfielder: 'MID', forward: 'FWD' }[position] || 'MID';
}

