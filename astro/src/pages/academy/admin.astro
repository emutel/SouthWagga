---
// src/pages/academy/admin.astro
// Technical Director admin panel — Directus administrator role only
import Base from '../../layouts/Base.astro';
---
<Base
  title="Academy — Technical Director"
  description="Warriors FC Academy administration panel."
>

  <!-- Login -->
  <div id="view-login" class="admin-view">
    <div class="portal-hero">
      <div class="portal-hero-inner">
        <div class="label">Academy</div>
        <h1>Technical Director</h1>
        <p>Manage enrollments, player profiles, assessments and parent messages.</p>
      </div>
    </div>
    <div class="login-outer">
      <div class="login-card card">
        <h2>Sign In</h2>
        <form id="admin-login-form" novalidate>
          <div class="field">
            <label for="a-email">Email</label>
            <input type="email" id="a-email" autocomplete="email" required>
          </div>
          <div class="field">
            <label for="a-password">Password</label>
            <input type="password" id="a-password" autocomplete="current-password" required>
          </div>
          <div id="a-login-error" class="form-error" hidden></div>
          <button type="submit" class="btn btn-primary btn-full" id="a-login-btn">Sign In →</button>
        </form>
      </div>
    </div>
  </div>

  <!-- Dashboard -->
  <div id="view-dashboard" class="admin-view" hidden>

    <div class="topbar">
      <div class="topbar-inner">
        <div class="topbar-title">
          <div class="label">Academy</div>
          <h1>Technical Director</h1>
        </div>
        <div class="topbar-right">
          <div class="stats-bar" id="stats-bar"></div>
          <button class="btn btn-secondary btn-sm" id="a-logout-btn">Sign Out</button>
        </div>
      </div>
      <!-- Tab nav -->
      <div class="tab-nav">
        <button class="tab-btn tab-btn--active" data-tab="enrollments">Enrollments</button>
        <button class="tab-btn" data-tab="players">Players</button>
        <button class="tab-btn" data-tab="messages">Messages</button>
      </div>
    </div>

    <div class="admin-body">
      <div id="admin-loading" class="center-msg"><div class="spinner"></div><p>Loading…</p></div>

      <!-- ── ENROLLMENTS TAB ─────────────────────── -->
      <div id="tab-enrollments" class="tab-panel">
        <div class="panel-header">
          <h2>Enrollments</h2>
          <div class="filter-row">
            <button class="filter-btn filter-btn--active" data-status="pending">Pending</button>
            <button class="filter-btn" data-status="accepted">Accepted</button>
            <button class="filter-btn" data-status="enrolled">Enrolled</button>
            <button class="filter-btn" data-status="all">All</button>
          </div>
        </div>
        <div id="enrollments-list"></div>
      </div>

      <!-- ── PLAYERS TAB ─────────────────────────── -->
      <div id="tab-players" class="tab-panel" hidden>
        <div class="panel-header">
          <h2>Players</h2>
          <input type="text" id="player-search" placeholder="Search by name…" class="search-input">
        </div>
        <div id="players-grid"></div>
      </div>

      <!-- ── MESSAGES TAB ────────────────────────── -->
      <div id="tab-messages" class="tab-panel" hidden>
        <div class="messages-layout">
          <div class="thread-list" id="thread-list">
            <div class="thread-list-header">All Conversations</div>
          </div>
          <div class="thread-detail" id="thread-detail">
            <div class="center-msg" style="height:300px">
              <p style="color:var(--muted)">Select a conversation</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ── ENROLLMENT DETAIL MODAL ─────────────────── -->
    <div id="enr-modal" class="modal-overlay" hidden>
      <div class="modal-box card">
        <div class="modal-header">
          <h3 id="modal-title">Enrollment</h3>
          <button class="modal-close" id="modal-close">✕</button>
        </div>
        <div id="modal-body"></div>
      </div>
    </div>

  </div>

</Base>

<script>
const DURL = import.meta.env.PUBLIC_DIRECTUS_URL || '';

// ── AUTH ──────────────────────────────────────────────────────
const ALS = {
  get token()   { return sessionStorage.getItem('warriors_admin_token'); },
  get refresh() { return sessionStorage.getItem('warriors_admin_refresh'); },
  get user()    { try { return JSON.parse(sessionStorage.getItem('warriors_admin_user') || 'null'); } catch { return null; } },
  set token(v)  { sessionStorage.setItem('warriors_admin_token', v); },
  set refresh(v){ sessionStorage.setItem('warriors_admin_refresh', v); },
  set user(v)   { sessionStorage.setItem('warriors_admin_user', JSON.stringify(v)); },
  clear()       { ['warriors_admin_token','warriors_admin_refresh','warriors_admin_user'].forEach(k => sessionStorage.removeItem(k)); },
};

async function aapi(path, opts = {}) {
  const headers = { 'Content-Type': 'application/json', 'Authorization': `Bearer ${ALS.token}` };
  const res = await fetch(`${DURL}${path}`, { ...opts, headers: { ...headers, ...(opts.headers||{}) } });
  if (res.status === 401) { showLogin(); return null; }
  if (res.status === 204) return { ok: true };
  if (!res.ok) return null;
  const json = await res.json();
  return json.data ?? json;
}

// ── FIFA CARD UTILS ───────────────────────────────────────────
const AGE_SCALE = { 'u8-u9':{min:30,max:72},'u10-u11':{min:35,max:78},'u12-u13':{min:40,max:83},'u14-u16':{min:45,max:90} };
function norm(raw, ag) { const s=AGE_SCALE[ag]||AGE_SCALE['u12-u13']; return Math.round(s.min+(raw-1)*(s.max-s.min)/9); }
function overall(a, ag, pos) {
  const attrs = { pac:norm(a.pace_raw,ag),sho:norm(a.shooting_raw,ag),pas:norm(a.passing_raw,ag),dri:norm(a.dribbling_raw,ag),def:norm(a.defending_raw,ag),phy:norm(a.physical_raw,ag) };
  const isAtk = ['forward','midfielder'].includes(pos);
  const ov = isAtk ? Math.round((attrs.dri*2+attrs.sho*2+attrs.pac+attrs.pas+attrs.phy)/7)
                   : Math.round((attrs.def*2+attrs.phy*2+attrs.pac+attrs.pas+attrs.dri)/7);
  return { ov, attrs };
}
function tierClass(ov) { return ov>=90?'card-elite':ov>=75?'card-gold':ov>=60?'card-silver':'card-bronze'; }

// ── STATE ─────────────────────────────────────────────────────
let allEnrollments = [];
let allPlayers     = [];
let allMessages    = [];
let currentFilter  = 'pending';
let activeTab      = 'enrollments';

// ── VIEWS ─────────────────────────────────────────────────────
function showLogin() { ALS.clear(); document.getElementById('view-login').hidden=false; document.getElementById('view-dashboard').hidden=true; }
function showDashboard() { document.getElementById('view-login').hidden=true; document.getElementById('view-dashboard').hidden=false; }

// ── TABS ──────────────────────────────────────────────────────
document.querySelectorAll('.tab-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('tab-btn--active'));
    btn.classList.add('tab-btn--active');
    activeTab = btn.dataset.tab;
    document.querySelectorAll('.tab-panel').forEach(p => p.hidden = true);
    document.getElementById(`tab-${activeTab}`).hidden = false;
    if (activeTab === 'messages' && allMessages.length === 0) loadMessages();
  });
});

// ── ENROLLMENT FILTERS ────────────────────────────────────────
document.querySelectorAll('.filter-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('filter-btn--active'));
    btn.classList.add('filter-btn--active');
    currentFilter = btn.dataset.status;
    renderEnrollments();
  });
});

// ── LOAD DATA ─────────────────────────────────────────────────
async function loadAll() {
  document.getElementById('admin-loading').hidden = false;

  const [enrollments, players] = await Promise.all([
    aapi('/items/academy_enrollments?sort[]=-date_created&limit=200&fields=id,status,date_created,parent_first_name,parent_last_name,parent_email,parent_phone,player_first_name,player_last_name,player_dob,age_group,previous_experience,medical_notes,directus_user_id,program'),
    aapi('/items/academy_player_profiles?limit=200&fields=id,position,photo,jersey_number,notes,enrollment.id,enrollment.age_group,enrollment.player_first_name,enrollment.player_last_name,enrollment.status'),
  ]);

  allEnrollments = enrollments || [];
  allPlayers     = players     || [];

  renderStats();
  renderEnrollments();
  renderPlayers();

  document.getElementById('admin-loading').hidden = true;
}

// ── STATS BAR ─────────────────────────────────────────────────
function renderStats() {
  const pending  = allEnrollments.filter(e => e.status === 'pending').length;
  const enrolled = allEnrollments.filter(e => e.status === 'enrolled' || e.status === 'accepted').length;
  document.getElementById('stats-bar').innerHTML = `
    <span class="stat-chip stat-chip--warn">${pending} pending</span>
    <span class="stat-chip stat-chip--ok">${enrolled} active</span>
    <span class="stat-chip">${allPlayers.length} profiles</span>`;
}

// ── ENROLLMENTS ───────────────────────────────────────────────
function renderEnrollments() {
  const list = document.getElementById('enrollments-list');
  const filtered = currentFilter === 'all' ? allEnrollments : allEnrollments.filter(e => e.status === currentFilter);

  if (!filtered.length) {
    list.innerHTML = `<p class="empty-msg" style="padding:32px">No ${currentFilter === 'all' ? '' : currentFilter + ' '}enrollments.</p>`;
    return;
  }

  list.innerHTML = filtered.map(e => {
    const d = e.date_created ? new Date(e.date_created).toLocaleDateString('en-AU',{day:'numeric',month:'short',year:'numeric'}) : '—';
    const hasProfile = allPlayers.some(p => (p.enrollment?.id || p.enrollment) === e.id);
    const statusClass = { pending:'status-pending', accepted:'status-accepted', enrolled:'status-enrolled', inactive:'status-inactive' }[e.status] || '';
    return `
<div class="enr-row card" data-id="${e.id}">
  <div class="enr-main">
    <div class="enr-player"><strong>${e.player_first_name} ${e.player_last_name}</strong> <span class="age-chip">${(e.age_group||'').toUpperCase().replace('-','/')}</span></div>
    <div class="enr-parent">${e.parent_first_name} ${e.parent_last_name} · ${e.parent_email}</div>
    <div class="enr-date">Submitted ${d}</div>
  </div>
  <div class="enr-actions">
    <span class="status-badge ${statusClass}">${e.status}</span>
    ${e.status === 'pending' ? `<button class="btn btn-primary btn-sm" data-action="accept" data-id="${e.id}">Accept →</button>` : ''}
    ${e.status === 'accepted' && !hasProfile ? `<button class="btn btn-outline-green btn-sm" data-action="create-profile" data-id="${e.id}">Create Profile →</button>` : ''}
    ${e.status === 'accepted' && hasProfile ? `<button class="btn btn-secondary btn-sm" data-action="enroll" data-id="${e.id}">Mark Enrolled</button>` : ''}
    <button class="btn btn-secondary btn-sm" data-action="view" data-id="${e.id}">View</button>
  </div>
</div>`;
  }).join('');

  list.querySelectorAll('[data-action]').forEach(btn => {
    btn.addEventListener('click', () => handleEnrAction(btn.dataset.action, btn.dataset.id));
  });
}

async function handleEnrAction(action, id) {
  const enr = allEnrollments.find(e => e.id === id);
  if (!enr) return;

  if (action === 'view') {
    openEnrollmentModal(enr);
    return;
  }
  if (action === 'accept') {
    await aapi(`/items/academy_enrollments/${id}`, { method: 'PATCH', body: JSON.stringify({ status: 'accepted' }) });
    enr.status = 'accepted';
    renderStats(); renderEnrollments();
    openEnrollmentModal({ ...enr, status: 'accepted' });
    return;
  }
  if (action === 'enroll') {
    await aapi(`/items/academy_enrollments/${id}`, { method: 'PATCH', body: JSON.stringify({ status: 'enrolled' }) });
    enr.status = 'enrolled';
    renderStats(); renderEnrollments();
    return;
  }
  if (action === 'create-profile') {
    openCreateProfileModal(enr);
    return;
  }
}

// ── ENROLLMENT MODAL ──────────────────────────────────────────
function openEnrollmentModal(enr) {
  const hasProfile = allPlayers.some(p => (p.enrollment?.id || p.enrollment) === enr.id);
  document.getElementById('modal-title').textContent = `${enr.player_first_name} ${enr.player_last_name}`;

  const dob = enr.player_dob ? new Date(enr.player_dob).toLocaleDateString('en-AU') : '—';
  const statusClass = { pending:'status-pending', accepted:'status-accepted', enrolled:'status-enrolled' }[enr.status] || '';

  document.getElementById('modal-body').innerHTML = `
<div class="modal-section">
  <span class="status-badge ${statusClass}" style="margin-bottom:16px;display:inline-block">${enr.status}</span>
  <div class="detail-grid">
    <div class="detail-row"><span>Player</span><strong>${enr.player_first_name} ${enr.player_last_name}</strong></div>
    <div class="detail-row"><span>DOB</span><strong>${dob}</strong></div>
    <div class="detail-row"><span>Age Group</span><strong>${(enr.age_group||'—').toUpperCase().replace('-','/')}</strong></div>
    <div class="detail-row"><span>Parent</span><strong>${enr.parent_first_name} ${enr.parent_last_name}</strong></div>
    <div class="detail-row"><span>Email</span><strong>${enr.parent_email}</strong></div>
    <div class="detail-row"><span>Phone</span><strong>${enr.parent_phone||'—'}</strong></div>
    ${enr.previous_experience ? `<div class="detail-row detail-row--full"><span>Experience</span><p>${enr.previous_experience}</p></div>` : ''}
    ${enr.medical_notes ? `<div class="detail-row detail-row--full"><span>Medical Notes</span><p class="medical-note">${enr.medical_notes}</p></div>` : ''}
  </div>
</div>

${enr.status === 'pending' ? `
<div class="modal-actions">
  <button class="btn btn-primary" data-modal-action="accept" data-id="${enr.id}">Accept Application →</button>
  <button class="btn btn-secondary" data-modal-action="reject" data-id="${enr.id}">Reject</button>
</div>` : ''}

${enr.status === 'accepted' && !hasProfile ? `
<div class="modal-section">
  <div class="label" style="margin-bottom:16px">Next Step — Create Player Profile</div>
  <form id="inline-profile-form">
    <div class="field-row">
      <div class="field">
        <label>Position</label>
        <select id="ip-position">
          <option value="midfielder">Midfielder</option>
          <option value="forward">Forward</option>
          <option value="defender">Defender</option>
          <option value="goalkeeper">Goalkeeper</option>
        </select>
      </div>
      <div class="field">
        <label>Jersey Number (optional)</label>
        <input type="number" id="ip-jersey" min="1" max="99" placeholder="e.g. 10">
      </div>
    </div>
    <div class="field">
      <label>Internal Notes (not visible to parents)</label>
      <textarea id="ip-notes" rows="2" placeholder="Any notes for coaches…"></textarea>
    </div>
    <div class="modal-actions">
      <button type="submit" class="btn btn-primary">Create Profile →</button>
      <span id="ip-msg" hidden style="font-family:var(--font-cond);font-size:13px;color:var(--green-bright);font-weight:700"></span>
    </div>
  </form>
</div>
<div class="invite-instructions">
  <div class="label" style="margin-bottom:10px">Then — Invite Parent to Portal</div>
  <ol>
    <li>Go to <a href="${DURL}/admin/users" target="_blank" rel="noopener">Directus → Users ↗</a></li>
    <li>Click <strong>Invite Users</strong></li>
    <li>Enter <strong>${enr.parent_email}</strong></li>
    <li>Set role to <strong>parent</strong></li>
    <li>Click Send — parent receives login email</li>
  </ol>
</div>` : ''}

${enr.status === 'accepted' && hasProfile ? `
<div class="modal-section">
  <p style="color:var(--green-bright);font-family:var(--font-cond);font-weight:700">✓ Player profile created</p>
  <div class="invite-instructions" style="margin-top:12px">
    <div class="label" style="margin-bottom:10px">Invite Parent to Portal</div>
    <ol>
      <li>Go to <a href="${DURL}/admin/users" target="_blank" rel="noopener">Directus → Users ↗</a></li>
      <li>Click <strong>Invite Users</strong></li>
      <li>Enter <strong>${enr.parent_email}</strong></li>
      <li>Set role to <strong>parent</strong></li>
      <li>Click Send</li>
    </ol>
  </div>
</div>` : ''}`;

  // Bind modal actions
  document.querySelectorAll('[data-modal-action]').forEach(btn => {
    btn.addEventListener('click', async () => {
      if (btn.dataset.modalAction === 'accept') {
        await aapi(`/items/academy_enrollments/${btn.dataset.id}`, { method:'PATCH', body:JSON.stringify({status:'accepted'}) });
        enr.status = 'accepted';
        renderStats(); renderEnrollments();
        openEnrollmentModal(enr);
      }
      if (btn.dataset.modalAction === 'reject') {
        if (!confirm(`Reject ${enr.player_first_name}'s application?`)) return;
        await aapi(`/items/academy_enrollments/${btn.dataset.id}`, { method:'PATCH', body:JSON.stringify({status:'inactive'}) });
        enr.status = 'inactive';
        renderStats(); renderEnrollments();
        closeModal();
      }
    });
  });

  // Inline profile form
  const profileForm = document.getElementById('inline-profile-form');
  if (profileForm) {
    profileForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const msgEl = document.getElementById('ip-msg');
      const payload = {
        enrollment:     enr.id,
        position:       document.getElementById('ip-position').value,
        jersey_number:  parseInt(document.getElementById('ip-jersey').value) || null,
        notes:          document.getElementById('ip-notes').value.trim() || null,
      };
      const result = await aapi('/items/academy_player_profiles', { method:'POST', body:JSON.stringify(payload) });
      if (result) {
        allPlayers.push({ id: result.id || 'new', enrollment: { id: enr.id, ...enr }, ...payload });
        msgEl.textContent = 'Profile created!'; msgEl.hidden = false;
        renderPlayers();
        setTimeout(() => openEnrollmentModal(enr), 1000);
      } else {
        msgEl.textContent = 'Failed — try again.'; msgEl.hidden = false;
      }
    });
  }

  document.getElementById('enr-modal').hidden = false;
}

function openCreateProfileModal(enr) { openEnrollmentModal(enr); }

function closeModal() { document.getElementById('enr-modal').hidden = true; }
document.getElementById('modal-close').addEventListener('click', closeModal);
document.getElementById('enr-modal').addEventListener('click', (e) => { if (e.target === document.getElementById('enr-modal')) closeModal(); });

// ── PLAYERS ───────────────────────────────────────────────────
async function renderPlayers() {
  const grid = document.getElementById('players-grid');
  const search = document.getElementById('player-search')?.value?.toLowerCase() || '';
  const players = search
    ? allPlayers.filter(p => `${p.enrollment?.player_first_name||''} ${p.enrollment?.player_last_name||''}`.toLowerCase().includes(search))
    : allPlayers;

  if (!players.length) {
    grid.innerHTML = '<p class="empty-msg" style="padding:32px">No player profiles yet. Accept an enrollment and create a profile first.</p>';
    return;
  }

  // Fetch latest assessments for all players in one go
  const playerIds = players.map(p => p.id).join(',');
  const assessments = playerIds ? await aapi(
    `/items/academy_assessments?filter[player][_in]=${playerIds}&filter[is_latest][_eq]=true&fields=player,pace_raw,shooting_raw,passing_raw,dribbling_raw,defending_raw,physical_raw,assessment_date`
  ) : [];
  const assessMap = {};
  (assessments || []).forEach(a => { assessMap[a.player] = a; });

  grid.innerHTML = players.map(p => {
    const enr  = p.enrollment || {};
    const name = `${enr.player_first_name||''} ${enr.player_last_name||''}`.trim();
    const ag   = enr.age_group || 'u12-u13';
    const a    = assessMap[p.id];
    let cardHtml = '';
    if (a) {
      const { ov, attrs } = overall(a, ag, p.position||'midfielder');
      const tc = tierClass(ov);
      cardHtml = `<div class="mini-card ${tc}"><div class="mc-top"><span class="mc-ov">${ov}</span></div><div class="mc-attrs">${Object.entries(attrs).map(([k,v])=>`<span><b>${k.toUpperCase()}</b>${v}</span>`).join('')}</div></div>`;
    } else {
      cardHtml = `<div class="mini-card card-bronze unrated"><div class="mc-top"><span class="mc-ov">—</span></div><div class="mc-no-assess">Not yet assessed</div></div>`;
    }
    const lastAssessed = a ? new Date(a.assessment_date).toLocaleDateString('en-AU',{month:'short',year:'numeric'}) : 'Never';
    return `
<div class="player-card card">
  ${cardHtml}
  <div class="pc-info">
    <div class="pc-name">${name}</div>
    <div class="pc-meta">
      <span class="age-chip">${ag.toUpperCase().replace('-','/')}</span>
      <span class="pos-chip">${(p.position||'MID').slice(0,3).toUpperCase()}</span>
    </div>
    <div class="pc-last">Last assessed: ${lastAssessed}</div>
  </div>
</div>`;
  }).join('');
}

document.getElementById('player-search').addEventListener('input', renderPlayers);

// ── MESSAGES ──────────────────────────────────────────────────
async function loadMessages() {
  const messages = await aapi(
    '/items/academy_messages?sort[]=-date_created&limit=500&fields=id,player,sender_role,sender_name,body,date_created,read_at'
  );
  allMessages = messages || [];
  renderThreadList();
}

function renderThreadList() {
  const list = document.getElementById('thread-list');
  // Group by player
  const threads = {};
  allMessages.forEach(m => {
    const pid = m.player;
    if (!threads[pid]) threads[pid] = [];
    threads[pid].push(m);
  });

  const playerMap = {};
  allPlayers.forEach(p => {
    playerMap[p.id] = `${p.enrollment?.player_first_name||''} ${p.enrollment?.player_last_name||''}`.trim();
  });

  const threadEntries = Object.entries(threads);
  if (!threadEntries.length) {
    list.innerHTML = '<div class="thread-list-header">All Conversations</div><p class="empty-msg" style="padding:16px">No messages yet.</p>';
    return;
  }

  list.innerHTML = '<div class="thread-list-header">All Conversations</div>' + threadEntries.map(([pid, msgs]) => {
    const latest = msgs[0];
    const unread = msgs.filter(m => m.sender_role === 'parent' && !m.read_at).length;
    const name = playerMap[pid] || 'Unknown Player';
    const preview = latest.body.length > 50 ? latest.body.slice(0,50)+'…' : latest.body;
    return `
<button class="thread-item" data-player-id="${pid}">
  <div class="ti-name">${name} ${unread ? `<span class="unread-badge">${unread}</span>` : ''}</div>
  <div class="ti-preview">${preview}</div>
</button>`;
  }).join('');

  list.querySelectorAll('.thread-item').forEach(btn => {
    btn.addEventListener('click', () => openThread(btn.dataset.playerId));
  });
}

function openThread(playerId) {
  const msgs = allMessages.filter(m => m.player === playerId);
  const playerMap = {};
  allPlayers.forEach(p => { playerMap[p.id] = `${p.enrollment?.player_first_name||''} ${p.enrollment?.player_last_name||''}`.trim(); });
  const name = playerMap[playerId] || 'Player';

  // Mark parent messages as read
  msgs.filter(m => m.sender_role === 'parent' && !m.read_at).forEach(m => {
    aapi(`/items/academy_messages/${m.id}`, { method:'PATCH', body:JSON.stringify({read_at: new Date().toISOString()}) });
    m.read_at = new Date().toISOString();
  });

  document.getElementById('thread-detail').innerHTML = `
<div class="thread-header">
  <strong>${name}</strong>
</div>
<div class="thread-msgs" id="thread-msgs-${playerId}">
  ${msgs.sort((a,b)=>new Date(a.date_created)-new Date(b.date_created)).map(m => `
  <div class="msg msg--${m.sender_role}">
    <div class="msg-meta">
      <span class="msg-author">${m.sender_name || (m.sender_role==='coach'?'You':'Parent')}</span>
      <span class="msg-date">${new Date(m.date_created).toLocaleDateString('en-AU',{day:'numeric',month:'short',year:'numeric'})}</span>
    </div>
    <div class="msg-body">${m.body.replace(/\n/g,'<br>')}</div>
  </div>`).join('')}
</div>
<form class="reply-form" data-player="${playerId}">
  <textarea class="reply-input" rows="3" placeholder="Write a reply…"></textarea>
  <button type="submit" class="btn btn-primary btn-sm">Send Reply →</button>
</form>`;

  const msgs_el = document.getElementById(`thread-msgs-${playerId}`);
  if (msgs_el) msgs_el.scrollTop = msgs_el.scrollHeight;

  document.querySelector(`.reply-form[data-player="${playerId}"]`).addEventListener('submit', async (e) => {
    e.preventDefault();
    const textarea = e.target.querySelector('.reply-input');
    const body = textarea.value.trim();
    if (!body) return;
    const user = ALS.user;
    const payload = {
      player: playerId, sender_role: 'coach',
      sender_name: `${user?.first_name||''} ${user?.last_name||''}`.trim() || 'Technical Director',
      body,
    };
    const result = await aapi('/items/academy_messages', { method:'POST', body:JSON.stringify(payload) });
    if (result) {
      allMessages.unshift({ ...payload, id: result.id, date_created: new Date().toISOString(), read_at: null });
      textarea.value = '';
      openThread(playerId);
      renderThreadList();
    }
  });

  renderThreadList();
}

// ── LOGIN ─────────────────────────────────────────────────────
document.getElementById('admin-login-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  const errEl = document.getElementById('a-login-error');
  const btn   = document.getElementById('a-login-btn');
  errEl.hidden = true; btn.disabled = true; btn.textContent = 'Signing in…';

  try {
    const res = await fetch(`${DURL}/auth/login`, {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ email: document.getElementById('a-email').value.trim(), password: document.getElementById('a-password').value }),
    });
    const json = await res.json();
    if (!res.ok) throw new Error(json?.errors?.[0]?.message || 'Login failed');

    ALS.token   = json.data.access_token;
    ALS.refresh = json.data.refresh_token;

    const user = await aapi('/users/me?fields=id,email,first_name,last_name,role.name');
    if (!user) throw new Error('Could not load user');
    ALS.user = user;

    // Allow admin and coach roles
    const role = (user?.role?.name||'').toLowerCase();
    if (!['administrator','admin','coach'].some(r => role.includes(r))) {
      ALS.clear();
      throw new Error('Your account does not have Technical Director access.');
    }

    showDashboard();
    loadAll();
  } catch (err) {
    errEl.textContent = err.message;
    errEl.hidden = false;
    btn.disabled = false; btn.textContent = 'Sign In →';
  }
});

document.getElementById('a-logout-btn').addEventListener('click', () => {
  if (ALS.token) fetch(`${DURL}/auth/logout`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({refresh_token:ALS.refresh})}).catch(()=>{});
  showLogin();
});

// ── INIT ──────────────────────────────────────────────────────
(async function init() {
  if (!ALS.token) { showLogin(); return; }
  const user = await aapi('/users/me?fields=id,email,first_name,last_name,role.name');
  if (!user) { showLogin(); return; }
  ALS.user = user;
  showDashboard();
  loadAll();
})();
</script>

