---
// src/pages/academy/admin.astro
// Technical Director admin portal — full rewrite
import PortalBase from '../../layouts/PortalBase.astro';
---
<PortalBase
  title="Academy — Technical Director"
  description="Warriors FC Academy administration panel."
>

<style is:global>
@import url('https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Barlow+Condensed:wght@400;600;700;800;900&display=swap');

[hidden] { display: none !important; }

:root {
  --bg: #f4f6f8;
  --surface: #ffffff;
  --card: #f8f9fa;
  --border: #e1e4e8;
  --text: #1c2128;
  --muted: #656d76;
  --green: #1d7a3a;
  --green-light: #e6f4ea;
  --green-accent: #2da44e;
  --amber: #9a6700;
  --amber-light: #fff8c5;
  --red: #cf222e;
  --red-light: #ffebe9;
  --blue: #0969da;
  --blue-light: #ddf4ff;
  --font-body: 'Barlow', sans-serif;
  --font-cond: 'Barlow Condensed', sans-serif;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body { background: var(--bg); color: var(--text); font-family: var(--font-body); font-size: 14px; }

/* Login */
.login-hero { background: linear-gradient(135deg, #1c2128 0%, #0d1117 100%); padding: 60px 24px; text-align: center; }
.login-label { font-family: var(--font-cond); font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: #8b949e; }
.login-title { font-family: var(--font-cond); font-size: 36px; font-weight: 800; color: #fff; margin-top: 8px; }
.login-sub { color: #6e7681; font-size: 14px; margin-top: 8px; }
.login-outer { display: flex; justify-content: center; padding: 32px 24px 48px; }
.login-card { width: 100%; max-width: 400px; background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 24px; display: flex; flex-direction: column; gap: 14px; box-shadow: 0 4px 16px rgba(0,0,0,0.08); }
.field-group { display: flex; flex-direction: column; gap: 5px; }
.field-group label { font-size: 13px; font-weight: 600; }
.field-group input { padding: 9px 12px; border: 1px solid var(--border); border-radius: 6px; font-size: 14px; background: var(--card); }
.field-group input:focus { outline: none; border-color: var(--green-accent); }
.error-text { font-size: 13px; color: var(--red); }

/* Topbar */
.topbar { background: var(--surface); border-bottom: 1px solid var(--border); position: sticky; top: 0; z-index: 100; box-shadow: 0 1px 4px rgba(0,0,0,0.06); }
.topbar-row1 { max-width: 1400px; margin: 0 auto; padding: 12px 24px; display: flex; justify-content: space-between; align-items: center; }
.topbar-label { font-family: var(--font-cond); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); display: block; }
.topbar-title { font-family: var(--font-cond); font-size: 20px; font-weight: 800; color: var(--text); }
.topbar-right { display: flex; align-items: center; gap: 12px; }
.topbar-row2 { max-width: 1400px; margin: 0 auto; padding: 0 24px; display: flex; gap: 2px; border-top: 1px solid var(--border); }
.tab-nav { padding: 10px 16px; font-family: var(--font-cond); font-size: 13px; font-weight: 700; letter-spacing: 0.05em; background: none; border: none; color: var(--muted); cursor: pointer; border-bottom: 2px solid transparent; margin-bottom: -1px; display: flex; align-items: center; gap: 6px; transition: color 0.2s; }
.tab-nav:hover { color: var(--text); }
.tab-nav--active { color: var(--green-accent); border-bottom-color: var(--green-accent); }
.tab-badge { background: var(--red); color: #fff; border-radius: 10px; padding: 1px 6px; font-size: 11px; }

/* Stats chips */
.stats-bar { display: flex; gap: 8px; align-items: center; }
.stat-chip { font-family: var(--font-cond); font-size: 12px; font-weight: 700; padding: 3px 10px; border-radius: 12px; }
.stat-chip--amber { background: var(--amber-light); color: var(--amber); }
.stat-chip--green { background: var(--green-light); color: var(--green); }
.stat-chip--red   { background: var(--red-light); color: var(--red); }

/* Split pane layout */
.split-pane { display: grid; grid-template-columns: 280px 1fr; height: calc(100vh - 113px); }
.split-list { border-right: 1px solid var(--border); background: var(--surface); display: flex; flex-direction: column; overflow: hidden; }
.split-detail { overflow-y: auto; background: var(--bg); }

/* Filter bar */
.filter-bar { padding: 10px 12px; border-bottom: 1px solid var(--border); display: flex; gap: 4px; flex-wrap: wrap; }
.filter-btn { padding: 4px 10px; border: 1px solid var(--border); border-radius: 16px; font-family: var(--font-cond); font-size: 12px; font-weight: 700; cursor: pointer; background: none; color: var(--muted); display: flex; align-items: center; gap: 4px; transition: all 0.15s; }
.filter-btn:hover { border-color: var(--green-accent); color: var(--green-accent); }
.filter-btn--active { background: var(--green-light); border-color: var(--green-accent); color: var(--green-accent); }
.filter-btn:disabled { opacity: 0.4; pointer-events: none; }
.filter-count { font-size: 11px; background: rgba(0,0,0,0.06); padding: 0 4px; border-radius: 8px; }

/* Item lists */
.list-header { padding: 10px 12px; border-bottom: 1px solid var(--border); }
.list-heading { font-family: var(--font-cond); font-size: 14px; font-weight: 700; color: var(--text); }
.item-list { flex: 1; overflow-y: auto; }
.search-input { width: 100%; padding: 7px 10px; border: 1px solid var(--border); border-radius: 6px; font-size: 13px; }
.search-input:focus { outline: none; border-color: var(--green-accent); }

/* Enrollment list items */
.enr-item { padding: 11px 14px; border-bottom: 1px solid var(--border); cursor: pointer; transition: background 0.1s; }
.enr-item:hover { background: var(--card); }
.enr-item.selected { background: var(--green-light); }
.enr-name { font-weight: 600; font-size: 14px; }
.enr-meta { font-size: 12px; color: var(--muted); margin-top: 2px; }
.status-badge { display: inline-block; font-family: var(--font-cond); font-size: 10px; font-weight: 700; padding: 2px 7px; border-radius: 10px; letter-spacing: 0.04em; float: right; }
.status-pending  { background: var(--amber-light); color: var(--amber); }
.status-accepted { background: var(--blue-light); color: var(--blue); }
.status-enrolled { background: var(--green-light); color: var(--green); }
.status-inactive { background: var(--card); color: var(--muted); }

/* Player list items */
.player-item { padding: 10px 14px; border-bottom: 1px solid var(--border); cursor: pointer; transition: background 0.1s; }
.player-item:hover { background: var(--card); }
.player-item.selected { background: var(--green-light); }
.pi-name { font-weight: 600; font-size: 14px; }
.pi-meta { font-size: 12px; color: var(--muted); margin-top: 2px; }
.tier-chip { font-family: var(--font-cond); font-size: 10px; font-weight: 700; padding: 2px 7px; border-radius: 10px; letter-spacing: 0.04em; float: right; }
.tier-bronze  { background: rgba(160,80,20,0.1); color: #9a4a0e; }
.tier-silver  { background: rgba(80,100,150,0.1); color: #506090; }
.tier-gold    { background: rgba(150,110,0,0.1); color: #8a6400; }
.tier-elite   { background: rgba(0,80,160,0.1); color: #0050a0; }
.tier-unrated { background: var(--card); color: var(--muted); }

/* Detail pane common */
.detail-empty { padding: 40px 24px; color: var(--muted); font-style: italic; }
.detail-section { padding: 24px; border-bottom: 1px solid var(--border); }
.detail-title { font-family: var(--font-cond); font-size: 22px; font-weight: 800; margin-bottom: 6px; }
.detail-meta-grid { display: grid; grid-template-columns: 120px 1fr; gap: 6px 16px; margin-bottom: 16px; }
.meta-label { font-size: 12px; color: var(--muted); font-family: var(--font-cond); letter-spacing: 0.04em; text-transform: uppercase; padding-top: 1px; }
.meta-value { font-size: 14px; font-weight: 500; }
.medical-alert { background: var(--red-light); border: 1px solid #ffcdd2; border-radius: 6px; padding: 10px 14px; font-size: 13px; color: var(--red); margin-bottom: 16px; }
.action-row { display: flex; gap: 10px; flex-wrap: wrap; }

/* Create profile form */
.create-profile-form { display: flex; flex-direction: column; gap: 14px; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.form-field { display: flex; flex-direction: column; gap: 4px; }
.form-field label { font-size: 12px; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; font-family: var(--font-cond); }
.form-field select,
.form-field input { padding: 8px 10px; border: 1px solid var(--border); border-radius: 6px; font-size: 14px; background: var(--surface); }

/* Player detail - two column */
.player-detail-grid { display: grid; grid-template-columns: 200px 1fr; gap: 24px; align-items: start; }
.player-card-col { display: flex; flex-direction: column; align-items: center; gap: 10px; }

/* Assessment sliders */
.sliders-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 16px; margin-bottom: 14px; }
.slider-field { display: flex; flex-direction: column; gap: 4px; }
.slider-row { display: flex; justify-content: space-between; align-items: center; }
.slider-name { font-family: var(--font-cond); font-size: 13px; font-weight: 700; letter-spacing: 0.05em; }
.norm-chip { font-family: var(--font-cond); font-size: 11px; font-weight: 700; padding: 2px 7px; border-radius: 10px; }
.nc-green { background: #dcfce7; color: #166534; }
.nc-amber { background: var(--amber-light); color: #78350f; }
.nc-red   { background: var(--red-light); color: #7f1d1d; }
input[type=range] { width: 100%; accent-color: var(--green-accent); }

/* FIFA card */
.fifa-card { width: 190px; border-radius: 14px; padding: 16px 14px 14px; position: relative; filter: drop-shadow(0 10px 28px rgba(0,0,0,0.25)); }
.card-bronze { background: linear-gradient(145deg, #3d2008 0%, #7c4010 40%, #b86020 100%); }
.card-silver { background: linear-gradient(145deg, #1a1f2e 0%, #3a4060 40%, #6070a0 100%); }
.card-gold   { background: linear-gradient(145deg, #2a1f00 0%, #7a5800 40%, #c09020 100%); }
.card-elite  { background: linear-gradient(145deg, #001a2e 0%, #003060 40%, #0060b0 100%); }
.fc-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 6px; }
.fc-overall { font-size: 36px; font-weight: 900; color: #fff; line-height: 1; font-family: var(--font-cond); }
.fc-pos   { font-size: 11px; color: rgba(255,255,255,0.7); font-family: var(--font-cond); font-weight: 700; }
.fc-tier  { font-size: 9px; color: rgba(255,255,255,0.5); font-family: var(--font-cond); text-transform: uppercase; }
.fc-photo { display: flex; justify-content: center; margin: 8px 0; }
.fc-photo-img { width: 72px; height: 72px; border-radius: 50%; object-fit: cover; border: 2px solid rgba(255,255,255,0.3); }
.fc-name  { text-align: center; font-size: 12px; font-weight: 800; color: #fff; font-family: var(--font-cond); letter-spacing: 0.07em; margin: 4px 0 2px; }
.fc-age   { text-align: center; font-size: 9px; color: rgba(255,255,255,0.5); font-family: var(--font-cond); margin-bottom: 10px; }
.fc-stats { display: grid; grid-template-columns: repeat(3,1fr); gap: 4px 8px; }
.fc-stat  { display: flex; flex-direction: column; align-items: center; }
.fc-sv    { font-size: 14px; font-weight: 800; color: #fff; font-family: var(--font-cond); line-height: 1; }
.fc-sl    { font-size: 8px; color: rgba(255,255,255,0.6); font-family: var(--font-cond); }
.fc-no-assess { text-align: center; color: rgba(255,255,255,0.4); font-size: 12px; padding: 12px 0; }

/* Save banner */
.save-banner { display: none; background: var(--green-accent); color: #fff; border-radius: 6px; padding: 10px 14px; font-family: var(--font-cond); font-size: 13px; font-weight: 700; margin-bottom: 12px; }
.save-banner.visible { display: flex; align-items: center; gap: 6px; }

/* Messages */
.message-thread { max-height: 320px; overflow-y: auto; display: flex; flex-direction: column; gap: 10px; padding: 12px; background: var(--card); border-radius: 8px; margin-bottom: 12px; }
.msg-bubble { max-width: 80%; }
.msg--parent { align-self: flex-start; }
.msg--coach  { align-self: flex-end; }
.msg-body { padding: 9px 13px; border-radius: 10px; font-size: 13px; line-height: 1.5; white-space: pre-wrap; }
.msg--parent .msg-body { background: var(--surface); border: 1px solid var(--border); }
.msg--coach  .msg-body { background: var(--green-light); border: 1px solid #a7f3d0; }
.msg-meta { font-size: 11px; color: var(--muted); font-family: var(--font-cond); margin-top: 3px; }
.msg--coach .msg-meta { text-align: right; }
.msg-empty { color: var(--muted); font-style: italic; text-align: center; padding: 20px; font-size: 13px; }
.reply-form { display: flex; flex-direction: column; gap: 8px; }
.reply-textarea { width: 100%; padding: 9px; border: 1px solid var(--border); border-radius: 6px; font-size: 13px; font-family: var(--font-body); resize: vertical; min-height: 72px; }
.reply-textarea:focus { outline: none; border-color: var(--green-accent); }
.reply-footer { display: flex; justify-content: flex-end; align-items: center; gap: 10px; }

/* Thread list */
.thread-item { padding: 12px 14px; border-bottom: 1px solid var(--border); cursor: pointer; transition: background 0.1s; }
.thread-item:hover { background: var(--card); }
.thread-item.selected { background: var(--green-light); }
.thread-item.unread .thread-name::before { content: '●'; color: var(--red); font-size: 8px; margin-right: 6px; vertical-align: middle; }
.thread-name { font-weight: 600; font-size: 14px; }
.thread-preview { font-size: 12px; color: var(--muted); margin-top: 3px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.thread-date { font-size: 11px; color: var(--muted); float: right; font-family: var(--font-cond); }

/* Buttons */
.btn-primary { width: 100%; padding: 11px; background: var(--green-accent); color: #fff; border: none; border-radius: 7px; font-family: var(--font-cond); font-size: 15px; font-weight: 800; letter-spacing: 0.04em; cursor: pointer; }
.btn-primary:hover { background: var(--green); }
.btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }
.btn-green { background: var(--green-accent); color: #fff; border: none; border-radius: 7px; padding: 9px 18px; font-family: var(--font-cond); font-size: 13px; font-weight: 800; cursor: pointer; }
.btn-green:hover { background: var(--green); }
.btn-green:disabled { opacity: 0.5; cursor: not-allowed; }
.btn-outline { background: none; border: 1px solid var(--border); border-radius: 7px; padding: 8px 16px; font-family: var(--font-cond); font-size: 13px; font-weight: 700; cursor: pointer; color: var(--text); }
.btn-outline:hover { border-color: var(--text); }
.btn-danger { background: none; border: 1px solid var(--red); color: var(--red); border-radius: 7px; padding: 8px 16px; font-family: var(--font-cond); font-size: 13px; font-weight: 700; cursor: pointer; }
.btn-danger:hover { background: var(--red-light); }
.accept-pw-panel { background: #fffbeb; border: 1px solid #fcd34d; border-radius: 8px; padding: 14px; margin-top: 4px; }
.accept-pw-desc { font-size: 13px; color: #78350f; margin: 4px 0 12px; line-height: 1.4; }
.accept-pw-panel .section-heading { color: #92400e; margin: 0 0 8px; }
.creds-box { background: #f0fdf4; border: 1px solid #86efac; border-radius: 8px; padding: 14px; margin-top: 8px; }
.creds-box.creds-warn { background: #fffbeb; border-color: #fcd34d; }
.creds-title { font-family: var(--font-cond); font-weight: 700; font-size: 15px; color: #166534; margin: 0 0 8px; }
.creds-warn .creds-title { color: #92400e; }
.cred-row { display: flex; gap: 10px; align-items: center; font-size: 13px; color: #374151; margin-bottom: 4px; }
.cred-row span { color: #6b7280; min-width: 60px; }
.cred-row code { background: #fff; border: 1px solid #d1fae5; border-radius: 4px; padding: 2px 8px; font-size: 13px; color: #065f46; user-select: all; }
.creds-warn .cred-row code { border-color: #fcd34d; color: #92400e; }
.creds-continue { font-size: 12px; margin-top: 10px; color: var(--green-accent); }
.pref-note { font-size: 12px; color: #6b7280; margin: 0 0 10px; background: #f9fafb; border-radius: 4px; padding: 6px 10px; }
.btn-ghost { background: none; border: none; color: var(--muted); cursor: pointer; font-family: var(--font-cond); font-size: 13px; font-weight: 700; padding: 6px 10px; }
.btn-ghost:hover { color: var(--text); }

/* Misc */
.full-loading { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 60vh; gap: 16px; color: var(--muted); }
.spinner { width: 28px; height: 28px; border: 3px solid var(--border); border-top-color: var(--green-accent); border-radius: 50%; animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.tab-panel { display: none; }
.tab-panel.active { display: grid; }
.section-heading { font-family: var(--font-cond); font-size: 12px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); margin-bottom: 12px; }
.notes-textarea { width: 100%; padding: 9px; border: 1px solid var(--border); border-radius: 6px; font-size: 13px; font-family: var(--font-body); resize: vertical; }
.notes-textarea:focus { outline: none; border-color: var(--green-accent); }

.view { display: block; }

@media (max-width: 900px) {
  .split-pane { grid-template-columns: 1fr; height: auto; }
  .split-list { max-height: 250px; border-right: none; border-bottom: 1px solid var(--border); }
  .player-detail-grid { grid-template-columns: 1fr; }
  .form-row { grid-template-columns: 1fr; }
  .sliders-grid { grid-template-columns: 1fr; }
}
</style>

<!-- View: Login -->
<div id="view-login" class="view">
  <div class="login-hero">
    <span class="login-label">Warriors Academy</span>
    <h1 class="login-title">Technical Director Portal</h1>
    <p class="login-sub">Manage enrollments, players, and communications</p>
  </div>
  <div class="login-outer">
    <div class="login-card">
      <div class="field-group">
        <label>Email</label>
        <input id="login-email" type="email" autocomplete="email">
      </div>
      <div class="field-group">
        <label>Password</label>
        <input id="login-password" type="password" autocomplete="current-password">
      </div>
      <button id="login-btn" class="btn-primary">Sign In &rarr;</button>
      <p id="login-error" class="error-text" hidden></p>
    </div>
  </div>
</div>

<!-- View: Dashboard -->
<div id="view-dashboard" class="view" hidden>

  <!-- Topbar -->
  <div class="topbar">
    <div class="topbar-row1">
      <div class="topbar-left">
        <span class="topbar-label">Warriors Academy</span>
        <h1 class="topbar-title">Technical Director</h1>
      </div>
      <div class="topbar-right">
        <div id="stats-bar" class="stats-bar">
          <span id="stat-pending"  class="stat-chip stat-chip--amber" hidden></span>
          <span id="stat-active"   class="stat-chip stat-chip--green" hidden></span>
          <span id="stat-unread"   class="stat-chip stat-chip--red"   hidden></span>
        </div>
        <button id="logout-btn" class="btn-ghost">Sign Out</button>
      </div>
    </div>
    <div class="topbar-row2">
      <button class="tab-nav tab-nav--active" data-tab="registrations">Registrations</button>
      <button class="tab-nav" data-tab="players">Players</button>
      <button class="tab-nav" data-tab="messages">
        Messages <span id="msg-tab-badge" class="tab-badge" hidden></span>
      </button>
    </div>
  </div>

  <!-- Loading -->
  <div id="admin-loading" class="full-loading">
    <div class="spinner"></div>
    <p>Loading academy data&hellip;</p>
  </div>

  <!-- Tab: Registrations -->
  <div id="tab-registrations" class="tab-panel split-pane" hidden>
    <div class="split-list">
      <div class="filter-bar">
        <button class="filter-btn filter-btn--active" data-filter="pending">Pending <span class="filter-count" id="fc-pending">0</span></button>
        <button class="filter-btn" data-filter="accepted">Accepted <span class="filter-count" id="fc-accepted">0</span></button>
        <button class="filter-btn" data-filter="enrolled">Enrolled <span class="filter-count" id="fc-enrolled">0</span></button>
        <button class="filter-btn" data-filter="all">All</button>
      </div>
      <div id="enrollment-list" class="item-list"></div>
    </div>
    <div id="enrollment-detail" class="split-detail">
      <div class="detail-empty">Select an application to review it.</div>
    </div>
  </div>

  <!-- Tab: Players -->
  <div id="tab-players" class="tab-panel split-pane" hidden>
    <div class="split-list">
      <div class="list-header">
        <input id="player-search" type="search" placeholder="Search players&hellip;" class="search-input">
      </div>
      <div id="admin-player-list" class="item-list"></div>
    </div>
    <div id="player-detail" class="split-detail">
      <div class="detail-empty">Select a player to view their profile and send messages.</div>
    </div>
  </div>

  <!-- Tab: Messages -->
  <div id="tab-messages" class="tab-panel split-pane" hidden>
    <div class="split-list">
      <div class="list-header">
        <h3 class="list-heading">Conversations</h3>
      </div>
      <div id="thread-list" class="item-list"></div>
    </div>
    <div id="thread-detail" class="split-detail">
      <div class="detail-empty">Select a conversation to read and reply.</div>
    </div>
  </div>

</div><!-- /view-dashboard -->

<script>
const DURL = import.meta.env.PUBLIC_DIRECTUS_URL || 'https://directus-production-ebbb.up.railway.app';

// ── Helpers ──────────────────────────────────────────────────────────────────

function asArray(v) { return Array.isArray(v) ? v : []; }

const ALS = {
  get token()   { return sessionStorage.getItem('warriors_admin_token'); },
  get refresh() { return sessionStorage.getItem('warriors_admin_refresh'); },
  get user()    { try { return JSON.parse(sessionStorage.getItem('warriors_admin_user')||'null'); } catch { return null; } },
  set token(v)  { sessionStorage.setItem('warriors_admin_token', v); },
  set refresh(v){ sessionStorage.setItem('warriors_admin_refresh', v); },
  set user(v)   { sessionStorage.setItem('warriors_admin_user', JSON.stringify(v)); },
  clear()       { ['warriors_admin_token','warriors_admin_refresh','warriors_admin_user'].forEach(k => sessionStorage.removeItem(k)); },
};

// ── FIFA card system ──────────────────────────────────────────────────────────

const AGE_SCALE = {
  'u8-u9':   { min: 30, max: 72 },
  'u10-u11': { min: 35, max: 78 },
  'u12-u13': { min: 40, max: 83 },
  'u14-u16': { min: 45, max: 90 },
};

function norm(raw, ag) {
  const s = AGE_SCALE[ag] || AGE_SCALE['u12-u13'];
  return Math.round(s.min + (raw - 1) * (s.max - s.min) / 9);
}

function calcOverall(a, ag, pos) {
  const attrs = {
    pac: norm(a.pace_raw, ag),
    sho: norm(a.shooting_raw, ag),
    pas: norm(a.passing_raw, ag),
    dri: norm(a.dribbling_raw, ag),
    def: norm(a.defending_raw, ag),
    phy: norm(a.physical_raw, ag),
  };
  const isAtk = ['forward', 'midfielder'].includes(pos);
  const ov = isAtk
    ? Math.round((attrs.dri * 2 + attrs.sho * 2 + attrs.pac + attrs.pas + attrs.phy) / 7)
    : Math.round((attrs.def * 2 + attrs.phy * 2 + attrs.pac + attrs.pas + attrs.dri) / 7);
  return { ov, attrs };
}

function tierClass(ov)    { return ov >= 90 ? 'card-elite' : ov >= 75 ? 'card-gold' : ov >= 60 ? 'card-silver' : 'card-bronze'; }
function tierName(ov)     { return ov >= 90 ? 'Elite' : ov >= 75 ? 'Gold' : ov >= 60 ? 'Silver' : 'Bronze'; }
function tierRowClass(ov) { return ov >= 90 ? 'tier-elite' : ov >= 75 ? 'tier-gold' : ov >= 60 ? 'tier-silver' : 'tier-bronze'; }
function posLabel(p)      { return { goalkeeper: 'GK', defender: 'CB', midfielder: 'MID', forward: 'FWD' }[p] || 'MID'; }

function buildFIFACard(profile, assessment) {
  const ag  = profile.enrollment?.age_group || 'u12-u13';
  const pos = profile.position || 'midfielder';
  const enr = profile.enrollment || {};
  const name = `${enr.player_first_name || ''} ${((enr.player_last_name || '')[0] || '')}.`.trim();
  const agLabel = { 'u8-u9': 'U9', 'u10-u11': 'U11', 'u12-u13': 'U13', 'u14-u16': 'U16' }[ag] || ag.toUpperCase();
  const photoSrc = profile.photo
    ? `${DURL}/assets/${profile.photo}?width=190&height=190&format=webp&fit=cover`
    : null;
  const photoHtml = photoSrc
    ? `<img src="${photoSrc}" class="fc-photo-img" alt="${name}">`
    : `<svg viewBox="0 0 80 100" width="70" height="88" fill="none"><circle cx="40" cy="26" r="18" fill="rgba(255,255,255,0.2)"/><path d="M8 95 C8 65 20 54 40 52 C60 54 72 65 72 95" fill="rgba(255,255,255,0.2)"/></svg>`;

  if (!assessment) {
    return `<div class="fifa-card card-bronze">
      <div class="fc-header"><div><div class="fc-overall">&mdash;</div><div class="fc-pos">${posLabel(pos)}</div><div class="fc-tier">Unrated</div></div></div>
      <div class="fc-photo">${photoHtml}</div>
      <div class="fc-name">${name.toUpperCase()}</div>
      <div class="fc-age">${agLabel} &middot; Warriors FC</div>
      <div class="fc-no-assess">Not yet assessed</div>
    </div>`;
  }

  const { ov, attrs } = calcOverall(assessment, ag, pos);
  const tc = tierClass(ov);
  return `<div class="fifa-card ${tc}">
    <div class="fc-header">
      <div><div class="fc-overall">${ov}</div><div class="fc-pos">${posLabel(pos)}</div><div class="fc-tier">${tierName(ov)}</div></div>
      <svg viewBox="0 0 40 40" width="28" height="28" fill="none"><polygon points="20,3 37,12 37,28 20,37 3,28 3,12" fill="rgba(255,255,255,0.12)" stroke="rgba(255,255,255,0.25)" stroke-width="1.5"/><text x="20" y="26" text-anchor="middle" font-size="13" font-weight="bold" fill="rgba(255,255,255,0.7)" font-family="Arial">W</text></svg>
    </div>
    <div class="fc-photo">${photoHtml}</div>
    <div class="fc-name">${name.toUpperCase()}</div>
    <div class="fc-age">${agLabel} &middot; Warriors FC</div>
    <div class="fc-stats">
      ${[['PAC', attrs.pac], ['SHO', attrs.sho], ['PAS', attrs.pas], ['DRI', attrs.dri], ['DEF', attrs.def], ['PHY', attrs.phy]]
        .map(([l, v]) => `<div class="fc-stat"><span class="fc-sv">${v}</span><span class="fc-sl">${l}</span></div>`).join('')}
    </div>
  </div>`;
}

// ── State ─────────────────────────────────────────────────────────────────────

let allEnrollments        = [];
let allPlayers            = [];
let allMessages           = [];
let playerAssessMap       = {};
let activeEnrollmentFilter = 'pending';
let selectedEnrollmentId  = null;
let selectedPlayerId      = null;
let selectedThreadPlayerId = null;
let messagesLoaded        = false;

// ── API helper ────────────────────────────────────────────────────────────────

async function aapi(path, opts = {}) {
  try {
    const headers = {
      'Content-Type': 'application/json',
      'Authorization': `Bearer ${ALS.token}`,
    };
    const res = await fetch(`${DURL}${path}`, {
      ...opts,
      headers: { ...headers, ...(opts.headers || {}) },
    });
    if (res.status === 401) {
      const ok = await tryRefresh();
      if (ok) return aapi(path, opts);
      showLogin(); return null;
    }
    if (res.status === 204) return { ok: true };
    if (!res.ok) { console.warn('API error', res.status, path); return null; }
    const json = await res.json();
    return json.data ?? json;
  } catch (e) {
    console.error('aapi error', path, e);
    return null;
  }
}

// ── Load all data ─────────────────────────────────────────────────────────────

async function loadAll() {
  try {
  const [enrollRaw, playersRaw, unreadRaw] = await Promise.all([
    aapi('/items/academy_enrollments?sort[]=-date_created&limit=200&fields=id,status,date_created,parent_first_name,parent_last_name,parent_email,parent_phone,player_first_name,player_last_name,player_dob,age_group,previous_experience,medical_notes,directus_user_id,program'),
    aapi('/items/academy_player_profiles?limit=200&fields=id,position,photo,jersey_number,enrollment.id,enrollment.age_group,enrollment.player_first_name,enrollment.player_last_name,enrollment.status'),
    aapi('/items/academy_messages?filter[sender_role][_eq]=parent&filter[read_at][_null]=true&limit=200&fields=player,id'),
  ]);

  allEnrollments = asArray(enrollRaw);
  allPlayers     = asArray(playersRaw);

  // Fetch latest assessments for all players
  const assessRaw = await aapi('/items/academy_assessments?filter[is_latest][_eq]=true&limit=200&fields=player,pace_raw,shooting_raw,passing_raw,dribbling_raw,defending_raw,physical_raw,assessment_date');
  playerAssessMap = {};
  asArray(assessRaw).forEach(a => { playerAssessMap[String(a.player)] = a; });

  // Unread count
  const unreadIds   = new Set(asArray(unreadRaw).map(m => String(m.player)));
  const unreadCount = unreadIds.size;

  document.getElementById('admin-loading').hidden = true;

  // Stats bar
  const pendingCount = allEnrollments.filter(e => e.status === 'pending').length;
  const activeCount  = allPlayers.length;

  const pendingChip = document.getElementById('stat-pending');
  const activeChip  = document.getElementById('stat-active');
  const unreadChip  = document.getElementById('stat-unread');
  const msgTabBadge = document.getElementById('msg-tab-badge');

  if (pendingCount > 0) { pendingChip.textContent = `${pendingCount} Pending`; pendingChip.hidden = false; }
  if (activeCount  > 0) { activeChip.textContent  = `${activeCount} Players`;  activeChip.hidden  = false; }
  if (unreadCount  > 0) {
    unreadChip.textContent  = `${unreadCount} Unread`;
    unreadChip.hidden       = false;
    msgTabBadge.textContent = unreadCount;
    msgTabBadge.hidden      = false;
  }

  switchTab('registrations');
  renderEnrollmentList();
  renderAdminPlayerList();
  updateFilterCounts();
  } catch(err) {
    console.error('loadAll error:', err);
    document.getElementById('admin-loading').hidden = true;
    document.getElementById('tab-registrations').style.display = 'grid';
  }
}

// ── Tabs ──────────────────────────────────────────────────────────────────────

function switchTab(name) {
  document.querySelectorAll('.tab-nav').forEach(b =>
    b.classList.toggle('tab-nav--active', b.dataset.tab === name)
  );
  document.querySelectorAll('.tab-panel').forEach(p => {
    const active = p.id === `tab-${name}`;
    p.classList.toggle('active', active);
    p.hidden = false;
    p.style.display = active ? 'grid' : 'none';
  });
  if (name === 'messages' && !messagesLoaded) loadAllMessages();
}

document.querySelectorAll('.tab-nav').forEach(b =>
  b.addEventListener('click', () => switchTab(b.dataset.tab))
);

// ── Enrollments tab ───────────────────────────────────────────────────────────

function updateFilterCounts() {
  document.getElementById('fc-pending').textContent  = allEnrollments.filter(e => e.status === 'pending').length;
  document.getElementById('fc-accepted').textContent = allEnrollments.filter(e => e.status === 'accepted').length;
  document.getElementById('fc-enrolled').textContent = allEnrollments.filter(e => e.status === 'enrolled').length;

  document.querySelectorAll('.filter-btn[data-filter]').forEach(btn => {
    const f = btn.dataset.filter;
    if (f === 'all') { btn.disabled = false; return; }
    const count = allEnrollments.filter(e => e.status === f).length;
    btn.disabled = count === 0;
  });
}

function renderEnrollmentList() {
  const list = document.getElementById('enrollment-list');
  const filtered = activeEnrollmentFilter === 'all'
    ? allEnrollments
    : allEnrollments.filter(e => e.status === activeEnrollmentFilter);

  if (!filtered.length) {
    list.innerHTML = `<p style="padding:16px;color:var(--muted);font-size:13px;">No ${activeEnrollmentFilter === 'all' ? '' : activeEnrollmentFilter} applications.</p>`;
    return;
  }

  list.innerHTML = filtered.map(e => {
    const name       = `${e.player_first_name || ''} ${e.player_last_name || ''}`.trim() || 'Unknown Player';
    const parentName = `${e.parent_first_name || ''} ${e.parent_last_name || ''}`.trim() || e.parent_email || '';
    const agLabel    = { 'u8-u9': 'U8/U9', 'u10-u11': 'U10/U11', 'u12-u13': 'U12/U13', 'u14-u16': 'U14/U16' }[e.age_group] || e.age_group || '';
    const date       = e.date_created ? new Date(e.date_created).toLocaleDateString('en-AU', { day: 'numeric', month: 'short' }) : '';
    return `<div class="enr-item${selectedEnrollmentId === e.id ? ' selected' : ''}" data-id="${e.id}">
      <span class="status-badge status-${e.status}">${e.status}</span>
      <div class="enr-name">${name}</div>
      <div class="enr-meta">${parentName}${agLabel ? ' &middot; ' + agLabel : ''}${date ? ' &middot; ' + date : ''}</div>
    </div>`;
  }).join('');

  list.querySelectorAll('.enr-item').forEach(el => {
    el.addEventListener('click', () => {
      selectedEnrollmentId = el.dataset.id;
      list.querySelectorAll('.enr-item').forEach(i => i.classList.remove('selected'));
      el.classList.add('selected');
      openEnrollmentDetail(allEnrollments.find(e => String(e.id) === String(el.dataset.id)));
    });
  });
}

document.querySelectorAll('.filter-btn[data-filter]').forEach(btn => {
  btn.addEventListener('click', () => {
    activeEnrollmentFilter = btn.dataset.filter;
    document.querySelectorAll('.filter-btn[data-filter]').forEach(b => b.classList.remove('filter-btn--active'));
    btn.classList.add('filter-btn--active');
    renderEnrollmentList();
  });
});

function openEnrollmentDetail(enr) {
  if (!enr) return;
  const detail     = document.getElementById('enrollment-detail');
  const ag         = enr.age_group || '';
  const agLabel    = { 'u8-u9': 'U8/U9', 'u10-u11': 'U10/U11', 'u12-u13': 'U12/U13', 'u14-u16': 'U14/U16' }[ag] || ag;
  const playerName = `${enr.player_first_name || ''} ${enr.player_last_name || ''}`.trim();
  const parentName = `${enr.parent_first_name || ''} ${enr.parent_last_name || ''}`.trim() || 'N/A';
  const dob        = enr.player_dob ? new Date(enr.player_dob).toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' }) : 'N/A';
  const submitted  = enr.date_created ? new Date(enr.date_created).toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' }) : '';

  let actionHtml = '';

  if (enr.status === 'pending') {
    actionHtml = `
    <div id="accept-btn-row" class="action-row">
      <button class="btn-green" id="btn-accept">Accept Application &rarr;</button>
      <button class="btn-danger" id="btn-reject">Reject &times;</button>
    </div>
    <div id="accept-pw-panel" class="accept-pw-panel" hidden>
      <p class="section-heading">Set Parent Login</p>
      <p class="accept-pw-desc">Creating account for <strong>${parentName}</strong> (${enr.parent_email || ''}). Set a temporary password — share it with them after accepting.</p>
      <div class="form-row">
        <div class="form-field">
          <label>Temporary Password</label>
          <input type="text" id="accept-pw" placeholder="Min 8 characters" autocomplete="off">
        </div>
      </div>
      <div class="action-row" style="margin-top:8px">
        <button class="btn-green" id="btn-accept-confirm">Create Account &amp; Accept &rarr;</button>
        <button class="btn-ghost" id="btn-accept-cancel">Cancel</button>
      </div>
      <p id="accept-pw-error" class="error-msg" hidden></p>
    </div>
    <div id="accept-creds" hidden></div>`;
  } else if (enr.status === 'accepted') {
    const existingProfile = allPlayers.find(p => String(p.enrollment?.id) === String(enr.id));
    if (existingProfile) {
      actionHtml = `<div class="action-row">
        <button class="btn-green" id="btn-mark-enrolled">Mark as Enrolled &rarr;</button>
      </div>
      <p style="font-size:12px;color:var(--muted);margin-top:8px;">Player profile created. Once enrolled, the family can access the portal.</p>`;
    } else {
      actionHtml = `<div style="margin-top:8px;">
        <p class="section-heading" style="margin-bottom:12px;">Create Player Profile</p>
        <form class="create-profile-form" id="create-profile-form">
          <div class="form-row">
            <div class="form-field">
              <label>Position</label>
              <select id="cp-position">
                <option value="goalkeeper">Goalkeeper</option>
                <option value="defender">Defender</option>
                <option value="midfielder" selected>Midfielder</option>
                <option value="forward">Forward</option>
              </select>
            </div>
            <div class="form-field">
              <label>Jersey Number</label>
              <input type="number" id="cp-jersey" min="1" max="99" placeholder="Optional">
            </div>
          </div>
          <div class="form-field">
            <label>Notes (optional)</label>
            <textarea id="cp-notes" class="notes-textarea" rows="2" placeholder="Any notes about this player&hellip;"></textarea>
          </div>
          <button type="submit" class="btn-green" id="btn-create-profile">Create Player Profile &rarr;</button>
          <p id="cp-error" class="error-text" hidden></p>
        </form>
      </div>`;
    }
  } else if (enr.status === 'enrolled') {
    actionHtml = `<p style="color:var(--green);font-weight:600;font-size:14px;">&#10003; Enrolled &mdash; Portal access active</p>`;
  }

  detail.innerHTML = `<div class="detail-section">
    <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:12px;">
      <h2 class="detail-title">${playerName}</h2>
      <span class="status-badge status-${enr.status}" style="position:static;float:none;">${enr.status}</span>
    </div>
    <div class="detail-meta-grid">
      <span class="meta-label">Age Group</span><span class="meta-value">${agLabel}</span>
      <span class="meta-label">Date of Birth</span><span class="meta-value">${dob}</span>
      <span class="meta-label">Parent</span><span class="meta-value">${parentName}</span>
      <span class="meta-label">Email</span><span class="meta-value">${enr.parent_email || 'N/A'}</span>
      <span class="meta-label">Phone</span><span class="meta-value">${enr.parent_phone || 'N/A'}</span>
      ${submitted ? `<span class="meta-label">Submitted</span><span class="meta-value">${submitted}</span>` : ''}
      ${enr.previous_experience ? `<span class="meta-label">Experience</span><span class="meta-value" style="white-space:pre-wrap;">${enr.previous_experience}</span>` : ''}
    </div>
    ${enr.medical_notes ? `<div class="medical-alert">&#9877; Medical: ${enr.medical_notes}</div>` : ''}
    ${actionHtml}
  </div>`;

  // Wire buttons
  const acceptBtn = detail.querySelector('#btn-accept');
  const rejectBtn = detail.querySelector('#btn-reject');
  const markBtn   = detail.querySelector('#btn-mark-enrolled');
  const cpForm    = detail.querySelector('#create-profile-form');

  const acceptBtnRow = detail.querySelector('#accept-btn-row');
  const acceptPwPanel = detail.querySelector('#accept-pw-panel');
  const acceptCredsEl = detail.querySelector('#accept-creds');

  if (acceptBtn) {
    acceptBtn.addEventListener('click', () => {
      acceptBtnRow.hidden = true;
      acceptPwPanel.hidden = false;
      detail.querySelector('#accept-pw')?.focus();
    });
  }

  const cancelAcceptBtn = detail.querySelector('#btn-accept-cancel');
  if (cancelAcceptBtn) {
    cancelAcceptBtn.addEventListener('click', () => {
      acceptPwPanel.hidden = true;
      acceptBtnRow.hidden = false;
    });
  }

  const confirmAcceptBtn = detail.querySelector('#btn-accept-confirm');
  if (confirmAcceptBtn) {
    confirmAcceptBtn.addEventListener('click', async () => {
      const pw = detail.querySelector('#accept-pw').value.trim();
      const errEl = detail.querySelector('#accept-pw-error');
      if (!pw || pw.length < 8) {
        errEl.textContent = 'Password must be at least 8 characters.';
        errEl.hidden = false;
        return;
      }
      confirmAcceptBtn.disabled = true;
      confirmAcceptBtn.textContent = 'Creating\u2026';
      errEl.hidden = true;

      // Check if Directus user already exists for this email
      let userId = null;
      let userExisted = false;
      try {
        const existingUsers = asArray(await aapi(`/users?filter[email][_eq]=${encodeURIComponent(enr.parent_email)}&fields=id&limit=1`));
        if (existingUsers.length) {
          userId = existingUsers[0].id;
          userExisted = true;
        } else {
          // Create new Directus user (admin token has user:create permission)
          const newUser = await aapi('/users', {
            method: 'POST',
            body: JSON.stringify({
              email:      enr.parent_email,
              password:   pw,
              first_name: enr.parent_first_name || '',
              last_name:  enr.parent_last_name  || '',
              status:     'active',
              role:       '546e9eba-1285-47dd-a881-731581b7acfb', // parent role
            }),
          });
          if (newUser?.id) userId = newUser.id;
        }
      } catch (_) { /* user creation non-fatal */ }

      const patchPayload = { status: 'accepted' };
      if (userId) patchPayload.directus_user_id = userId;

      const result = await aapi(`/items/academy_enrollments/${enr.id}`, {
        method: 'PATCH', body: JSON.stringify(patchPayload),
      });

      if (result) {
        enr.status = 'accepted';
        if (userId) enr.directus_user_id = userId;
        updateFilterCounts();
        renderEnrollmentList();
        updateStatsBar();
        acceptPwPanel.hidden = true;

        if (userId && !userExisted) {
          acceptCredsEl.innerHTML = `<div class="creds-box">
            <p class="creds-title">✓ Account created &amp; application accepted!</p>
            <p>Share these login details with ${enr.parent_first_name}:</p>
            <div class="cred-row"><span>Portal:</span><code>/academy/portal</code></div>
            <div class="cred-row"><span>Email:</span><code>${enr.parent_email}</code></div>
            <div class="cred-row"><span>Password:</span><code>${pw}</code></div>
            <button class="btn-ghost creds-continue" id="btn-continue">Continue to Player Profile &rarr;</button>
          </div>`;
        } else if (userId && userExisted) {
          acceptCredsEl.innerHTML = `<div class="creds-box">
            <p class="creds-title">✓ Accepted. Parent account already exists.</p>
            <p>They can log in to <code>/academy/portal</code> with <code>${enr.parent_email}</code>.</p>
            <button class="btn-ghost creds-continue" id="btn-continue">Continue to Player Profile &rarr;</button>
          </div>`;
        } else {
          acceptCredsEl.innerHTML = `<div class="creds-box creds-warn">
            <p class="creds-title">✓ Application accepted.</p>
            <p>Could not auto-create login (role assignment may be required in Directus admin). Please create the parent account manually with email: <code>${enr.parent_email}</code>, then link their user ID in the enrollment.</p>
            <button class="btn-ghost creds-continue" id="btn-continue">Continue &rarr;</button>
          </div>`;
        }
        acceptCredsEl.hidden = false;
        acceptCredsEl.querySelector('#btn-continue')?.addEventListener('click', () => openEnrollmentDetail(enr));
      } else {
        errEl.textContent = 'Failed to accept. Please try again.';
        errEl.hidden = false;
        confirmAcceptBtn.disabled = false;
        confirmAcceptBtn.textContent = 'Create Account & Accept \u2192';
      }
    });
  }

  if (rejectBtn) {
    rejectBtn.addEventListener('click', async () => {
      if (!confirm(`Reject ${playerName}'s application?`)) return;
      rejectBtn.disabled = true; rejectBtn.textContent = 'Rejecting\u2026';
      const result = await aapi(`/items/academy_enrollments/${enr.id}`, {
        method: 'PATCH', body: JSON.stringify({ status: 'inactive' }),
      });
      if (result) {
        enr.status = 'inactive';
        updateFilterCounts();
        renderEnrollmentList();
        document.getElementById('enrollment-detail').innerHTML = '<div class="detail-empty">Application rejected.</div>';
        updateStatsBar();
      } else {
        rejectBtn.disabled = false; rejectBtn.textContent = 'Reject \u00d7';
      }
    });
  }

  if (markBtn) {
    markBtn.addEventListener('click', async () => {
      markBtn.disabled = true; markBtn.textContent = 'Saving\u2026';
      const result = await aapi(`/items/academy_enrollments/${enr.id}`, {
        method: 'PATCH', body: JSON.stringify({ status: 'enrolled' }),
      });
      if (result) {
        enr.status = 'enrolled';
        updateFilterCounts();
        renderEnrollmentList();
        openEnrollmentDetail(enr);
        updateStatsBar();
      } else {
        markBtn.disabled = false; markBtn.textContent = 'Mark as Enrolled \u2192';
      }
    });
  }

  if (cpForm) {
    cpForm.addEventListener('submit', async e => {
      e.preventDefault();
      const btn   = cpForm.querySelector('#btn-create-profile');
      const errEl = cpForm.querySelector('#cp-error');
      btn.disabled = true; btn.textContent = 'Creating\u2026';
      errEl.hidden = true;

      const payload = {
        enrollment:    parseInt(enr.id) || enr.id,
        position:      document.getElementById('cp-position').value,
        jersey_number: parseInt(document.getElementById('cp-jersey').value) || null,
        notes:         document.getElementById('cp-notes').value.trim() || null,
      };

      const result = await aapi('/items/academy_player_profiles', {
        method: 'POST', body: JSON.stringify(payload),
      });
      if (result) {
        allPlayers.push({
          ...result,
          enrollment: {
            id: enr.id,
            age_group: enr.age_group,
            player_first_name: enr.player_first_name,
            player_last_name:  enr.player_last_name,
            status: enr.status,
          },
        });
        renderAdminPlayerList();
        openEnrollmentDetail(enr);
        updateStatsBar();
      } else {
        errEl.textContent = 'Failed to create profile. Please try again.';
        errEl.hidden = false;
        btn.disabled = false; btn.textContent = 'Create Player Profile \u2192';
      }
    });
  }
}

function updateStatsBar() {
  const pendingCount = allEnrollments.filter(e => e.status === 'pending').length;
  const pendingChip  = document.getElementById('stat-pending');
  if (pendingCount > 0) { pendingChip.textContent = `${pendingCount} Pending`; pendingChip.hidden = false; }
  else { pendingChip.hidden = true; }
}

// ── Players tab ───────────────────────────────────────────────────────────────

function renderAdminPlayerList(query = '') {
  const list    = document.getElementById('admin-player-list');
  let   players = allPlayers;
  if (query) {
    const q = query.toLowerCase();
    players = allPlayers.filter(p => {
      const name = `${p.enrollment?.player_first_name || ''} ${p.enrollment?.player_last_name || ''}`.toLowerCase();
      return name.includes(q);
    });
  }

  if (!players.length) {
    list.innerHTML = `<p style="padding:16px;color:var(--muted);font-size:13px;">No players found.</p>`;
    return;
  }

  const GROUP_ORDER  = ['u8-u9', 'u10-u11', 'u12-u13', 'u14-u16'];
  const GROUP_LABELS = { 'u8-u9': 'U8/U9', 'u10-u11': 'U10/U11', 'u12-u13': 'U12/U13', 'u14-u16': 'U14/U16' };
  const groups = {};
  players.forEach(p => {
    const ag = p.enrollment?.age_group || 'other';
    if (!groups[ag]) groups[ag] = [];
    groups[ag].push(p);
  });

  let html = '';
  if (query) {
    players.forEach(p => { html += renderPlayerListItem(p); });
  } else {
    GROUP_ORDER.forEach(ag => {
      if (!groups[ag]?.length) return;
      html += `<div style="padding:6px 12px 3px;font-family:var(--font-cond);font-size:11px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--muted);background:var(--card);border-bottom:1px solid var(--border);">${GROUP_LABELS[ag] || ag}</div>`;
      groups[ag].forEach(p => { html += renderPlayerListItem(p); });
    });
    if (groups['other']?.length) {
      groups['other'].forEach(p => { html += renderPlayerListItem(p); });
    }
  }

  list.innerHTML = html;
  list.querySelectorAll('.player-item').forEach(el => {
    el.addEventListener('click', () => {
      selectedPlayerId = el.dataset.id;
      list.querySelectorAll('.player-item').forEach(i => i.classList.remove('selected'));
      el.classList.add('selected');
      openPlayerDetail(allPlayers.find(p => String(p.id) === String(el.dataset.id)));
    });
  });
}

function renderPlayerListItem(p) {
  const enr    = p.enrollment || {};
  const name   = `${enr.player_first_name || ''} ${enr.player_last_name || ''}`.trim() || 'Unknown';
  const pos    = posLabel(p.position || 'midfielder');
  const assess = playerAssessMap[String(p.id)];
  let tierHtml = `<span class="tier-chip tier-unrated">Unrated</span>`;
  if (assess) {
    const ag     = enr.age_group || 'u12-u13';
    const { ov } = calcOverall(assess, ag, p.position || 'midfielder');
    tierHtml = `<span class="tier-chip ${tierRowClass(ov)}">${tierName(ov)} ${ov}</span>`;
  }
  return `<div class="player-item${selectedPlayerId === String(p.id) ? ' selected' : ''}" data-id="${p.id}">
    ${tierHtml}
    <div class="pi-name">${name}</div>
    <div class="pi-meta">${pos}</div>
  </div>`;
}

document.getElementById('player-search').addEventListener('input', e => renderAdminPlayerList(e.target.value));

async function openPlayerDetail(player) {
  if (!player) return;
  const detail = document.getElementById('player-detail');
  const enr    = player.enrollment || {};
  const ag     = enr.age_group || 'u12-u13';
  const pos    = player.position || 'midfielder';
  const name   = `${enr.player_first_name || ''} ${enr.player_last_name || ''}`.trim();

  detail.innerHTML = `<div class="detail-section"><div class="full-loading" style="height:200px;"><div class="spinner"></div></div></div>`;

  const [assessRaw, messagesRaw] = await Promise.all([
    aapi(`/items/academy_assessments?filter[player][_eq]=${player.id}&filter[is_latest][_eq]=true&limit=1&fields=*`),
    aapi(`/items/academy_messages?filter[player][_eq]=${player.id}&sort[]=date_created&fields=*`),
  ]);

  const latestAssess = asArray(assessRaw)[0] || null;
  const messages     = asArray(messagesRaw);
  const agLabel      = { 'u8-u9': 'U8/U9', 'u10-u11': 'U10/U11', 'u12-u13': 'U12/U13', 'u14-u16': 'U14/U16' }[ag] || ag;

  const ATTRS      = ['pace', 'shooting', 'passing', 'dribbling', 'defending', 'physical'];
  const ATTR_LABELS = { pace: 'PAC', shooting: 'SHO', passing: 'PAS', dribbling: 'DRI', defending: 'DEF', physical: 'PHY' };

  function normChipCls(v) { return v >= 65 ? 'nc-green' : v >= 50 ? 'nc-amber' : 'nc-red'; }

  const slidersHtml = ATTRS.map(attr => {
    const raw = latestAssess?.[`${attr}_raw`] ?? 5;
    const nv  = norm(raw, ag);
    return `<div class="slider-field">
      <div class="slider-row">
        <span class="slider-name">${ATTR_LABELS[attr]}</span>
        <span class="norm-chip ${normChipCls(nv)}" id="adm-chip-${attr}">${nv}</span>
      </div>
      <input type="range" min="1" max="10" value="${raw}" id="adm-slider-${attr}"
        data-attr="${attr}" data-ag="${ag}" data-playerid="${player.id}">
    </div>`;
  }).join('');

  const messagesHtml = messages.length
    ? messages.map(m => {
        const isCoach = m.sender_role === 'coach';
        const date    = new Date(m.date_created).toLocaleDateString('en-AU', { day: 'numeric', month: 'short' });
        return `<div class="msg-bubble msg--${isCoach ? 'coach' : 'parent'}">
          <div class="msg-body">${m.body}</div>
          <div class="msg-meta">${m.sender_name || (isCoach ? 'Coach' : 'Parent')} &middot; ${date}</div>
        </div>`;
      }).join('')
    : `<p class="msg-empty">No messages yet. Send one below.</p>`;

  detail.innerHTML = `<div class="detail-section">
    <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:12px;">
      <h2 class="detail-title">${name}</h2>
      <span style="font-family:var(--font-cond);font-size:12px;color:var(--muted);">${agLabel} &middot; ${posLabel(pos)}${player.jersey_number ? ' &middot; #' + player.jersey_number : ''}</span>
    </div>

    <div class="player-detail-grid">
      <div class="player-card-col">
        <div id="adm-card-preview">${buildFIFACard(player, latestAssess)}</div>
      </div>
      <div class="player-assess-col">
        <p class="section-heading">Assessment</p>
        <div id="adm-save-banner" class="save-banner"></div>
        <div class="sliders-grid">${slidersHtml}</div>
        <div style="margin-bottom:12px;">
          <label class="section-heading" style="display:block;margin-bottom:4px;">Coach Notes</label>
          <textarea id="adm-assess-notes" class="notes-textarea" rows="2" placeholder="Optional notes&hellip;">${latestAssess?.notes || ''}</textarea>
        </div>
        <button id="adm-save-btn" class="btn-green" style="width:100%;">Save Assessment &rarr;</button>
        <p id="adm-assess-error" class="error-text" hidden style="margin-top:6px;"></p>
      </div>
    </div>

    <div style="margin-top:24px;border-top:1px solid var(--border);padding-top:20px;">
      <p class="section-heading">Messages</p>
      <div class="message-thread" id="adm-msg-thread">${messagesHtml}</div>
      <form class="reply-form" id="adm-reply-form">
        <textarea class="reply-textarea" id="adm-reply-body" placeholder="Send a message to the player's family&hellip;"></textarea>
        <div class="reply-footer">
          <span id="adm-reply-error" class="error-text" hidden></span>
          <button type="submit" class="btn-green">Send Message &rarr;</button>
        </div>
      </form>
    </div>
  </div>`;

  // Scroll messages
  const thread = detail.querySelector('#adm-msg-thread');
  if (thread) setTimeout(() => { thread.scrollTop = thread.scrollHeight; }, 50);

  // Slider live update (using event delegation on the detail pane)
  detail.querySelectorAll('input[type=range]').forEach(slider => {
    slider.addEventListener('input', () => {
      const attr     = slider.dataset.attr;
      const sliderAg = slider.dataset.ag;
      const nv       = norm(parseInt(slider.value), sliderAg);
      const chip     = detail.querySelector(`#adm-chip-${attr}`);
      if (chip) {
        chip.textContent = nv;
        chip.className   = `norm-chip ${normChipCls(nv)}`;
      }
      // Rebuild card preview from all current slider values
      const ATTRS_ALL = ['pace', 'shooting', 'passing', 'dribbling', 'defending', 'physical'];
      const rawAttrs  = {};
      ATTRS_ALL.forEach(a => {
        const el = detail.querySelector(`#adm-slider-${a}`);
        rawAttrs[`${a}_raw`] = el ? parseInt(el.value) : 5;
      });
      const preview = detail.querySelector('#adm-card-preview');
      if (preview) preview.innerHTML = buildFIFACard(player, rawAttrs);
    });
  });

  // Save assessment
  const saveBtn = detail.querySelector('#adm-save-btn');
  saveBtn.addEventListener('click', async () => {
    saveBtn.disabled = true; saveBtn.textContent = 'Saving\u2026';
    const errEl = detail.querySelector('#adm-assess-error');
    errEl.hidden = true;

    const user = ALS.user;
    const payload = {
      player:            player.id,
      assessed_by:       `${user?.first_name || ''} ${user?.last_name || ''}`.trim() || 'Technical Director',
      assessment_date:   new Date().toISOString().split('T')[0],
      age_group_at_time: ag,
      pace_raw:          parseInt(detail.querySelector('#adm-slider-pace').value),
      shooting_raw:      parseInt(detail.querySelector('#adm-slider-shooting').value),
      passing_raw:       parseInt(detail.querySelector('#adm-slider-passing').value),
      dribbling_raw:     parseInt(detail.querySelector('#adm-slider-dribbling').value),
      defending_raw:     parseInt(detail.querySelector('#adm-slider-defending').value),
      physical_raw:      parseInt(detail.querySelector('#adm-slider-physical').value),
      notes:             detail.querySelector('#adm-assess-notes').value.trim() || null,
      is_latest:         true,
    };

    // Mark any existing "latest" assessments as not-latest
    const existing = await aapi(`/items/academy_assessments?filter[player][_eq]=${player.id}&filter[is_latest][_eq]=true&fields=id`);
    await Promise.all(asArray(existing).map(a =>
      aapi(`/items/academy_assessments/${a.id}`, { method: 'PATCH', body: JSON.stringify({ is_latest: false }) })
    ));

    const result = await aapi('/items/academy_assessments', { method: 'POST', body: JSON.stringify(payload) });
    if (result) {
      playerAssessMap[String(player.id)] = payload;
      const banner = detail.querySelector('#adm-save-banner');
      banner.textContent = '\u2713 Assessment saved';
      banner.classList.add('visible');
      setTimeout(() => banner.classList.remove('visible'), 3000);
      detail.querySelector('#adm-card-preview').innerHTML = buildFIFACard(player, payload);
      renderAdminPlayerList(document.getElementById('player-search').value);
    } else {
      errEl.textContent = 'Failed to save. Please try again.';
      errEl.hidden = false;
    }
    saveBtn.disabled = false; saveBtn.textContent = 'Save Assessment \u2192';
  });

  // Message form
  const replyForm = detail.querySelector('#adm-reply-form');
  replyForm.addEventListener('submit', async e => {
    e.preventDefault();
    const ta    = replyForm.querySelector('#adm-reply-body');
    const btn   = replyForm.querySelector('button[type=submit]');
    const errEl = replyForm.querySelector('#adm-reply-error');
    const body  = ta.value.trim();
    if (!body) return;

    btn.disabled = true; btn.textContent = 'Sending\u2026';
    const user       = ALS.user;
    const senderName = `${user?.first_name || ''} ${user?.last_name || ''}`.trim() || 'Technical Director';

    const result = await aapi('/items/academy_messages', {
      method: 'POST',
      body: JSON.stringify({ player: player.id, sender_role: 'coach', sender_name: senderName, body }),
    });

    if (result) {
      ta.value = '';
      const freshMsgs = await aapi(`/items/academy_messages?filter[player][_eq]=${player.id}&sort[]=date_created&fields=*`);
      const newMsgs   = asArray(freshMsgs);
      const newHtml   = newMsgs.map(m => {
        const isCoach = m.sender_role === 'coach';
        const date    = new Date(m.date_created).toLocaleDateString('en-AU', { day: 'numeric', month: 'short' });
        return `<div class="msg-bubble msg--${isCoach ? 'coach' : 'parent'}">
          <div class="msg-body">${m.body}</div>
          <div class="msg-meta">${m.sender_name || (isCoach ? 'Coach' : 'Parent')} &middot; ${date}</div>
        </div>`;
      }).join('');
      const msgThread = detail.querySelector('#adm-msg-thread');
      if (msgThread) {
        msgThread.innerHTML = newHtml || `<p class="msg-empty">No messages yet.</p>`;
        setTimeout(() => { msgThread.scrollTop = msgThread.scrollHeight; }, 50);
      }
      if (messagesLoaded) {
        allMessages = allMessages.filter(m => String(m.player) !== String(player.id));
        allMessages.push(...newMsgs);
      }
    } else {
      errEl.hidden = false; errEl.textContent = 'Failed to send.';
      setTimeout(() => { errEl.hidden = true; }, 4000);
    }
    btn.disabled = false; btn.textContent = 'Send Message \u2192';
  });
}

// ── Messages tab ──────────────────────────────────────────────────────────────

async function loadAllMessages() {
  messagesLoaded = true;
  const msgs = await aapi('/items/academy_messages?sort[]=-date_created&limit=500&fields=id,player,sender_role,sender_name,body,date_created,read_at');
  allMessages = asArray(msgs);
  renderThreadList();
}

function renderThreadList(activePlayerId = selectedThreadPlayerId) {
  const list = document.getElementById('thread-list');

  // Group by player
  const threads = {};
  allMessages.forEach(m => {
    const pid = String(m.player);
    if (!threads[pid]) threads[pid] = { messages: [], hasUnread: false };
    threads[pid].messages.push(m);
    if (m.sender_role === 'parent' && !m.read_at) threads[pid].hasUnread = true;
  });

  const threadList = Object.entries(threads).map(([pid, t]) => {
    const player = allPlayers.find(p => String(p.id) === pid);
    const enr    = player?.enrollment || {};
    const name   = `${enr.player_first_name || ''} ${enr.player_last_name || ''}`.trim() || `Player #${pid}`;
    t.messages.sort((a, b) => new Date(a.date_created) - new Date(b.date_created));
    const latest = t.messages[t.messages.length - 1];
    return { pid, name, latest, hasUnread: t.hasUnread };
  });

  // Sort: unread first, then most recent
  threadList.sort((a, b) => {
    if (a.hasUnread && !b.hasUnread) return -1;
    if (!a.hasUnread && b.hasUnread) return 1;
    return new Date(b.latest.date_created) - new Date(a.latest.date_created);
  });

  if (!threadList.length) {
    list.innerHTML = `<p style="padding:16px;color:var(--muted);font-size:13px;">No messages yet.</p>`;
    return;
  }

  list.innerHTML = threadList.map(t => {
    const date    = new Date(t.latest.date_created).toLocaleDateString('en-AU', { day: 'numeric', month: 'short' });
    const preview = t.latest.sender_role === 'coach' ? `You: ${t.latest.body}` : t.latest.body;
    return `<div class="thread-item${t.hasUnread ? ' unread' : ''}${activePlayerId === t.pid ? ' selected' : ''}" data-pid="${t.pid}">
      <span class="thread-date">${date}</span>
      <div class="thread-name">${t.name}</div>
      <div class="thread-preview">${preview.slice(0, 80)}${preview.length > 80 ? '\u2026' : ''}</div>
    </div>`;
  }).join('');

  list.querySelectorAll('.thread-item').forEach(el => {
    el.addEventListener('click', () => openThread(el.dataset.pid));
  });
}

async function openThread(playerId) {
  selectedThreadPlayerId = playerId;
  const pid    = String(playerId);
  const player = allPlayers.find(p => String(p.id) === pid);
  const enr    = player?.enrollment || {};
  const name   = `${enr.player_first_name || ''} ${enr.player_last_name || ''}`.trim() || `Player #${pid}`;
  const msgs   = allMessages.filter(m => String(m.player) === pid);
  msgs.sort((a, b) => new Date(a.date_created) - new Date(b.date_created));

  // Mark parent messages as read
  const unread = msgs.filter(m => m.sender_role === 'parent' && !m.read_at);
  if (unread.length) {
    await Promise.all(unread.map(m =>
      aapi(`/items/academy_messages/${m.id}`, { method: 'PATCH', body: JSON.stringify({ read_at: new Date().toISOString() }) })
    ));
    unread.forEach(m => { m.read_at = new Date().toISOString(); });
    const badge     = document.getElementById('msg-tab-badge');
    const remaining = allMessages.filter(m => m.sender_role === 'parent' && !m.read_at).length;
    if (remaining === 0) {
      badge.hidden = true;
      document.getElementById('stat-unread').hidden = true;
    } else {
      badge.textContent = remaining;
    }
    renderThreadList(pid);
  }

  document.querySelectorAll('.thread-item').forEach(el => el.classList.toggle('selected', el.dataset.pid === pid));

  const threadDetail = document.getElementById('thread-detail');

  const msgsHtml = msgs.length
    ? msgs.map(m => {
        const isCoach = m.sender_role === 'coach';
        const date    = new Date(m.date_created).toLocaleDateString('en-AU', { day: 'numeric', month: 'short' });
        return `<div class="msg-bubble msg--${isCoach ? 'coach' : 'parent'}">
          <div class="msg-body">${m.body}</div>
          <div class="msg-meta">${m.sender_name || (isCoach ? 'Staff' : 'Parent')} &middot; ${date}</div>
        </div>`;
      }).join('')
    : `<p class="msg-empty">No messages.</p>`;

  threadDetail.innerHTML = `<div class="detail-section">
    <h3 style="font-family:var(--font-cond);font-size:18px;font-weight:800;margin-bottom:16px;">${name}</h3>
    <div class="message-thread" id="thread-msgs">${msgsHtml}</div>
    <form class="reply-form" id="thread-reply-form">
      <textarea class="reply-textarea" id="thread-reply-body" placeholder="Reply to ${name}'s family&hellip;"></textarea>
      <div class="reply-footer">
        <span id="thread-reply-error" class="error-text" hidden></span>
        <button type="submit" class="btn-green">Send as Technical Director &rarr;</button>
      </div>
    </form>
  </div>`;

  setTimeout(() => {
    const t = document.getElementById('thread-msgs');
    if (t) t.scrollTop = t.scrollHeight;
  }, 50);

  document.getElementById('thread-reply-form').addEventListener('submit', async e => {
    e.preventDefault();
    const ta    = document.getElementById('thread-reply-body');
    const btn   = e.target.querySelector('button[type=submit]');
    const errEl = document.getElementById('thread-reply-error');
    const body  = ta.value.trim();
    if (!body) return;

    btn.disabled = true; btn.textContent = 'Sending\u2026';
    const user       = ALS.user;
    const senderName = `${user?.first_name || ''} ${user?.last_name || ''}`.trim() || 'Technical Director';

    const result = await aapi('/items/academy_messages', {
      method: 'POST',
      body: JSON.stringify({ player: parseInt(pid) || pid, sender_role: 'coach', sender_name: senderName, body }),
    });

    if (result) {
      ta.value = '';
      allMessages.push({
        ...result,
        player:      pid,
        sender_role: 'coach',
        sender_name: senderName,
        body,
        date_created: new Date().toISOString(),
        read_at:      new Date().toISOString(),
      });
      renderThreadList(pid);
      openThread(pid);
    } else {
      errEl.hidden = false; errEl.textContent = 'Failed to send.';
      setTimeout(() => { errEl.hidden = true; }, 4000);
    }
    btn.disabled = false; btn.textContent = 'Send as Technical Director \u2192';
  });
}

// ── Auth ──────────────────────────────────────────────────────────────────────

async function tryRefresh() {
  if (!ALS.refresh) return false;
  try {
    const res = await fetch(`${DURL}/auth/refresh`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ refresh_token: ALS.refresh, mode: 'json' }),
    });
    if (!res.ok) return false;
    const { data } = await res.json();
    ALS.token = data.access_token; ALS.refresh = data.refresh_token;
    return true;
  } catch { return false; }
}

function showLogin() {
  ALS.clear();
  document.getElementById('view-login').hidden    = false;
  document.getElementById('view-dashboard').hidden = true;
}

function showDashboard() {
  document.getElementById('view-login').hidden    = true;
  document.getElementById('view-dashboard').hidden = false;
}

// ── Login button ──────────────────────────────────────────────────────────────

document.getElementById('login-btn').addEventListener('click', async () => {
  const email    = document.getElementById('login-email').value.trim();
  const password = document.getElementById('login-password').value;
  const errEl    = document.getElementById('login-error');
  const btn      = document.getElementById('login-btn');
  if (!email || !password) return;

  btn.disabled = true; btn.textContent = 'Signing in\u2026';
  errEl.hidden = true;

  try {
    const res = await fetch(`${DURL}/auth/login`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email, password }),
    });
    if (!res.ok) throw new Error('Invalid email or password.');
    const { data } = await res.json();
    ALS.token = data.access_token; ALS.refresh = data.refresh_token;

    const userRes = await fetch(`${DURL}/users/me?fields=id,email,first_name,last_name,role.name`, {
      headers: { Authorization: `Bearer ${ALS.token}` },
    });
    if (!userRes.ok) throw new Error('Could not verify user.');
    const { data: user } = await userRes.json();

    const role = (user?.role?.name || '').toLowerCase();
    if (!['administrator', 'admin', 'technical director', 'director', 'coach'].some(r => role.includes(r))) {
      ALS.clear();
      throw new Error('Access denied. You need Technical Director access.');
    }

    ALS.user = user;
    showDashboard();
    await loadAll();
  } catch (err) {
    errEl.textContent = err.message || 'Sign in failed.';
    errEl.hidden = false;
  }

  btn.disabled = false; btn.textContent = 'Sign In \u2192';
});

// Allow Enter key in password field
document.getElementById('login-password').addEventListener('keydown', e => {
  if (e.key === 'Enter') document.getElementById('login-btn').click();
});

// ── Logout ────────────────────────────────────────────────────────────────────

document.getElementById('logout-btn').addEventListener('click', async () => {
  if (ALS.refresh) {
    await fetch(`${DURL}/auth/logout`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${ALS.token}` },
      body: JSON.stringify({ refresh_token: ALS.refresh }),
    }).catch(() => {});
  }
  showLogin();
});

// ── Init ──────────────────────────────────────────────────────────────────────

async function init() {
  if (!ALS.token) { showLogin(); return; }

  const userRes = await fetch(`${DURL}/users/me?fields=id,email,first_name,last_name,role.name`, {
    headers: { Authorization: `Bearer ${ALS.token}` },
  });

  if (!userRes.ok) {
    const ok = await tryRefresh();
    if (!ok) { showLogin(); return; }
    return init();
  }

  const { data: user } = await userRes.json();
  const role = (user?.role?.name || '').toLowerCase();
  if (!['administrator', 'admin', 'technical director', 'director', 'coach'].some(r => role.includes(r))) {
    showLogin(); return;
  }

  ALS.user = user;
  showDashboard();
  await loadAll();
}

document.addEventListener('DOMContentLoaded', init);
</script>

</PortalBase>
