---
// src/pages/academy/admin.astro
// Technical Director admin panel — split-pane layout, no modals
import Base from '../../layouts/Base.astro';
---
<Base
  title="Academy — Technical Director"
  description="Warriors FC Academy administration panel."
>

  <!-- Login -->
  <div id="view-login" class="admin-view">
    <div class="portal-hero">
      <div class="portal-hero-inner">
        <div class="label">Academy</div>
        <h1>Technical Director</h1>
        <p>Manage enrollments, player profiles, assessments and parent messages.</p>
      </div>
    </div>
    <div class="login-outer">
      <div class="login-card card">
        <h2>Sign In</h2>
        <form id="admin-login-form" novalidate>
          <div class="field">
            <label for="a-email">Email</label>
            <input type="email" id="a-email" autocomplete="email" required>
          </div>
          <div class="field">
            <label for="a-password">Password</label>
            <input type="password" id="a-password" autocomplete="current-password" required>
          </div>
          <div id="a-login-error" class="form-error" hidden></div>
          <button type="submit" class="btn btn-primary btn-full" id="a-login-btn">Sign In →</button>
        </form>
      </div>
    </div>
  </div>

  <!-- Dashboard -->
  <div id="view-dashboard" class="admin-view" hidden>

    <div class="topbar">
      <div class="topbar-inner">
        <div class="topbar-title">
          <div class="label">Academy</div>
          <h1>Technical Director</h1>
        </div>
        <div class="topbar-right">
          <div class="stats-bar" id="stats-bar"></div>
          <button class="btn btn-secondary btn-sm" id="a-logout-btn">Sign Out</button>
        </div>
      </div>
      <div class="tab-nav">
        <button class="tab-btn tab-btn--active" data-tab="enrollments">Enrollments</button>
        <button class="tab-btn" data-tab="players">Players</button>
        <button class="tab-btn" data-tab="messages">Messages</button>
      </div>
    </div>

    <div class="admin-body">
      <div id="admin-loading" class="center-msg" hidden><div class="spinner"></div><p>Loading…</p></div>

      <!-- ── ENROLLMENTS TAB ─────────────────────── -->
      <div id="tab-enrollments" class="tab-panel">
        <div class="split-pane">
          <div class="split-list" id="enr-list-col">
            <div class="list-header">
              <div class="filter-row">
                <button class="filter-btn filter-btn--active" data-status="pending">Pending</button>
                <button class="filter-btn" data-status="accepted">Accepted</button>
                <button class="filter-btn" data-status="enrolled">Enrolled</button>
                <button class="filter-btn" data-status="all">All</button>
              </div>
            </div>
            <div id="enrollments-list"></div>
          </div>
          <div class="split-detail" id="enr-detail">
            <div class="detail-placeholder">
              <p>Select an enrollment to view details</p>
            </div>
          </div>
        </div>
      </div>

      <!-- ── PLAYERS TAB ─────────────────────────── -->
      <div id="tab-players" class="tab-panel" hidden>
        <div class="split-pane">
          <div class="split-list" id="player-list-col">
            <div class="list-header">
              <input type="text" id="player-search" placeholder="Search by name…" class="search-input">
            </div>
            <div id="players-list"></div>
          </div>
          <div class="split-detail" id="player-detail">
            <div class="detail-placeholder">
              <p>Select a player to view their card and messages</p>
            </div>
          </div>
        </div>
      </div>

      <!-- ── MESSAGES TAB ────────────────────────── -->
      <div id="tab-messages" class="tab-panel" hidden>
        <div class="split-pane">
          <div class="split-list" id="thread-list"></div>
          <div class="split-detail" id="thread-detail">
            <div class="detail-placeholder"><p>Select a conversation</p></div>
          </div>
        </div>
      </div>
    </div>

  </div>

</Base>

<script>
const DURL = import.meta.env.PUBLIC_DIRECTUS_URL || '';

// ── AUTH ──────────────────────────────────────────────────────
const ALS = {
  get token()   { return sessionStorage.getItem('warriors_admin_token'); },
  get refresh() { return sessionStorage.getItem('warriors_admin_refresh'); },
  get user()    { try { return JSON.parse(sessionStorage.getItem('warriors_admin_user') || 'null'); } catch { return null; } },
  set token(v)  { sessionStorage.setItem('warriors_admin_token', v); },
  set refresh(v){ sessionStorage.setItem('warriors_admin_refresh', v); },
  set user(v)   { sessionStorage.setItem('warriors_admin_user', JSON.stringify(v)); },
  clear()       { ['warriors_admin_token','warriors_admin_refresh','warriors_admin_user'].forEach(k => sessionStorage.removeItem(k)); },
};

async function aapi(path, opts = {}) {
  try {
    const headers = { 'Content-Type': 'application/json', 'Authorization': `Bearer ${ALS.token}` };
    const res = await fetch(`${DURL}${path}`, { ...opts, headers: { ...headers, ...(opts.headers||{}) } });
    if (res.status === 401) {
      const refreshed = await tryRefresh();
      if (refreshed) return aapi(path, opts);
      showLogin(); return null;
    }
    if (res.status === 204) return { ok: true };
    if (!res.ok) return null;
    const json = await res.json();
    return json.data ?? json;
  } catch(e) { console.error('API error', path, e); return null; }
}

async function tryRefresh() {
  if (!ALS.refresh) return false;
  try {
    const res = await fetch(`${DURL}/auth/refresh`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ refresh_token: ALS.refresh, mode: 'json' }),
    });
    if (!res.ok) return false;
    const { data } = await res.json();
    ALS.token = data.access_token;
    ALS.refresh = data.refresh_token;
    return true;
  } catch { return false; }
}

// ── FIFA CARD UTILS ───────────────────────────────────────────
const AGE_SCALE = { 'u8-u9':{min:30,max:72},'u10-u11':{min:35,max:78},'u12-u13':{min:40,max:83},'u14-u16':{min:45,max:90} };
function norm(raw, ag) { const s=AGE_SCALE[ag]||AGE_SCALE['u12-u13']; return Math.round(s.min+(raw-1)*(s.max-s.min)/9); }
function calcOverall(a, ag, pos) {
  const attrs = { pac:norm(a.pace_raw,ag),sho:norm(a.shooting_raw,ag),pas:norm(a.passing_raw,ag),dri:norm(a.dribbling_raw,ag),def:norm(a.defending_raw,ag),phy:norm(a.physical_raw,ag) };
  const isAtk = ['forward','midfielder'].includes(pos);
  const ov = isAtk ? Math.round((attrs.dri*2+attrs.sho*2+attrs.pac+attrs.pas+attrs.phy)/7)
                   : Math.round((attrs.def*2+attrs.phy*2+attrs.pac+attrs.pas+attrs.dri)/7);
  return { ov, attrs };
}
function tierClass(ov) { return ov>=90?'card-elite':ov>=75?'card-gold':ov>=60?'card-silver':'card-bronze'; }
function tierName(ov)  { return ov>=90?'Elite':ov>=75?'Gold':ov>=60?'Silver':'Bronze'; }
function posLabel(p)   { return {goalkeeper:'GK',defender:'CB',midfielder:'MID',forward:'FWD'}[p]||'MID'; }

function buildFIFACard(profile, assessment) {
  const ag  = (profile.enrollment?.age_group || 'u12-u13');
  const pos = profile.position || 'midfielder';
  const enr = profile.enrollment || {};
  const name = `${enr.player_first_name||''} ${(enr.player_last_name||'')[0]||''}.`.trim();
  const agLabel = {'u8-u9':'U9','u10-u11':'U11','u12-u13':'U13','u14-u16':'U16'}[ag]||ag.toUpperCase();

  if (!assessment) {
    return `<div class="fifa-card card-bronze unrated">
      <div class="fc-header"><div class="fc-left"><div class="fc-overall">—</div><div class="fc-pos">${posLabel(pos)}</div><div class="fc-tier">Unrated</div></div></div>
      <div class="fc-name">${name.toUpperCase()}</div>
      <div class="fc-age">${agLabel} · Warriors FC</div>
      <div class="fc-no-assess">Not yet assessed</div>
    </div>`;
  }
  const { ov, attrs } = calcOverall(assessment, ag, pos);
  const tc = tierClass(ov);
  return `<div class="fifa-card ${tc}">
    <div class="fc-header">
      <div class="fc-left"><div class="fc-overall">${ov}</div><div class="fc-pos">${posLabel(pos)}</div><div class="fc-tier">${tierName(ov)}</div></div>
      <div class="fc-badge"><svg viewBox="0 0 40 40" width="32" height="32" fill="none"><polygon points="20,3 37,12 37,28 20,37 3,28 3,12" fill="rgba(255,255,255,0.12)" stroke="rgba(255,255,255,0.25)" stroke-width="1.5"/><text x="20" y="26" text-anchor="middle" font-size="13" font-weight="bold" fill="rgba(255,255,255,0.7)" font-family="Arial">W</text></svg></div>
    </div>
    <div class="fc-photo"><svg viewBox="0 0 80 100" fill="none" width="70" height="88"><circle cx="40" cy="26" r="18" fill="rgba(255,255,255,0.2)"/><path d="M8 95 C8 65 20 54 40 52 C60 54 72 65 72 95" fill="rgba(255,255,255,0.2)"/></svg></div>
    <div class="fc-name">${name.toUpperCase()}</div>
    <div class="fc-age">${agLabel} · Warriors FC</div>
    <div class="fc-stats">
      ${[['PAC',attrs.pac],['SHO',attrs.sho],['PAS',attrs.pas],['DRI',attrs.dri],['DEF',attrs.def],['PHY',attrs.phy]].map(([l,v])=>`<div class="fc-stat"><span class="fc-sv">${v}</span><span class="fc-sl">${l}</span></div>`).join('')}
    </div>
  </div>`;
}

// ── STATE ─────────────────────────────────────────────────────
let allEnrollments = [];
let allPlayers     = [];
let allMessages    = [];
let currentFilter  = 'pending';
let activeTab      = 'enrollments';
let selectedEnrId  = null;
let selectedPlayerId = null;

// ── VIEWS ─────────────────────────────────────────────────────
function showLogin() { ALS.clear(); document.getElementById('view-login').hidden=false; document.getElementById('view-dashboard').hidden=true; }
function showDashboard() { document.getElementById('view-login').hidden=true; document.getElementById('view-dashboard').hidden=false; }

// ── TABS ──────────────────────────────────────────────────────
document.querySelectorAll('.tab-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('tab-btn--active'));
    btn.classList.add('tab-btn--active');
    activeTab = btn.dataset.tab;
    document.querySelectorAll('.tab-panel').forEach(p => p.hidden = true);
    document.getElementById(`tab-${activeTab}`).hidden = false;
    if (activeTab === 'messages') ensureMessagesLoaded();
  });
});

// ── ENROLLMENT FILTERS ────────────────────────────────────────
document.querySelectorAll('.filter-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('filter-btn--active'));
    btn.classList.add('filter-btn--active');
    currentFilter = btn.dataset.status;
    selectedEnrId = null;
    document.getElementById('enr-detail').innerHTML = '<div class="detail-placeholder"><p>Select an enrollment to view details</p></div>';
    renderEnrollments();
  });
});

// ── LOAD DATA ─────────────────────────────────────────────────
async function loadAll() {
  const loadEl = document.getElementById('admin-loading');
  loadEl.hidden = false;
  try {
    const [enrollments, players] = await Promise.all([
      aapi('/items/academy_enrollments?sort[]=-date_created&limit=200&fields=id,status,date_created,parent_first_name,parent_last_name,parent_email,parent_phone,player_first_name,player_last_name,player_dob,age_group,previous_experience,medical_notes,directus_user_id,program'),
      aapi('/items/academy_player_profiles?limit=200&fields=id,position,photo,jersey_number,notes,enrollment.id,enrollment.age_group,enrollment.player_first_name,enrollment.player_last_name,enrollment.status'),
    ]);
    allEnrollments = enrollments || [];
    allPlayers     = players     || [];
    renderStats();
    renderEnrollments();
    renderPlayerList();
  } catch(err) {
    console.error('loadAll error:', err);
    document.getElementById('enrollments-list').innerHTML =
      '<p style="padding:32px;color:var(--muted);text-align:center">Error loading data — please refresh or sign out and back in.</p>';
  } finally {
    loadEl.hidden = true;
  }
}

// ── STATS BAR ─────────────────────────────────────────────────
function renderStats() {
  const pending  = allEnrollments.filter(e => e.status === 'pending').length;
  const active   = allEnrollments.filter(e => e.status === 'enrolled' || e.status === 'accepted').length;
  document.getElementById('stats-bar').innerHTML = `
    <span class="stat-chip stat-chip--warn">${pending} pending</span>
    <span class="stat-chip stat-chip--ok">${active} active</span>
    <span class="stat-chip">${allPlayers.length} profiles</span>`;
}

// ── ENROLLMENTS LIST ──────────────────────────────────────────
function renderEnrollments() {
  const list = document.getElementById('enrollments-list');
  const filtered = currentFilter === 'all' ? allEnrollments : allEnrollments.filter(e => e.status === currentFilter);
  if (!filtered.length) {
    list.innerHTML = `<p class="empty-msg">No ${currentFilter === 'all' ? '' : currentFilter + ' '}enrollments.</p>`;
    return;
  }
  list.innerHTML = filtered.map(e => {
    const statusClass = { pending:'status-pending', accepted:'status-accepted', enrolled:'status-enrolled', inactive:'status-inactive' }[e.status] || '';
    const active = String(e.id) === String(selectedEnrId) ? 'list-item--active' : '';
    return `<div class="list-item ${active}" data-id="${e.id}">
      <div class="li-name">${e.player_first_name} ${e.player_last_name} <span class="status-badge ${statusClass}">${e.status}</span></div>
      <div class="li-sub">${e.parent_first_name} ${e.parent_last_name} · <span class="age-chip">${(e.age_group||'').toUpperCase().replace('-','/')}</span></div>
    </div>`;
  }).join('');
  list.querySelectorAll('.list-item').forEach(item => {
    item.addEventListener('click', () => {
      const enr = allEnrollments.find(e => String(e.id) === String(item.dataset.id));
      if (enr) openEnrollmentDetail(enr);
    });
  });
}

function openEnrollmentDetail(enr) {
  selectedEnrId = enr.id;
  renderEnrollments(); // refresh active state
  const hasProfile = allPlayers.some(p => String(p.enrollment?.id || p.enrollment) === String(enr.id));
  const dob = enr.player_dob ? new Date(enr.player_dob).toLocaleDateString('en-AU') : '—';
  const d   = enr.date_created ? new Date(enr.date_created).toLocaleDateString('en-AU',{day:'numeric',month:'short',year:'numeric'}) : '—';
  const statusClass = { pending:'status-pending', accepted:'status-accepted', enrolled:'status-enrolled' }[enr.status] || '';

  document.getElementById('enr-detail').innerHTML = `
<div class="detail-section">
  <div class="detail-title-row">
    <h2>${enr.player_first_name} ${enr.player_last_name}</h2>
    <span class="status-badge ${statusClass}">${enr.status}</span>
  </div>
  <div class="detail-grid">
    <div class="detail-row"><span>Age Group</span><strong>${(enr.age_group||'—').toUpperCase().replace('-','/')}</strong></div>
    <div class="detail-row"><span>Date of Birth</span><strong>${dob}</strong></div>
    <div class="detail-row"><span>Parent</span><strong>${enr.parent_first_name} ${enr.parent_last_name}</strong></div>
    <div class="detail-row"><span>Email</span><strong><a href="mailto:${enr.parent_email}" style="color:var(--green-bright)">${enr.parent_email}</a></strong></div>
    <div class="detail-row"><span>Phone</span><strong>${enr.parent_phone||'—'}</strong></div>
    <div class="detail-row"><span>Submitted</span><strong>${d}</strong></div>
    ${enr.previous_experience ? `<div class="detail-row detail-row--full"><span>Experience</span><p>${enr.previous_experience}</p></div>` : ''}
    ${enr.medical_notes       ? `<div class="detail-row detail-row--full medical-row"><span>⚠ Medical</span><p>${enr.medical_notes}</p></div>` : ''}
  </div>
</div>

${enr.status === 'pending' ? `
<div class="detail-section detail-actions-section">
  <button class="btn btn-primary" id="btn-accept-${enr.id}">Accept Application →</button>
  <button class="btn btn-secondary" id="btn-reject-${enr.id}">Reject</button>
  <span id="action-msg-${enr.id}" class="action-msg" hidden></span>
</div>` : ''}

${enr.status === 'accepted' && !hasProfile ? `
<div class="detail-section">
  <div class="label" style="margin-bottom:16px">Create Player Profile</div>
  <form id="profile-form-${enr.id}" class="profile-form">
    <div class="form-row">
      <div class="field">
        <label>Position</label>
        <select id="ip-position-${enr.id}">
          <option value="midfielder">Midfielder</option>
          <option value="forward">Forward</option>
          <option value="defender">Defender</option>
          <option value="goalkeeper">Goalkeeper</option>
        </select>
      </div>
      <div class="field">
        <label>Jersey # (optional)</label>
        <input type="number" id="ip-jersey-${enr.id}" min="1" max="99" placeholder="e.g. 10">
      </div>
    </div>
    <div class="field">
      <label>Internal Notes</label>
      <textarea id="ip-notes-${enr.id}" rows="2" placeholder="Coach notes (not visible to parents)…"></textarea>
    </div>
    <div style="display:flex;gap:10px;align-items:center;margin-top:8px">
      <button type="submit" class="btn btn-primary">Create Profile →</button>
      <span id="profile-msg-${enr.id}" class="action-msg" hidden></span>
    </div>
  </form>
</div>
<div class="detail-section invite-section">
  <div class="label" style="margin-bottom:10px">Then — Invite Parent to Portal</div>
  <ol class="invite-steps">
    <li>Go to <a href="${DURL}/admin/users" target="_blank" rel="noopener" style="color:var(--green-bright)">Directus → Users ↗</a></li>
    <li>Click <strong>Invite Users</strong></li>
    <li>Enter <strong>${enr.parent_email}</strong></li>
    <li>Set role to <strong>parent</strong></li>
    <li>Send — parent receives login email</li>
  </ol>
</div>` : ''}

${enr.status === 'accepted' && hasProfile ? `
<div class="detail-section">
  <p style="color:var(--green-bright);font-family:var(--font-cond);font-weight:700;margin-bottom:12px">✓ Player profile created</p>
  <button class="btn btn-primary" id="btn-enroll-${enr.id}">Mark as Enrolled →</button>
  <span id="action-msg-${enr.id}" class="action-msg" hidden></span>
  <div class="invite-section" style="margin-top:20px">
    <div class="label" style="margin-bottom:10px">Invite Parent (if not done)</div>
    <ol class="invite-steps">
      <li>Go to <a href="${DURL}/admin/users" target="_blank" rel="noopener" style="color:var(--green-bright)">Directus → Users ↗</a></li>
      <li>Click <strong>Invite Users</strong> → <strong>${enr.parent_email}</strong> → role: <strong>parent</strong></li>
    </ol>
  </div>
</div>` : ''}

${enr.status === 'enrolled' ? `
<div class="detail-section">
  <p style="color:var(--green-bright);font-family:var(--font-cond);font-weight:700">✓ Enrolled</p>
</div>` : ''}`;

  // Bind accept/reject
  document.getElementById(`btn-accept-${enr.id}`)?.addEventListener('click', async () => {
    const msg = document.getElementById(`action-msg-${enr.id}`);
    const btn = document.getElementById(`btn-accept-${enr.id}`);
    btn.disabled = true; btn.textContent = 'Accepting…';
    const result = await aapi(`/items/academy_enrollments/${enr.id}`, { method:'PATCH', body:JSON.stringify({status:'accepted'}) });
    if (result) {
      enr.status = 'accepted';
      const idx = allEnrollments.findIndex(e => String(e.id) === String(enr.id));
      if (idx > -1) allEnrollments[idx].status = 'accepted';
      renderStats(); renderEnrollments();
      openEnrollmentDetail(enr);
    } else { btn.disabled=false; btn.textContent='Accept Application →'; msg.textContent='Failed. Try again.'; msg.hidden=false; }
  });

  document.getElementById(`btn-reject-${enr.id}`)?.addEventListener('click', async () => {
    if (!confirm(`Reject ${enr.player_first_name}'s application?`)) return;
    await aapi(`/items/academy_enrollments/${enr.id}`, { method:'PATCH', body:JSON.stringify({status:'inactive'}) });
    enr.status = 'inactive';
    const idx = allEnrollments.findIndex(e => String(e.id) === String(enr.id));
    if (idx > -1) allEnrollments[idx].status = 'inactive';
    renderStats(); renderEnrollments();
    selectedEnrId = null;
    document.getElementById('enr-detail').innerHTML = '<div class="detail-placeholder"><p>Application rejected.</p></div>';
  });

  document.getElementById(`btn-enroll-${enr.id}`)?.addEventListener('click', async () => {
    const msg = document.getElementById(`action-msg-${enr.id}`);
    await aapi(`/items/academy_enrollments/${enr.id}`, { method:'PATCH', body:JSON.stringify({status:'enrolled'}) });
    enr.status = 'enrolled';
    const idx = allEnrollments.findIndex(e => String(e.id) === String(enr.id));
    if (idx > -1) allEnrollments[idx].status = 'enrolled';
    renderStats(); renderEnrollments();
    openEnrollmentDetail(enr);
  });

  const profileForm = document.getElementById(`profile-form-${enr.id}`);
  profileForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const msg = document.getElementById(`profile-msg-${enr.id}`);
    const btn = profileForm.querySelector('button[type="submit"]');
    btn.disabled=true; btn.textContent='Creating…';
    const payload = {
      enrollment: parseInt(enr.id) || enr.id,
      position: document.getElementById(`ip-position-${enr.id}`).value,
      jersey_number: document.getElementById(`ip-jersey-${enr.id}`).value || null,
      notes: document.getElementById(`ip-notes-${enr.id}`).value || null,
    };
    const result = await aapi('/items/academy_player_profiles', { method:'POST', body:JSON.stringify(payload) });
    if (result) {
      allPlayers.push({ id: result.id, position: payload.position, enrollment: { id: enr.id, age_group: enr.age_group, player_first_name: enr.player_first_name, player_last_name: enr.player_last_name, status: enr.status } });
      renderStats(); renderPlayerList();
      openEnrollmentDetail(enr);
    } else { btn.disabled=false; btn.textContent='Create Profile →'; msg.textContent='Failed. Try again.'; msg.hidden=false; }
  });
}

// ── PLAYERS LIST ──────────────────────────────────────────────
function renderPlayerList() {
  const list   = document.getElementById('players-list');
  const search = document.getElementById('player-search')?.value?.toLowerCase() || '';
  const players = search
    ? allPlayers.filter(p => `${p.enrollment?.player_first_name||''} ${p.enrollment?.player_last_name||''}`.toLowerCase().includes(search))
    : allPlayers;

  if (!players.length) {
    list.innerHTML = '<p class="empty-msg">No player profiles yet.</p>';
    return;
  }
  list.innerHTML = players.map(p => {
    const enr  = p.enrollment || {};
    const name = `${enr.player_first_name||''} ${enr.player_last_name||''}`.trim();
    const active = String(p.id) === String(selectedPlayerId) ? 'list-item--active' : '';
    return `<div class="list-item ${active}" data-id="${p.id}">
      <div class="li-name">${name}</div>
      <div class="li-sub"><span class="age-chip">${(enr.age_group||'').toUpperCase().replace('-','/')}</span> <span class="pos-chip">${posLabel(p.position||'midfielder')}</span></div>
    </div>`;
  }).join('');
  list.querySelectorAll('.list-item').forEach(item => {
    item.addEventListener('click', () => {
      const player = allPlayers.find(p => String(p.id) === String(item.dataset.id));
      if (player) openPlayerDetail(player);
    });
  });
}

document.getElementById('player-search').addEventListener('input', renderPlayerList);

async function openPlayerDetail(player) {
  selectedPlayerId = player.id;
  renderPlayerList();
  const detail = document.getElementById('player-detail');
  const enr = player.enrollment || {};
  const name = `${enr.player_first_name||''} ${enr.player_last_name||''}`.trim();

  detail.innerHTML = `<div class="center-msg" style="height:120px"><div class="spinner"></div><p>Loading…</p></div>`;

  // Fetch assessment + messages in parallel
  const pid = String(player.id);
  const [assessData, msgData] = await Promise.all([
    aapi(`/items/academy_assessments?filter[player][_eq]=${pid}&filter[is_latest][_eq]=true&limit=1&fields=*`),
    aapi(`/items/academy_messages?filter[player][_eq]=${pid}&sort[]=date_created&fields=*`),
  ]);
  const assessment = Array.isArray(assessData) ? assessData[0] : null;
  const messages   = Array.isArray(msgData) ? msgData : (msgData ? [msgData] : []);

  const assessDate = assessment ? new Date(assessment.assessment_date).toLocaleDateString('en-AU',{day:'numeric',month:'short',year:'numeric'}) : 'Never';

  detail.innerHTML = `
<div class="player-detail-inner">
  <div class="pd-header">
    <div>
      <h2>${name}</h2>
      <div class="pd-meta">
        <span class="age-chip">${(enr.age_group||'').toUpperCase().replace('-','/')}</span>
        <span class="pos-chip">${posLabel(player.position||'midfielder')}</span>
        <span style="font-size:12px;color:var(--muted)">Last assessed: ${assessDate}</span>
      </div>
    </div>
    <a href="/academy/coach" class="btn btn-outline-green btn-sm">Assess in Coach Dashboard →</a>
  </div>

  <div class="pd-body">
    <div class="pd-card-col">
      <div class="section-label">Player Card</div>
      ${buildFIFACard(player, assessment)}
      ${assessment?.notes ? `<div class="coach-note-box card" style="margin-top:16px"><div class="label" style="margin-bottom:6px">Coach Notes</div><p>${assessment.notes}</p><div style="font-size:11px;color:var(--muted);margin-top:6px">${assessDate}</div></div>` : ''}
    </div>
    <div class="pd-msg-col">
      <div class="section-label">Messages</div>
      <div class="thread-msgs" id="pd-msgs-${pid}">
        ${messages.length === 0
          ? '<p class="empty-msg">No messages yet.</p>'
          : messages.map(m => `<div class="msg msg--${m.sender_role}">
              <div class="msg-meta"><span class="msg-author">${m.sender_name||(m.sender_role==='coach'?'You':'Parent')}</span><span class="msg-date">${new Date(m.date_created).toLocaleDateString('en-AU',{day:'numeric',month:'short'})}</span></div>
              <div class="msg-body">${m.body.replace(/\n/g,'<br>')}</div>
            </div>`).join('')}
      </div>
      <form class="pd-reply-form" data-player="${pid}">
        <textarea class="reply-input" rows="3" placeholder="Write a message to ${name}'s family…"></textarea>
        <div style="display:flex;gap:8px;align-items:center;margin-top:8px">
          <button type="submit" class="btn btn-primary btn-sm">Send →</button>
          <span class="reply-status" hidden style="font-size:12px;color:red"></span>
        </div>
      </form>
    </div>
  </div>
</div>`;

  // Scroll messages
  const msgsEl = document.getElementById(`pd-msgs-${pid}`);
  if (msgsEl) msgsEl.scrollTop = msgsEl.scrollHeight;

  // Mark parent messages as read
  messages.filter(m => m.sender_role === 'parent' && !m.read_at).forEach(m => {
    aapi(`/items/academy_messages/${m.id}`, { method:'PATCH', body:JSON.stringify({read_at: new Date().toISOString()}) });
  });

  // Reply handler
  document.querySelector(`.pd-reply-form[data-player="${pid}"]`).addEventListener('submit', async (e) => {
    e.preventDefault();
    const textarea = e.target.querySelector('.reply-input');
    const status   = e.target.querySelector('.reply-status');
    const btn      = e.target.querySelector('button[type="submit"]');
    const body     = textarea.value.trim();
    if (!body) return;
    btn.disabled=true; btn.textContent='Sending…';
    const user = ALS.user;
    const result = await aapi('/items/academy_messages', { method:'POST', body: JSON.stringify({
      player: parseInt(pid)||pid,
      sender_role: 'coach',
      sender_name: `${user?.first_name||''} ${user?.last_name||''}`.trim() || 'Technical Director',
      body,
    })});
    if (result) {
      textarea.value = '';
      btn.disabled=false; btn.textContent='Send →';
      // Reload messages
      const fresh = await aapi(`/items/academy_messages?filter[player][_eq]=${pid}&sort[]=date_created&fields=*`);
      const freshMsgs = Array.isArray(fresh) ? fresh : [];
      if (msgsEl) {
        msgsEl.innerHTML = freshMsgs.map(m => `<div class="msg msg--${m.sender_role}">
          <div class="msg-meta"><span class="msg-author">${m.sender_name||(m.sender_role==='coach'?'You':'Parent')}</span><span class="msg-date">${new Date(m.date_created).toLocaleDateString('en-AU',{day:'numeric',month:'short'})}</span></div>
          <div class="msg-body">${m.body.replace(/\n/g,'<br>')}</div>
        </div>`).join('');
        msgsEl.scrollTop = msgsEl.scrollHeight;
      }
      // Update allMessages for the Messages tab
      allMessages = allMessages.filter(m => String(m.player) !== pid).concat(freshMsgs);
    } else {
      status.textContent='Failed. Try again.'; status.hidden=false;
      btn.disabled=false; btn.textContent='Send →';
    }
  });
}

// ── MESSAGES TAB ──────────────────────────────────────────────
async function ensureMessagesLoaded() {
  if (allPlayers.length === 0) {
    const players = await aapi('/items/academy_player_profiles?limit=200&fields=id,position,enrollment.id,enrollment.player_first_name,enrollment.player_last_name');
    allPlayers = players || [];
  }
  if (allMessages.length === 0) {
    const messages = await aapi('/items/academy_messages?sort[]=-date_created&limit=500&fields=id,player,sender_role,sender_name,body,date_created,read_at');
    allMessages = messages || [];
  }
  renderThreadList();
}

function renderThreadList(activeId) {
  const list = document.getElementById('thread-list');
  const playerMap = {};
  allPlayers.forEach(p => {
    playerMap[String(p.id)] = `${p.enrollment?.player_first_name||''} ${p.enrollment?.player_last_name||''}`.trim();
  });

  const entries = allPlayers.map(p => {
    const pid   = String(p.id);
    const msgs  = allMessages.filter(m => String(m.player) === pid);
    const unread = msgs.filter(m => m.sender_role === 'parent' && !m.read_at).length;
    const latest = msgs.sort((a,b)=>new Date(b.date_created)-new Date(a.date_created))[0];
    const preview = latest ? (latest.body.length>50?latest.body.slice(0,50)+'…':latest.body) : 'No messages yet';
    return { pid, name: playerMap[pid]||'Player', unread, preview };
  });

  list.innerHTML = '<div class="list-header"><strong>All Conversations</strong></div>' + entries.map(({ pid, name, unread, preview }) => `
<div class="list-item ${String(activeId)===pid?'list-item--active':''}" data-player-id="${pid}">
  <div class="li-name">${name}${unread?` <span class="unread-badge">${unread}</span>`:''}</div>
  <div class="li-sub" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${preview}</div>
</div>`).join('');

  list.querySelectorAll('[data-player-id]').forEach(item => {
    item.addEventListener('click', () => openThread(item.dataset.playerId));
  });
}

function openThread(playerId) {
  const pid = String(playerId);
  const msgs = allMessages.filter(m => String(m.player) === pid);
  const playerMap = {};
  allPlayers.forEach(p => { playerMap[String(p.id)] = `${p.enrollment?.player_first_name||''} ${p.enrollment?.player_last_name||''}`.trim(); });
  const name = playerMap[pid] || 'Player';

  msgs.filter(m => m.sender_role === 'parent' && !m.read_at).forEach(m => {
    aapi(`/items/academy_messages/${m.id}`, { method:'PATCH', body:JSON.stringify({read_at:new Date().toISOString()}) });
    m.read_at = new Date().toISOString();
  });

  const detail = document.getElementById('thread-detail');
  detail.innerHTML = `
<div class="thread-header"><strong>${name}</strong></div>
<div class="thread-msgs" id="tmsg-${pid}">
  ${msgs.length===0
    ? '<p class="empty-msg">No messages yet. Send the first message below.</p>'
    : msgs.sort((a,b)=>new Date(a.date_created)-new Date(b.date_created)).map(m=>`
  <div class="msg msg--${m.sender_role}">
    <div class="msg-meta"><span class="msg-author">${m.sender_name||(m.sender_role==='coach'?'You':'Parent')}</span><span class="msg-date">${new Date(m.date_created).toLocaleDateString('en-AU',{day:'numeric',month:'short',year:'numeric'})}</span></div>
    <div class="msg-body">${m.body.replace(/\n/g,'<br>')}</div>
  </div>`).join('')}
</div>
<form class="reply-form" data-player="${pid}">
  <textarea class="reply-input" rows="3" placeholder="Write a message to ${name}'s family…"></textarea>
  <div style="display:flex;gap:8px;align-items:center;margin-top:8px">
    <button type="submit" class="btn btn-primary btn-sm">Send →</button>
    <span class="reply-status" hidden style="font-size:12px;color:red"></span>
  </div>
</form>`;

  const msgsEl = document.getElementById(`tmsg-${pid}`);
  if (msgsEl) msgsEl.scrollTop = msgsEl.scrollHeight;

  document.querySelector(`.reply-form[data-player="${pid}"]`).addEventListener('submit', async (e) => {
    e.preventDefault();
    const textarea = e.target.querySelector('.reply-input');
    const status   = e.target.querySelector('.reply-status');
    const btn      = e.target.querySelector('button[type="submit"]');
    const body     = textarea.value.trim();
    if (!body) return;
    btn.disabled=true; btn.textContent='Sending…';
    const user = ALS.user;
    const result = await aapi('/items/academy_messages', { method:'POST', body:JSON.stringify({
      player: parseInt(pid)||pid,
      sender_role: 'coach',
      sender_name: `${user?.first_name||''} ${user?.last_name||''}`.trim() || 'Technical Director',
      body,
    })});
    if (result) {
      allMessages.push({ player: pid, sender_role:'coach', sender_name: ALS.user?.first_name||'Coach', body, id:result.id, date_created:new Date().toISOString(), read_at:null });
      textarea.value = '';
      btn.disabled=false; btn.textContent='Send →';
      openThread(pid);
      renderThreadList(pid);
    } else {
      status.textContent='Failed.'; status.hidden=false;
      btn.disabled=false; btn.textContent='Send →';
    }
  });

  renderThreadList(pid);
}

// ── LOGIN ─────────────────────────────────────────────────────
document.getElementById('admin-login-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  const errEl = document.getElementById('a-login-error');
  const btn   = document.getElementById('a-login-btn');
  errEl.hidden = true; btn.disabled = true; btn.textContent = 'Signing in…';
  try {
    const res  = await fetch(`${DURL}/auth/login`, {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ email: document.getElementById('a-email').value.trim(), password: document.getElementById('a-password').value }),
    });
    const json = await res.json();
    if (!res.ok) throw new Error(json?.errors?.[0]?.message || 'Login failed');
    ALS.token   = json.data.access_token;
    ALS.refresh = json.data.refresh_token;
    const user = await aapi('/users/me?fields=id,email,first_name,last_name,role.name');
    if (!user) throw new Error('Could not load user');
    ALS.user = user;
    const role = (user?.role?.name||'').toLowerCase();
    if (!['administrator','admin','technical_director','coach'].some(r => role.includes(r))) {
      ALS.clear();
      throw new Error('Your account does not have admin access.');
    }
    showDashboard();
    loadAll();
  } catch (err) {
    errEl.textContent = err.message.includes('Invalid') ? 'Invalid email or password.' : err.message;
    errEl.hidden = false;
    btn.disabled = false; btn.textContent = 'Sign In →';
  }
});

document.getElementById('a-logout-btn').addEventListener('click', () => {
  if (ALS.token) fetch(`${DURL}/auth/logout`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({refresh_token:ALS.refresh})}).catch(()=>{});
  showLogin();
});

// ── INIT ──────────────────────────────────────────────────────
(async function init() {
  if (!ALS.token) { showLogin(); return; }
  const user = await aapi('/users/me?fields=id,email,first_name,last_name,role.name');
  if (!user) { showLogin(); return; }
  ALS.user = user;
  showDashboard();
  loadAll();
})();
</script>

