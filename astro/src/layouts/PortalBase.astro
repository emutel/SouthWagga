---
// src/layouts/PortalBase.astro
// Minimal layout for academy portals — no site nav/footer
import { CLUB } from '../club.config.js';

const {
  title       = `${CLUB.shortName} Academy`,
  description = `${CLUB.shortName} Academy Portal`,
} = Astro.props;

const colorVars = `--green:${CLUB.colors.primary};--green-bright:${CLUB.colors.primaryBright};--green-dark:${CLUB.colors.primaryDark};--gold:${CLUB.colors.gold};`;
---
<!DOCTYPE html>
<html lang="en" style={colorVars}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="robots" content="noindex">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;800;900&family=Barlow:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <slot />
</body>
</html>
