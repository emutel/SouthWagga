# ═══════════════════════════════════════════════════════════
#  Emu: Sports Club Site — Environment Config Template
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to git.
# ═══════════════════════════════════════════════════════════

# ── DIRECTUS ────────────────────────────────────────────────
# Your Railway Directus instance URL (no trailing slash)
DIRECTUS_URL=https://your-directus.up.railway.app
DIRECTUS_TOKEN=your-static-token-here

# Same URL — used in client-side code (safe to expose)
PUBLIC_DIRECTUS_URL=https://your-directus.up.railway.app

# Create a Directus user in an "Enrollment" role with write-only
# access to academy_enrollments, generate a static token, paste here.
PUBLIC_ACADEMY_ENROLLMENT_TOKEN=

# ── COACHING HUB PIN ────────────────────────────────────────
# Optional PIN to gate the coaching section (leave blank to disable)
PUBLIC_COACHING_PIN=

# ── SITE ────────────────────────────────────────────────────
PUBLIC_SITE_URL=https://your-club-domain.com.au

# ── EMAIL (smtp2go) ─────────────────────────────────────────
SMTP2GO_API_KEY=
EMAIL_FROM=noreply@your-club-domain.com.au

# ── SQUARE (shop / payments) ────────────────────────────────
SQUARE_APP_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox   # change to 'production' when live

# ── META / INSTAGRAM (gallery) ──────────────────────────────
META_APP_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# ── DRIBL (results scraper) ─────────────────────────────────
DRIBL_CLUB_ID=
DRIBL_API_TOKEN=
